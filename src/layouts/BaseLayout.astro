---
/**
 * Base page shell: <html lang dir>, SEO head, fonts, skip link, header, <main>, footer, floating contact button,
 * Cloudflare Web Analytics beacon (production builds, live hostname only).
 */
import baseHeadSrc from "~/scripts/inline/base-head.js?raw";
import { inlineJs } from "~/lib/inline-js";
import { Font } from "astro:assets";
import "~/styles/global.css";
/* Plain CSS (no Tailwind), all inside @media print: fetched at low priority, never render-blocking. */
import printCss from "~/styles/print.css?url";
import { LOCALE_META, getMessages, type Locale } from "~/i18n";
import { SITE } from "~/data/site";
import Seo from "~/components/Seo.astro";
import Header from "~/components/Header.astro";
import HeaderDrawer from "~/components/HeaderDrawer.astro";
import Footer from "~/components/Footer.astro";
import WhatsAppButton from "~/components/WhatsAppButton.astro";
import montserratTrNormal from "~/assets/fonts/montserrat-tr-normal.woff2?url&no-inline";
import montserratTrItalic from "~/assets/fonts/montserrat-tr-italic.woff2?url&no-inline";
import alexandriaLabel from "~/assets/fonts/alexandria-ar-label.woff2?url&no-inline";

interface Props {
  locale: Locale;
  /** Page title without the brand suffix (omit on the home page). */
  title?: string;
  description?: string;
  /** Path without the locale prefix: "" (home), "services", "services/control-panels". */
  path?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** The page starts with a dark <Hero>: header is transparent until scrolled. */
  heroDark?: boolean;
  /** Preload the LCP image (home hero poster); `media` limits it to the viewports where it is the LCP; `type` (e.g.
   *  "image/avif") lets browsers that cannot decode it skip the preload. */
  preloadImage?: { href: string; srcset?: string; sizes?: string; media?: string; type?: string };
  ogImage?: string;
  /** Real pixel size of `ogImage` (default 1200×630). */
  ogImageSize?: { width: number; height: number };
  /** Pre-filled WhatsApp message for the floating button (defaults to the generic one). */
  whatsappMessage?: string;
  /** Render header/footer/floating button (false for bare pages such as 404). */
  chrome?: boolean;
  /** Emit hreflang alternates (false for pages that only exist once, e.g. 404). */
  alternates?: boolean;
  /** Emit canonical + og:url (false for 404). */
  canonical?: boolean;
  /** Preload the first-screen font files (default true). */
  preloadFonts?: boolean;
  bodyClass?: string;
}

/* The <head> script, minified (it is in every page's first round trip). */
const baseHeadJs = inlineJs(baseHeadSrc);
const {
  locale,
  title,
  description,
  path = "",
  noindex = false,
  jsonLd,
  heroDark = false,
  preloadImage,
  ogImage,
  ogImageSize,
  whatsappMessage,
  chrome = true,
  alternates = true,
  canonical = true,
  preloadFonts = true,
  bodyClass,
} = Astro.props;

const meta = LOCALE_META[locale];
const t = getMessages(locale).ui;
/* Preload exactly the font files the first screen uses (the hero H1 is Montserrat italic, the lead upright), plus the
   Turkish letters on Turkish pages; Arabic pages use Alexandria's Arabic + Latin files ("PLC" in the H1).
   Chinese headings are upright (no italic Latin on any zh first screen, checked at 390 / 1440), so zh preloads the
   upright file only. Fonts that arrive late swap in without moving the layout (metric-matched fallbacks, global.css).
   The fonts are self-hosted local files (astro.config.mjs), so the filters select by style only (no `subset`). */
const latinPreload = preloadFonts && locale !== "ar" && [{ style: "normal" }, ...(locale === "zh" ? [] : [{ style: "italic" }])];
/* "LC Montserrat Ext": the Montserrat glyphs Turkish needs beyond the "latin" subset (which has ı): ğ Ğ İ Ş ş (Ğ, İ
   also come from text-transform: uppercase). Listed right after Montserrat in --font-latin (astro.config.mjs), so the
   browser takes only these code points from it, and only pages that contain them download it (unicode-range).
   ~5 KB / 2 KB vs 72/76 KB for fontsource's full latin-ext files. Same outlines, metrics and hinting as those files,
   and the same wght axis as the main faces (upright 100–900; italic 700–800, unhinted, like the italic "latin" file),
   cut with fonttools (Romanian locl dropped) from
   https://cdn.jsdelivr.net/fontsource/fonts/montserrat:vf@latest/latin-ext-wght-{normal,italic}.woff2:
     [italic: fonttools varLib.instancer <file> wght=700:800 -o <file>, then --no-hinting below]
     pyftsubset <file> --unicodes="U+011E-011F,U+0130,U+015E-015F" --layout-features="kern,mark,mkmk,ccmp,rvrn" \
       --flavor=woff2 --output-file=src/assets/fonts/montserrat-tr-<style>.woff2
   Turkish pages preload both (the first screen's H1 / lead usually has ş or ğ; a late Ext glyph would re-wrap a
   balanced heading).
   scripts/check-i18n.mjs fails the build if the copy gains a Latin letter that neither subset covers.
   `no-inline`: Vite would inline files < 4 KB as data: URIs, which the CSP (font-src 'self') blocks. */
const latinExtFaces = [
  { style: "normal", weight: "100 900", url: montserratTrNormal },
  { style: "italic", weight: "700 800", url: montserratTrItalic },
];
/* "LC Arabic Label" (I18N-13): on en / zh / tr pages the only Arabic is the language switcher's "العربية" / "ع" (the
   404 page loads the full Alexandria). A 4 KB Alexandria cut of exactly those letters (ا ب ة ر ع ل ي, all joining
   forms, wght 400–700, unhinted) instead of an OS fallback face; `:lang(ar)` in global.css falls back to it when
   --font-arabic is not loaded. Fetched only when a page shows those letters (unicode-range), not preloaded: it swaps
   inside the label without moving anything around it (measured CLS 0).
     fonttools varLib.instancer alexandria-arabic-wght.woff2 wght=400:700 -o tmp.ttf
     pyftsubset tmp.ttf --text="العربية" --layout-features='*' --no-hinting --flavor=woff2 \
       --output-file=src/assets/fonts/alexandria-ar-label.woff2 */
const fontFaceCss =
  latinExtFaces
    .map(
      ({ style, weight, url }) =>
        `@font-face{font-family:"LC Montserrat Ext";src:url("${url}") format("woff2");font-display:swap;font-weight:${weight};font-style:${style};unicode-range:U+011E-011F,U+0130,U+015E-015F}`,
    )
    .join("") +
  (locale === "ar"
    ? ""
    : `@font-face{font-family:"LC Arabic Label";src:url("${alexandriaLabel}") format("woff2");font-display:swap;font-weight:400 700;unicode-range:U+0627-0629,U+0631,U+0639,U+0644,U+064A}`);
/* Speculation rules (PERF2-06): prefetch a same-site page's HTML when the visitor is about to open it (eagerness
   "moderate": ~200 ms hover or pointer-down on desktop, viewport heuristics on Android Chrome), so the click no longer
   waits for the round trip (140–450 ms from Egypt). Prefetch only, no prerender: nothing runs (analytics, forms) for a
   page that is not opened. Never the Worker routes (/ and /api/*), the RFQ thank-you page, media / OG files, or links
   marked download / nofollow / new tab. Cloudflare Speed Brain does not cover sites that run a Worker. Browsers
   without speculation rules ignore the block; the inline script is hashed into the CSP like the others. */
const speculation = JSON.stringify({
  prefetch: [
    {
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/" } },
          { not: { href_matches: "/api/*" } },
          { not: { href_matches: "/*/contact/thanks/*" } },
          { not: { href_matches: "/media/*" } },
          // gallery thumbnails link to the full-size photo (no-JS fallback): never prefetch a file as a page
          { not: { href_matches: "/_astro/*" } },
          { not: { href_matches: "/og/*" } },
          { not: { href_matches: "/cdn-cgi/*" } },
          { not: { selector_matches: "[download], [rel~=nofollow], [target=_blank]" } },
        ],
      },
      eagerness: "moderate",
    },
  ],
});
const beacon = JSON.stringify({ token: SITE.webAnalyticsToken });
/** /^(www\.)?logic-controls\.com$/ as source text for the inline loader below. */
const beaconHost = `/^(www\\.)?${new URL(SITE.url).hostname.replace(/\./g, "\\.")}$/`;
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/*
      Render-blocking on purpose (tiny): before first paint it sets html.js, the motion preference
      (html[data-motion="off"]: user paused animations — localStorage.lcMotion — or the OS asks for reduced motion; see
      src/scripts/motion/motion-pref.ts) and the once-per-session motion flags (logo intro, FAB ping). It also listens
      for pageswap / pagereveal, which fire before the first frame of a cross-document view transition. Names are set
      only for that one navigation (unique, cheap) and cleared when it ends:
        both pages: header, floating button, nav indicator → "lc-header" / "lc-fab" / "lc-nav-ind" (only while the
          transition runs: a permanent name would make the header a backdrop root and kill its frosted glass); leaving
          through the open phone drawer, only the drawer's top bar → "lc-header" (nothing above the modal sheet)
        pageswap (old page): the clicked card's art/photo → "lc-media"; going back / up: the hero's art, or its photo
          alone ("lc-media") with its scrims as separate layers above it ("lc-hs0…"), and its copy ("lc-copy-out")
        pagereveal (new page): the hero art, phone photo band or desktop photo (+ scrims) and copy → "lc-media" /
          "lc-hs*" / "lc-hero-copy", the card we came back to → "lc-media", or the own hero when coming "up"
      Transition types: lc-page (every page-to-page transition: the page fade-through is scoped to it, so a
      same-document transition such as the project filter never fades the page), lc-next / lc-prev (case-study pager),
      lc-back (history back), lc-lang (language switch), lc-dark (a dark hero is the first screen: navy backdrop down
      to the hero's bottom edge, --vt-hero-b), lc-photo / lc-photo-out (a hero photo is the new / old side of the morph:
      clipped to the hero's slant), lc-orphan (old hero with no counterpart: leaves quickly), lc-hold (the new hero
      photo is still loading: the old picture stays until the new one can cover it), lc-fab-hold (the kept floating
      button is not parsed yet: the old one stays until the end).
      html[data-vting] while the transition runs (both pages): the header bar is opaque instead of frosted (a named
      element has no backdrop to blur). html[data-fab-keep]: the floating button was showing on the old page, so the
      new page shows it from its first style on (set here, before any page script; WhatsAppButton adopts that state).
      Same-site arrivals with the HTML at hand wait for the whole document before the first frame (<link rel=expect>).
      clear() also drops any of these names left on a node by name, so a stale one can never reach the next transition.
      html[data-vt]: this page arrived through a view transition (hero entrances don't replay). With motion off the
      transition is skipped. Also pauses looping decoration ([data-pause-offscreen]) while it is offscreen.
      See src/styles/motion.css.
    */}
    <script is:inline set:html={baseHeadJs} />
    <Seo
      locale={locale}
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      alternates={alternates}
      canonical={canonical}
      jsonLd={jsonLd}
      ogImage={ogImage}
      ogImageSize={ogImageSize}
    />
    <meta name="theme-color" content="#040e27" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        media={preloadImage.media}
        type={preloadImage.type}
        fetchpriority="high"
      />
    )}
    <Font cssVariable="--font-latin" preload={latinPreload} />
    {preloadFonts &&
      locale === "tr" &&
      latinExtFaces.map(({ url }) => <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaceCss} />
    {locale === "ar" && <Font cssVariable="--font-arabic" preload={preloadFonts} />}
    {/* The site's client JavaScript: ONE module for the whole page (src/scripts/site.ts, which takes over the component
        scripts; integrations/site-scripts.mjs). Add site-wide code there, not as another script tag here. */}
    <script>
      import "~/scripts/site";
    </script>
    <script is:inline type="speculationrules" set:html={speculation} />
    <noscript>
      <style>
        .lc-header[data-hero] .lc-header-bg {
          background: rgb(4 14 39/0.94) !important;
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body class:list={["min-h-dvh bg-white", bodyClass]}>
    <a
      href="#main"
      class="sr-only z-[100] bg-signal-400 font-bold text-navy-950 focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:px-4 focus:py-3"
    >
      {t.a11y.skip}
    </a>
    {/* The phone drawer (a top-layer modal: its DOM position does not show) is rendered after the footer, so <main> and
        the hero come ~25–30 KB earlier in the HTML (PERF2-02). */}
    {chrome && <Header locale={locale} path={path} heroDark={heroDark} drawer={false} whatsappMessage={whatsappMessage} />}
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    {chrome && <Footer locale={locale} path={path} />}
    {chrome && <WhatsAppButton locale={locale} message={whatsappMessage} />}
    {chrome && <HeaderDrawer locale={locale} path={path} whatsappMessage={whatsappMessage} />}
    {/* Analytics only on the live hostname (and www): local `wrangler dev` previews and *.workers.dev builds serve the
        same production bundle, and the beacon's reports would fail CORS there (console errors, no data anyway). */}
    {import.meta.env.PROD && SITE.webAnalyticsToken && (
      <script
        is:inline
        set:html={`if(${beaconHost}.test(location.hostname)){var s=document.createElement("script");s.defer=true;s.src="https://static.cloudflareinsights.com/beacon.min.js";s.setAttribute("data-cf-beacon",${JSON.stringify(beacon)});document.body.appendChild(s)}`}
      />
    )}
    {/* Last in the document, so its rules win ties with the screen styles above. id="lc-end": the end of the document
        for the head script's render-blocking <link rel="expect"> (keep it last, on every page). */}
    <link rel="stylesheet" href={printCss} media="print" id="lc-end" />
  </body>
</html>
