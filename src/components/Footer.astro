---
/**
 * Site footer (site chrome, one tonal step lighter than the navy closing band above it): logo, pitch, nav columns,
 * NAP (name/address/phone — identical everywhere for local SEO), WhatsApp (email on zh), Facebook (not on zh: blocked
 * in mainland China), industrial zones, language list, © year.
 * Service / industry columns list every service and industry (data-driven from src/data) and end with an
 * "All services" / "All industries" link.
 * © year: computed at build time (static site). The yearly rebuild is on the release checklist — no runtime JS.
 */
import { getMessages, type Locale } from "~/i18n";
import { SITE, telLink } from "~/data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import ChromeIcon from "./ChromeIcon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import CopyEmail from "./CopyEmail.astro";
import { FOREIGN_PATH, href, whatsappLink, mailtoLink, prefersEmail, serviceNav, industryNav } from "./nav";
import { pageContact } from "./contact-cta";
import { colon, html, ltr } from "~/lib/text";
import MotionToggle from "./MotionToggle.astro";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const m = getMessages(locale);
const t = m.ui;
const year = new Date().getFullYear();
const email = prefersEmail(locale);
const company = [
  { label: t.nav.about, path: "about" },
  { label: t.nav.projects, path: "projects" },
  { label: t.nav.technologies, path: "technologies" },
  /* the page's own short name (as in its breadcrumb), not the question the header asks: one line in a narrow list */
  { label: m.common.breadcrumbs.foreign as string, path: FOREIGN_PATH },
  { label: t.nav.contact, path: "contact" },
  { label: t.nav.privacy, path: "privacy" },
];
const columns = [
  { title: t.footer.servicesTitle, items: serviceNav(locale), all: { label: t.footer.allServices, path: "services" } },
  { title: t.footer.industriesTitle, items: industryNav(locale), all: { label: t.footer.allIndustries, path: "industries" } },
];
const linkCls = "lc-foot-link inline-flex min-h-8 items-center py-1 leading-snug text-navy-200 transition-colors hover:text-white";
/** Closing "All services" / "All industries" link of a column. */
const allCls = "lc-foot-link group inline-flex min-h-8 items-center gap-1.5 font-semibold text-royal-300 transition-colors hover:text-white";
/** Current page: underline + white (the closing "All …" link is already semibold, so weight is added per link). */
const curCls = "text-white underline decoration-signal-400 decoration-2 underline-offset-4";
/* "© 2026 Logic Controls. All rights reserved." — Chinese runs on without the Latin full stop: "Logic Controls 版权所有". */
const rights = locale === "zh" ? `${SITE.name} ${t.footer.rights}` : `${SITE.name}. ${t.footer.rights}`;
const headCls = "mb-3 type-label text-navy-300 lg:mb-4";
const ctx = pageContact(locale, path);
const mail = mailtoLink(undefined, { locale, path, topic: ctx.topic });
---

<footer class="lc-footer on-dark relative isolate bg-navy-900 text-sm text-navy-200">
  <div aria-hidden="true" class="h-px bg-[linear-gradient(90deg,var(--color-royal-500),rgb(255_255_255/0.12)_40%,rgb(255_255_255/0.12))] rtl:bg-[linear-gradient(-90deg,var(--color-royal-500),rgb(255_255_255/0.12)_40%,rgb(255_255_255/0.12))]"></div>

  <div class="wrap pt-10 sm:pt-14 lg:pt-16">
    <div class="grid gap-9 sm:gap-12 lg:grid-cols-12 lg:gap-8">
      {/* 1024–1279: the brand block is one row across the top (logo · pitch · Facebook), so the link columns below get
          the width their longer names need; from 1280 it is the first column again. */}
      <div class="lc-foot-brand lg:col-span-12 xl:col-span-3">
        <a href={href(locale)} aria-label={t.a11y.homeLink} class="inline-block">
          <Logo variant="dark" width={150} alt="" class="h-auto w-[132px] sm:w-[150px]" />
        </a>
        <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-navy-200 lg:max-xl:mt-0 lg:max-xl:max-w-xl" set:html={html(locale, t.footer.pitch)} />
        {
          !email && (
            <a
              href={SITE.facebook}
              target="_blank"
              rel="noopener"
              class="mt-5 inline-flex min-h-10 items-center gap-2.5 border border-white/15 px-3 text-navy-100 transition-colors hover:border-white/40 hover:text-white lg:max-xl:mt-0"
            >
              <Icon name="facebook" size={18} />
              <span>{t.footer.facebook}</span>
              <span class="sr-only">({t.a11y.newTab})</span>
            </a>
          )
        }
      </div>

      <nav aria-label={t.a11y.footerNav} class="lc-foot-nav grid grid-cols-2 gap-x-6 gap-y-9 sm:grid-cols-3 sm:gap-8 lg:col-span-8 lg:gap-6 xl:col-span-6 xl:gap-8 xl:ps-10">
        {
          columns.map((col) => (
            <div>
              <h2 class={headCls}>{col.title}</h2>
              <ul role="list">
                {col.items.map((l) => {
                  const cur = l.path === path;
                  return (
                    <li>
                      <a href={href(locale, l.path)} class:list={[linkCls, cur && [curCls, "font-semibold"]]} aria-current={cur ? "page" : undefined}>
                        {/* one child: in the inline-flex link, bare text runs and <bdi> would be separate flex items and
                            lose the spaces between them */}
                        <span set:html={html(locale, l.label)} />
                      </a>
                    </li>
                  );
                })}
                <li class="mt-1">
                  <a href={href(locale, col.all.path)} class:list={[allCls, path === col.all.path && curCls]} aria-current={path === col.all.path ? "page" : undefined}>
                    {col.all.label}
                    <Icon name="arrow" size={14} class="transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" />
                  </a>
                </li>
              </ul>
            </div>
          ))
        }
        <div class="max-sm:col-span-2">
          <h2 class={headCls}>{t.footer.companyTitle}</h2>
          <ul role="list" class="grid grid-cols-2 gap-x-6 sm:grid-cols-1">
            {
              company.map((l) => (
                <li>
                  <a href={href(locale, l.path)} class:list={[linkCls, l.path === path && [curCls, "font-semibold"]]} aria-current={l.path === path ? "page" : undefined}>
                    <span set:html={html(locale, l.label)} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <div class="lg:col-span-4 xl:col-span-3">
        <h2 class={headCls}>{t.footer.contactTitle}</h2>
        <address class="not-italic">
          <ul role="list" class="space-y-1.5">
            <li class="flex gap-3 pb-1.5">
              <Icon name="map-pin" size={18} class="mt-0.5 text-royal-300" />
              <span>
                <span class="block font-semibold text-white">{SITE.name}</span>
                {t.contact.addressValue}
              </span>
            </li>
            <li>
              <a href={telLink()} class="lc-foot-link flex min-h-8 items-center gap-3 transition-colors hover:text-white">
                <ChromeIcon name="phone" size={18} class="text-royal-300" />
                <span class="sr-only">{t.contact.phone}{colon(locale)}</span>
                <span class="ltr" dir="ltr">{SITE.phone.display}</span>
              </a>
            </li>
            <li class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <a href={mail} class="lc-foot-link flex min-h-8 items-center gap-3 transition-colors hover:text-white">
                <ChromeIcon name="mail" size={18} class="text-royal-300" />
                <span class="sr-only">{t.contact.email}{colon(locale)}</span>
                <Fragment set:html={ltr(SITE.email)} />
              </a>
              <CopyEmail locale={locale} iconOnly={!email} />
            </li>
            <li>
              <a href={whatsappLink(ctx.whatsapp)} target="_blank" rel="noopener" class="lc-foot-link flex min-h-8 items-center gap-3 transition-colors hover:text-white">
                <ChromeIcon name="whatsapp" size={18} class="text-whatsapp-500" />
                {/* zh: WhatsApp is blocked in mainland China, so it is offered only to visitors already in Egypt */}
                <span>{email ? t.cta.inEgyptWhatsapp : t.contact.whatsapp}</span>
                <span class="sr-only">({t.a11y.newTab})</span>
              </a>
            </li>
          </ul>
        </address>
      </div>
    </div>

    <div class="mt-10 grid gap-6 border-t border-white/10 pt-7 sm:mt-12 lg:grid-cols-[1fr_auto] lg:items-center">
      <p class="flex items-start gap-3 text-navy-200">
        <Icon name="factory" size={18} class="mt-0.5 text-signal-400" />
        <span>
          <span class="font-semibold text-white">{t.footer.zonesTitle}{colon(locale).trimEnd()}</span>{locale === "zh" ? "" : " "}
          <Fragment set:html={html(locale, t.footer.zones)} />
        </span>
      </p>
      <LanguageSwitcher locale={locale} path={path} variant="inline" class="-ms-2 flex-wrap" />
    </div>

    <div class="lc-foot-bottom mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-navy-300">
      <p>
        © <span class="ltr" dir="ltr">{year}</span> {rights}
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <MotionToggle locale={locale} class="text-xs" />
        <p class="font-mono tracking-wider ltr" dir="ltr">PLC · HMI · SCADA · VFD</p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Room under the last line for the floating contact button (phones; it steps aside over the controls above), clear
     of the home indicator. */
  .lc-foot-bottom {
    padding-bottom: max(4.5rem, calc(env(safe-area-inset-bottom, 0px) + 4rem));
  }
  @media (min-width: 64rem) {
    .lc-foot-bottom {
      padding-bottom: max(2.5rem, env(safe-area-inset-bottom, 0px));
    }
  }
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .lc-foot-brand {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 2.5rem;
    }
  }
  /* Desktop: Services and Industries as wide as their longest name, so their lists keep one line per item ("PLC and
     HMI programming", "Packaging and labeling", tr "Endüstriyel çamaşırhane"); Company takes what is left, up to its
     own longest name (it wraps first when the row is short). Any room left over spreads evenly between the columns.
     If even the shortest Company column does not fit beside them (WCAG text spacing), it moves to a second row
     instead of overflowing (VIS2-20, VIS3-07). */
  @media (min-width: 64rem) {
    .lc-foot-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }
    .lc-foot-nav > * {
      flex: none;
    }
    .lc-foot-nav > :last-child {
      flex: 1 1 0;
      max-width: max-content;
    }
  }
  /* Touch screens: 44px rows for the dense link lists (desktop density unchanged). */
  @media (pointer: coarse) {
    .lc-foot-link {
      min-height: 2.75rem;
    }
  }
</style>
