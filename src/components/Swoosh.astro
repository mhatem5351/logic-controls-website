---
/** The logo's swoosh as a tapered divider stroke (thick at the inline start, fading to a point). */
import { uid } from "./uid";
interface Props {
  class?: string;
  /** "steel" (logo gray) on light, "light" on dark, "royal" for emphasis. */
  tone?: "steel" | "light" | "royal";
}
const { class: className = "w-40", tone = "steel" } = Astro.props;
const id = uid("sw");
const [a, b] = { steel: ["#6a6b72", "#a7a7ab"], light: ["#c1d6f6", "#628ed3"], royal: ["#0556ad", "#5fa4fa"] }[tone];
---

<svg viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true" focusable="false" class:list={["block h-auto rtl:-scale-x-100", className]}>
  <defs>
    <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color={a} />
      <stop offset="0.55" stop-color={b} stop-opacity="0.85" />
      <stop offset="1" stop-color={b} stop-opacity="0" />
    </linearGradient>
  </defs>
  <path fill={`url(#${id})`} d="M0 15.5C92 6.2 210 1.6 400 2.2v.9C214 4 104 10.6 3.2 23.6Z" />
</svg>
