---
/**
 * "Where we work": interactive zone map (navy panel) + the zone list grouped by region, numbered like the pins.
 * Content: common.zones (+ common.zones.map for the interactive layer) + ZONES. Geometry: ./zone-geo.ts.
 * Put a <SectionHeading> before it (the block itself has no heading).
 * `compact` (home page): below 768px each region's zones wrap as numbered chips (names only) instead of ruled rows.
 *
 * Interaction (src/scripts/zones-map.ts, progressive enhancement — without JS the map and list are static):
 *  - Pins are HTML buttons laid over the LTR map (physical left/top from the SVG coordinates); the list rows are
 *    buttons too. Hover / keyboard focus on either lights the pin, its list row and the trace from our base; an amber
 *    signal travels the trace and the pin pings once; a tooltip shows name, governorate · region, SCZONE and the
 *    straight-line distance from our base. Hovering a region heading lights that region's pins.
 *  - Click / tap / Enter / Space selects: the readout strip under the map swaps its legend for a detail card with
 *    a CTA to the quote form (?location=<slug>#quote). Same control again, Escape or the close button deselects.
 *  - Every text inserted by the script is server-rendered here with the text helper (html() / plain()).
 */
import { getMessages, localePath, type Locale } from "~/i18n";
import { ZONES, type ZoneRegion } from "~/data/zones";
import Icon from "~/components/Icon.astro";
import Button from "~/components/Button.astro";
import { uid } from "~/components/uid";
import ZoneMap from "./ZoneMap.astro";
import { PIN, BASE, HIT_ANCHOR, MAP_W, MAP_H, kmFromBase } from "./zone-geo";
import { colon, html, plain } from "./rich";

interface Props {
  locale: Locale;
  /** Heading level for the region names. */
  headingLevel?: "h3" | "h4";
  /** Show common.zones.note under the list. */
  note?: boolean;
  /** Phones: zones as wrapped chips (names only). */
  compact?: boolean;
  class?: string;
}
const { locale, headingLevel: H = "h3", note = true, compact = false, class: className } = Astro.props;
const t = getMessages(locale).common.zones;
const m = t.map;
const u = uid("zones");
const cardId = `${u}-card`;
const comma = locale === "ar" ? "، " : locale === "zh" ? "，" : ", ";
const contact = localePath(locale, "contact");
const regions = [...new Set(ZONES.map((z) => z.region))] as ZoneRegion[];

const numbered = ZONES.map((z, i) => {
  const it = t.items[z.slug];
  const [x, y] = PIN[z.slug];
  const [ax, ay] = HIT_ANCHOR[z.slug] ?? [0.5, 0.5];
  const km = kmFromBase(z.slug);
  // "About 80 km …": the number and its unit never split (no-break space); the number is the highlighted readout.
  const distText = m.distance.replace("{km} ", `${km}\u00A0`).replace("{km}", String(km));
  const dist = z.home ? "" : html(locale, distText).replace(new RegExp(`(?<!\\d)${km}(?!\\d)`), `<b>${km}</b>`);
  // "Alexandria" alone when the region is named after the governorate (never "Alexandria · Alexandria")
  const region = it.governorate.includes(t.regions[z.region]) ? "" : t.regions[z.region];
  return {
    ...z,
    n: i + 1,
    x,
    y,
    ax,
    ay,
    name: it.name,
    label: plain(locale, [it.name, it.governorate, z.home && t.homeBase].filter(Boolean).join(comma)),
    meta: html(locale, region ? `${it.governorate} · ${region}` : it.governorate),
    // pin description for assistive tech (name + governorate are its label): region, straight-line distance
    desc: plain(locale, [region, !z.home && distText].filter(Boolean).join(locale === "ar" || locale === "zh" ? comma : ". ")),
    dist,
    cta: z.home ? m.homeCta : m.cta.replace("{zone}", (m.short as Record<string, string>)[z.slug] ?? it.name),
    href: z.home ? contact : `${contact}?location=${z.slug}#quote`,
    said: plain(locale, m.selected.replace("{zone}", it.name)),
  };
});
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---

<div class:list={["lc-zones grid items-start gap-8 sm:gap-10 lg:grid-cols-12 lg:gap-12", className]} data-zones>
  <div
    class="lc-zm-panel on-dark chamfer-lg relative isolate overflow-hidden bg-navy-950 p-2 sm:p-6 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:col-span-7"
    data-zm-panel
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint opacity-70"></div>

    <div class="lc-zm relative" data-zm data-base={BASE.join(" ")} data-home={ZONES.find((z) => z.home)?.slug}>
      <ZoneMap interactive />
      <div class="lc-zm-pins" role="group" aria-label={plain(locale, m.label)}>
        {
          numbered.map((z) => (
            <button
              type="button"
              class="lc-zm-pin"
              style={`left:${pct(z.x, MAP_W)};top:${pct(z.y, MAP_H)};--ax:${z.ax};--ay:${z.ay};--r:${z.home ? 8.5 : 7}`}
              data-zm-ctrl
              data-zone={z.slug}
              data-xy={`${z.x} ${z.y}`}
              aria-label={z.label}
              aria-expanded="false"
              aria-controls={cardId}
              aria-describedby={z.desc ? `${u}-x${z.n}` : undefined}
            />
          ))
        }
      </div>
      <div hidden>{numbered.map((z) => z.desc && <span id={`${u}-x${z.n}`}>{z.desc}</span>)}</div>
      <div class="lc-zm-tip" data-zm-tip hidden aria-hidden="true"></div>
      <p class="lc-zm-hint" data-zm-hint hidden aria-hidden="true"><span class="lc-led"></span><span set:html={html(locale, m.hint)} /></p>
    </div>

    {/* readout strip: the legend, or the selected zone's card */}
    <div class="lc-zm-legend">
      <div>
        <p class="flex items-center gap-2 px-2 pt-2 text-xs text-navy-200 sm:px-1">
          <span class="lc-led" aria-hidden="true"></span>{t.homeBase}{colon(locale)}{t.items["6th-of-october"].name}
        </p>
      </div>
    </div>
    <div class="lc-zm-card" id={cardId} data-zm-card>
      <div>
        <div class="lc-zm-card-in">
          <button type="button" class="lc-zm-close" data-zm-close aria-label={m.close}><Icon name="close" size={18} /></button>
          {
            numbered.map((z) => (
              <div class="lc-zm-art" data-card={z.slug} data-said={z.said} hidden>
                <div class="lc-zm-head" data-tip>
                  <span class:list={["lc-zm-num", z.home && "lc-zm-num-home"]} aria-hidden="true" dir="ltr">
                    {z.n}
                  </span>
                  <div class="min-w-0">
                    <p class="lc-zm-name" set:html={html(locale, z.name)} />
                    <p class="lc-zm-meta">
                      <span set:html={z.meta} />
                      {z.home && <span class="lc-zm-badge lc-zm-badge-home">{t.homeBase}</span>}
                      {z.sczone && (
                        <span class="lc-zm-badge" lang="en" dir="ltr">
                          {t.sczone}
                        </span>
                      )}
                    </p>
                  </div>
                </div>
                {z.dist && (
                  <p class="lc-zm-dist" data-tip>
                    <svg viewBox="0 0 24 8" width="24" height="8" aria-hidden="true">
                      <circle cx="3.5" cy="4" r="2.4" fill="none" stroke="currentColor" stroke-width="1.4" />
                      <path d="M6 4h14" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2 2" />
                      <circle cx="21" cy="4" r="2" fill="currentColor" />
                    </svg>
                    <span set:html={z.dist} />
                  </p>
                )}
                <Button href={z.href} size="sm" iconEnd="arrow" class="lc-zm-cta">
                  <Fragment set:html={html(locale, z.cta)} />
                </Button>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-zm-live></p>
  </div>

  <div class="lg:col-span-5">
    <div class="grid gap-5 sm:grid-cols-2 sm:gap-7 lg:grid-cols-1">
      {
        regions.map((r) => (
          <div>
            <H class="mb-2 flex items-center gap-2 type-label text-charcoal-600" data-zm-region={r}>
              <span class="slant-bar text-royal-600" aria-hidden="true" />
              {t.regions[r]}
            </H>
            <ul
              role="list"
              class:list={["divide-y divide-charcoal-200 border-y border-charcoal-200", compact && "max-md:flex max-md:flex-wrap max-md:gap-1.5 max-md:divide-y-0 max-md:border-0"]}
            >
              {numbered
                .filter((z) => z.region === r)
                .map((z) => (
                  <li>
                    <button
                      type="button"
                      class:list={[
                        "lc-zm-row flex w-full items-center gap-3 py-2 text-start sm:py-2.5",
                        compact && "max-md:w-auto max-md:gap-2 max-md:rounded-xs max-md:border max-md:border-charcoal-200 max-md:bg-white max-md:py-1 max-md:ps-1 max-md:pe-2.5",
                      ]}
                      data-zm-ctrl
                      data-zm-row
                      data-compact={compact ? "" : undefined}
                      data-zone={z.slug}
                      aria-expanded="false"
                      aria-controls={cardId}
                    >
                      <span
                        aria-hidden="true"
                        class:list={[
                          "grid size-6 shrink-0 place-items-center rounded-full font-mono text-[0.6875rem] font-bold ltr",
                          z.home ? "bg-signal-400 text-navy-950" : "border border-royal-600/40 bg-royal-50 text-royal-700",
                        ]}
                        dir="ltr"
                      >
                        {z.n}
                      </span>
                      <span class:list={["min-w-0 flex-1", compact && "max-md:flex-none"]}>
                        <span class:list={["block font-semibold text-navy-950", compact && "max-md:text-sm"]}>{z.name}</span>
                        <span class:list={["block text-[0.8125rem] leading-snug text-charcoal-600 sm:text-sm", compact && "max-md:hidden"]}>{t.items[z.slug].governorate}</span>
                      </span>
                      {z.home && (
                        <span class:list={["inline-flex shrink-0 items-center gap-1.5 rounded-xs border border-signal-600/30 bg-signal-50 px-2 py-0.5 text-xs font-semibold text-signal-800", compact && "max-md:hidden"]}>
                          <Icon name="map-pin" size={13} />
                          {t.homeBase}
                        </span>
                      )}
                      {z.sczone && (
                        <span class:list={["shrink-0 rounded-xs border border-charcoal-200 bg-charcoal-50 px-2 py-0.5 font-mono text-[0.6875rem] tracking-wider text-charcoal-700 ltr", compact && "max-md:hidden"]} lang="en" dir="ltr">
                          {t.sczone}
                        </span>
                      )}
                    </button>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
    {note && <p class="mt-6 flex gap-2.5 text-sm text-charcoal-600"><Icon name="map-pin" size={18} class="mt-0.5 text-royal-600" />{t.note}</p>}
  </div>
</div>

<script>
  import "~/scripts/zones-map";
</script>

<style is:global>
  /* ------------------------------------------------------------------ pins: HTML buttons over the LTR map */
  .lc-zm {
    container-type: inline-size;
    --u: calc(100cqw / 380); /* one map unit (viewBox 380×260), resolved inside the container */
    --k: 1; /* pin scale */
  }
  /* phones: pins a little larger (legible numbers, clearer tap affordance; hit areas are sized separately) */
  @media (max-width: 39.99rem) {
    .lc-zm {
      --k: 1.2;
    }
    .lc-zm .lc-map-pin {
      scale: var(--k);
      transform-box: fill-box;
      transform-origin: center;
    }
  }
  .lc-zm-pins {
    position: absolute;
    inset: 0;
  }
  :root:not(.js) .lc-zm-pins {
    display: none;
  }
  .lc-zm-pin {
    position: absolute;
    /* 28 map units (≈ 24px on a phone, never below 24px), at most 44px; the pin sits at (--ax, --ay) inside */
    width: clamp(1.5rem, calc(28 * var(--u)), 2.75rem);
    aspect-ratio: 1;
    translate: calc(var(--ax) * -100%) calc(var(--ay) * -100%);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .lc-zm-pin:focus-visible {
    outline: none;
  }
  .lc-zm-pin::after {
    content: "";
    position: absolute;
    left: calc(var(--ax) * 100%);
    top: calc(var(--ay) * 100%);
    width: calc((var(--r) * 2 + 8) * var(--k) * var(--u));
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    outline: 2px solid var(--focus);
    opacity: 0;
  }
  .lc-zm-pin:focus-visible::after {
    opacity: 1;
  }

  /* ------------------------------------------------------------------ map states (SVG from ZoneMap) */
  .lc-zm .lc-map-pin[data-hl] .lc-map-dot,
  .lc-zm .lc-map-pin[data-rhl] .lc-map-dot,
  .lc-zm .lc-map-pin[data-sel] .lc-map-dot {
    fill: var(--color-royal-500);
    stroke: var(--color-white);
  }
  .lc-zm .lc-map-home .lc-map-home-dot {
    transition: stroke var(--dur-micro) var(--ease-mech);
  }
  .lc-zm .lc-map-home:is([data-hl], [data-rhl], [data-sel]) .lc-map-home-dot {
    stroke: var(--color-white);
  }
  .lc-zm .lc-map-ring {
    fill: none;
    stroke: var(--color-white);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    scale: 0.7;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity var(--dur-ui) var(--ease-mech),
      scale var(--dur-ui) var(--ease-mech);
  }
  .lc-zm .lc-map-pin[data-sel] .lc-map-ring {
    opacity: 0.9;
    scale: 1;
  }
  .lc-zm .lc-map-home[data-sel] .lc-map-ring {
    stroke: var(--color-signal-300);
  }
  .lc-zm .lc-map-links path {
    transition: stroke var(--dur-ui) var(--ease-mech);
  }
  .lc-zm .lc-map-links path:is([data-hl], [data-rhl]) {
    stroke: rgb(193 224 255 / 0.85);
    stroke-width: 1.2;
  }
  .lc-zm .lc-map-links path[data-sel] {
    stroke: rgb(255 198 75 / 0.85);
    stroke-width: 1.4;
  }
  /* the signal (dash length / offsets are set per run by the script, in map units) */
  .lc-zm .lc-map-sig {
    stroke: var(--color-signal-300);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 18 1000;
    opacity: 0;
  }
  .lc-zm .lc-map-ping {
    stroke: var(--color-signal-300);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  /* once, when the map first scrolls into view: the pins breathe in numbered order */
  @media (prefers-reduced-motion: no-preference) {
    .lc-zm[data-intro] .lc-map-ring {
      animation: lc-zm-breathe 1s var(--ease-emph) calc(var(--i) * 90ms + 150ms);
    }
  }
  @keyframes lc-zm-breathe {
    0% {
      opacity: 0;
      scale: 0.6;
    }
    30% {
      opacity: 0.85;
      scale: 1;
    }
    100% {
      opacity: 0;
      scale: 1.6;
    }
  }
  @keyframes lc-zm-in {
    from {
      opacity: 0;
      translate: 0 4px;
    }
  }

  /* ------------------------------------------------------------------ hint chip (one time, panel corner) */
  .lc-zm-hint {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.25rem;
    padding-inline: 0.625rem 0.75rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-navy-100);
    background: rgb(4 14 39 / 0.82);
    border: 1px solid rgb(150 182 232 / 0.28);
    border-radius: 999px;
    pointer-events: none;
    transition: opacity var(--dur-ui) var(--ease-exit);
    animation: lc-zm-in var(--dur-ui) var(--ease-mech) 1.1s backwards;
  }
  .lc-zm-hint[data-out] {
    opacity: 0;
  }

  /* ------------------------------------------------------------------ tooltip */
  .lc-zm-tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: max-content;
    max-width: min(17rem, calc(100% - 0.5rem));
    padding: 0.625rem 0.75rem 0.6875rem;
    color: var(--color-navy-100);
    background: var(--color-navy-900);
    border: 1px solid rgb(95 164 250 / 0.38);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 20px -12px rgb(0 0 0 / 0.8);
    pointer-events: none;
    animation: lc-zm-in var(--dur-ui) var(--ease-emph);
  }
  .lc-zm-tip::after {
    content: "";
    position: absolute;
    left: var(--cx, 50%);
    top: 100%;
    width: 9px;
    height: 9px;
    translate: -50% -50%;
    rotate: 45deg;
    background: inherit;
    border: solid rgb(95 164 250 / 0.38);
    border-width: 0 1px 1px 0;
  }
  .lc-zm-tip[data-below]::after {
    top: 0;
    border-width: 1px 0 0 1px;
  }
  .lc-zm-tip .lc-zm-name {
    font-size: 0.875rem;
  }
  .lc-zm-tip .lc-zm-num {
    display: none;
  }
  .lc-zm-tip .lc-zm-dist {
    margin-top: 0.375rem;
  }

  /* ------------------------------------------------------------------ readout strip: legend ⇄ card */
  /* Both collapse with grid rows 1fr ⇄ 0fr (smooth height, user-initiated only); the collapsed one is hidden from
     focus and AT once it has closed. Nothing changes height on load (CLS 0). */
  .lc-zm-legend,
  .lc-zm-card {
    display: grid;
    transition:
      grid-template-rows var(--dur-ui) var(--ease-mech),
      opacity var(--dur-ui) var(--ease-mech),
      visibility 0s linear 0s;
  }
  .lc-zm-legend > *,
  .lc-zm-card > * {
    min-height: 0;
    overflow: hidden;
  }
  .lc-zm-legend,
  [data-zm-panel][data-open] .lc-zm-card {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }
  .lc-zm-card,
  [data-zm-panel][data-open] .lc-zm-legend {
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition-delay: 0s, 0s, var(--dur-ui);
  }
  .lc-zm-card-in {
    position: relative;
    margin-top: 0.5rem;
    padding: 0.875rem 1rem 1rem;
    background: rgb(6 27 69 / 0.78);
    border: 1px solid rgb(150 182 232 / 0.2);
  }
  /* the amber trace switches on along the card's top edge (logo motif) */
  .lc-zm-card-in::before {
    content: "";
    position: absolute;
    inset-inline: -1px;
    top: -1px;
    height: 2px;
    background: linear-gradient(to right, var(--color-signal-400), rgb(255 176 43 / 0.15));
    transform-origin: 0 50%;
    scale: 0 1;
    transition: scale var(--dur-section) var(--ease-emph);
  }
  [dir="rtl"] .lc-zm-card-in::before {
    background: linear-gradient(to left, var(--color-signal-400), rgb(255 176 43 / 0.15));
    transform-origin: 100% 50%;
  }
  [data-zm-panel][data-open] .lc-zm-card-in::before {
    scale: 1 1;
  }
  .lc-zm-close {
    position: absolute;
    top: 0.375rem;
    inset-inline-end: 0.375rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-navy-200);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease-mech),
      background-color var(--dur-micro) var(--ease-mech);
  }
  @media (hover: hover) {
    .lc-zm-close:hover {
      color: var(--color-white);
      background: rgb(255 255 255 / 0.08);
    }
  }
  .lc-zm-close:focus-visible {
    outline-offset: -2px;
  }
  .lc-zm-art {
    display: grid;
    gap: 0.625rem 1rem;
    animation: lc-zm-in var(--dur-ui) var(--ease-mech);
  }
  @media (min-width: 40rem) {
    .lc-zm-art {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
    .lc-zm-art > .lc-zm-head {
      grid-column: 1 / -1;
    }
  }
  .lc-zm-cta {
    justify-self: start;
  }
  .lc-zm-card .lc-zm-head {
    padding-inline-end: 2.25rem;
  }
  .lc-zm-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .lc-zm-num {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.0625rem;
    border-radius: 999px;
    font: 700 0.6875rem/1 var(--font-mono);
    color: var(--color-royal-200);
    background: rgb(37 122 224 / 0.16);
    border: 1px solid rgb(149 198 255 / 0.45);
  }
  .lc-zm-num-home {
    color: var(--color-navy-950);
    background: var(--color-signal-400);
    border-color: var(--color-signal-400);
  }
  .lc-zm-name {
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-white);
  }
  .lc-zm-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-navy-200);
  }
  .lc-zm-badge {
    padding: 0 0.375rem;
    font: 500 0.625rem/1.6 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--color-navy-100);
    border: 1px solid rgb(150 182 232 / 0.4);
    border-radius: var(--radius-xs);
  }
  .lc-zm-badge-home {
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-signal-300);
    border-color: rgb(255 176 43 / 0.45);
  }
  .lc-zm-dist {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-navy-100);
  }
  .lc-zm-dist svg {
    flex: none;
    color: var(--color-signal-400);
  }
  [dir="rtl"] .lc-zm-dist svg {
    scale: -1 1;
