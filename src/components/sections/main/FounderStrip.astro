---
/**
 * Compact founder strip ("who you will work with") for the home page and the foreign-manufacturers page:
 * small chamfered photo, eyebrow, title, one paragraph and a link to the founder block on the About page.
 * Copy: common.founderStrip { eyebrow, title, text, cta } — renders nothing until it exists.
 * Photo alt text: about.founder name + role. Layout: photo + heading side by side on phones, text below;
 * from 640px one row (photo | heading + text | link).
 */
import { Picture } from "astro:assets";
import { getMessages, type Locale } from "~/i18n";
import Button from "~/components/Button.astro";
import { href } from "~/components/nav";
import { html } from "./rich";
import founderPhoto from "~/assets/people/founder.jpg";

interface Strip {
  eyebrow?: string;
  title?: string;
  text?: string;
  cta?: string;
}
interface Props {
  locale: Locale;
  headingLevel?: "h2" | "h3";
  class?: string;
}
const { locale, headingLevel: H = "h3", class: className } = Astro.props;
const t = getMessages(locale);
const strip = (t.common as Record<string, unknown>).founderStrip as Strip | undefined;
const founder = (t.about as Record<string, unknown>).founder as { name?: string; role?: string } | undefined;
const alt = [founder?.name, founder?.role].filter(Boolean).join(", ");
---

{
  strip?.title && (
    <div
      class:list={[
        "lc-reveal relative grid grid-cols-[4.5rem_minmax(0,1fr)] items-center gap-x-4 gap-y-4 border border-charcoal-200 bg-white p-5",
        "sm:grid-cols-[6.5rem_minmax(0,1fr)_auto] sm:gap-x-7 sm:gap-y-1.5 sm:p-6 lg:p-7",
        className,
      ]}
    >
      <span aria-hidden="true" class="absolute -top-px start-5 h-1 w-14 skew-x-[-10deg] bg-royal-600 sm:start-6 lg:start-7 rtl:skew-x-[10deg]" />
      {/* navy hairline frame with the logo's 45° cut (the photo's light-grey wall would hide a bare chamfer) */}
      <div class="chamfer col-start-1 row-start-1 bg-navy-950 p-[3px] [--chamfer:13px] sm:row-span-2 sm:self-center sm:[--chamfer:17px]">
      <div class="chamfer relative aspect-square overflow-hidden bg-charcoal-100 [--chamfer:11px] sm:[--chamfer:15px]">
        <Picture
          src={founderPhoto}
          alt={alt}
          formats={["avif", "webp"]}
          widths={[104, 208]}
          sizes="(min-width: 640px) 104px, 72px"
          layout="full-width"
          class="size-full origin-[50%_32%] scale-[1.25] object-cover"
        />
      </div>
      </div>
      <div class="col-start-2 row-start-1 min-w-0 sm:self-end">
        {strip.eyebrow && (
          <p class="mb-1.5 flex items-center gap-3 type-label text-royal-700">
            <span class="slant-bar w-4 text-royal-600" aria-hidden="true" />
            {strip.eyebrow}
          </p>
        )}
        <H class="type-h3 text-navy-950" set:html={html(locale, strip.title)} />
      </div>
      {strip.text && (
        <p class="col-span-2 max-w-3xl text-[0.9375rem] text-charcoal-700 sm:col-span-1 sm:col-start-2 sm:row-start-2 sm:self-start" set:html={html(locale, strip.text)} />
      )}
      {strip.cta && (
        <Button
          href={`${href(locale, "about")}#founder`}
          variant="secondary"
          size="sm"
          iconEnd="arrow"
          class="col-span-2 justify-self-start sm:col-span-1 sm:col-start-3 sm:row-span-2 sm:row-start-1 sm:self-center"
        >
          {strip.cta}
        </Button>
      )}
    </div>
  )
}
