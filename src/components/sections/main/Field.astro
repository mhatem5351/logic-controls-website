---
/**
 * Form field scaffold for the RFQ form: label (+ required "*" / "optional" marker), the control (slot),
 * help text (`{id}-help`) and an error slot (`{id}-error`, filled by the form script).
 * The control must reference them itself: aria-describedby={`${id}-help ${id}-error`}.
 *
 * `requiredNoJs`: required only in the no-JS single-page form (shows "*" without JS, "optional" with JS).
 * The "optional" marker gets the locale's brackets: full-width （选填） in Chinese, ASCII elsewhere (on Arabic pages
 * the label is RTL, so the bidi algorithm mirrors them correctly around the Arabic word).
 */
import type { Locale } from "~/i18n";
import { toHtml } from "~/lib/text";

interface Props {
  id: string;
  label: string;
  required?: boolean;
  requiredNoJs?: boolean;
  /** "optional" label text (shown for optional fields). */
  optional?: string;
  help?: string;
  class?: string;
}
const { id, label, required = false, requiredNoJs = false, optional, help, class: className } = Astro.props;
const locale = Astro.currentLocale as Locale | undefined;
const BRACKETS: Partial<Record<Locale, [string, string]>> = { zh: ["（", "）"] };
const [open, close] = BRACKETS[locale ?? "en"] ?? ["(", ")"];
/* Messages may already carry the brackets; never double them. A full-width bracket brings its own space, so the
   zh marker cancels the label's flex gap (-ms-1.5). */
const optionalMarker = optional && (/^[(（].*[)）]$/.test(optional.trim()) ? optional : `${open}${optional}${close}`);
---

<div class:list={["lc-field", className]} data-field={id}>
  <label for={id} class="lc-label">
    <span>{label}</span>
    {required && <span class="lc-req" aria-hidden="true">*</span>}
    {requiredNoJs && <span class="lc-req lc-nojs" aria-hidden="true">*</span>}
    {optional && !required && <span class:list={["lc-opt", requiredNoJs && "lc-js", open === "（" && "-ms-1.5"]}>{optionalMarker}</span>}
  </label>
  <slot />
  {help && <p id={`${id}-help`} class="lc-help" set:html={toHtml(locale, help)} />}
  <p id={`${id}-error`} class="lc-error" hidden></p>
</div>
