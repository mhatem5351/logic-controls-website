---
/**
 * Closing CTA with the "What we need to quote" checklist (common.quoteChecklist).
 * Same visual language as <CtaBand> (navy, angled top, blueprint, gear watermark) in two columns:
 * pitch + buttons + contact line | checklist card. On zh the drawings hint points to email (WhatsApp is blocked).
 */
import { getMessages, type Locale } from "~/i18n";
import { SITE } from "~/data/site";
import Button from "~/components/Button.astro";
import BrandMark from "~/components/BrandMark.astro";
import Icon from "~/components/Icon.astro";
import Swoosh from "~/components/Swoosh.astro";
import { href as lhref, QUOTE_PATH, whatsappLink, mailtoLink, prefersEmail } from "~/components/nav";
import { html } from "./rich";

interface Cta {
  label: string;
  href: string;
}
interface Props {
  locale: Locale;
  title: string;
  text?: string;
  eyebrow?: string;
  primary?: Cta;
  /** Defaults to WhatsApp (email on zh). */
  secondary?: Cta | false;
  /** WhatsApp message for the drawings hint. */
  whatsappMessage?: string;
  id?: string;
  class?: string;
}

const { locale, title, text, eyebrow, id, class: className } = Astro.props;
const t = getMessages(locale);
const email = prefersEmail(locale);
const q = t.common.quoteChecklist;
const {
  primary = { label: t.ui.cta.quote, href: lhref(locale, QUOTE_PATH) },
  secondary = email
    ? { label: t.ui.cta.emailEngineer, href: mailtoLink(t.ui.email.subject) }
    : { label: t.ui.cta.whatsapp, href: whatsappLink(t.common.whatsapp.default) },
  whatsappMessage = t.common.whatsapp.drawings,
} = Astro.props;
const secondaryIsWa = secondary && secondary.href.startsWith("https://wa.me");
---

<section id={id} class:list={["on-dark angle-top relative isolate overflow-hidden bg-navy-950 py-section text-navy-100", className]}>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint mask-fade-edges"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(ellipse_60%_80%_at_20%_40%,rgb(5_86_173/0.35),transparent_70%)] rtl:bg-[radial-gradient(ellipse_60%_80%_at_80%_40%,rgb(5_86_173/0.35),transparent_70%)]"></div>
  <BrandMark tone="mono" class="pointer-events-none absolute -start-24 top-1/2 -z-10 hidden h-[120%] w-auto -translate-y-1/2 text-white/[0.03] lg:block" />
  <div class="wrap grid items-start gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6 lg:pt-4">
      {
        eyebrow && (
          <p class="mb-4 flex items-center gap-3 type-label text-navy-200">
            <span class="slant-bar text-signal-400" aria-hidden="true" />
            <span>{eyebrow}</span>
          </p>
        )
      }
      <h2 class="type-h2 text-white" set:html={html(locale, title)} />
      <Swoosh tone="light" class="mt-5 w-40" />
      {text && <p class="mt-5 max-w-xl type-lead text-navy-200" set:html={html(locale, text)} />}
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Button href={primary.href} size="lg" iconEnd="arrow" class="max-sm:w-full">{primary.label}</Button>
        {
          secondary && (
            <Button
              href={secondary.href}
              size="lg"
              variant="on-dark"
              icon={secondaryIsWa ? "whatsapp" : "mail"}
              iconClass={secondaryIsWa ? "text-[#25d366]" : "text-royal-300"}
              external={secondaryIsWa}
              class="max-sm:w-full"
            >
              {secondary.label}
            </Button>
          )
        }
      </div>
      <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-navy-200">
        <a href={`tel:${SITE.phone.tel}`} class="inline-flex min-h-6 items-center gap-2 hover:text-white">
          <Icon name="phone" size={16} class="text-royal-300" />
          <span class="sr-only">{t.common.labels.phone}:</span>
          <span class="ltr" dir="ltr">{SITE.phone.display}</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="inline-flex min-h-6 items-center gap-2 hover:text-white">
          <Icon name="mail" size={16} class="text-royal-300" />
          <span class="sr-only">{t.common.labels.email}:</span>
          <span class="ltr" dir="ltr">{SITE.email}</span>
        </a>
      </p>
    </div>

    <div class="lg:col-span-6">
      <div class="chamfer-lg relative border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm sm:p-8">
        <span aria-hidden="true" class="absolute -top-px start-8 h-1 w-14 skew-x-[-10deg] bg-signal-400 rtl:skew-x-[10deg]"></span>
        <h3 class="flex items-center gap-3 type-h3 text-white">
          <Icon name="file" size={24} class="text-signal-300" />
          {q.title}
        </h3>
        <p class="mt-3 text-sm text-navy-200">{q.intro}</p>
        <ol role="list" class="mt-6 divide-y divide-white/8 border-y border-white/8">
          {
            q.items.map((item, i) => (
              <li class="flex gap-4 py-3">
                <span aria-hidden="true" class="mt-0.5 shrink-0 font-mono text-xs text-royal-300 ltr" dir="ltr">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="text-[0.9375rem] text-navy-100" set:html={html(locale, item)} />
              </li>
            ))
          }
        </ol>
        {
          email ? (
            <a href={mailtoLink(t.ui.email.subject)} class="mt-6 inline-flex min-h-11 items-center gap-3 font-semibold text-royal-300 underline-offset-4 hover:text-white hover:underline">
              <Icon name="mail" size={20} />
              <span>
                {t.contact.channels.email.text} <span class="ltr" dir="ltr">{SITE.email}</span>
              </span>
            </a>
          ) : (
            <a href={whatsappLink(whatsappMessage)} target="_blank" rel="noopener" class="mt-6 inline-flex min-h-11 items-center gap-3 font-semibold text-navy-100 underline-offset-4 hover:text-white hover:underline">
              <Icon name="whatsapp" size={20} class="text-[#25d366]" />
              <span>{q.whatsappHint}</span>
              <span class="sr-only">({t.ui.a11y.newTab})</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
