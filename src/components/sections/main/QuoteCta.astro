---
/**
 * Closing CTA with the "What we need to quote" checklist (common.quoteChecklist): <CtaBand> with <ChecklistPanel> in
 * its aside (two columns from 1024px; the panel is collapsed below that so the buttons stay close to the pitch).
 * Also the single closing block of the service pages. Takes plain-text copy (formatted with the rich-text rules).
 * On zh the drawings hint points to email (WhatsApp is blocked); on ar WhatsApp is the first, filled button.
 */
import type { Locale } from "~/i18n";
import CtaBand from "~/components/CtaBand.astro";
import type { Cta } from "~/components/contact-cta";
import ChecklistPanel from "./ChecklistPanel.astro";
import { html } from "~/lib/text";

interface Props {
  locale: Locale;
  title: string;
  text?: string;
  eyebrow?: string;
  primary?: Cta;
  /** Defaults to WhatsApp (email on zh). */
  secondary?: Cta | false;
  /** WhatsApp message for the drawings hint (and the default WhatsApp button). */
  whatsappMessage?: string;
  id?: string;
  class?: string;
}

const { locale, title, text, eyebrow, primary, secondary, whatsappMessage, id, class: className } = Astro.props;
---

<CtaBand
  locale={locale}
  title={html(locale, title)}
  textHtml={text ? html(locale, text) : undefined}
  eyebrow={eyebrow}
  primary={primary}
  secondary={secondary}
  whatsappMessage={whatsappMessage}
  id={id}
  class={className}
>
  <ChecklistPanel slot="aside" locale={locale} tone="dark" whatsappMessage={whatsappMessage} />
</CtaBand>
