---
/**
 * Leadership / founder block for the About page. Renders nothing unless `founder` is passed
 * (about.founder is optional copy: { eyebrow, title, name, role, bio: string[], highlights: [{ value, label }] }).
 * No photo: a navy "nameplate" tile with a monogram (Latin names) or the brand mark (other scripts).
 */
import type { Locale } from "~/i18n";
import BrandMark from "~/components/BrandMark.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import { html } from "./rich";

export interface Founder {
  eyebrow?: string;
  title?: string;
  name: string;
  role?: string;
  bio?: string[];
  highlights?: { value: string; label: string }[];
}

interface Props {
  locale: Locale;
  founder?: Founder | null;
  /** Technical-drawing index for the heading, e.g. "02". */
  index?: string;
  id?: string;
  class?: string;
}

const { locale, founder, index, id = "founder", class: className } = Astro.props;
const name = founder?.name?.trim() ?? "";
const latin = /^[A-Za-z]/.test(name);
const words = name.split(/\s+/).filter(Boolean);
const initials = latin && words.length ? `${words[0]![0]}${words.length > 1 ? words[words.length - 1]![0] : ""}`.toUpperCase() : "";
const bio = (founder?.bio ?? []).filter(Boolean);
const highlights = (founder?.highlights ?? []).filter((h) => h && h.value && h.label);
const titleId = `${id}-title`;
---

{
  founder && name && (
    <section id={id} class:list={["relative isolate bg-white py-section text-charcoal-800", className]} aria-labelledby={titleId}>
      <div class="wrap grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
        {/* nameplate (after the text on small screens, at the start of the row on desktop) */}
        <div class="order-last lg:order-first lg:col-span-4">
          <div class="on-dark chamfer-lg relative isolate overflow-hidden bg-navy-950 p-7 text-navy-100 sm:p-8">
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint mask-fade-edges" />
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(ellipse_80%_70%_at_100%_0%,rgb(5_86_173/0.5),transparent_70%)] rtl:bg-[radial-gradient(ellipse_80%_70%_at_0%_0%,rgb(5_86_173/0.5),transparent_70%)]" />
            <BrandMark tone="mono" class="pointer-events-none absolute -end-10 -bottom-10 -z-10 h-56 w-auto text-white/[0.05]" />
            <span class="lc-led absolute end-8 top-8 max-lg:hidden" aria-hidden="true" />
            <div class="flex items-center gap-5 lg:block">
              <div aria-hidden="true" class="grid aspect-square w-20 shrink-0 place-items-center border border-royal-400/40 bg-navy-900/70 sm:w-24 lg:mt-6 lg:w-36">
                {initials ? (
                  <span class="text-[2rem] leading-none font-extrabold tracking-[-0.04em] text-white italic sm:text-[2.5rem] lg:text-[3.25rem] ltr" lang="en" dir="ltr">
                    {initials.split("").map((ch, i) => (i === initials.length - 1 && initials.length > 1 ? <span class="text-royal-300">{ch}</span> : ch))}
                  </span>
                ) : (
                  <BrandMark tone="dark" class="h-10 w-auto sm:h-12 lg:h-16" />
                )}
              </div>
              <div class="min-w-0 lg:mt-8">
                <p class="type-h3 text-white">{name}</p>
                {founder.role && <p class="mt-1.5 text-sm text-navy-200">{founder.role}</p>}
              </div>
            </div>
            <div aria-hidden="true" class="mt-6 h-px bg-gradient-to-r lg:mt-7 from-royal-400/60 to-transparent rtl:bg-gradient-to-l" />
            <p aria-hidden="true" class="mt-4 font-mono text-[0.6875rem] tracking-[0.18em] text-navy-300 ltr" dir="ltr">PLC · HMI · SCADA</p>
          </div>
        </div>

        {/* bio */}
        <div class="lg:col-span-8">
          <SectionHeading
            id={titleId}
            index={index}
            eyebrow={founder.eyebrow}
            title={html(locale, founder.title ?? name)}
          />
          {bio.length > 0 && (
            <div class="prose-lc mt-8 max-w-2xl text-[1.0625rem] text-charcoal-700">
              {bio.map((p) => <p set:html={html(locale, p)} />)}
            </div>
          )}
          {highlights.length > 0 && (
            <dl class:list={["mt-10 grid gap-px overflow-hidden border border-charcoal-200 bg-charcoal-200", highlights.length >= 3 ? "sm:grid-cols-3" : "sm:grid-cols-2"]}>
              {highlights.map((h) => (
                <div class="flex flex-col gap-1.5 bg-white p-5 sm:p-6">
                  <dt class="text-sm text-charcoal-600" set:html={html(locale, h.label)} />
                  <dd class="order-first type-h3 text-navy-950"><span dir="auto" set:html={html(locale, h.value)} /></dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </section>
  )
}
