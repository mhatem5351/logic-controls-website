---
/**
 * Compact team strip ("who you will work with") for the home page and the foreign-manufacturers page: chamfered
 * icon tile, eyebrow, title, one paragraph and a link to the About page. Copy: common.teamStrip { eyebrow, title,
 * text, cta }. No names or portraits: the founder asked not to be featured on the site (October 2026), so the strip
 * speaks for the team. Layout: tile + heading side by side on phones, text below; from 640px one row
 * (tile | heading + text | link).
 */
import { getMessages, type Locale } from "~/i18n";
import Button from "~/components/Button.astro";
import Icon from "~/components/Icon.astro";
import { href } from "~/components/nav";
import { heading, html } from "~/lib/text";

interface Props {
  locale: Locale;
  headingLevel?: "h2" | "h3";
  class?: string;
}
const { locale, headingLevel: H = "h3", class: className } = Astro.props;
const strip = getMessages(locale).common.teamStrip;
---

{strip.title && (
  <div
    class:list={[
      "lc-reveal relative grid grid-cols-[3.5rem_minmax(0,1fr)] items-center gap-x-4 gap-y-4 border border-charcoal-200 bg-white p-5",
      "sm:grid-cols-[4.5rem_minmax(0,1fr)_auto] sm:gap-x-7 sm:gap-y-1.5 sm:p-6 lg:p-7",
      className,
    ]}
  >
    <span
      aria-hidden="true"
      class="absolute -top-px start-5 h-1 w-14 skew-x-[-10deg] bg-royal-600 sm:start-6 lg:start-7 rtl:skew-x-[10deg]"
    />
    <div
      aria-hidden="true"
      class="chamfer col-start-1 row-start-1 grid aspect-square place-items-center bg-navy-950 text-royal-300 [--chamfer:10px] sm:row-span-2 sm:self-center sm:[--chamfer:13px]"
    >
      <Icon name="users" size={26} class="sm:size-8" />
    </div>
    <div class="col-start-2 row-start-1 min-w-0 sm:self-end">
      {strip.eyebrow && (
        <p class="mb-1.5 flex items-center gap-3 type-label text-royal-700">
          <span class="slant-bar w-4 text-royal-600" aria-hidden="true" />
          {strip.eyebrow}
        </p>
      )}
      <H class="type-h3 text-navy-950" set:html={heading(locale, strip.title)} />
    </div>
    {strip.text && (
      <p
        class="col-span-2 max-w-3xl text-[0.9375rem] text-charcoal-700 sm:col-span-1 sm:col-start-2 sm:row-start-2 sm:self-start"
        set:html={html(locale, strip.text)}
      />
    )}
    {strip.cta && (
      <Button
        href={href(locale, "about")}
        variant="secondary"
        size="sm"
        iconEnd="arrow"
        class="col-span-2 justify-self-start sm:col-span-1 sm:col-start-3 sm:row-span-2 sm:row-start-1 sm:self-center"
      >
        {strip.cta}
      </Button>
    )}
  </div>
)}
