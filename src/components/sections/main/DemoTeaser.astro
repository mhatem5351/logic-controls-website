---
/**
 * Phone / tablet teaser for a long interactive block (the live HMI demo): below 1024px the slot is shown as a
 * ~1-screen preview — clipped and faded out at the bottom — with a "Try the live demo" button that expands it in
 * place and moves focus into it. From 1024px, and without JavaScript, the slot renders in full and the button is not
 * shown.
 * While collapsed, only the interactive part (`interactive`, a selector inside the slot; default: the whole slot) is
 * inert, so its controls are not reachable while you cannot use them — the block's heading and lead stay in the
 * accessibility tree (screen-reader users navigating by headings still find the section).
 * The demo component itself is untouched; this only wraps it from the page side (it may mark its control group with
 * `data-teaser-anchor`: on short screens the expand scrolls that group into view, see below).
 */
import { getMessages, type Locale } from "~/i18n";
import Icon from "~/components/Icon.astro";

interface Props {
  locale: Locale;
  /** Accessible label for the button, if it should say more than ui.demo.open. */
  label?: string;
  /** CSS selector (inside the slot) of the part to make inert while collapsed, e.g. ".lc-hmi". Default: everything. */
  interactive?: string;
  class?: string;
}
const { locale, label, interactive, class: className } = Astro.props;
const t = getMessages(locale).ui;
---

<div class:list={["lc-teaser", className]} data-teaser data-collapsed data-interactive={interactive}>
  <div class="lc-teaser-body">
    <slot />
  </div>
  <div class="lc-teaser-cta">
    <button type="button" class="lc-btn" data-variant="primary" data-size="lg" data-block aria-label={label}>
      <Icon name="play" size={18} />
      <span class="lc-btn-label">{t.demo.open}</span>
    </button>
  </div>
</div>

<style>
  .lc-teaser-cta {
    display: none;
  }
  @media (max-width: 63.99rem) {
    :global(html.js) .lc-teaser[data-collapsed] .lc-teaser-body {
      max-height: var(--teaser-h, 30rem);
      overflow: hidden;
      mask-image: linear-gradient(to bottom, #000 55%, transparent);
    }
    :global(html.js) .lc-teaser[data-collapsed] .lc-teaser-cta {
      position: relative;
      display: block;
      margin-top: -3.5rem;
    }
  }
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    /* tablets: a centred button, not a full-width bar */
    :global(html.js) .lc-teaser[data-collapsed] .lc-teaser-cta {
      max-width: 24rem;
      margin-inline: auto;
    }
  }
</style>

<script>
  import { scrollBehavior } from "~/scripts/motion/motion-pref";

  const collapsible = matchMedia("(max-width: 63.99rem)");
  document.querySelectorAll<HTMLElement>("[data-teaser]").forEach((teaser) => {
    if (teaser.dataset.teaserInit) return;
    teaser.dataset.teaserInit = "";
    const body = teaser.querySelector<HTMLElement>(".lc-teaser-body");
    const btn = teaser.querySelector<HTMLButtonElement>(".lc-teaser-cta button");
    if (!body || !btn) return;
    // Only the clipped controls are taken out of reach; the heading / lead around them stay exposed.
    const sel = teaser.dataset.interactive;
    const target = (sel && body.querySelector<HTMLElement>(sel)) || body;
    const sync = () => target.toggleAttribute("inert", collapsible.matches && teaser.hasAttribute("data-collapsed"));
    sync();
    collapsible.addEventListener("change", sync);
    btn.addEventListener("click", () => {
      teaser.removeAttribute("data-collapsed");
      sync();
      // Focus the first visible control of the demo (the button that was pressed disappears), else the block itself.
      const first = [...target.querySelectorAll<HTMLElement>("button:not([disabled]), [href], [tabindex]:not([tabindex='-1'])")].find(
        (el) => el.getClientRects().length > 0 && getComputedStyle(el).visibility !== "hidden",
      );
      if (first) first.focus({ preventScroll: true });
      else {
        target.tabIndex = -1;
        target.focus({ preventScroll: true });
      }
      /* Short screens (< 720px): the block's top under the header left its controls on the bottom edge (the next
         ones below the fold, the floating button over the first) (MOT3-09). Instead: the focused control at ~60% of
         the height, higher if the slot's control group ([data-teaser-anchor]) would end in the floating button's
         corner (the bottom 5.5rem), never in the top 20% (under the header). */
      if (first && innerHeight < 720) {
        const f = first.getBoundingClientRect();
        const a = (target.querySelector<HTMLElement>("[data-teaser-anchor]") ?? first).getBoundingClientRect();
        const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        const dy = Math.min(Math.max(f.top - innerHeight * 0.6, a.bottom - (innerHeight - 5.5 * rem)), a.top - innerHeight * 0.2);
        scrollTo({ top: scrollY + dy, behavior: scrollBehavior() });
      } else target.scrollIntoView({ block: "start", behavior: scrollBehavior() });
    });
  });
</script>
