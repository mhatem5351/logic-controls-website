---
/**
 * Schematic map of northern Egypt (Mediterranean coast, Nile and its delta, Suez Canal, Gulf of Suez) with
 * numbered pins for the industrial zones we work across. Language-neutral (no text inside the SVG: pins carry
 * the same numbers as the zone list next to it). Self-drawn, so no map tiles or third-party requests (zh-safe).
 *
 *   <ZoneMap />                    all zones, numbered, home base pulsing
 *   <ZoneMap interactive />        + selection rings, the amber signal pulse and the arrival ping (ZonesBlock drives
 *                                  them from src/scripts/zones-map.ts; the HTML pin buttons sit over this SVG)
 *   <ZoneMap only="home" />        our base highlighted, the other zones as faint dots (contact address card)
 *
 * Projection and pin positions: ./zone-geo.ts.
 */
import { ZONES } from "~/data/zones";
import { uid } from "~/components/uid";
import { PIN, BASE, PIN_R, MAP_W, MAP_H } from "./zone-geo";

interface Props {
  only?: "home";
  /** Hooks for ZonesBlock's interactive layer (data-zone / data-region on links and pins, rings, signal path). */
  interactive?: boolean;
  /** Accessible name. Without it the map is decorative (the zone list carries the content). */
  label?: string;
  class?: string;
}
const { only, interactive = false, label, class: className } = Astro.props;

const pins = ZONES.map((z, i) => ({ ...z, n: i + 1, x: PIN[z.slug][0], y: PIN[z.slug][1] }));
const region = (z: (typeof pins)[number]) => (interactive ? { "data-region": z.region } : {});
const u = uid("map");
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

<svg class:list={["lc-map block h-auto w-full", className]} viewBox={`0 0 ${MAP_W} ${MAP_H}`} {...a11y} data-map data-pause-offscreen>
  <defs>
    <pattern id={`${u}-sea`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-10)">
      <path d="M0 3H6" stroke="currentColor" stroke-width=".6" class="text-royal-400/25"></path>
    </pattern>
    <radialGradient id={`${u}-glow`} cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="var(--color-signal-400)" stop-opacity=".45"></stop>
      <stop offset="1" stop-color="var(--color-signal-400)" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  {/* sea + gulf */}
  <path d="M0 0H380V65L364 68L329 65L303 53L286 45L263 28L234 25L190 22L134 33L110 48L97 60L82 68L52 85L13 97L0 85Z" fill={`url(#${u}-sea)`}></path>
  <path d="M323 183L308 220L325 250L333 260H359L355 250L342 220L329 185Z" fill={`url(#${u}-sea)`}></path>

  {/* coastline + gulf shores */}
  <path
    class="lc-map-coast"
    d="M0 85L13 97L52 85L82 68L97 60L110 48L134 33L190 22L234 25L263 28L286 45L303 53L329 65L364 68L380 65"
    fill="none"
    stroke-width="1.4"
    stroke-linejoin="round"
    stroke-linecap="round"
  ></path>
  <path class="lc-map-coast" d="M323 183L308 220L325 250L333 260M329 185L342 220L355 250L359 260" fill="none" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"></path>

  {/* Nile, delta branches, Suez Canal */}
  <path
    class="lc-map-water"
    d="M212 260L211 215L210.4 175L201 160M201 160L177.5 130L160 95L143 60L134 33M201 160L208 130L225 90L247 60L263 28"
    fill="none"
    stroke-width="1.6"
    stroke-linejoin="round"
    stroke-linecap="round"
  ></path>
  <path class="lc-map-water" d="M304 54L305 95L301 122L310 145L325 183" fill="none" stroke-width="1.6" stroke-dasharray="1 0" stroke-linejoin="round"></path>
  <ellipse class="lc-map-lake" cx="310" cy="146" rx="5" ry="7"></ellipse>

  {/* the 45° trace from our base to every zone (logo motif) */}
  {
    !only && (
      <g class="lc-map-links" fill="none" stroke-width=".8">
        {pins
          .filter((z) => !z.home)
          .map((z) => (
            <path d={`M${BASE[0]} ${BASE[1]}L${z.x} ${z.y}`} data-zone={interactive ? z.slug : undefined} {...region(z)} />
          ))}
      </g>
    )
  }

  {/* the amber signal travelling from our base to the zone in focus, and its arrival ping (zones-map.ts) */}
  {
    interactive && (
      <g>
        <path class="lc-map-sig" d={`M${BASE[0]} ${BASE[1]}L${BASE[0]} ${BASE[1]}`} fill="none" />
        <circle class="lc-map-ping" cx={BASE[0]} cy={BASE[1]} r="8" fill="none" />
      </g>
    )
  }

  {/* pins */}
  {
    pins.map((z) =>
      z.home ? (
        <g class="lc-map-pin lc-map-home" data-zone={z.slug} {...region(z)} style={interactive ? `--i:${z.n - 1}` : undefined}>
          <circle cx={z.x} cy={z.y} r={only ? 30 : 22} fill={`url(#${u}-glow)`} class="lc-map-pulse" />
          {interactive && <circle cx={z.x} cy={z.y} r="13" class="lc-map-ring" />}
          <circle cx={z.x} cy={z.y} r={only ? PIN_R.zone : PIN_R.home} class="lc-map-home-dot" />
          {!only && (
            <text x={z.x} y={z.y + 3.6} text-anchor="middle" class="lc-map-num lc-map-num-home">
              {z.n}
            </text>
          )}
        </g>
      ) : only ? (
        <circle cx={z.x} cy={z.y} r="3" class="lc-map-dim" />
      ) : (
        <g class="lc-map-pin" data-zone={z.slug} {...region(z)} style={interactive ? `--i:${z.n - 1}` : undefined}>
          {interactive && <circle cx={z.x} cy={z.y} r="11" class="lc-map-ring" />}
          <circle cx={z.x} cy={z.y} r={PIN_R.zone} class="lc-map-dot" />
          <text x={z.x} y={z.y + 3.3} text-anchor="middle" class="lc-map-num">
            {z.n}
          </text>
        </g>
      ),
    )
  }
</svg>

<style>
  .lc-map {
    --map-coast: var(--color-navy-300);
    --map-water: var(--color-royal-400);
    --map-dot: var(--color-navy-900);
    --map-dot-stroke: var(--color-royal-300);
    --map-num: var(--color-white);
    --map-link: rgb(150 182 232 / 0.28);
    color: var(--map-coast);
    direction: ltr;
  }
  .lc-map-coast,
  .lc-map-water,
  .lc-map-links path {
    vector-effect: non-scaling-stroke;
  }
  .lc-map-coast {
    stroke: var(--map-coast);
    opacity: 0.75;
  }
  .lc-map-water {
    stroke: var(--map-water);
  }
  .lc-map-lake {
    fill: var(--map-water);
    opacity: 0.6;
  }
  /* the trace colour / dash come through custom properties, so ZonesBlock can light a trace (hover / selection)
     without fighting this scoped rule's specificity */
  .lc-map-links path {
    stroke: var(--link-stroke, var(--map-link));
    stroke-dasharray: var(--link-dash, 2 3);
  }
  .lc-map-dot {
    fill: var(--map-dot);
    stroke: var(--map-dot-stroke);
    stroke-width: 1.3;
    transition: fill var(--dur-micro) var(--ease-mech), stroke var(--dur-micro) var(--ease-mech);
  }
  .lc-map-home-dot {
    fill: var(--color-signal-400);
    stroke: var(--color-navy-950);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .lc-map-num {
    fill: var(--map-num);
    font: 700 9px/1 var(--font-mono);
    pointer-events: none;
  }
  .lc-map-num-home {
    fill: var(--color-navy-950);
    font-size: 10px;
  }
  .lc-map-dim {
    fill: var(--color-royal-400);
    opacity: 0.55;
  }
  /* the base "breathes" four times when the map is on screen, then rests as a steady glow (WCAG 2.2.2: no
     endless loop next to the content; the reduced-motion / pause-switch pose is the same rest pose) */
  .lc-map-pulse {
    opacity: 0.6;
    transform-box: fill-box;
    transform-origin: center;
    animation: lc-map-pulse 3.2s var(--ease-emph) 4;
  }
  @keyframes lc-map-pulse {
    0% {
      transform: scale(0.45);
      opacity: 1;
    }
    80%,
    100% {
      transform: scale(1.25);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lc-map-pulse {
      animation: none;
    }
  }
  :global(:root[data-motion="off"]) .lc-map-pulse {
    animation: none;
  }
</style>
