---
/**
 * Home "two doors": local factories & machine builders → services, foreign manufacturers → foreign-manufacturers.
 * Whole panel is one link (stretched title link). The foreign door adds one small second link (its own tab stop,
 * above the stretched overlay) for machine builders exporting to Egypt → the OEM block of the foreign page.
 * `foreignFirst` for /zh/ and /tr/ visitors.
 */
import { getMessages, type Locale } from "~/i18n";
import Icon from "~/components/Icon.astro";
import { href, FOREIGN_PATH, OEM_PATH } from "~/components/nav";
import { html } from "~/lib/text";

interface Props {
  locale: Locale;
  foreignFirst?: boolean;
  class?: string;
}
const { locale, foreignFirst = false, class: className } = Astro.props;
const t = getMessages(locale);
const a = t.home.audiences;
const oem = t.foreign.oem;
const doors = [
  { key: "local", ...a.local, href: href(locale, "services"), dark: false, icon: "factory" as const, chips: ["PLC", "HMI", "SCADA", "VFD"] },
  { key: "foreign", ...a.foreign, href: href(locale, FOREIGN_PATH), dark: true, icon: "globe" as const, chips: ["FAT", "SAT", "I/O"] },
];
if (foreignFirst) doors.reverse();
---

<div class:list={["grid grid-cols-1 gap-5 md:grid-cols-2 lg:gap-6", className]}>
  {
    doors.map((d) => (
      <article
        class:list={[
          "lc-reveal group relative isolate flex flex-col overflow-hidden p-6 transition-[translate,border-color,box-shadow] duration-(--dur-ui) ease-mech sm:p-9",
          "has-[.lc-door-link:focus-visible]:outline-2 has-[.lc-door-link:focus-visible]:outline-offset-4 has-[.lc-door-link:focus-visible]:outline-(--focus)",
          d.dark
            ? "on-dark bg-navy-950 text-navy-100 hover:shadow-glow"
            : "border border-charcoal-200 bg-white hover:-translate-y-(--move-lift) hover:border-royal-300 hover:shadow-lift",
        ]}
      >
        {d.dark && <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint mask-fade-edges" />}
        {d.dark && (
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(ellipse_70%_80%_at_100%_0%,rgb(5_86_173/0.45),transparent_70%)] rtl:bg-[radial-gradient(ellipse_70%_80%_at_0%_0%,rgb(5_86_173/0.45),transparent_70%)]" />
        )}
        <div class="flex items-start justify-between gap-4">
          <span
            class:list={[
              "chamfer inline-grid size-12 place-items-center [--chamfer:12px] sm:size-14",
              d.dark ? "bg-royal-600/25 text-signal-300" : "bg-navy-950 text-royal-300",
            ]}
          >
            <Icon name={d.icon} size={28} />
          </span>
        </div>
        <h3 class:list={["mt-5 type-h2 max-w-md sm:mt-7", d.dark ? "text-white" : "text-navy-950"]} style="font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.125rem)">
          <a href={d.href} class="lc-door-link after:absolute after:inset-0 after:z-10 after:content-[''] focus-visible:outline-none" set:html={html(locale, d.title)} />
        </h3>
        <p class:list={["mt-3 max-w-lg sm:mt-4", d.dark ? "text-navy-200" : "text-charcoal-600"]} set:html={html(locale, d.text)} />
        <ul role="list" class="mt-6 flex flex-wrap gap-2 max-sm:hidden" aria-hidden="true">
          {d.chips.map((c) => (
            <li
              class:list={[
                "rounded-xs border px-2 py-1 font-mono text-[0.6875rem] tracking-wider ltr",
                d.dark ? "border-white/12 bg-white/[0.04] text-navy-200" : "border-charcoal-200 bg-charcoal-50 text-charcoal-700",
              ]}
              dir="ltr"
            >
              {c}
            </li>
          ))}
        </ul>
        <div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-1 pt-6 sm:pt-8">
          <span
            aria-hidden="true"
            class:list={[
              "inline-flex min-h-11 items-center gap-2 font-bold",
              d.dark ? "text-signal-300 group-hover:text-white" : "text-royal-600 group-hover:text-royal-800",
            ]}
          >
            {d.dark && <span class="lc-led" />}
            {d.cta}
            <Icon name="arrow" size={18} class="transition-[translate] duration-(--dur-ui) ease-mech group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
          </span>
          {d.key === "foreign" && oem?.eyebrow && (
            <a
              href={href(locale, OEM_PATH)}
              class="relative z-20 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-navy-200 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white hover:decoration-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--focus)"
            >
              {oem.eyebrow}
              <Icon name="arrow" size={14} />
            </a>
          )}
        </div>
      </article>
    ))
  }
</div>
