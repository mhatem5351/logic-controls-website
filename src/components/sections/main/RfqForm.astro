---
/**
 * Quote request (RFQ) form → POST /api/rfq (worker/index.ts). Contract, limits and validation rules:
 * src/lib/rfq-rules.ts (shared with the Worker). Behaviour: src/scripts/rfq-form.ts. Styles: src/styles/rfq-form.css.
 *
 * Without JS: one long multipart form (all fields and the attachments input visible, native validation, the
 * description optional), posting to /api/rfq, which answers 303 → /{locale}/contact/thanks/?ref=… or
 * ?error=<code>#rfq-error-<code>; the matching <noscript> alert below is shown with :target.
 * With JS (progressive enhancement): two steps — 1) name, company, phone (zh: email; phone optional), "what do you
 * need"; 2) optional project details and up to 3 files — linked error summary, Turnstile loaded on the first
 * interaction, JSON submit, inline success → thanks page, and a pre-filled WhatsApp/email hand-over if sending fails.
 * "Machine stopped?" (timeline "urgent" or the troubleshooting service) shows a call-now panel.
 */
import { getMessages, localePath, LOCALE_META, type Locale } from "~/i18n";
import { SITE } from "~/data/site";
import { ZONES } from "~/data/zones";
import Icon from "~/components/Icon.astro";
import Button from "~/components/Button.astro";
import { fmt, whatsappLink, mailtoLink, prefersEmail } from "~/components/nav";
import { REPLY_CHANNELS, RFQ_FILES, RFQ_FILES_ACCEPT, RFQ_MAX } from "~/lib/rfq-rules";
import type { RfqI18n } from "~/scripts/rfq-form";
import Field from "./Field.astro";
import { rich, esc, ltr } from "./rich";
import "~/styles/rfq-form.css";

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className } = Astro.props;
const t = getMessages(locale);
const f = t.contact.form;
const fields = f.fields;
const urgent = t.ui.urgent;
/** zh: email is the reply channel (required, step 1) and the phone is optional; WhatsApp is not offered. */
const email = prefersEmail(locale);
const siteKey = import.meta.env.DEV ? "1x00000000000000000000AA" : SITE.turnstileSiteKey;
const thanks = localePath(locale, "contact/thanks");
const privacyHref = localePath(locale, "privacy");
const consentHtml = rich(locale, fields.consent.text, {
  link: `<a href="${privacyHref}" class="font-semibold text-royal-600 underline underline-offset-2 hover:text-royal-800">${esc(fields.consent.linkText)}</a>`,
});
const counter = (current: number) => fmt(f.steps.counter, { current, total: 2 });
/** "4 MB" as an LTR isolate, so RTL text never reorders it to "MB 4". */
const isolate = (s: string | number) => `${String.fromCharCode(0x2066)}${s}${String.fromCharCode(0x2069)}`;
const maxSize = isolate(`${RFQ_FILES.maxTotal / 1024 / 1024} MB`);
const mail = mailtoLink(t.ui.email.subject, { locale, path: "contact" });
const phone = email ? fields.phoneOptional : fields.phone;
/** "How should we reply?": no WhatsApp on zh; preselected WhatsApp on ar and email on zh (the locale's usual channel). */
const replyChannels = REPLY_CHANNELS.filter((c) => !(email && c === "whatsapp"));
const replyDefault = locale === "ar" ? "whatsapp" : email ? "email" : undefined;
const replyIcon = { whatsapp: "whatsapp", phone: "phone", email: "mail" } as const;

/** Strings the client script needs. */
const i18n: RfqI18n = {
  validation: t.contact.validation,
  errors: t.contact.errors,
  counter: f.steps.counter,
  sending: f.buttons.sending,
  submit: f.buttons.submit,
  sendNow: f.buttons.sendNow,
  sent: f.sent,
  waiting: f.security.waiting,
  thanks,
  files: { remove: fields.files.remove, summary: fields.files.summary },
  prefill: f.prefill,
  whatsapp: email ? null : SITE.whatsapp,
  email: SITE.email,
};
const desc = (id: string, help = true) => (help ? `${id}-help ${id}-error` : `${id}-error`);
const optional = f.optional;
const linkCls = "inline-flex min-h-6 items-center gap-1.5 font-semibold underline underline-offset-2";
const NOJS_ERRORS = ["invalid", "attachments", "verification", "send"] as const;
---

<form
  id="quote"
  class:list={["lc-rfq relative scroll-mt-28 border border-charcoal-200 bg-white shadow-lift", className]}
  action="/api/rfq"
  method="post"
  enctype="multipart/form-data"
  accept-charset="UTF-8"
  data-rfq
  data-fab-avoid
  data-i18n={JSON.stringify(i18n)}
  aria-labelledby="rfq-title"
>
  {/* outside the body: stays announced while the body is inert after success */}
  <p class="sr-only" aria-live="polite" data-step-live>{counter(1)}</p>
  <div data-rfq-body>
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="page" value={localePath(locale, "contact")} data-page-field />
    {/* honeypot: hidden from people and assistive tech, bots fill it */}
    <div class="lc-hp" aria-hidden="true">
      <label for="rfq-company-website">Website</label>
      <input id="rfq-company-website" type="text" name="company_website" tabindex="-1" autocomplete="off" />
    </div>

    {/* ---------- header ---------- */}
    <div class="relative border-b border-charcoal-200 px-5 pt-6 pb-5 sm:px-8 sm:pt-8">
      <span aria-hidden="true" class="absolute -top-px start-5 h-1 w-14 skew-x-[-10deg] bg-royal-600 sm:start-8 rtl:skew-x-[10deg]"></span>
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <h2 id="rfq-title" class="type-h3 text-navy-950">{f.title}</h2>
        <p class="text-sm text-charcoal-600">{f.requiredNote}</p>
      </div>
      {/* step indicator (JS only: .lc-js shows it from the first paint when html.js is set, so the form never shifts) */}
      <div class="lc-stepper lc-js mt-5" data-stepper>
        <ol role="list" class="grid grid-cols-2 gap-2">
          {
            [f.steps.one, f.steps.two].map((label, i) => (
              <li class="lc-step" data-step-tab={i + 1} data-active={i === 0 ? "" : undefined} aria-current={i === 0 ? "step" : undefined}>
                <span class="lc-step-bar" aria-hidden="true" />
                <span class="mt-2 flex items-center gap-2 text-sm">
                  <span class="font-mono text-xs ltr" dir="ltr">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="lc-step-label font-semibold">{label}</span>
                  <Icon name="check" size={14} strokeWidth={2.5} class="lc-step-check" />
                  <span class="sr-only" data-done-text hidden>
                    ({f.steps.done})
                  </span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="px-5 py-6 sm:px-8 sm:py-8">
      {/* ---------- alert: validation summary / server errors (also ?error=) ---------- */}
      <div class="lc-alert mb-7" data-alert tabindex="-1" role="alert" hidden>
        <Icon name="close" size={20} class="mt-0.5 shrink-0" />
        <div class="min-w-0 flex-1">
          <p class="font-bold" data-alert-title></p>
          <p class="mt-1" data-alert-text hidden></p>
          <ul role="list" class="lc-alert-list mt-2 space-y-1.5" data-alert-list hidden></ul>
          <div class="mt-3 text-sm" data-alert-fallback hidden>
            <p>{t.contact.errors.fallback}</p>
            <p class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
              <a href={`tel:${SITE.phone.tel}`} class={linkCls}>
                <Icon name="phone" size={15} /><span class="ltr" dir="ltr">{SITE.phone.display}</span>
              </a>
              {
                !email && (
                  <a href={whatsappLink(t.common.whatsapp.quote)} target="_blank" rel="noopener" class={linkCls} data-fallback="whatsapp">
                    <Icon name="whatsapp" size={15} />
                    {t.common.labels.whatsapp}
                    <span class="sr-only"> ({t.ui.a11y.newTab})</span>
                  </a>
                )
              }
              <a href={mail} class={linkCls} data-fallback="email">
                <Icon name="mail" size={15} /><Fragment set:html={ltr(SITE.email)} />
              </a>
            </p>
            <p class="mt-2 text-charcoal-600">{t.contact.errors.handover}</p>
            <button
              type="button"
              class="mt-3 inline-flex min-h-11 items-center gap-2 border border-danger-700 bg-white px-4 font-bold text-danger-700 hover:bg-danger-700 hover:text-white"
              data-retry
              hidden
            >
              {f.buttons.retry}
            </button>
          </div>
        </div>
      </div>

      {/* ---------- no-JS: the Worker's ?error=<code>#rfq-error-<code> lands on one of these (:target) ---------- */}
      <noscript>
        {
          NOJS_ERRORS.map((code) => (
            <div id={`rfq-error-${code}`} class="lc-alert lc-nojs-alert mb-7" role="alert">
              <Icon name="close" size={20} class="mt-0.5 shrink-0" />
              <div class="min-w-0 flex-1">
                <p class="font-bold">{t.contact.errors.title}</p>
                <p class="mt-1">{t.contact.errors[code]}</p>
                <div class="mt-3 text-sm">
                  <p>{t.contact.errors.fallback}</p>
                  <p class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
                    <a href={`tel:${SITE.phone.tel}`} class={linkCls}>
                      <Icon name="phone" size={15} />
                      <span class="ltr" dir="ltr">
                        {SITE.phone.display}
                      </span>
                    </a>
                    {!email && (
                      <a href={whatsappLink(t.common.whatsapp.quote)} target="_blank" rel="noopener" class={linkCls}>
                        <Icon name="whatsapp" size={15} />
                        {t.common.labels.whatsapp}
                      </a>
                    )}
                    <a href={mail} class={linkCls}>
                      <Icon name="mail" size={15} />
                      <Fragment set:html={ltr(SITE.email)} />
                    </a>
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </noscript>

      {/* ---------- step 1 ---------- */}
      <fieldset class="lc-step-panel" data-step="1" data-active>
        <legend class="lc-legend" tabindex="-1">
          <span class="font-mono text-xs text-royal-700 ltr" dir="ltr">01</span>
          {f.steps.one}
        </legend>
        <div class="grid gap-5 sm:grid-cols-2">
          <Field id="rfq-name" label={fields.name.label} required>
            <input
              id="rfq-name"
              class="lc-input"
              type="text"
              name="name"
              autocomplete="name"
              required
              minlength="2"
              maxlength={RFQ_MAX.name}
              dir="auto"
              dirname="name.dir"
              aria-invalid="false"
              aria-describedby={desc("rfq-name", false)}
            />
          </Field>
          <Field id="rfq-company" label={fields.company.label} required help={fields.company.help}>
            <input
              id="rfq-company"
              class="lc-input"
              type="text"
              name="company"
              autocomplete="organization"
              required
              maxlength={RFQ_MAX.company}
              dir="auto"
              dirname="company.dir"
              aria-invalid="false"
              aria-describedby={desc("rfq-company")}
            />
          </Field>
          <Field id="rfq-phone" label={phone.label} required={!email} optional={email ? optional : undefined} help={phone.help}>
            <input
              id="rfq-phone"
              class="lc-input"
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              required={!email}
              maxlength={RFQ_MAX.phone}
              dir="ltr"
              aria-invalid="false"
              aria-describedby={desc("rfq-phone")}
              data-phone
            />
          </Field>
          {
            email && (
              <Field id="rfq-email" label={fields.email.label} required help={fields.email.help}>
                <input
                  id="rfq-email"
                  class="lc-input"
                  type="email"
                  name="email"
                  autocomplete="email"
                  inputmode="email"
                  required
                  maxlength={RFQ_MAX.email}
                  dir="ltr"
                  aria-invalid="false"
                  aria-describedby={desc("rfq-email")}
                  data-email
                />
              </Field>
            )
          }
          <Field id="rfq-service" label={fields.need.label} required class={email ? "sm:col-span-2" : undefined}>
            <select id="rfq-service" class="lc-input lc-select" name="service" required aria-invalid="false" aria-describedby={desc("rfq-service", false)}>
              <option value="">{fields.need.placeholder}</option>
              {Object.entries(fields.need.options).map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </Field>
          {/* preferred reply channel (the thanks page promises "your preferred channel") */}
          <fieldset class="lc-field lc-choice sm:col-span-2" data-field="rfq-reply">
            <legend class="lc-label">
              <span>{fields.contactPreference.label}</span>
              <span class:list={["lc-opt", locale === "zh" && "-ms-1.5"]}>{locale === "zh" ? `（${optional}）` : `(${optional})`}</span>
            </legend>
            <div class="flex flex-wrap gap-2">
              {
                replyChannels.map((c) => (
                  <label class="lc-choice-opt">
                    <input id={`rfq-reply-${c}`} type="radio" name="reply" value={c} checked={c === replyDefault} data-reply />
                    <Icon name={replyIcon[c]} size={16} class={c === "whatsapp" ? "text-whatsapp-700" : "text-royal-600"} />
                    <span>{fields.contactPreference.options[c]}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>
      </fieldset>

      {/* ---------- step 2 ---------- */}
      <fieldset class="lc-step-panel mt-9" data-step="2" aria-describedby="rfq-step2-note">
        <legend class="lc-legend" tabindex="-1">
          <span class="font-mono text-xs text-royal-700 ltr" dir="ltr">02</span>
          {f.steps.two}
        </legend>
        <p id="rfq-step2-note" class="-mt-2 mb-5 text-sm text-charcoal-600">{f.steps.twoNote}</p>
        <div class="grid gap-5 sm:grid-cols-2">
          <Field id="rfq-message" label={fields.message.label} optional={optional} help={fields.message.help} class="sm:col-span-2">
            <textarea
              id="rfq-message"
              class="lc-input lc-textarea"
              name="message"
              rows="5"
              maxlength={RFQ_MAX.message}
              dir="auto"
              dirname="message.dir"
              aria-invalid="false"
              aria-describedby={desc("rfq-message")}
              data-message></textarea>
            <p class="lc-count" data-count hidden aria-hidden="true"></p>
          </Field>
          <Field
            id="rfq-files"
            label={fields.files.label}
            optional={optional}
            help={fmt(fields.files.help, { count: isolate(RFQ_FILES.maxCount), size: maxSize })}
            class="sm:col-span-2"
          >
            <div class="lc-file">
              <input
                id="rfq-files"
                class="lc-file-input"
                type="file"
                name={RFQ_FILES.field}
                multiple
                accept={RFQ_FILES_ACCEPT}
                aria-invalid="false"
                aria-describedby="rfq-files-help rfq-files-error rfq-files-summary"
                data-files
              />
              <label for="rfq-files" class="lc-file-btn lc-js" aria-hidden="true">
                <Icon name="file" size={18} />
                {fields.files.choose}
              </label>
              <ul role="list" class="lc-file-list lc-js" data-files-list></ul>
              <p id="rfq-files-summary" class="lc-file-summary" data-files-summary aria-live="polite" hidden></p>
            </div>
          </Field>
          <Field id="rfq-industry" label={fields.industry.label} optional={optional}>
            <select id="rfq-industry" class="lc-input lc-select" name="industry" aria-invalid="false" aria-describedby={desc("rfq-industry", false)}>
              <option value="">{fields.industry.placeholder}</option>
              {Object.entries(fields.industry.options).map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </Field>
          <Field id="rfq-location" label={fields.location.label} optional={optional}>
            <select id="rfq-location" class="lc-input lc-select" name="location" aria-invalid="false" aria-describedby={desc("rfq-location", false)}>
              <option value="">{fields.location.placeholder}</option>
              {ZONES.map((z) => <option value={z.slug}>{t.common.zones.items[z.slug].name}</option>)}
              <option value="otherEgypt">{fields.location.otherEgypt}</option>
              <option value="outsideEgypt">{fields.location.outsideEgypt}</option>
            </select>
          </Field>
          <Field id="rfq-timeline" label={fields.timeline.label} optional={optional}>
            <select id="rfq-timeline" class="lc-input lc-select" name="timeline" aria-invalid="false" aria-describedby={desc("rfq-timeline", false)}>
              <option value="">{fields.timeline.placeholder}</option>
              {Object.entries(fields.timeline.options).map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </Field>
          <Field id="rfq-country" label={fields.country.label} optional={optional} help={fields.country.help}>
            <input
              id="rfq-country"
              class="lc-input"
              type="text"
              name="country"
              autocomplete="country-name"
              maxlength={RFQ_MAX.country}
              dir="auto"
              aria-invalid="false"
              aria-describedby={desc("rfq-country")}
            />
          </Field>
          {
            !email && (
              <Field id="rfq-email" label={fields.email.label} optional={optional} help={fields.email.help} class="sm:col-span-2">
                <input
                  id="rfq-email"
                  class="lc-input"
                  type="email"
                  name="email"
                  autocomplete="email"
                  inputmode="email"
                  maxlength={RFQ_MAX.email}
                  dir="ltr"
                  aria-invalid="false"
                  aria-describedby={desc("rfq-email")}
                  data-email
                />
              </Field>
            )
          }
        </div>
      </fieldset>

      {/* ---------- consent + security (always visible) ---------- */}
      <div class="mt-8 border-t border-charcoal-200 pt-6">
        {/* "Machine stopped?": the form is the slow channel, so offer the phone (and WhatsApp) right here */}
        <div aria-live="polite">
          <div class="lc-urgent on-dark" data-urgent hidden>
            <div class="min-w-0 flex-1 basis-64">
              <p class="flex items-center gap-2.5 font-bold text-white">
                <span class="lc-led" data-blink aria-hidden="true"></span>
                {urgent.title}
              </p>
              <p class="mt-1 text-sm text-navy-200">{email ? urgent.textEmail : urgent.text}</p>
              <p class="mt-1 text-sm font-semibold text-white"><span class="ltr" dir="ltr">{SITE.phone.display}</span></p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <Button href={`tel:${SITE.phone.tel}`} size="sm" icon="phone">{t.common.labels.callEngineer}</Button>
              {
                !email && (
                  <Button href={whatsappLink(t.common.whatsapp.stopped)} size="sm" variant="on-dark" icon="whatsapp" iconClass="text-whatsapp-500" external>
                    {urgent.whatsapp}
                  </Button>
                )
              }
            </div>
          </div>
        </div>

        <div class="lc-field" data-field="rfq-consent">
          <div class="flex items-start gap-3">
            <input id="rfq-consent" class="lc-check" type="checkbox" name="consent" value="yes" required aria-invalid="false" aria-describedby="rfq-consent-error" />
            <label for="rfq-consent" class="text-[0.9375rem] text-charcoal-700">
              <Fragment set:html={consentHtml} />
              <span class="lc-req" aria-hidden="true">*</span>
            </label>
          </div>
          <p id="rfq-consent-error" class="lc-error ms-9" hidden></p>
        </div>

        <div class="mt-5">
          <p class="mb-2 text-sm" data-ts-label hidden>
            <span class="font-semibold text-navy-950">{f.security.label}</span>
            <span class="text-charcoal-600"> — {f.security.help}</span>
          </p>
          {/* Rendered explicitly by rfq-form.ts on the first interaction with the form (api.js?render=explicit). */}
          <div class="cf-turnstile" data-turnstile data-sitekey={siteKey} data-language={LOCALE_META[locale].turnstile}></div>
          <div class="mt-3 border-s-4 border-signal-500 bg-signal-50 px-4 py-3 text-sm text-charcoal-800" data-ts-status hidden>
            <p>{f.security.waiting}</p>
            <p class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
              <a href={`tel:${SITE.phone.tel}`} class={linkCls}>
                <Icon name="phone" size={15} /><span class="ltr" dir="ltr">{SITE.phone.display}</span>
              </a>
              {
                !email && (
                  <a href={whatsappLink(t.common.whatsapp.quote)} target="_blank" rel="noopener" class={linkCls} data-fallback="whatsapp">
                    <Icon name="whatsapp" size={15} />
                    {t.common.labels.whatsapp}
                    <span class="sr-only"> ({t.ui.a11y.newTab})</span>
                  </a>
                )
              }
              <a href={mail} class={linkCls} data-fallback="email">
                <Icon name="mail" size={15} /><Fragment set:html={ltr(SITE.email)} />
              </a>
            </p>
          </div>
          <noscript>
            <p class="flex gap-2.5 border-s-4 border-signal-500 bg-signal-50 px-4 py-3 text-sm text-charcoal-800">{f.noscript}</p>
          </noscript>
        </div>

        {/* actions — step 1 (JS only) */}
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3" data-actions="1" hidden data-fab-avoid>
          <Button type="button" size="lg" iconEnd="arrow" data-next class="max-sm:w-full">{f.buttons.next}</Button>
          <button
            type="submit"
            class="lc-skip inline-flex min-h-11 items-center gap-2 text-sm font-bold text-royal-600 underline-offset-4 hover:text-royal-800 hover:underline max-sm:w-full max-sm:justify-center"
            data-submit
          >
            <Icon name="send" size={16} />
            <span data-submit-label>{f.buttons.sendNow}</span>
          </button>
        </div>
        {/* actions — step 2 / no-JS */}
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3" data-actions="2" data-fab-avoid>
          <Button type="submit" size="lg" icon="send" class="max-sm:w-full" data-submit>
            <span data-submit-label>{f.buttons.submit}</span>
          </Button>
          <button
            type="button"
            class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-charcoal-700 hover:text-navy-950 max-sm:w-full max-sm:justify-center"
            data-back
            hidden
          >
            <Icon name="arrow" size={16} class="-scale-x-100 rtl:scale-x-100" />
            {f.buttons.back}
          </button>
        </div>
        <p class="mt-5 flex items-start gap-2 text-xs text-charcoal-600">
          <Icon name="shield" size={16} class="mt-px shrink-0 text-royal-600" />
          {f.privacyNote}
        </p>
      </div>
    </div>
  </div>

  {/* ---------- success (JS) ---------- */}
  <div class="lc-success absolute inset-0 z-10 flex-col items-center justify-center gap-4 bg-white/95 p-8 text-center" data-success hidden>
    <span class="lc-success-badge grid size-14 place-items-center rounded-full bg-success-700 text-white"><Icon name="check" size={28} /></span>
    <p class="type-h4 text-navy-950 outline-none" tabindex="-1">{f.sent}</p>
  </div>
</form>

<script>
  import { enhance } from "~/scripts/rfq-form";

  const form = document.querySelector<HTMLFormElement>("form[data-rfq]");
  if (form) enhance(form);
</script>
