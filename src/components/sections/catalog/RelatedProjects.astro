---
/**
 * Related case studies: heading, up to `limit` project cards, and a link to the (pre-filtered) portfolio.
 * Renders nothing when the list is empty.
 */
import type { ProjectData } from "~/data/projects";
import type { Locale } from "~/i18n";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import ViewAll from "~/components/ViewAll.astro";
import ProjectCard from "./ProjectCard.astro";
import { html } from "~/lib/text";

interface Props {
  locale: Locale;
  projects: readonly ProjectData[];
  title: string;
  eyebrow?: string;
  index?: string;
  lead?: string;
  /** "All projects" link (e.g. the portfolio filtered by this service). */
  all?: { href: string; label: string; count?: number };
  limit?: number;
  variant?: "light" | "muted";
  id?: string;
}
const { locale, projects, title, eyebrow, index, lead, all, limit = 3, variant = "light", id = "related-projects" } = Astro.props;
const list = projects.slice(0, limit);
const n = list.length;
/* 3+ cards: 1 → 2 → 3 columns (lc-grid-projects). On tablets (640–1023px, 2 columns) an odd count opens with the first
   card as a wide feature (photo beside the text), so no card is left alone in the last row (VIS2-08); from 1024px an
   incomplete last row of 3 is centred. 2 cards: two up. 1 card: the feature layout from 640px. The list marks the
   cards itself (data-managed, see global.css), like the filtered portfolio. */
const cols = n >= 3 ? "lc-grid-projects" : n === 2 ? "grid sm:grid-cols-2 lg:max-w-5xl" : "grid lg:max-w-5xl";
const featureFirst = n >= 3 && n % 2 === 1;
const centre = (i: number) => (n % 3 === 1 && i === n - 1 && n > 1 ? "1" : n % 3 === 2 && i === n - 2 && n > 2 ? "2" : undefined);
---

{
  list.length > 0 && (
    <Section variant={variant} id={id} aria-labelledby={`${id}-title`}>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
        <SectionHeading id={`${id}-title`} index={index} eyebrow={eyebrow} title={html(locale, title)} lead={lead ? html(locale, lead) : undefined} />
        {all && <ViewAll href={all.href} label={all.label} count={all.count} />}
      </div>
      <ul role="list" class:list={["mt-12 gap-x-8 gap-y-14", cols]} data-managed={n >= 3 ? "" : undefined}>
        {list.map((p, i) => (
          <li data-feature={featureFirst && i === 0 ? "" : undefined} data-c3={centre(i)}>
            <ProjectCard project={p} locale={locale} feature={n === 1 ? "always" : featureFirst && i === 0 ? "tablet" : undefined} />
          </li>
        ))}
      </ul>
    </Section>
  )
}
