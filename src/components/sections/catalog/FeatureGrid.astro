---
/**
 * Numbered spec-sheet grid ("What we do", "What matters in this industry"): hairline rule, mono index,
 * title and text per cell. Adapts to dark sections.
 */
import type { Locale } from "~/i18n";
import Icon, { type IconName } from "~/components/Icon.astro";
import { html } from "~/lib/text";

interface Item {
  title: string;
  text: string;
  icon?: IconName;
}
interface Props {
  items: Item[];
  locale: Locale;
  columns?: 2 | 3 | 4;
  headingLevel?: "h3" | "h4";
  class?: string;
}
const { items, locale, columns = 3, headingLevel: H = "h3", class: className } = Astro.props;
const grid = { 2: "sm:grid-cols-2", 3: "sm:grid-cols-2 lg:grid-cols-3", 4: "sm:grid-cols-2 lg:grid-cols-4" }[columns];
const pad = (i: number) => String(i + 1).padStart(2, "0");
---

<ul role="list" class:list={["grid gap-x-8 gap-y-10", grid, className]}>
  {
    items.map((it, i) => (
      <li class="lc-reveal relative border-t border-charcoal-200 pt-6 on-dark:border-white/12">
        <span aria-hidden="true" class="lc-draw-x absolute -top-px start-0 h-0.5 w-10 bg-royal-600 on-dark:bg-signal-400" />
        <span aria-hidden="true" class="mb-4 flex items-center gap-3">
          <span class="font-mono text-xs font-semibold tracking-widest text-royal-600 ltr on-dark:text-signal-300" dir="ltr">
            {pad(i)}
          </span>
          {it.icon && <Icon name={it.icon} size={20} class="text-royal-600 on-dark:text-royal-300" />}
        </span>
        <H class="type-h4 text-navy-950 on-dark:text-white" set:html={html(locale, it.title)} />
        <p class="mt-2 text-charcoal-600 on-dark:text-navy-200" set:html={html(locale, it.text)} />
      </li>
    ))
  }
</ul>
