---
/**
 * Technologies of a case study, grouped PLC / HMI / SCADA / drives / other (derived from the strings in projects.ts).
 * Laid out like an I/O table: group label in the first column, chips in the second.
 * Grouping uses the English strings; the chips show the localised names (tech.json, see techLabel()).
 * Rows are de-duplicated (facts.ts techRows): a chip that only repeats its group ("PLC | PLC", "Drives and motion |
 * Motion control") is dropped, and so is a group the case study's facts table already states. Renders nothing when
 * no row is left. projects/[slug].astro shows it only for a case study without a facts table.
 */
import type { Locale } from "~/i18n";
import Chips from "~/components/Chips.astro";
import { techLabel } from "~/lib/text";
import { techGroupLabel, techRows } from "./facts";

interface Props {
  technologies: readonly string[];
  locale: Locale;
  /** Case-study slug: groups its facts table already states are left out. */
  slug?: string;
  class?: string;
}
const { technologies, locale, slug = "", class: className } = Astro.props;
const groups = techRows(slug, technologies);
---

{
  groups.length > 0 && (
    <dl class:list={["divide-y divide-charcoal-200 border-y border-charcoal-200", className]}>
      {groups.map((g) => (
        <div class="grid gap-2 py-4 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-center sm:gap-6">
          <dt class="type-label text-charcoal-600">{techGroupLabel(locale, g.group)}</dt>
          <dd>
            <Chips items={g.items.map((s) => techLabel(locale, s))} label={techGroupLabel(locale, g.group)} locale={locale} />
          </dd>
        </div>
      ))}
    </dl>
  )
}
