---
/**
 * Animated service / industry illustration for <Hero size="page">.
 *  - default (slot="media"): fills the hero's media panel on ≥1024px, above the panel's photo overlays
 *    (z-index inside the media stacking context) so the art keeps its full contrast; the slanted edge and
 *    the header area stay clear. Hidden below 1024px, where the media panel sits behind the copy.
 *  - inline: a smaller copy under the CTAs for < 1024px (default slot), so phones see the art too.
 * The art is decorative (aria-hidden); it pauses offscreen and respects reduced motion (see illustrations/STYLE.md).
 */
import ServiceArt from "~/components/illustrations/ServiceArt.astro";
import IndustryArt from "~/components/illustrations/IndustryArt.astro";
import type { ServiceSlug } from "~/data/services";
import type { IndustrySlug } from "~/data/industries";

type Props = ({ kind: "service"; slug: ServiceSlug } | { kind: "industry"; slug: IndustrySlug }) & { inline?: boolean };
const props = Astro.props;
---

{
  props.inline ? (
    <div class="mt-10 max-w-[24rem] lg:hidden">
      {props.kind === "service" ? <ServiceArt slug={props.slug} variant="dark" /> : <IndustryArt slug={props.slug} variant="dark" />}
    </div>
  ) : (
    <div class="absolute inset-0 z-[1] hidden items-center justify-center pe-(--spacing-gutter) ps-[calc(var(--slant-x)*0.55)] pt-[calc(var(--header-h)+var(--utility-h)+1.5rem)] pb-12 lg:flex">
      <div class="w-full max-w-[34rem]">
        {props.kind === "service" ? <ServiceArt slug={props.slug} variant="dark" /> : <IndustryArt slug={props.slug} variant="dark" />}
      </div>
    </div>
  )
}
