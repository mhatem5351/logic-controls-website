---
/**
 * "What we need to quote" — the checklist from common.quoteChecklist as an HMI-style checklist panel,
 * with the "send it from your phone" hint (WhatsApp; on /zh/ email first, WhatsApp as the in-Egypt option).
 */
import { getMessages, type Locale } from "~/i18n";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import Button from "~/components/Button.astro";
import Icon from "~/components/Icon.astro";
import { mailtoLink, prefersEmail, whatsappLink } from "~/components/nav";
import { html, quoteHref } from "./catalog";

interface Props {
  locale: Locale;
  /** Preselect the RFQ form (`{ service: slug }` / `{ industry: slug }`). */
  query?: Record<string, string>;
  index?: string;
  variant?: "light" | "muted";
  id?: string;
}
const { locale, query, index, variant = "muted", id = "quote-checklist" } = Astro.props;
const m = getMessages(locale);
const q = m.common.quoteChecklist;
const email = prefersEmail(locale);
const pad = (i: number) => String(i + 1).padStart(2, "0");
---

<Section variant={variant} id={id} aria-labelledby={`${id}-title`}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <div>
      <SectionHeading id={`${id}-title`} index={index} eyebrow={m.ui.cta.quote} title={html(q.title, locale)} lead={html(q.intro, locale)} />
      <div class="mt-8 border-s-2 border-royal-600 ps-5">
        <p class="text-charcoal-700">{q.whatsappHint}</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href={quoteHref(locale, query)} iconEnd="arrow">{m.ui.cta.quote}</Button>
          {
            email ? (
              <Button href={mailtoLink(m.ui.email.subject)} variant="secondary" icon="mail" iconClass="text-royal-600">
                {m.ui.cta.emailEngineer}
              </Button>
            ) : (
              <Button href={whatsappLink(m.common.whatsapp.drawings)} variant="secondary" icon="whatsapp" iconClass="text-[#1fa855]" external>
                {m.ui.cta.whatsapp}
              </Button>
            )
          }
        </div>
        {
          email && (
            <p class="mt-3 text-sm">
              <a href={whatsappLink(m.common.whatsapp.drawings)} target="_blank" rel="noopener" class="inline-flex min-h-6 items-center gap-2 text-royal-700 underline-offset-4 hover:underline">
                <Icon name="whatsapp" size={16} class="text-[#1fa855]" />
                {m.ui.cta.inEgyptWhatsapp}
              </a>
            </p>
          )
        }
      </div>
    </div>

    <div class="relative">
      <div class="chamfer flex items-center gap-3 bg-navy-950 px-5 py-3 text-navy-200 sm:px-6" aria-hidden="true">
        <span class="lc-led" style="--led:#2bd47d" aria-hidden="true"></span>
        <span class="type-label">{q.title}</span>
      </div>
      <ol role="list" class="divide-y divide-charcoal-200 border border-t-0 border-charcoal-200 bg-white shadow-card">
        {
          q.items.map((item, i) => (
            <li class="flex items-start gap-4 px-5 py-4 sm:px-6">
              <span class="mt-0.5 font-mono text-xs font-semibold text-royal-600 ltr" dir="ltr" aria-hidden="true">
                {pad(i)}
              </span>
              <Icon name="check" size={18} class="mt-0.5 text-success-700" />
              <span class="text-charcoal-800" set:html={html(item, locale)} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Section>
