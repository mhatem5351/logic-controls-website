---
/**
 * Floating contact button, bottom inline-end (bottom-left in RTL via logical inset).
 * WhatsApp with a pre-filled message in the page language; on zh (WhatsApp blocked in mainland China)
 * it becomes an email button.
 *
 * It never covers a call to action: while an element marked `data-fab-avoid` (hero CTAs and proof figures,
 * form actions…) or a large button in <main> passes underneath it, the button fades out of the way.
 */
import { getMessages, type Locale } from "~/i18n";
import Icon from "./Icon.astro";
import { whatsappLink, mailtoLink, prefersEmail } from "./nav";

interface Props {
  locale: Locale;
  /** Override the pre-filled WhatsApp message (e.g. include the page context). */
  message?: string;
}
const { locale, message } = Astro.props;
const t = getMessages(locale).ui;
const email = prefersEmail(locale);
const label = email ? t.email.fabLabel : t.whatsapp.fabLabel;
const link = email ? mailtoLink(t.email.subject) : whatsappLink(message ?? t.whatsapp.message);
---

<aside aria-label={label}>
<a
  href={link}
  target={email ? undefined : "_blank"}
  rel={email ? undefined : "noopener"}
  aria-label={label}
  title={label}
  class:list={[
    "lc-fab group fixed end-4 bottom-4 z-40 grid size-14 place-items-center rounded-full text-white shadow-[0_10px_30px_-8px_rgb(4_14_39/0.55)] transition-transform duration-300 hover:-translate-y-0.5 sm:end-6 sm:bottom-6",
    email ? "bg-royal-600 hover:bg-royal-700" : "bg-[#128c4a] hover:bg-[#0f7a40]",
  ]}
>
  <span aria-hidden="true" class:list={["absolute inset-0 rounded-full", !email && "lc-fab-ring"]}></span>
  <Icon name={email ? "mail" : "whatsapp"} size={28} />
</a>
</aside>

<style>
  .lc-fab {
    transition-property: transform, translate, opacity, visibility;
    transition-duration: 0.3s, 0.3s, 0.25s, 0s;
  }
  .lc-fab[data-hidden] {
    opacity: 0;
    transform: translateY(1rem) scale(0.9);
    visibility: hidden;
    pointer-events: none;
    transition-delay: 0s, 0s, 0s, 0.25s;
  }
  .lc-fab:focus-visible {
    outline: 3px solid var(--color-signal-400);
    outline-offset: 3px;
  }
  .lc-fab-ring {
    box-shadow: 0 0 0 0 rgb(37 211 102 / 0.45);
    animation: lc-fab-ring 2.8s ease-out 3;
  }
  @keyframes lc-fab-ring {
    0% {
      box-shadow: 0 0 0 0 rgb(37 211 102 / 0.45);
    }
    70%,
    100% {
      box-shadow: 0 0 0 14px rgb(37 211 102 / 0);
    }
  }
</style>

<script>
  // Fade the button out while a CTA / proof figure / form action sits under it (bottom strip of the viewport,
  // horizontally overlapping the button). One IntersectionObserver; rebuilt when the viewport height changes.
  const fab = document.querySelector<HTMLElement>(".lc-fab");
  if (fab && "IntersectionObserver" in window) {
    const targets = document.querySelectorAll<HTMLElement>("[data-fab-avoid], main .lc-btn[data-size='lg']");
    const hits = new Set<Element>();
    let io: IntersectionObserver | undefined;
    let lastH = 0;
    const overlaps = (r: DOMRectReadOnly) => {
      const f = fab.getBoundingClientRect();
      return r.right > f.left - 12 && r.left < f.right + 12;
    };
    const setup = () => {
      if (Math.abs(window.innerHeight - lastH) < 40 && io) return;
      lastH = window.innerHeight;
      io?.disconnect();
      hits.clear();
      const zone = fab.getBoundingClientRect().height + 48; // button + its offset + breathing room
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && overlaps(e.boundingClientRect)) hits.add(e.target);
            else hits.delete(e.target);
          }
          // Never hide it while it has keyboard focus.
          fab.toggleAttribute("data-hidden", hits.size > 0 && document.activeElement !== fab);
        },
        { rootMargin: `-${Math.max(0, window.innerHeight - zone)}px 0px 0px 0px` },
      );
      targets.forEach((t) => io!.observe(t));
    };
    if (targets.length) {
      setup();
      let timer = 0;
      window.addEventListener("resize", () => {
        clearTimeout(timer);
        timer = window.setTimeout(setup, 150);
      });
    }
  }
</script>
