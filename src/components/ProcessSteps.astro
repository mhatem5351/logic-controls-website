---
/**
 * Numbered process ("how we work"): ring nodes on a circuit-trace bus — horizontal on desktop,
 * vertical (inline-start rail) on mobile. Adapts to dark sections.
 * Motion (motion.css): on scroll each node switches on and its trace draws to the next one, step after step.
 * Titles / texts are plain text rendered through html() (src/lib/text.ts: codes whole, Arabic Latin runs and
 * "(Loop check)" glosses isolated, Chinese breaks between words).
 */
import { getMessages, type Locale } from "~/i18n";
import { colon, html } from "~/lib/text";
import Icon, { type IconName } from "./Icon.astro";

interface Step {
  title: string;
  text?: string;
  icon?: IconName;
}
interface Props {
  steps: Step[];
  locale?: Locale;
  class?: string;
}
const locale = (Astro.props.locale ?? Astro.currentLocale ?? "en") as Locale;
const t = getMessages(locale).ui;
const { steps, class: className } = Astro.props;
const n = steps.length;
const pad = (i: number) => String(i + 1).padStart(2, "0");
const cols = { 3: "lg:grid-cols-3", 4: "lg:grid-cols-4", 5: "lg:grid-cols-5", 6: "lg:grid-cols-6" }[n] ?? "lg:grid-cols-4";
---

<ol role="list" class:list={["lc-steps relative grid gap-10 lg:gap-8", cols, className]}>
  {
    steps.map((s, i) => (
      <li class="relative ps-16 lg:ps-0 lg:pt-16" style={`--i:${i}`}>
        {/* rail: vertical on mobile, horizontal bus on desktop */}
        {i < n - 1 && (
          <span
            aria-hidden="true"
            class="lc-step-rail absolute start-[1.375rem] top-12 -bottom-10 w-0.5 bg-gradient-to-b from-royal-500 to-royal-500/20 lg:start-12 lg:-end-8 lg:top-[1.375rem] lg:bottom-auto lg:h-0.5 lg:w-auto lg:bg-gradient-to-r rtl:lg:bg-gradient-to-l on-dark:from-royal-400 on-dark:to-royal-400/15"
          />
        )}
        <span
          aria-hidden="true"
          class="lc-step-node absolute start-0 top-0 grid size-11 place-items-center rounded-full border-2 border-royal-600 bg-white font-mono text-sm font-semibold text-royal-700 on-dark:border-royal-400 on-dark:bg-navy-950 on-dark:text-royal-300"
        >
          <span class="ltr" dir="ltr">{pad(i)}</span>
        </span>
        <div class="lc-step-body">
          {s.icon && <Icon name={s.icon} size={22} class="mb-3 text-royal-600 on-dark:text-signal-300" />}
          <h3 class="type-h4 text-navy-950 on-dark:text-white">
            <span class="sr-only">{t.process.step} {i + 1}{colon(locale)}</span>
            <Fragment set:html={html(locale, s.title)} />
          </h3>
          {s.text && <p class="mt-2 text-sm text-charcoal-600 on-dark:text-navy-200" set:html={html(locale, s.text)} />}
        </div>
      </li>
    ))
  }
</ol>
