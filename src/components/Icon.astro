export type IconName = keyof typeof ICONS;
const DIRECTIONAL = new Set<IconName>(["arrow", "chevron-right", "chevron-left", "external", "send"]);

const { name, size = 24, title, class: className = "", strokeWidth = 1.75 } = Astro.props;
const flip = DIRECTIONAL.has(name) ? "rtl:-scale-x-100" : "";
/* Callers often pass "shrink-0" too: emit each class once. */
const classes = [...new Set(["shrink-0", flip, ...className.split(/\s+/)].filter(Boolean))].join(" ");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={classes}
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  aria-label={title}
  focusable="false"
  set:html={ICONS[name]}
/>
