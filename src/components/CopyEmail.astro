---
/**
 * "Copy address" button for the main email address (UX: mailto does nothing visible on desktops without a mail
 * client, common with webmail users — the main zh channel). Copies SITE.email to the clipboard and confirms in place
 * ("Address copied" + a check), announced once through a polite live region that exists from page load (a region
 * created and filled in the same moment is often missed, VoiceOver especially). The button's accessible name stays
 * "Copy address" throughout (aria-label; the changing visual label is aria-hidden), so screen readers do not hear the
 * confirmation twice. Falls back to execCommand("copy") when the Clipboard API is unavailable. Rendered only when
 * JavaScript runs (html.js), since it does nothing without it.
 *
 * tone: "dark" (navy surfaces: footer, drawer, FAB panel) · "light"
 */
import { getMessages, type Locale } from "~/i18n";
import { SITE } from "~/data/site";

interface Props {
  locale: Locale;
  tone?: "dark" | "light";
  /** Show the label next to the icon (default) or icon only (the label stays the accessible name). */
  iconOnly?: boolean;
  class?: string;
}
const { locale, tone = "dark", iconOnly = false, class: className } = Astro.props;
const t = getMessages(locale).ui.email;
---

<button
  type="button"
  class:list={[
    "lc-copy inline-flex min-h-8 shrink-0 items-center gap-1.5 border px-2 text-xs font-semibold transition-colors",
    tone === "dark"
      ? "border-white/20 text-navy-100 hover:border-white/50 hover:text-white"
      : "border-charcoal-300 text-navy-800 hover:border-royal-600 hover:text-royal-700",
    className,
  ]}
  aria-label={t.copy}
  data-copy={SITE.email}
  data-copied={t.copied}
  data-label={t.copy}
>
  <svg class="lc-copy-i" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"></path>
  </svg>
  <svg class="lc-copy-ok" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
  <span class:list={["lc-copy-label", iconOnly && "sr-only"]} aria-hidden="true">{t.copy}</span>
</button>

<style>
  .lc-copy {
    -webkit-tap-highlight-color: transparent;
  }
  :global(html:not(.js)) .lc-copy {
    display: none;
  }
  .lc-copy-ok,
  .lc-copy[data-done] .lc-copy-i {
    display: none;
  }
  .lc-copy[data-done] .lc-copy-ok {
    display: block;
    color: #2bd47d;
  }
  @media (pointer: coarse) {
    .lc-copy {
      min-height: 2.75rem;
      padding-inline: 0.75rem;
    }
  }
</style>

<script>
  /* One delegated handler for every copy button on the page; bound once (idempotent). */
  const KEY = "lcCopyReady";
  const root = document.documentElement;
  if (!root.dataset[KEY]) {
    root.dataset[KEY] = "1";
    // The polite live region exists from the start (empty), so its first message is reliably announced.
    const live = document.createElement("p");
    live.className = "sr-only";
    live.setAttribute("aria-live", "polite");
    live.setAttribute("data-copy-live", "");
    document.body.append(live);
    let clearLive = 0;
    const announce = (msg: string) => {
      clearTimeout(clearLive);
      live.textContent = "";
      // A beat later, so a repeated message is still a change.
      window.setTimeout(() => {
        live.textContent = msg;
        clearLive = window.setTimeout(() => (live.textContent = ""), 5000);
      }, 60);
    };
    const legacyCopy = (text: string) => {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;inset-inline-start:-9999px;top:0;opacity:0";
      document.body.append(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {}
      ta.remove();
      return ok;
    };
    // Per button: the reset timer, so a second copy inside the confirmation window restarts it (CODE2-10).
    const timers = new WeakMap<HTMLElement, number>();
    document.addEventListener("click", async (event) => {
      const btn = (event.target as Element | null)?.closest<HTMLButtonElement>("button[data-copy]");
      if (!btn) return;
      const text = btn.dataset.copy ?? "";
      let ok: boolean;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        ok = legacyCopy(text);
      }
      if (!ok) return;
      const label = btn.querySelector<HTMLElement>(".lc-copy-label");
      const original = btn.dataset.label ?? label?.textContent ?? "";
      btn.setAttribute("data-done", "");
      if (label) label.textContent = btn.dataset.copied ?? original;
      announce(btn.dataset.copied ?? "");
      clearTimeout(timers.get(btn));
      timers.set(
        btn,
        window.setTimeout(() => {
          btn.removeAttribute("data-done");
          if (label) label.textContent = original;
        }, 2400),
      );
    });
  }
</script>
