---
/**
 * Mobile / tablet drawer (< 1024px): native modal <dialog> (focus trap, Esc, inert page), opened by the header's menu
 * button (.lc-menu-open[aria-controls="lc-drawer"]). It is a top-layer modal, so where it sits in the DOM does not
 * matter visually: <Header> renders it by default, BaseLayout may render it after the footer instead
 * (<Header drawer={false}> + <HeaderDrawer>) so <main> comes earlier in the HTML (PERF2-02).
 *
 *  - Order: main nav (Services / Industries expand in place; they start collapsed so the actions below stay on the
 *    first screen — the current page is named under its section), "Setting up in Egypt?", the two actions (ar:
 *    WhatsApp first), "Machine stopped? Call / WhatsApp", languages, phone / email / copy, pause animations.
 *  - The actions carry the page's context (pageContact: ?service= / ?industry= preselection, the page's WhatsApp
 *    message, the email topic).
 *  - A link to the page itself (e.g. the quote form on /contact/) closes the sheet before the browser scrolls to it;
 *    restored from the back/forward cache the sheet is always closed.
 * Icons come from the chrome sprite (<ChromeSprite> in <Header>).
 */
import { getMessages, type Locale } from "~/i18n";
import { SITE, telLink } from "~/data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import ChromeIcon from "./ChromeIcon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import CopyEmail from "./CopyEmail.astro";
import MotionToggle from "./MotionToggle.astro";
import { contactCta, narrowWhatsapp, pageContact } from "./contact-cta";
import { serviceIcon, industryIcon } from "./sections/catalog/catalog";
import { colon, ltr } from "~/lib/text";
import { MAIN_NAV, FOREIGN_PATH, href, currentState, whatsappLink, mailtoLink, prefersEmail, prefersWhatsapp, serviceNav, industryNav, fmt } from "./nav";

interface Props {
  locale: Locale;
  path: string;
  /** The page's WhatsApp message (BaseLayout's whatsappMessage); default: derived from the path (pageContact). */
  whatsappMessage?: string;
}
const { locale, path, whatsappMessage } = Astro.props;
const m = getMessages(locale);
const t = m.ui;
const email = prefersEmail(locale);
const waFirst = prefersWhatsapp(locale);
const ctx = pageContact(locale, path);
const wa = whatsappLink(whatsappMessage ?? ctx.whatsapp);
const mail = mailtoLink(undefined, { locale, path, topic: ctx.topic });
const contact = contactCta(locale, { whatsapp: whatsappMessage ?? ctx.whatsapp, mail: { path, topic: ctx.topic } });
const foreignState = currentState(FOREIGN_PATH, path);
const urgent = { title: m.contact.thanks.urgent.title as string, wa: whatsappLink(m.common.whatsapp.stopped) };
const menus = {
  services: { items: serviceNav(locale).map((l) => ({ ...l, icon: serviceIcon(l.slug) })), all: { label: m.common.labels.allServices as string, path: "services" } },
  industries: { items: industryNav(locale).map((l) => ({ ...l, icon: industryIcon(l.slug) })), all: { label: m.common.labels.allIndustries as string, path: "industries" } },
};
const accId = (key: string) => `lc-acc-${key}`;
/* The two actions (filled first). Maintenance and support (a stopped machine): call + WhatsApp / email, as in that
   page's hero; otherwise the locale's pair (ar: WhatsApp first). */
interface Action {
  href: string;
  label: string;
  icon?: "whatsapp" | "mail" | "phone";
  arrow?: boolean;
  external?: boolean;
}
const contactAction: Action =
  contact.kind === "email" ? { href: contact.href, label: contact.label, icon: "mail" } : { href: contact.href, label: contact.label, icon: "whatsapp", external: true };
const quoteAction: Action = { href: ctx.quote, label: t.cta.quote, arrow: true };
/* The sheet is at most 26rem wide: a WhatsApp action takes the locale's short label when the full one would wrap
   (tr, VIS3-06). */
const pair: Action[] = ctx.urgent
  ? [{ href: telLink(), label: m.common.labels.callEngineer as string, icon: "phone" }, contactAction]
  : waFirst
    ? [{ href: wa, label: t.cta.whatsapp, icon: "whatsapp", external: true }, quoteAction]
    : [quoteAction, contactAction];
const actions = pair.map((a) => (a.icon === "whatsapp" ? { ...a, label: narrowWhatsapp(locale, a.label) ?? a.label } : a));
---

<dialog id="lc-drawer" class="lc-drawer on-dark bg-navy-950 text-navy-100" aria-label={t.a11y.menu}>
  <div class="flex min-h-full flex-col">
    {/* .lc-drawer-bar: following a link from the sheet, this bar crossfades into the new page's header (BaseLayout,
        MOT3-04); its own background makes that layer opaque. */}
    <div class="lc-drawer-bar flex h-14 shrink-0 items-center justify-between border-b border-white/10 bg-navy-950 px-5">
      <Logo variant="dark" width={104} alt="Logic Controls" loading="lazy" />
      {/* `autofocus` is the HTML way to set a modal dialog's initial focus (as in Header / Gallery; the rule is off for
          this file in eslint.config.mjs). */}
      <button type="button" class="lc-menu-close inline-flex size-11 items-center justify-center border border-white/20 text-white hover:border-white/50" autofocus>
        <Icon name="close" size={22} />
        <span class="sr-only">{t.a11y.closeMenu}</span>
      </button>
    </div>
    <nav aria-label={t.a11y.mainNav} class="px-5 pt-1">
      <ul role="list" class="divide-y divide-white/8">
        {
          MAIN_NAV.map((item, i) => {
            const state = currentState(item.path, path);
            const label = t.nav[item.key];
            const menu = "menu" in item ? menus[item.menu] : undefined;
            /* The page we are on, named under its section (the accordion itself starts collapsed). */
            const here = menu && state === "true" ? menu.items.find((l) => currentState(l.path, path) === "page") : undefined;
            const id = accId(item.key);
            return (
              <li>
                <div class="flex items-stretch">
                  <a
                    href={href(locale, item.path)}
                    aria-current={state}
                    class:list={["flex min-h-12 flex-1 items-center gap-4 py-1.5 text-lg font-bold", state ? "text-white" : "text-navy-100 hover:text-white"]}
                  >
                    <span class="w-5 shrink-0 font-mono text-xs font-medium text-navy-400 ltr" dir="ltr" aria-hidden="true">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="flex min-w-0 flex-col">
                      <span class:list={[state && "underline decoration-signal-400 decoration-2 underline-offset-8"]}>{label}</span>
                      {here && (
                        <span class="mt-1 truncate text-sm font-medium text-signal-200" aria-hidden="true">
                          {here.label}
                        </span>
                      )}
                    </span>
                  </a>
                  {menu ? (
                    <button
                      type="button"
                      class="lc-acc-btn -me-3 grid w-14 shrink-0 place-items-center text-navy-300 transition-colors hover:text-white"
                      aria-expanded="false"
                      aria-controls={id}
                    >
                      <Icon name="chevron-down" size={22} class="lc-acc-chev" />
                      <span class="sr-only">{fmt(t.a11y.submenu, { label })}</span>
                    </button>
                  ) : (
                    <span class="-me-3 grid w-14 shrink-0 place-items-center" aria-hidden="true">
                      <Icon name="chevron-right" size={20} class={state ? "text-signal-400" : "text-navy-400"} />
                    </span>
                  )}
                </div>
                {menu && (
                  <ul id={id} role="list" class="lc-acc-list grid pb-3 ps-9" hidden>
                    {menu.items.map((l) => {
                      const cur = currentState(l.path, path) === "page";
                      return (
                        <li>
                          <a
                            href={href(locale, l.path)}
                            aria-current={cur ? "page" : undefined}
                            class:list={["flex min-h-11 items-center gap-3 text-[0.9375rem] transition-colors", cur ? "font-bold text-white" : "text-navy-200 hover:text-white"]}
                          >
                            <ChromeIcon name={l.icon} size={18} class="text-royal-300" />
                            <span class:list={["leading-snug", cur && "underline decoration-signal-400 decoration-2 underline-offset-4"]}>{l.label}</span>
                          </a>
                        </li>
                      );
                    })}
                    <li>
                      <a href={href(locale, menu.all.path)} class="inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-bold text-royal-300 hover:text-white">
                        {menu.all.label}
                        <Icon name="arrow" size={16} />
                      </a>
                    </li>
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="px-5 pt-3">
      <a
        href={href(locale, FOREIGN_PATH)}
        aria-current={foreignState}
        class:list={[
          "flex min-h-12 items-center gap-3 border bg-signal-400/[0.07] px-4 font-semibold text-signal-200 hover:border-signal-400",
          foreignState ? "border-2 border-signal-400" : "border-signal-400/40",
        ]}
      >
        <span class="lc-led" aria-hidden="true"></span>
        <span class="flex-1">{t.nav.foreign}</span>
        {foreignState ? <Icon name="check" size={18} /> : <Icon name="arrow" size={18} />}
      </a>
    </div>
    <div class="grid gap-3 px-5 pt-4">
      {
        actions.map((a, i) => (
          <a href={a.href} class="lc-btn" data-variant={i === 0 ? "primary" : "on-dark"} data-size="lg" data-block {...(a.external ? { target: "_blank", rel: "noopener" } : {})}>
            {a.icon && <ChromeIcon name={a.icon} size={20} class={i === 0 ? undefined : a.icon === "whatsapp" ? "text-whatsapp-500" : "text-royal-300"} />}
            <span class="lc-btn-label">
              {a.label}
              {a.external && <span class="sr-only"> ({t.a11y.newTab})</span>}
            </span>
            {a.arrow && <Icon name="arrow" size={20} class="lc-btn-icon-end" />}
          </a>
        ))
      }
    </div>
    {
      /* The emergency path, one tap from every page — on maintenance and support it is the two actions above. */
      !ctx.urgent && (
        <div class="px-5 pt-3">
          <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border border-white/10 bg-white/[0.03] px-4 py-2.5">
            <p class="flex items-center gap-2.5 text-sm font-semibold text-white">
              <span class="lc-led" style="--led: var(--color-danger-500)" aria-hidden="true" />
              {urgent.title}
            </p>
            <div class="flex gap-2">
              <a href={telLink()} class="lc-tel-label inline-flex min-h-11 items-center gap-1.5 border border-white/20 px-3 text-sm font-semibold whitespace-nowrap text-white hover:border-white/50">
                <ChromeIcon name="phone" size={16} class="text-royal-300" />
                {t.cta.call}
              </a>
              {!email && (
                <a href={urgent.wa} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 border border-white/20 px-3 text-sm font-semibold whitespace-nowrap text-white hover:border-white/50">
                  <ChromeIcon name="whatsapp" size={16} class="text-whatsapp-500" />
                  {t.cta.whatsappShort}
                  <span class="sr-only">({t.a11y.newTab})</span>
                </a>
              )}
            </div>
          </div>
        </div>
      )
    }
    <div class="px-5 pt-8">
      <p class="mb-3 type-label text-navy-300">{t.a11y.language}</p>
      <LanguageSwitcher locale={locale} path={path} variant="grid" />
    </div>
    <div class="lc-drawer-foot mt-auto space-y-1 border-t border-white/10 px-5 pt-5 text-sm text-navy-200">
      <a href={telLink()} class="flex min-h-11 items-center gap-3 hover:text-white">
        <ChromeIcon name="phone" size={18} class="text-royal-300" />
        <span class="sr-only">{t.contact.phone}{colon(locale)}</span>
        <span class="ltr" dir="ltr">{SITE.phone.display}</span>
      </a>
      <div class="flex items-center justify-between gap-3">
        <a href={mail} class="flex min-h-11 min-w-0 items-center gap-3 hover:text-white">
          <ChromeIcon name="mail" size={18} class="text-royal-300" />
          <span class="sr-only">{t.contact.email}{colon(locale)}</span>
          <Fragment set:html={ltr(SITE.email)} />
        </a>
        <CopyEmail locale={locale} />
      </div>
      <MotionToggle variant="drawer" locale={locale} class="mt-4" />
    </div>
  </div>
</dialog>

<style>
  /* Full-height sheet from the inline-end edge, clear of the notch / home indicator (viewport-fit=cover). */
  .lc-drawer {
    position: fixed;
    inset: 0;
    inset-inline-start: auto;
    width: min(26rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) 0 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  :global([dir="rtl"]) .lc-drawer {
    padding-right: 0;
    padding-left: env(safe-area-inset-left, 0px);
  }
  .lc-drawer-foot {
    padding-bottom: max(2rem, calc(env(safe-area-inset-bottom, 0px) + 1rem));
  }
  .lc-drawer::backdrop {
    background: rgb(4 14 39 / 0.6);
    backdrop-filter: blur(4px);
  }
  /* Sheet slides in from the inline-end edge (emphasized ease) and leaves faster (exit ease); the backdrop fades with
     it. allow-discrete keeps the dialog in the top layer until the exit has played. */
  .lc-drawer,
  .lc-drawer::backdrop {
    opacity: 0;
    transition:
      opacity var(--dur-micro) var(--ease-exit),
      translate var(--dur-micro) var(--ease-exit),
      overlay var(--dur-micro) allow-discrete,
      display var(--dur-micro) allow-discrete;
  }
  .lc-drawer {
    translate: var(--drawer-from, var(--move-slide)) 0;
    contain: layout style;
  }
  .lc-drawer[open],
  .lc-drawer[open]::backdrop {
    opacity: 1;
    translate: 0 0;
    transition-duration: var(--dur-page);
    transition-timing-function: var(--ease-emph);
  }
  @starting-style {
    .lc-drawer[open],
    .lc-drawer[open]::backdrop {
      opacity: 0;
    }
    .lc-drawer[open] {
      translate: var(--drawer-from, var(--move-slide)) 0;
    }
  }
  /* Restored from the back/forward cache: closed without replaying the exit. */
  .lc-drawer[data-instant],
  .lc-drawer[data-instant]::backdrop {
    transition: none;
  }
  :global([dir="rtl"]) .lc-drawer {
    --drawer-from: calc(-1 * var(--move-slide));
  }
  :global(html:has(.lc-drawer[open])) {
    overflow: hidden;
  }
  /* 320px phones: the full-width actions keep their one-line labels ("WhatsApp an engineer", ar) with less side
     padding (they are centred anyway). */
  @media (max-width: 22.49rem) {
    .lc-drawer .lc-btn[data-size="lg"] {
      padding-inline: 1rem;
    }
  }

  /* Accordions: the chevron turns (the svg comes from <Icon>, hence :global) and the list drops in. */
  .lc-acc-btn :global(.lc-acc-chev) {
    transition: rotate var(--dur-ui) var(--ease-mech);
  }
  .lc-acc-btn[aria-expanded="true"] :global(.lc-acc-chev) {
    rotate: 180deg;
  }
  .lc-acc-btn[aria-expanded="true"] {
    color: var(--color-white);
  }
  .lc-acc-list:not([hidden]) {
    transition:
      opacity var(--dur-ui) var(--ease-mech),
      translate var(--dur-ui) var(--ease-mech);
  }
  @starting-style {
    .lc-acc-list:not([hidden]) {
      opacity: 0;
      translate: 0 calc(-1 * var(--move-ui));
    }
  }
</style>

<script>
  /* Idempotent: the controller binds once even if this module is bundled / imported more than once. */
  const drawer = document.getElementById("lc-drawer") as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>('.lc-menu-open[aria-controls="lc-drawer"]');
  if (drawer && opener && !drawer.hasAttribute("data-ready")) {
    drawer.setAttribute("data-ready", "");
    opener.addEventListener("click", () => {
      drawer.showModal();
      opener.setAttribute("aria-expanded", "true");
    });
    drawer.querySelector(".lc-menu-close")?.addEventListener("click", () => drawer.close());
    drawer.addEventListener("close", () => opener.setAttribute("aria-expanded", "false"));
    drawer.addEventListener("click", (e) => {
      // A click on the backdrop closes the sheet.
      if (e.target === drawer) return drawer.close();
      // A link to this very page (an in-page anchor such as the quote form on /contact/): the browser only scrolls,
      // so close the sheet first, or the jump happens behind a modal, scroll-locked page.
      const a = (e.target as Element | null)?.closest<HTMLAnchorElement>("a[href]");
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.target === "_blank") return;
      const to = new URL(a.href, location.href);
      if (to.origin === location.origin && to.pathname === location.pathname && to.search === location.search) drawer.close();
    });
    // Services / Industries accordions.
    drawer.querySelectorAll<HTMLButtonElement>(".lc-acc-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const list = document.getElementById(btn.getAttribute("aria-controls") ?? "");
        if (!list) return;
        const open = btn.getAttribute("aria-expanded") !== "true";
        btn.setAttribute("aria-expanded", String(open));
        list.hidden = !open;
      });
    });
    // Close if the viewport grows to desktop while open.
    matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && drawer.close());
    // Back / forward cache: the page comes back exactly as it was left — never with the sheet still open.
    addEventListener("pageshow", (e) => {
      if (!e.persisted || !drawer.open) return;
      drawer.setAttribute("data-instant", "");
      drawer.close();
      requestAnimationFrame(() => requestAnimationFrame(() => drawer.removeAttribute("data-instant")));
    });
  }
</script>
