---
/**
 * Dark-navy hero. Use with <BaseLayout heroDark> so the transparent header sits on top of it.
 *
 * size="home": tall, slanted media panel on the inline-end side (≥1024px); optional muted background loop that only
 *              starts when motion, data and viewport allow (≥1024px, after first paint + 2.4 s and an idle moment),
 *              with a pause button (persisted) that also follows the site-wide "Pause animations" switch.
 * size="page": page header for inner pages (breadcrumbs slot, no video).
 * size="compact": index pages (services, industries, projects): page header with tight spacing and medium buttons,
 *              no proof figures, so the first cards are on the first screen (UX2-12).
 * Below 1024px a photo or video poster is shown as a visible band (<HeroBand>) instead of a dimmed backdrop: under the
 * breadcrumbs on page heroes, after the CTAs on the home hero.
 *
 * CTAs (contact-cta.ts): form + WhatsApp (zh: email); on Arabic pages WhatsApp comes first and filled.
 * `urgent` adds a "Machine stopped? Call / WhatsApp now" line under the CTAs.
 * Title accepts simple HTML; wrap the emphasised words in <em> (rendered in royal-300, not slanted twice).
 * Slots: default (extra content under the CTAs), "breadcrumbs", "media" (replaces the video/image panel).
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { SITE, telLink } from "~/data/site";
import { getMessages, pathWithoutLocale, type Locale } from "~/i18n";
import { heading, toHtml } from "~/lib/text";
import Button from "./Button.astro";
import Chips from "./Chips.astro";
import CircuitTraces from "./CircuitTraces.astro";
import HeroBand from "./HeroBand.astro";
import Icon from "./Icon.astro";
import { contactCta, pageTopic, placeCtas, type Cta } from "./contact-cta";
import CopyEmail from "./CopyEmail.astro";
import { BLANK_IMAGE, HERO_PANEL_SIZES, type HeroVideo } from "./hero-media";
import { href as lhref, QUOTE_PATH, whatsappLink, prefersEmail } from "./nav";

interface Proof {
  value: string;
  label: string;
}
interface Props {
  locale?: Locale;
  title: string;
  lead?: string;
  /** HMI spec chip above the title, e.g. ["PLC", "HMI", "SCADA", "VFD"]. */
  chips?: string[];
  /** Shorter chip text for the 1024–1279px split layout (size="home"), where the full eyebrow would wrap (VIS2-05). */
  chipsShort?: string[];
  primary?: Cta | false;
  secondary?: Cta | false;
  /** Static proof figures under the CTAs (never animated). */
  proof?: Proof[];
  /** "compact": index pages — tight header so the first cards show on the first screen; no proof figures (`proof` is
   *  ignored); a photo stays a desktop-only panel (no phone band). */
  size?: "home" | "page" | "compact";
  /** Background loop (muted). `poster` is required and is the LCP image on desktop (see hero-media.ts). */
  video?: HeroVideo;
  /** Photo instead of a video. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** fetchpriority="high" on the poster/photo (default: on whenever the hero has a photo or video: it is the LCP). */
  priority?: boolean;
  /** Show the animated circuit traces. */
  traces?: boolean;
  /** Slanted bottom edge (rises towards the inline end, like the italic). Default on for size="home". */
  angle?: boolean;
  /**
   * Title scale for size="home". "display" (default) is the full display size; "fit" is one step smaller with
   * tighter vertical rhythm so a long H1 + lead + CTAs + proof figures fit above the fold on a 1440×900 desktop.
   */
  titleSize?: "display" | "fit";
  /** Page topic for email CTAs (subject "Automation project inquiry: <topic>"); default: the catalogue page's title. */
  topic?: string;
  /** "Machine stopped?" call-now line under the CTAs (pages whose visitors may have a stopped line). */
  urgent?: boolean;
  /** Keep the phone band (`image` / video poster below 1024px) although a `media` slot replaces the desktop panel
   *  (case studies whose small cover is shown framed on desktop). Default off: a media slot handles its own phones. */
  bandWithMedia?: boolean;
  class?: string;
}

const locale = (Astro.props.locale ?? Astro.currentLocale ?? "en") as Locale;
const m = getMessages(locale);
const t = m.ui;
const email = prefersEmail(locale);
const path = pathWithoutLocale(Astro.url.pathname);
const mail = { topic: Astro.props.topic ?? pageTopic(locale, path), path };
const {
  title,
  lead,
  chips,
  chipsShort,
  primary = { label: t.cta.quote, href: lhref(locale, QUOTE_PATH), kind: "form" },
  secondary = contactCta(locale, { whatsapp: t.whatsapp.message, mail }),
  proof = [],
  size = "home",
  video,
  image,
  imageAlt = "",
  traces = true,
  angle,
  titleSize = "display",
  urgent = false,
  class: className,
} = Astro.props;

const home = size === "home";
const fit = home && titleSize === "fit";
const titleChars = title.replace(/<[^>]*>/g, "").length;
/** Long display titles (Turkish runs ~80 characters) step down one size so the CTAs stay above the fold. */
const longTitle = titleChars > 80;
/** Page titles past ~50 characters (case studies): Arabic steps down on phones (VIS3-05, see <style>). */
const longPageTitle = size === "page" && titleChars > 50;
/* Fit sizes below 360px: 27px at 320 rising to the 30px floor at 360, so the first CTA stays on a 320×568 first screen
   in every locale (DEV2-09). Not Arabic: its display size is already 0.86× and its title is three lines either way. */
const fitFloor = locale === "ar" ? "1.875rem" : "min(1.875rem, 0.1875rem + 7.5vw)";
const angled = angle ?? home;
const hasMediaSlot = Astro.slots.has("media");
const hasMedia = hasMediaSlot || !!video || !!image;
const priority = Astro.props.priority ?? (!!video || !!image);
/** Photo/poster shown as a band below 1024px (the slot's art handles its own mobile copy). */
const band = (!hasMediaSlot || !!Astro.props.bandWithMedia) && (!!video || !!image);
const ctas = placeCtas(locale, primary, secondary, mail);
const compact = size === "compact";
/** The phone band (not on compact heroes: there the cards right below are the imagery). */
const bandHere = band && !compact;

/* Below 1024px the desktop panel is not rendered (display: none) and must not download either: its <picture> only
   offers real files to ≥1024px and falls back to a 1×1 data-URI source. BaseLayout preloads the desktop poster for
   ≥1024px only (hero-media.ts). Pages without the band (media slot) never had a photo here. */
const WIDE = "(min-width: 1024px)";
/* object-fit: cover fills the panel (54% / 44% of the viewport wide, the hero's height tall), so the photo renders at
   max(panel width, hero height × aspect ratio). The hero's height comes from its copy and barely changes with the
   viewport (measured 1024–1920px: page ~620–890px, compact ~460–560px (Arabic ~650), home-size ~900–1040px), so below the width
   where the panel itself wins the rendered size is a fixed number of pixels: e.g. technologies (0.97:1) ~760–860px,
   about (1.47:1) ~910–940px. A flat 80vw asked for 1152px at 1440 and 1536px at 1920 (2x screens took the largest file). */
const PANEL_FRAC = home ? 0.54 : 0.44;
const HERO_H = home ? 940 : compact ? 540 : 760;
let panelSizes = home ? "100vw" : "80vw";
if (image) {
  const px = Math.round(HERO_H * (image.width / image.height));
  const bp = Math.ceil(px / PANEL_FRAC);
  panelSizes = bp > 1024 ? `(min-width: ${bp}px) ${Math.round(PANEL_FRAC * 100)}vw, ${px}px` : `${Math.round(PANEL_FRAC * 100)}vw`;
}
let photo: { avif: string; webp: string; src: string } | undefined;
if (image) {
  const widths = [...new Set([960, 1280, 1600, 2000, 2400].map((w) => Math.min(w, image.width)))];
  const set = async (format: "avif" | "webp") =>
    (await Promise.all(widths.map(async (w) => `${(await getImage({ src: image, width: w, format })).src} ${w}w`))).join(", ");
  const [avif, webp] = await Promise.all([set("avif"), set("webp")]);
  photo = { avif, webp, src: (await getImage({ src: image, width: Math.min(1280, image.width), format: "webp" })).src };
}
---

<section
  class:list={["lc-hero on-dark relative isolate overflow-hidden bg-navy-950 text-navy-100", home && "lg:max-xl:[--lc-panel-start:58%]", className]}
  data-size={size}
  data-angle={angled ? "" : undefined}
  style="margin-block-start: calc(-1 * (var(--header-h) + var(--utility-h)))"
>
  {/* ---------- media (≥1024px panel; below that, see <HeroBand>) ---------- */}
  {
    hasMedia && (
      <div
        class:list={[
          "lc-hero-media absolute inset-0 -z-30",
          band && "max-lg:hidden",
          /* home: at 1024–1279 the panel starts where the wider copy column ends (58%), from 1280 at 46% (DEV2-09) */
          home ? "lg:inset-s-auto lg:w-[42%] xl:w-[54%]" : "lg:inset-s-auto lg:w-[44%]",
        ]}
      >
        {hasMediaSlot ? (
          <slot name="media" />
        ) : video ? (
          <>
            <picture>
              {video.posterAvifSrcset && <source media={WIDE} type="image/avif" srcset={video.posterAvifSrcset} sizes={HERO_PANEL_SIZES} />}
              <source media={WIDE} srcset={video.posterSrcset ?? video.poster} sizes={video.posterSrcset ? HERO_PANEL_SIZES : undefined} />
              <source srcset={BLANK_IMAGE} />
              <img
                src={video.poster}
                width={video.width ?? 1920}
                height={video.height ?? 1080}
                alt=""
                loading="eager"
                decoding="async"
                fetchpriority={priority ? "high" : "auto"}
                class="absolute inset-0 size-full object-cover"
              />
            </picture>
            {/* no poster attribute: the image above is the poster (the video stays transparent until it plays) */}
            <video
              class="lc-hero-video absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-(--dur-page) ease-mech"
              data-src={video.src}
              data-webm={video.webm}
              muted
              playsinline
              preload="none"
              aria-hidden="true"
              tabindex="-1"
            />
          </>
        ) : (
          photo && (
            <picture>
              <source media={WIDE} type="image/avif" srcset={photo.avif} sizes={panelSizes} />
              <source media={WIDE} srcset={photo.webp} sizes={panelSizes} />
              <source srcset={BLANK_IMAGE} />
              <img
                src={photo.src}
                alt={imageAlt}
                width={image!.width}
                height={image!.height}
                loading="eager"
                decoding="async"
                fetchpriority={priority ? "high" : "auto"}
                class="absolute inset-0 size-full object-cover"
              />
            </picture>
          )
        )}
        {/* contrast overlays: full-strength where text sits on the media (no-band pages below 1024px), fading
            towards the end on desktop */}
        <div class="absolute inset-0 bg-navy-950/85 lg:bg-transparent lg:bg-linear-to-r lg:from-navy-950 lg:via-navy-950/45 lg:to-navy-950/10 rtl:lg:bg-linear-to-l" />
        <div class="absolute inset-x-0 bottom-0 h-2/5 bg-linear-to-t from-navy-950 to-transparent" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(4_14_39/0.7),transparent_28%)]" />
        {/* the slanted edge (10°, the logo's italic) with a hairline */}
        <svg
          class="pointer-events-none absolute inset-y-0 start-0 hidden h-full w-(--slant-x) text-royal-400/60 lg:block rtl:-scale-x-100"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path class="lc-hero-edge" d="M100 0 0 100" pathLength="100" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
        </svg>
      </div>
    )
  }

  {/* ---------- decoration ---------- */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(ellipse_55%_70%_at_10%_20%,rgb(13_37_82/0.95),transparent_70%)] rtl:bg-[radial-gradient(ellipse_55%_70%_at_90%_20%,rgb(13_37_82/0.95),transparent_70%)]" />
  {/* blueprint grid on the copy side only: never drawn over the photo/video panel (≥1024px) */}
  <div
    aria-hidden="true"
    class:list={[
      "pointer-events-none absolute inset-0 -z-10 bg-blueprint [mask-image:linear-gradient(to_bottom,#000_40%,transparent)]",
      band && "lg:[mask-image:linear-gradient(to_right,#000_38%,transparent_50%)] rtl:lg:[mask-image:linear-gradient(to_left,#000_38%,transparent_50%)]",
    ]}
  />
  {
    traces && (
      <>
        {/* Full heroes only (VIS2-04): on the tight compact hero the bundle ran into the CTAs; the home's top-end bundle
            only showed its rings over the video panel. */}
        {!compact && <CircuitTraces corner="bottom-start" class="-z-10 opacity-90 max-md:origin-bottom-left max-md:scale-[0.62] rtl:max-md:origin-bottom-right" />}
      </>
    )
  }

  {/* ---------- pause control for the background loop (WCAG 2.2.2); shown (data-shown, a fade) by the script only while
       the loop may run (≥1024px). At the top-start of the video panel, under the header and clear of its slant: always
       on the first screen, also on 1280×720 / 1366×768 laptops where the hero's bottom is below the fold (MOT3-07), and
       never in the floating button's corner (there it held back the button's dock-in on laptops, MOT2-09). ---------- */}
  {
    video && (
      <button
        type="button"
        class="lc-hero-pause group absolute z-10 grid size-11 place-items-center border border-white/30 bg-navy-950/70 text-white backdrop-blur-sm hover:border-signal-300 hover:text-signal-200 max-lg:hidden"
        style="inset-block-start: calc(var(--header-h) + var(--utility-h) + 1rem); inset-inline-start: calc(var(--lc-panel-start, 46%) + var(--slant-x) + 1rem)"
        aria-pressed="false"
        data-hero-pause
      >
        <svg class="group-aria-pressed:hidden" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <rect x="3.5" y="2.5" width="3" height="11" rx=".6" />
          <rect x="9.5" y="2.5" width="3" height="11" rx=".6" />
        </svg>
        <svg class="hidden group-aria-pressed:block" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M4.5 2.9a.8.8 0 0 1 1.2-.7l8 4.9a1 1 0 0 1 0 1.8l-8 4.9a.8.8 0 0 1-1.2-.7z" />
        </svg>
        <span class="sr-only">{t.video.pauseLoop}</span>
      </button>
    )
  }

  {/* ---------- content ---------- */}
  <div
    class:list={[
      "wrap relative",
      home
        ? fit
          ? "flex min-h-[min(46rem,100svh)] flex-col justify-center pt-[calc(var(--header-h)+var(--utility-h)+2rem)] pb-28 max-[22.5rem]:pt-[calc(var(--header-h)+var(--utility-h)+1.25rem)] lg:min-h-[min(47rem,100svh)] lg:pt-[calc(var(--header-h)+var(--utility-h)+1.75rem)] lg:pb-24"
          : "flex min-h-[min(46rem,100svh)] flex-col justify-center pt-[calc(var(--header-h)+var(--utility-h)+3rem)] pb-32 lg:min-h-[47rem] lg:pb-36"
        : compact
          ? "pt-[calc(var(--header-h)+var(--utility-h)+1rem)] pb-9 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16 lg:pt-[calc(var(--header-h)+var(--utility-h)+1.25rem)] lg:pb-10"
          : "pt-[calc(var(--header-h)+var(--utility-h)+2.5rem)] pb-24 lg:pb-28",
    ]}
  >
    <div
      class:list={[
        "lc-hero-copy",
        home
          ? fit
            ? "max-w-2xl lg:max-w-[58%] xl:max-w-[50%]" /* 1024–1279: wider, so both CTAs fit one row (DEV2-09) */
            : "max-w-2xl lg:max-w-[48%]"
          : compact
            ? hasMedia
              ? "max-w-3xl lg:max-w-[52%]"
              : "max-w-3xl lg:max-w-4xl" /* no panel beside it: a long (Arabic) title takes two lines, not three */
            : "max-w-3xl lg:max-w-[58%]",
      ]}
    >
      {
        Astro.slots.has("breadcrumbs") && (
          <div class={compact ? "mb-3" : "mb-6"}>
            <slot name="breadcrumbs" />
          </div>
        )
      }
      {bandHere && !home && <HeroBand image={image} video={video} alt={imageAlt} priority={priority} rise={0} class="mb-7" />}
      {/* The short eyebrow also below 360px (one or two lines instead of two or three: DEV2-09). Its "·" parts go to
          Chips as items, so a short place name ("6 Ekim Şehri") never splits at a wrap. */}
      {chips && chips.length > 0 && (
        <Chips
          items={chips}
          joined
          led
          class:list={["lc-rise", fit ? "mb-5" : compact ? "mb-3" : "mb-6", home && chipsShort?.length && "lg:max-xl:hidden max-[22.5rem]:hidden"]}
        />
      )}
      {
        home && chipsShort && chipsShort.length > 0 && (
          <Chips items={chipsShort.flatMap((c) => c.split(" · "))} joined led class:list={["lc-rise max-lg:min-[22.5rem]:hidden xl:hidden", fit ? "mb-5" : "mb-6"]} />
        )
      }
      <h1
        class:list={[home ? "type-display" : compact ? "type-h2" : "type-h1", "text-white [&_em]:text-royal-300 [&_em]:[font-style:inherit]"]}
        style={
          fit
            ? longTitle
              ? `--text-display: clamp(${fitFloor}, min(1.35rem + 1.9vw, 0.1875rem + 7.5vw), 3rem)` /* also on the floor's 27→30px slope below ~330px */
              : `--text-display: clamp(${fitFloor}, 0.25rem + 3.6vw, 3.5rem)` /* 360px: 30px, 1024px: 41px, 1440px: 56px */
            : undefined
        }
        data-long={longPageTitle ? "" : undefined}
        set:html={heading(locale, title)}
      />
      {
        lead && (
          <p
            class:list={["type-lead text-navy-200", compact ? "mt-3 max-w-2xl" : fit ? "mt-5 max-w-xl max-[22.5rem]:[--text-lead:1rem]" : "mt-6 max-w-xl"]}
            set:html={toHtml(locale, lead)}
          />
        )
      }
      {
        ctas.length > 0 && (
          <div
            class:list={["lc-rise flex flex-wrap items-center gap-3", fit ? "mt-8 max-[22.5rem]:mt-6" : compact ? "mt-5" : "mt-9", home && "lg:max-xl:flex-nowrap"]}
            style="--i:2"
            data-fab-avoid
          >
            {ctas.map((c) => (
              <Button
                href={c.cta.href}
                size={compact ? "md" : "lg"}
                variant={c.filled ? "primary" : "on-dark"}
                icon={c.icon}
                iconEnd={c.iconEnd}
                iconClass={c.iconClass}
                external={c.external}
                class:list={["max-sm:w-full", home && "lg:max-xl:px-5"]}
              >
                {c.narrow ? (
                  <>
                    <span class="max-[24.99rem]:hidden">{c.cta.label}</span>
                    <span class="min-[25rem]:hidden">{c.narrow}</span>
                  </>
                ) : (
                  c.cta.label
                )}
              </Button>
            ))}
          </div>
        )
      }
      {
        email && secondary && (
          <p class="lc-rise mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm" style="--i:2">
            {/* email is the main channel here: one tap to copy the address for webmail users */}
            <CopyEmail locale={locale} tone="dark" />
            <a
              href={whatsappLink(t.whatsapp.message)}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-6 items-center gap-2 text-navy-200 underline-offset-4 hover:text-white hover:underline"
            >
              <Icon name="whatsapp" size={16} class="text-whatsapp-500" />
              {t.cta.inEgyptWhatsapp}
              <span class="sr-only"> ({t.a11y.newTab})</span>
            </a>
          </p>
        )
      }
      {
        urgent && (
          <p class="lc-rise mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm" style="--i:2">
            <span class="inline-flex items-center gap-2.5 font-bold text-signal-300">
              <span class="lc-led" data-blink aria-hidden="true" />
              {t.urgent.title}
            </span>
            <a href={telLink()} class="inline-flex min-h-11 items-center gap-2 font-semibold text-white underline-offset-4 hover:underline">
              <Icon name="phone" size={16} class="text-royal-300" />
              {m.common.labels.callEngineer}
              <span class="ltr text-navy-200" dir="ltr">
                {SITE.phone.display}
              </span>
            </a>
            {!email && (
              <a
                href={whatsappLink(m.common.whatsapp.stopped)}
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-11 items-center gap-2 font-semibold text-white underline-offset-4 hover:underline"
              >
                <Icon name="whatsapp" size={16} class="text-whatsapp-500" />
                {t.urgent.whatsapp}
                <span class="sr-only"> ({t.a11y.newTab})</span>
              </a>
            )}
          </p>
        )
      }
      {bandHere && home && <HeroBand image={image} video={video} alt={imageAlt} priority={priority} rise={3} home class="mt-8" />}
      <slot />
      {
        proof.length > 0 && !compact && (
          <dl
            class:list={[
              "lc-rise grid border-t border-white/10 pt-6",
              fit ? "mt-10 lg:max-xl:mt-6" : "mt-12",
              proof.length === 4 ? "max-w-2xl grid-cols-2 gap-y-5 sm:grid-cols-4" : "max-w-lg grid-cols-3",
            ]}
            style="--i:3"
            data-fab-avoid
          >
            {proof.map((p, i) => (
              <div
                class:list={[
                  "relative flex flex-col pe-3 sm:pe-6",
                  i > 0 &&
                    "ps-4 before:absolute before:inset-y-1 before:start-0 before:w-px before:-skew-x-[10deg] before:bg-white/15 sm:ps-6 rtl:before:skew-x-[10deg]",
                  proof.length === 4 && i === 2 && "max-sm:ps-0 max-sm:before:hidden",
                ]}
              >
                <dt class:list={["mt-1 text-sm text-navy-300", locale === "zh" && "break-keep"]}>{p.label}</dt>
                <dd class="order-first type-stat text-white" style="font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem)">
                  <span class="ltr" dir="ltr">
                    {p.value}
                  </span>
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
  {/* end of the hero: the <head> script holds the first frame until here (src/scripts/inline/base-head.js) */}
  <span id="lc-hero-end" hidden></span>
</section>

<style>
  .lc-hero {
    --slant-x: 132px; /* tan(10°) × ~750px hero height */
  }
  @media (min-width: 64rem) {
    .lc-hero-media {
      clip-path: polygon(var(--slant-x) 0, 100% 0, 100% 100%, 0 100%);
    }
    :global([dir="rtl"]) .lc-hero-media {
      clip-path: polygon(0 0, calc(100% - var(--slant-x)) 0, 100% 100%, 0 100%);
    }
  }
  .lc-hero[data-angle] {
    --angle-h: clamp(1.5rem, 4vw, 4rem);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--angle-h)), 0 100%);
  }
  :global([dir="rtl"]) .lc-hero[data-angle] {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - var(--angle-h)));
  }
  .lc-hero-video[data-playing] {
    opacity: 1;
  }
  /* back to the poster when the loop rests (the clip is on its first frame by then, the same picture): a slower fade
     than the reveal */
  .lc-hero-video:not([data-playing]) {
    transition-duration: var(--dur-section);
  }
  /* Fades in and out with the clip instead of popping (MOT3-07); hidden = invisible and out of the tab order, without
     JS too. The tokens collapse under "Pause animations" / reduced motion. */
  .lc-hero-pause {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-ui) var(--ease-mech),
      visibility 0s linear var(--dur-ui),
      color var(--dur-micro) var(--ease-mech),
      border-color var(--dur-micro) var(--ease-mech);
  }
  .lc-hero-pause[data-shown] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  /* Arabic case-study titles on phones (VIS3-05): at the full h1 size a 60–80 character title ran 5–6 lines of 49px
     and pushed the intro off the first screen. 0.86× with a tighter line, like the display size's Arabic step. */
  @media (width < 40rem) {
    .lc-hero h1[data-long]:lang(ar) {
      font-size: calc(var(--text-h1) * 0.86);
      line-height: 1.28;
    }
  }
</style>

<script>
  /*
   * Decorative background clip. Starts only when welcome: viewport ≥ 1024px (below that the poster is a band and the
   * clip would play under nothing), no Save-Data / 2G / 3G, site motion on (html[data-motion="off"] covers the
   * "Pause animations" switch and prefers-reduced-motion), not paused with the hero button (localStorage), on screen.
   * Timing (MOT-12): first paint + 2.4 s, then an idle moment. The poster is the clip's first frame (hero-media.ts), so
   * the video is revealed on its first painted frame with a short fade and nothing is double-exposed (MOT2-08).
   * Play once, then rest on the poster; a mouse entering the hero plays it once more. The clip ends on a closer shot
   * than it starts, so it never fades over the poster from there (a double exposure) nor loops into its start (a seam
   * mid-loop, MOT3-06): at the end it jumps back to its first frame, a cut like the clip's own, and hands over to the
   * poster (= that frame) once that frame is on screen. AV1 WebM only where the device decodes it efficiently
   * (MediaCapabilities powerEfficient: no software 1080p decode on low-end PCs, DEV2-18), H.264 MP4 otherwise. The
   * pause button fades in only while the clip is on screen and playing (or paused by the visitor, to resume it).
   * Network (PERF2-08): no source until the hero is on screen; leaving it before the first frame stops the download.
   */
  import { motionOff, onMotionChange } from "~/scripts/motion/motion-pref";

  const video = document.querySelector<HTMLVideoElement>(".lc-hero-video[data-src]");
  const button = document.querySelector<HTMLButtonElement>("[data-hero-pause]");
  if (video) {
    const KEY = "lcHeroVideo";
    const AV1 = 'video/webm; codecs="av01.0.08M.08"';
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const slow = !!conn?.saveData || /(^|-)(2g|3g)$/.test(conn?.effectiveType ?? "");
    const wide = matchMedia("(min-width: 1024px)");
    const read = () => {
      try {
        return localStorage.getItem(KEY) === "paused";
      } catch {
        return false;
      }
    };
    let userPaused = read();
    let visible = false; // until the observer says so: no download for a hero already scrolled past (PERF2-08)
    let started = false;
    let failed = false; // play() refused (e.g. power saving): stay on the poster, no button
    let resting = false; // played its turn: on the poster until a hover replays it

    const allowed = () => wide.matches && !slow && !failed && !motionOff();
    const playing = () => video.hasAttribute("data-playing");
    const efficientAv1 = async () => {
      if (!video.dataset.webm || video.canPlayType(AV1) !== "probably") return false;
      try {
        const info = await navigator.mediaCapabilities?.decodingInfo({
          type: "file",
          video: { contentType: AV1, width: 1920, height: 1080, bitrate: 1_500_000, framerate: 25 },
        });
        return !!info?.supported && !!info.powerEfficient;
      } catch {
        return false;
      }
    };
    /* Shown on the first frame the compositor paints, so the fade starts from the same picture as the poster. */
    const reveal = () => {
      const show = () => {
        video.setAttribute("data-playing", "");
        sync();
      };
      if ("requestVideoFrameCallback" in video) video.requestVideoFrameCallback(show);
      else show();
    };
    const play = () => {
      video.addEventListener("playing", reveal, { once: true });
      video.play().catch(() => {
        video.removeEventListener("playing", reveal);
        if (!video.paused) return;
        failed = true;
        sync();
      });
    };
    const start = async () => {
      started = true;
      const av1 = await efficientAv1();
      if (!started) return; // stopped while asking
      video.src = av1 ? video.dataset.webm! : video.dataset.src!;
      sync();
    };
    const sync = () => {
      const on = allowed();
      if (button) {
        button.toggleAttribute("data-shown", on && (userPaused || playing()));
        button.setAttribute("aria-pressed", String(userPaused));
      }
      if (on && !userPaused && visible && !resting) {
        if (!started) void start();
        else if (video.getAttribute("src") && video.paused) play();
      } else if (started) {
        video.pause();
        // Left the screen (or paused) before its first frame: stop the download; it starts again when wanted.
        if (!playing() && !resting) {
          video.removeAttribute("src");
          video.load();
          started = false;
        }
      }
    };
    /* The end of a play-through, once each. Also from 'timeupdate': WebKit with the AV1 WebM fires no 'ended' (and
       stays unpaused) at the end of a second play-through (MOT4-02), which left the last frame and a dead pause button
       on screen; 'timeupdate' still comes with `ended` true. */
    const finish = () => {
      if (resting) return;
      resting = true;
      video.pause(); // a no-op after a real 'ended'; WebKit's unpaused end would otherwise play on from frame 0
      video.currentTime = 0;
      // Hand over once frame 0 is on screen (rVFC also fires for a seek while paused; 'seeked' + two frames where it
      // doesn't). Not if a hover replay has started meanwhile.
      const handBack = () => {
        if (!resting || !playing()) return;
        video.removeAttribute("data-playing");
        sync();
      };
      if ("requestVideoFrameCallback" in video) video.requestVideoFrameCallback(handBack);
      video.addEventListener("seeked", () => requestAnimationFrame(() => requestAnimationFrame(handBack)), { once: true });
    };
    video.addEventListener("ended", finish);
    video.addEventListener("timeupdate", () => video.ended && finish());
    const begin = () => {
      new IntersectionObserver(([entry]) => {
        visible = !!entry?.isIntersecting;
        sync();
      }).observe(video);
      onMotionChange(sync);
      wide.addEventListener("change", sync);
      button?.addEventListener("click", () => {
        userPaused = !userPaused;
        try {
          if (userPaused) localStorage.setItem(KEY, "paused");
          else localStorage.removeItem(KEY);
        } catch {}
        sync();
      });
      // A mouse entering the hero replays a resting clip once.
      video.closest(".lc-hero")?.addEventListener("pointerenter", (e) => {
        if ((e as PointerEvent).pointerType !== "mouse" || !resting || userPaused || !allowed()) return;
        resting = false;
        video.currentTime = 0;
        sync();
      });
      sync();
    };
    const schedule = () => {
      const fcp = performance.getEntriesByName("first-contentful-paint")[0]?.startTime ?? performance.now();
      setTimeout(
        () => ("requestIdleCallback" in window ? requestIdleCallback(begin, { timeout: 2000 }) : begin()),
        Math.max(0, fcp + 2400 - performance.now()),
      );
    };
    if (document.readyState === "complete") schedule();
    else addEventListener("load", schedule, { once: true });
  }
</script>
