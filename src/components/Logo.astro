---
/**
 * The Logic Controls logo (raster, derived from the client's original artwork — never redrawn or recoloured
 * beyond the dark-background variant). `variant="dark"` is for navy/charcoal backgrounds.
 */
import { Picture } from "astro:assets";
import logoLight from "~/assets/brand/logo.png";
import logoDark from "~/assets/brand/logo-dark.png";

interface Props {
  variant?: "light" | "dark";
  /** Rendered CSS width in px (height follows the 794×335 aspect ratio). */
  width?: number;
  alt?: string;
  class?: string;
  loading?: "eager" | "lazy";
}

const { variant = "light", width = 124, alt = "Logic Controls", class: className, loading = "lazy" } = Astro.props;
const src = variant === "dark" ? logoDark : logoLight;
/* 1x / 2x / 3x candidates (VIS2-22): `layout="fixed"` alone stops at 2x, so the mark (and its small "CONTROLS" line) was
   upscaled ×1.3 on 3x phones. Capped at the artwork's own width. */
const widths = [...new Set([width, width * 2, width * 3].map((w) => Math.min(w, src.width)))];
/* Emit each class once (callers may repeat the defaults, e.g. "h-auto"). */
const classes = [...new Set(["block", "h-auto", "select-none", ...(className ?? "").split(/\s+/)].filter(Boolean))].join(" ");
---

{/* AVIF (WebP in the <img> for the rest) at quality 60 (PERF2-11): the lossy alpha channel made the q90 WebP heavy —
    header 2x 18.5 → 9.4 KB, footer 2x 23.6 → ~11.6 KB, the same pixels at a glance (compared at 3x zoom). The
    <picture> is display: contents, so the <img> keeps its place in the layout. `sizes` is passed on to the <source>
    too: without it the AVIF candidates were chosen for 100vw, i.e. the 3x files on every desktop (PERF3-03). */}
<Picture
  src={src}
  alt={alt}
  width={width}
  widths={widths}
  sizes={`${width}px`}
  layout="fixed"
  formats={["avif"]}
  fallbackFormat="webp"
  quality={60}
  loading={loading}
  decoding="async"
  class={classes}
  pictureAttributes={{ class: "lc-logo contents" }}
/>

<style>
  /* The <picture> is display: contents, so its <source> would become a box of its own in a flex row: Chromium made an
     empty flex item of it, which centred the drawer's logo (WebKit left it at the start). */
  :global(.lc-logo > source) {
    display: none;
  }
</style>
