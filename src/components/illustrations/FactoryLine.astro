---
/* Factory line panorama (bonus, 4:1) — control cabinet → process skid (silo, agitated tank, pump, PHE)
   → filler → labeler → vision check → case packing, all hung off one control-network bus whose drops
   end in ring nodes. Loops: bottles advance one pitch every 1.6 s (seamless: each station changes the
   state of the bottle crossing it); a network packet runs the bus every 6 s and wakes each node in turn. */
import Frame from "./ArtFrame.astro";
import LazyArt from "./LazyArt.astro";
import { uid, type ArtProps } from "./types";
interface Props extends ArtProps {
  /** Load from the shared, cached fragment when near the viewport (LazyArt.astro). Default: true unless labelled. */
  lazy?: boolean;
}
const { lazy = !Astro.props.label, ...p } = Astro.props;
const u = uid("fl");

// bottles: pitch 32, k = 0 … 16 at x = 474 + 32k (bottom at y 219); k=0 fades in, k=16 drops into the case
const X = (k: number) => 474 + 32 * k;
const filled = [4, 5, 6, 7].map(X);
const labelled = [9, 10, 11, 12, 13, 14, 15].map(X);
// network drops: junction x on the bus (y 34) → 45° → ring
const drops: [number, number, number][] = [
  [276, 96, 1.07],
  [442, 112, 1.86],
  [618, 110, 2.7],
  [725, 108, 3.21],
  [862, 128, 3.87],
  [1102, 176, 5.01],
];
const dropPath = (x: number, ry: number) => `M${x} 34L${x + 10} 44V${ry - 5}`;
const pipes = "M216 220V240H329M284 220V240M338 231V200H376M376 156H362V70H570V90";
const plates = Array.from({ length: 10 }, (_, k) => 380 + k * 4);
---

{
  lazy ? (
    <LazyArt src="factory/factory-line" viewBox="0 0 1200 300" {...p} />
  ) : (
<Frame {...p} uid={u} name="fl" viewBox="0 0 1200 300">
  <style is:inline>
    .lca-fl .po{stroke:var(--i-ink);stroke-width:7}
    .lca-fl .pi{stroke:var(--i-m);stroke-width:4}
    .lca-fl .pf{stroke:var(--i-w);stroke-width:2;stroke-dasharray:3 7;animation:lca-fw .7s linear infinite}
    .lca-fl .bel{animation:flM 1.6s linear infinite}
    .lca-fl .slat{stroke:var(--i-ln);stroke-width:1.5;stroke-dasharray:3 5;animation:flS 1.6s linear infinite}
    .lca-fl .f1,.lca-fl .f2{transform-box:fill-box;transform-origin:50% 100%}
    .lca-fl .f1{animation:flF1 1.6s linear infinite}
    .lca-fl .f2{animation:flF2 1.6s linear infinite}
    .lca-fl .lb{transform-box:fill-box;transform-origin:100% 50%;animation:flL 1.6s linear infinite}
    .lca-fl .in{animation:flIn 1.6s linear infinite}
    .lca-fl .out{animation:flOut 1.6s ease-in infinite}
    .lca-fl .beam{animation:flBm 1.6s ease-out infinite}
    .lca-fl .lamp{animation:flBl 1.5s step-end infinite}
    .lca-fl .wv{animation:flW 1.6s ease-in-out calc(var(--k) * -.14s) infinite}
    .lca-fl .ag{transform-box:fill-box;transform-origin:center;animation:flA .8s ease-in-out infinite alternate}
    .lca-fl .lv{transform-box:fill-box;transform-origin:50% 100%;animation:flLv 6s ease-in-out infinite alternate}
    .lca-fl .tw{stroke-dasharray:100 100;animation:flT 6s linear infinite}
    .lca-fl .p.bus{stroke-dasharray:3 200;stroke-dashoffset:5;animation:flB 6s linear infinite}
    .lca-fl .p.dr{animation:flD 6s linear var(--d) infinite}
    .lca-fl .nd.dr{animation:flN 6s var(--d) infinite}
    .lca-fl .pg.dr{animation:flG 6s ease-out var(--d) infinite}
    @keyframes flM{to{transform:translateX(32px)}}
    @keyframes flS{to{stroke-dashoffset:-32}}
    @keyframes flF1{from{transform:scaleY(0)}to{transform:scaleY(.5)}}
    @keyframes flF2{from{transform:scaleY(.5)}to{transform:scaleY(1)}}
    @keyframes flL{from{transform:scaleX(0)}to{transform:scaleX(1)}}
    @keyframes flIn{from{opacity:0}to{opacity:1}}
    @keyframes flOut{0%{opacity:1;transform:none}60%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(10px)}}
    @keyframes flBm{0%{opacity:.85}30%,100%{opacity:0}}
    @keyframes flBl{0%,50%{opacity:1}51%,100%{opacity:.15}}
    @keyframes flW{0%,100%{opacity:.12}50%{opacity:.7}}
    @keyframes flA{from{transform:scaleX(1)}to{transform:scaleX(-1)}}
    @keyframes flLv{from{transform:scaleY(.55)}to{transform:scaleY(.85)}}
    @keyframes flT{0%{stroke-dashoffset:100}85%,100%{stroke-dashoffset:0}}
    @keyframes flB{0%{stroke-dashoffset:5}90%,100%{stroke-dashoffset:-102}}
    @keyframes flD{0%{stroke-dashoffset:14}10%,100%{stroke-dashoffset:-102}}
    @keyframes flN{0%,8%{opacity:0}9%,22%{opacity:1}38%,100%{opacity:0}}
    @keyframes flG{0%,8.5%{opacity:0;transform:scale(1)}9%{opacity:1;transform:scale(1)}26%,100%{opacity:0;transform:scale(2.6)}}
    @media (prefers-reduced-motion:reduce){.lca-fl .p.bus{stroke-dashoffset:-50}.lca-fl .f1{transform:scaleY(.5)}.lca-fl .lb{transform:scaleX(.6)}.lca-fl .wv{opacity:.4}}.lca-fl:is([data-play=rest],[data-motion=off] *) .p.bus{stroke-dashoffset:-50}.lca-fl:is([data-play=rest],[data-motion=off] *) .f1{transform:scaleY(.5)}.lca-fl:is([data-play=rest],[data-motion=off] *) .lb{transform:scaleX(.6)}.lca-fl:is([data-play=rest],[data-motion=off] *) .wv{opacity:.4}
  </style>
  <defs>
    <path id={`${u}a`} d={pipes}></path>
    <g id={`${u}e`}><path style="fill:var(--i-f);stroke-width:1.25" d="M-7 0V-20Q-7-24-3-25V-30H3V-25Q7-24 7-20V0Z"></path><rect style="fill:var(--i-b);stroke:none" x="-3.5" y="-33.5" width="7" height="4.5" rx="1"></rect></g>
    <g id={`${u}f`}><use href={`#${u}e`}></use><rect style="fill:var(--i-w);stroke:none" x="-5.5" y="-19" width="11" height="17.5" rx="1"></rect></g>
    <g id={`${u}l`}><use href={`#${u}f`}></use><rect style="fill:var(--i-b2);stroke-width:1.25" x="-7" y="-17" width="14" height="10"></rect></g>
    <g id={`${u}c`} style="stroke-width:1.25"><path style="fill:var(--i-t)" d="M0 0 12-12H52L40 0Z"></path><path style="fill:var(--i-s)" d="M40 0 52-12V12L40 24Z"></path><rect style="fill:var(--i-m2)" width="40" height="24"></rect><path style="stroke:var(--i-ln);stroke-width:.75" d="M20 0V24"></path></g>
  </defs>

  <!-- shadows -->
  <path class="sh" d="M40 258H168L154 244H54ZM186 258H470L462 248H194ZM1000 258H1170L1158 246H1012Z"></path>

  <!-- A · control cabinet (closed, HMI on the door) -->
  <path class="t" d="M40 98 54 84H154L140 98Z"></path>
  <path class="s" d="M140 98 154 84V244L140 258Z"></path>
  <rect class="f" x="40" y="98" width="100" height="148"></rect>
  <rect class="s" x="40" y="246" width="100" height="12"></rect>
  <path class="d" d="M90 102V242"></path>
  <rect class="k d" x="50" y="112" width="32" height="24" rx="1"></rect>
  <path class="e tw" pathLength="100" d="M53 130L60 126L66 128L72 120L79 118" stroke-width="1.5"></path>
  <g class="d"><circle class="b" cx="56" cy="150" r="3"></circle><circle class="f" cx="66" cy="150" r="3"></circle><circle class="f" cx="76" cy="150" r="3"></circle><circle class="m" cx="66" cy="168" r="5"></circle><path d="M62.5 171.5l7-7"></path><rect class="m3" x="82" y="176" width="3" height="14" rx="1"></rect><rect class="m3" x="95" y="176" width="3" height="14" rx="1"></rect></g>
  <circle class="y n lamp" cx="76" cy="150" r="2.2"></circle>
  <path class="d l" d="M100 214h32M100 220h32M100 226h32M50 214h32M50 220h32M50 226h32"></path>
  <g class="d"><rect class="m3" x="104" y="88" width="12" height="4"></rect><rect class="m2" x="108.5" y="76" width="3" height="12"></rect></g>
  <rect class="b" x="103" y="66" width="14" height="10" rx="1"></rect>
  <rect class="f" x="103" y="56" width="14" height="10" rx="1"></rect>
  <rect class="y n lamp" x="104.5" y="57.5" width="11" height="7" rx=".5"></rect>

  <!-- B · process skid: silo, agitated tank, pump, PHE -->
  <path class="d" d="M196 196V258M236 196V258M264 200V258M304 200V258"></path>
  <path class="m" d="M192 112Q216 90 240 112V202L220 220H212L192 202Z"></path>
  <path class="n" d="M235.5 111V203" style="stroke:var(--i-m2);stroke-width:6"></path>
  <path class="d" d="M192 112H240M192 202H240"></path>
  <rect class="f d" x="198" y="122" width="6" height="72" rx="2"></rect>
  <rect class="w n lv" x="199.5" y="128" width="3" height="64" rx="1"></rect>
  <path class="m" d="M260 128H308V206L288 220H280L260 206Z"></path>
  <path class="n" d="M303.5 129V206" style="stroke:var(--i-m2);stroke-width:6"></path>
  <rect class="b2 d" x="268" y="140" width="28" height="56" rx="2"></rect>
  <rect class="w n" x="269" y="164" width="26" height="31" rx="1" opacity=".75"></rect>
  <path class="d" d="M284 128V190"></path>
  <rect class="ink n ag" x="274" y="186" width="20" height="4" rx="1"></rect>
  <rect class="m3 d" x="279" y="120" width="10" height="8"></rect>
  <rect class="b" x="276" y="102" width="16" height="18" rx="2"></rect>
  <use href={`#${u}a`} class="po"></use>
  <use href={`#${u}a`} class="pi"></use>
  <use href={`#${u}a`} class="pf"></use>
  <circle class="b" cx="354" cy="224" r="8"></circle>
  <path class="b" d="M331.6 234.4 347.6 218.4 359.7 229.7 343.7 245.7Z"></path>
  <circle class="m" cx="338" cy="240" r="9"></circle>
  <path class="d sp" d="M338 240v-5.5M338 240l4.8 2.8M338 240l-4.8 2.8" style="--t:.8s"></path>
  <rect class="s d" x="368" y="250" width="16" height="8"></rect>
  <path class="t" d="M372 140 388 124H396L380 140Z"></path>
  <path class="s" d="M380 140 396 124V234L380 250Z"></path>
  <rect class="m" x="372" y="140" width="8" height="110"></rect>
  <path class="t" d="M380 146 396 130H436L420 146Z"></path>
  <rect class="f" x="380" y="146" width="40" height="98"></rect>
  {plates.map((x, k) => <rect class:list={["n wv", k % 2 ? "w" : "y"]} x={x} y="146" width="4" height="98" style={`--k:${k}`}></rect>)}
  <path class="h" d={plates.slice(1).map((x) => `M${x} 146V244M${x} 146l16-16`).join("")}></path>
  <rect class="d" x="380" y="146" width="40" height="98"></rect>
  <path class="t" d="M420 140 436 124H444L428 140Z"></path>
  <path class="s" d="M428 140 444 124V234L428 250Z"></path>
  <rect class="m" x="420" y="140" width="8" height="110"></rect>
  <rect class="m3 d" x="436" y="128" width="22" height="5"></rect>
  <rect class="m3 d" x="436" y="236" width="22" height="4"></rect>
  <rect class="m d" x="458" y="120" width="7" height="138"></rect>
  <circle class="m3 d" cx="376" cy="156" r="3.5"></circle>
  <circle class="m3 d" cx="376" cy="200" r="3.5"></circle>

  <!-- C · filler (posts behind the conveyor) -->
  <rect class="m d" x="526" y="100" width="6" height="158"></rect>
  <rect class="m d" x="608" y="100" width="6" height="158"></rect>
  <path class="t" d="M536 96 546 86H614L604 96Z"></path>
  <path class="s" d="M604 96 614 86V114L604 124Z"></path>
  <rect class="m" x="536" y="96" width="68" height="28"></rect>
  <path class="n" d="M599 97V123" style="stroke:var(--i-m2);stroke-width:8"></path>
  <rect x="536" y="96" width="68" height="28"></rect>
  <rect class="m3 d" x="540" y="124" width="60" height="8"></rect>
  <g class="d">{[546, 562, 578, 594].map((x) => <><rect class="m" x={x - 3.5} y="132" width="7" height="18" rx="1"></rect><rect class="m3" x={x - 1.5} y="150" width="3" height="22"></rect></>)}</g>
  <path class="fw" d="M546 174V186M562 174V186M578 174V186M594 174V186" style="stroke:var(--i-w);stroke-width:1.5;--t:.5s"></path>
  <rect class="f d" x="616" y="122" width="26" height="30" rx="2"></rect>
  <rect class="k n" x="620" y="126" width="18" height="13" rx="1"></rect>
  <path class="h q" d="M622 135l4-3 4 2 5-5"></path>
  <g class="d"><circle class="b" cx="623" cy="145" r="2"></circle><circle class="f" cx="629" cy="145" r="2"></circle><circle class="f" cx="635" cy="145" r="2"></circle></g>

  <!-- D · labeler -->
  <rect class="m d" x="760" y="196" width="6" height="62"></rect>
  <rect class="m d" x="700" y="122" width="72" height="76" rx="3"></rect>
  <path class="n" d="M766 124V196" style="stroke:var(--i-m2);stroke-width:8"></path>
  <path class="h l" d="M716 161L724 180M727 183L733 197L752 159"></path>
  <g class="sp" style="--t:3s"><circle class="f" cx="716" cy="146" r="15"></circle><circle class="b2 d" cx="716" cy="146" r="10"></circle><path class="d" d="M716 141v10M711 146h10"></path></g>
  <g class="sp" style="--t:2s;animation-direction:reverse"><circle class="m2" cx="752" cy="150" r="9"></circle><path class="d" d="M752 145v10M747 150h10"></path></g>
  <circle class="m3 d" cx="725" cy="182" r="3"></circle>
  <path class="ink n" d="M728 194H740L734 201Z"></path>

  <!-- E · vision check -->
  <rect class="m d" x="870" y="140" width="5" height="118"></rect>
  <rect class="m3 d" x="856" y="140" width="19" height="5"></rect>
  <rect class="b d" x="848" y="145" width="20" height="16" rx="2"></rect>
  <rect class="k d" x="854" y="161" width="8" height="4"></rect>
  <path class="y n beam" d="M856 166H860L868 186H848Z" opacity=".85"></path>

  <!-- conveyor -->
  <path class="t d" d="M470 222 478 214H1008L1000 222Z"></path>
  <g class="d">{[490, 640, 790, 940, 990].map((x) => <rect class="m3" x={x} y="234" width="5" height="24"></rect>)}</g>
  <rect class="m d" x="470" y="222" width="530" height="12"></rect>
  <path class="slat bt" d="M472 228H998"></path>

  <!-- bottles (one group slides one pitch per cycle and resets) -->
  <g transform="translate(0 219)">
    <g class="bel">
      <g class="in"><use href={`#${u}e`} x={X(0)}></use></g>
      <use href={`#${u}e`} x={X(1)}></use>
      <use href={`#${u}e`} x={X(2)}></use>
      <rect class="w n f1" x={X(2) - 5.5} y="-19" width="11" height="17.5" rx="1"></rect>
      <use href={`#${u}e`} x={X(3)}></use>
      <rect class="w n f2" x={X(3) - 5.5} y="-19" width="11" height="17.5" rx="1"></rect>
      {filled.map((x) => <use href={`#${u}f`} x={x}></use>)}
      <use href={`#${u}f`} x={X(8)}></use>
      <rect class="b2 d lb" x={X(8) - 7} y="-17" width="14" height="10"></rect>
      {labelled.map((x) => <use href={`#${u}l`} x={x}></use>)}
      <g class="out"><use href={`#${u}l`} x={X(16)}></use></g>
    </g>
  </g>
  <path class="d l" d="M470 204H1000"></path>

  <!-- F · case packing + pallet -->
  <g transform="translate(1004 216)"><use href={`#${u}c`}></use></g>
  <path class="d" d="M1004 216l-8-10M1044 216l6-12"></path>
  <rect class="m3 d" x="1000" y="240" width="56" height="5"></rect>
  <rect class="m3 d" x="1004" y="245" width="4" height="13"></rect>
  <rect class="m3 d" x="1046" y="245" width="4" height="13"></rect>
  <path class="t d" d="M1064 248 1076 236H1162L1150 248Z"></path>
  <rect class="m3 d" x="1064" y="248" width="86" height="10"></rect>
  <g transform="translate(1066 222)"><use href={`#${u}c`}></use></g>
  <g transform="translate(1106 222)"><use href={`#${u}c`}></use></g>
  <g transform="translate(1066 198)"><use href={`#${u}c`}></use></g>
  <g transform="translate(1106 198)"><use href={`#${u}c`}></use></g>

  <!-- control-network bus with drops to every machine -->
  <path class="tr" d={`M110 91V34H1150${drops.map(([x, ry]) => dropPath(x, ry)).join("")}`}></path>
  <circle class="rn" cx="1156" cy="34" r="6"></circle>
  {drops.map(([x, ry]) => <circle class="rn" cx={x + 10} cy={ry} r="5"></circle>)}
  <path class="p bus" pathLength="100" d="M110 91V34H1150"></path>
  {drops.map(([x, ry, d]) => <path class="p dr" pathLength="100" d={dropPath(x, ry)} style={`--d:${d}s`}></path>)}
  {drops.map(([x, ry, d]) => <circle class="nd dr" cx={x + 10} cy={ry} r="2.5" style={`--d:${d}s`}></circle>)}
  {drops.map(([x, ry, d]) => <circle class="pg dr" cx={x + 10} cy={ry} r="5" style={`--d:${d}s`}></circle>)}
</Frame>
  )
}
