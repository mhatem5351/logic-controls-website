---
/* packaging-labeling — wrap-around labeler: head plate with label supply reel, idler, peel blade,
   driven nip roller and liner rewind reel; capped bottles on a flat-belt conveyor; cap photo-eye;
   HMI on an arm and the stepper drive.
   Loop 4.2 s, bottles move continuously one pitch per loop (seamless): photo-eye sees a cap → pulse to
   the HMI → pulse to the stepper → web indexes one label length (reels turn) while the label peels
   off the blade onto the passing bottle, its edge pinned at the blade tip. */
import Frame from "../ArtFrame.astro";
import { uid, type ArtProps } from "../types";
const p = Astro.props as ArtProps;
const u = uid("lb");
const c0 = 211.8; // centre of the bottle being labelled at t = 0
const xs = (from: number, to: number) => Array.from({ length: to - from + 1 }, (_, i) => +(c0 + 52 * (from + i)).toFixed(1));
const bare = xs(-5, -1);
const done = xs(1, 4);
const body = "M-9 206Q-12 206 -12 203V174Q-12 166 -5 164V159H5V164Q12 166 12 174V203Q12 206 9 206Z";
const web = "M252 56H158A5 5 0 0 0 153.6 63.4L196 168L228 178";
const liner = "M228 181L186 173L161 125";
const spokes = (r0: number, r1: number) => [0, 120, 240].map((a) => {
  const c = Math.cos((a * Math.PI) / 180), s = Math.sin((a * Math.PI) / 180);
  return `M${(c * r0).toFixed(1)} ${(s * r0).toFixed(1)}L${(c * r1).toFixed(1)} ${(s * r1).toFixed(1)}`;
}).join("");
const tIn = "M95 106V20L103 12H332L340 20V54";
const tOut = "M340 100V119L328 131H290";
---

<Frame {...p} uid={u} name="lb">
  <style is:inline>
    .lca-lb .mv{animation:lbM 4.2s linear infinite}
    .lca-lb .belt{stroke:var(--i-ink);stroke-width:4;stroke-dasharray:1.5 11.5;animation:lbB 4.2s linear infinite}
    .lca-lb .lab{transform-box:fill-box;transform-origin:100% 50%;animation:lbL 4.2s linear infinite}
    .lca-lb .wb{stroke:var(--i-b);stroke-width:3.5;stroke-dasharray:22 2;stroke-linecap:butt;animation:lbW 4.2s linear infinite}
    .lca-lb .r1{animation:lbR 4.2s linear infinite}
    .lca-lb .bm{animation:lbE 4.2s step-end infinite}
    .lca-lb .ds{animation:lbD 4.2s step-end infinite}
    .lca-lb .p.i1{animation:lbPi 4.2s linear infinite}
    .lca-lb .p.o1{animation:lbPo 4.2s linear infinite}
    .lca-lb .pg.o1,.lca-lb .nd.o1{animation:lbPn 4.2s ease-out infinite}
    @keyframes lbM{to{transform:translateX(52px)}}
    @keyframes lbB{to{stroke-dashoffset:-52}}
    @keyframes lbL{0%,10%{transform:scaleX(0)}56.2%,100%{transform:scaleX(1)}}
    @keyframes lbW{0%,10%{stroke-dashoffset:var(--w0)}56.2%,100%{stroke-dashoffset:calc(var(--w0) - 24)}}
    @keyframes lbR{0%,10%{transform:rotate(0)}56.2%,100%{transform:rotate(-120deg)}}
    @keyframes lbE{0%{opacity:0}64.8%{opacity:1}87.9%,100%{opacity:0}}
    @keyframes lbD{0%{opacity:0}10%{opacity:1}56.2%,100%{opacity:0}}
    @keyframes lbPi{0%,66%{stroke-dashoffset:14}82%,100%{stroke-dashoffset:-102}}
    @keyframes lbPo{0%{stroke-dashoffset:14}9%,100%{stroke-dashoffset:-102}}
    @keyframes lbPn{0%,8%{opacity:0;transform:scale(1)}8.5%{opacity:1;transform:scale(1)}24%,100%{opacity:0;transform:scale(2.4)}}
    @media (prefers-reduced-motion:reduce){.lca-lb .lab{transform:scaleX(.6)}}
  </style>
  <defs>
    <path id={`${u}b`} d={body} style="fill:var(--i-f);stroke-width:1.25"></path>
    <g id={`${u}c`}>
      <rect x="-6" y="150" width="12" height="9" rx="1.5" style="fill:var(--i-m3);stroke-width:1.25"></rect>
      <path d="M-3 152V157M0 152V157M3 152V157" style="stroke-width:.75"></path>
    </g>
    <g id={`${u}l`}>
      <rect x="-11.4" y="177" width="22.8" height="21" style="fill:var(--i-b);stroke:none"></rect>
      <path d="M-7 184H7M-7 189H4" style="stroke:var(--i-b2);stroke-width:1.25"></path>
    </g>
    <linearGradient id={`${u}g`}>
      <stop offset=".05" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset=".12" stop-color="#fff"></stop>
      <stop offset=".86" stop-color="#fff"></stop>
      <stop offset=".93" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <mask id={`${u}k`} maskUnits="userSpaceOnUse" x="0" y="0" width="400" height="300">
      <rect width="400" height="300" fill={`url(#${u}g)`}></rect>
    </mask>
  </defs>

  <path class="sh" d="M14 258H380L372 250H22Z"></path>

  <!-- head plate + column (behind the conveyor) -->
  <rect class="m3 d" x="196" y="172" width="10" height="40"></rect>
  <path class="t" d="M108 30 118 20H302L292 30Z"></path>
  <path class="s" d="M292 30 302 20V162L292 172Z"></path>
  <rect class="m" x="108" y="30" width="184" height="142"></rect>
  <path d="M114 36H286M114 166H286" style="stroke:var(--i-ink);stroke-width:2;stroke-dasharray:0 171.9"></path>

  <!-- supply reel (labels on liner) -->
  <circle class="f d" cx="252" cy="83" r="34"></circle>
  <circle class="b2 d" cx="252" cy="83" r="27"></circle>
  <g transform="translate(252 83)"><g class="r1"><path class="l" d={spokes(10, 25)} stroke-width="1.5"></path><circle class="m d" r="10"></circle></g></g>
  <circle class="ink n" cx="252" cy="83" r="2.3"></circle>

  <!-- rewind reel (spent liner) -->
  <circle class="f d" cx="146" cy="118" r="24"></circle>
  <circle class="m2 d" cx="146" cy="118" r="15"></circle>
  <g transform="translate(146 118)"><g class="r1"><path class="l" d={spokes(6, 14)} stroke-width="1.5"></path><circle class="m d" r="6"></circle></g></g>

  <!-- web: liner path, labels riding on it, return liner; idler, nip roller, peel blade -->
  <path class="l d" d={web}></path>
  <path class="wb" d={web} style="--w0:11.24"></path>
  <path class="l d" d={liner}></path>
  <circle class="m3 d" cx="158" cy="61" r="5"></circle>
  <circle class="b d" cx="186" cy="168" r="5"></circle>
  <path class="m3 d" d="M194 168 229 178.5 229 181.5 194 175Z"></path>

  <!-- stepper drive -->
  <rect class="b d" x="252" y="121" width="30" height="20" rx="2"></rect>
  <circle class="f d" cx="264" cy="131" r="6"></circle>
  <circle class="y n ds" cx="276.5" cy="126" r="1.6"></circle>

  <!-- cap photo-eye on a bracket -->
  <path class="d" d="M102 121H108"></path>
  <rect class="f d" x="89" y="113" width="13" height="13" rx="2"></rect>
  <circle class="y n bm" cx="95.5" cy="119.5" r="1.8"></circle>

  <!-- conveyor (ends inside the frame) + bottles (fade in/out at the conveyor ends) -->
  <path class="m2" d="M18 212 30 200H380L368 212Z"></path>
  <g mask={`url(#${u}k)`}>
    <g class="mv">
      {bare.map((x) => <><use href={`#${u}b`} x={x}></use><use href={`#${u}c`} x={x}></use></>)}
      <use href={`#${u}b`} x={c0}></use><use href={`#${u}c`} x={c0}></use>
      <g class="lab"><use href={`#${u}l`} x={c0}></use></g>
      {done.map((x) => <><use href={`#${u}b`} x={x}></use><use href={`#${u}c`} x={x}></use><use href={`#${u}l`} x={x}></use></>)}
    </g>
  </g>
  <rect class="m3 d" x="18" y="212" width="350" height="5"></rect>
  <path class="belt bt" d="M24 214.5H362"></path>
  <rect class="m" x="14" y="217" width="358" height="11" rx="5.5"></rect>
  <circle class="m3 d" cx="20" cy="222.5" r="3"></circle>
  <circle class="m3 d" cx="366" cy="222.5" r="3"></circle>
  <path class="e bm" d="M95.5 126V149" stroke-width="1.5"></path>
  <g class="d m3">
    <rect x="44" y="228" width="8" height="30"></rect>
    <rect x="334" y="228" width="8" height="30"></rect>
  </g>

  <!-- HMI on an arm -->
  <rect class="m3 d" x="302" y="76" width="12" height="5"></rect>
  <path class="t" d="M314 58 322 50H380L372 58Z"></path>
  <path class="s" d="M372 58 380 50V92L372 100Z"></path>
  <rect class="f" x="314" y="58" width="58" height="42" rx="2"></rect>
  <rect class="k d" x="319" y="63" width="48" height="31" rx="1"></rect>
  <rect class="n" x="319" y="63" width="48" height="5" style="fill:var(--i-kl);opacity:.16"></rect>
  <path class="h q" d="M323 74h16M323 79h12M323 84h16M345 74h18" opacity=".7"></path>
  <circle class="y n ds" cx="356" cy="84" r="2"></circle>
  <circle class="y n bm" cx="348" cy="84" r="2"></circle>

  <!-- brand traces: photo-eye → HMI (input), HMI → stepper (output) -->
  <path class="tr" d={`${tIn}${tOut}`}></path>
  <circle class="rn" cx="95" cy="102" r="4"></circle>
  <circle class="rn" cx="286" cy="131" r="4"></circle>
  <path class="p i1" pathLength="100" d={tIn}></path>
  <path class="p o1" pathLength="100" d={tOut}></path>
  <circle class="nd o1" cx="286" cy="131" r="2"></circle>
  <circle class="pg o1" cx="286" cy="131" r="4"></circle>
</Frame>
