---
/* cosmetics-personal-care — 4-head shampoo filler (after the client's machine): stainless hopper,
   dosing block with pneumatic cylinders and nozzles, slat conveyor with guide rails, photo-eye,
   stainless HMI box with push-buttons.
   Loop 5.2 s: bottle-in-place pulse → HMI → valve pulse → nozzles dive into the necks → streams,
   levels rise (hopper level dips) → nozzles lift → conveyor indexes four pitches (seamless). */
import Frame from "../ArtFrame.astro";
import { uid, type ArtProps } from "../types";
const p = Astro.props as ArtProps;
const u = uid("cs");
const P = (j: number) => 136 + 26 * j;
const before = Array.from({ length: 10 }, (_, i) => P(i - 10));
const station = [0, 1, 2, 3].map(P);
const after = Array.from({ length: 7 }, (_, i) => P(i + 4));
const bottle = "M-6 207Q-10 207 -10 203Q-11 190 -9.5 178Q-9 168 -3.5 165V158H3.5V165Q9 168 9.5 178Q11 190 10 203Q10 207 6 207Z";
const tIn = "M97 183V30L105 22H322L330 30V88";
const tOut = "M280 106H255";
---

<Frame {...p} uid={u} name="cs">
  <style is:inline>
    .lca-cs .run{animation:csR 5.2s cubic-bezier(.65,0,.35,1) infinite}
    .lca-cs .belt{stroke:var(--i-ink);stroke-width:6;stroke-dasharray:1 7;animation:csB 5.2s cubic-bezier(.65,0,.35,1) infinite}
    .lca-cs .nz{animation:csN 5.2s cubic-bezier(.65,0,.35,1) infinite}
    .lca-cs .st{animation:csS 5.2s step-end infinite}
    .lca-cs .lv{transform-box:fill-box;transform-origin:50% 100%;animation:csL 5.2s ease-out infinite}
    .lca-cs .hl{transform-box:fill-box;transform-origin:50% 100%;animation:csH 5.2s ease-in-out infinite}
    .lca-cs .hb{transform-box:fill-box;transform-origin:50% 100%;animation:csM 5.2s ease-out infinite}
    .lca-cs .bm{animation:csE 5.2s step-end infinite}
    .lca-cs .vl{animation:csV 5.2s step-end infinite}
    .lca-cs .p.i1{animation:csPi 5.2s linear infinite}
    .lca-cs .p.o1{animation:csPo 5.2s linear infinite}
    .lca-cs .pg.o1,.lca-cs .nd.o1{animation:csPn 5.2s ease-out infinite}
    @keyframes csR{0%,70%{transform:none}96%,100%{transform:translateX(104px)}}
    @keyframes csB{0%,70%{stroke-dashoffset:0}96%,100%{stroke-dashoffset:-104}}
    @keyframes csN{0%,14%{transform:none}24%,58%{transform:translateY(14px)}68%,100%{transform:none}}
    @keyframes csS{0%{opacity:0}25%{opacity:1}57%,100%{opacity:0}}
    @keyframes csL{0%,25%{transform:scaleY(0)}56%,100%{transform:scaleY(1)}}
    @keyframes csH{0%,25%{transform:scaleY(1)}56%{transform:scaleY(.82)}70%{transform:scaleY(.82)}96%,100%{transform:scaleY(1)}}
    @keyframes csM{0%,25%{transform:scaleY(0)}56%,70%{transform:scaleY(1)}80%,100%{transform:scaleY(0)}}
    @keyframes csE{0%{opacity:1}70%{opacity:0}96%,100%{opacity:1}}
    @keyframes csV{0%{opacity:0}13%{opacity:1}58%,100%{opacity:0}}
    @keyframes csPi{0%{stroke-dashoffset:14}9%,100%{stroke-dashoffset:-102}}
    @keyframes csPo{0%,8%{stroke-dashoffset:14}14%,100%{stroke-dashoffset:-102}}
    @keyframes csPn{0%,12.5%{opacity:0;transform:scale(1)}13%{opacity:1;transform:scale(1)}26%,100%{opacity:0;transform:scale(2.4)}}
    @media (prefers-reduced-motion:reduce){.lca-cs .nz{transform:translateY(14px)}.lca-cs .lv{transform:scaleY(.55)}}
  </style>
  <defs>
    <path id={`${u}b`} d={bottle} style="fill:var(--i-b2);stroke-width:1.25"></path>
    <g id={`${u}f`}>
      <use href={`#${u}b`}></use>
      <rect x="-8" y="175" width="16" height="31" rx="3" style="fill:var(--i-w);stroke:none"></rect>
    </g>
    <linearGradient id={`${u}g`}>
      <stop offset=".05" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset=".11" stop-color="#fff"></stop>
      <stop offset=".89" stop-color="#fff"></stop>
      <stop offset=".95" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <mask id={`${u}k`} maskUnits="userSpaceOnUse" x="0" y="0" width="400" height="300">
      <rect width="400" height="300" fill={`url(#${u}g)`}></rect>
    </mask>
  </defs>

  <!-- shadow + frame posts (behind) -->
  <path class="sh" d="M14 258H380L372 250H22Z"></path>
  <g class="d">
    <rect class="m2" x="84" y="34" width="6" height="190"></rect>
    <rect class="m2" x="262" y="34" width="6" height="190"></rect>
  </g>

  <!-- hopper -->
  <path class="t" d="M110 40 122 28H258L246 40Z"></path>
  <path class="s" d="M246 40 258 28V66L246 78Z"></path>
  <path class="m" d="M110 40H246V78L234 90H122L110 78Z"></path>
  <path class="d" d="M110 78H246"></path>
  <path class="d l" d="M150 34H218"></path>
  <rect class="f d" x="120" y="48" width="6" height="26" rx="2"></rect>
  <rect class="w n hl" x="121.5" y="54" width="3" height="19" rx="1"></rect>
  <circle class="m3 d" cx="252" cy="58" r="3.5"></circle>
  <path class="d" d="M254 56l6-6" style="stroke:var(--i-b);stroke-width:2.5"></path>

  <!-- dosing block, valve terminal, cylinders -->
  <rect class="m3 d" x="124" y="90" width="104" height="9"></rect>
  <rect class="b d" x="228" y="92" width="18" height="12" rx="1"></rect>
  <path d="M232 98H244" style="stroke:var(--i-b2);stroke-width:2.2;stroke-dasharray:0 4"></path>
  <path class="vl" d="M232 98H244" style="stroke:var(--i-sig);stroke-width:2.2;stroke-dasharray:0 4"></path>
  <!-- nozzles (move; rods slide out of the cylinders) -->
  <g class="nz d">
    {station.map((x) => (
      <>
        <rect class="m3" x={x - 1.2} y="104" width="2.4" height="28"></rect>
        <rect class="m" x={x - 3} y="132" width="6" height="12" rx="1"></rect>
        <rect class="m3" x={x - 1.5} y="144" width="3" height="6"></rect>
      </>
    ))}
  </g>
  <g class="d">{station.map((x) => <rect class="m" x={x - 5} y="99" width="10" height="23" rx="1.5"></rect>)}</g>

  <!-- conveyor (ends inside the frame) + bottles (fade in/out at the conveyor ends) -->
  <rect class="m3 d" x="26" y="176" width="350" height="3"></rect>
  <path class="m2" d="M18 214 32 200H380L366 214Z"></path>
  <g mask={`url(#${u}k)`}>
    <g class="run">
      {before.map((x) => <use href={`#${u}b`} x={x}></use>)}
      {station.map((x) => <use href={`#${u}b`} x={x}></use>)}
      {station.map((x) => <rect class="w n lv" x={x - 8} y="175" width="16" height="31" rx="3"></rect>)}
      {after.map((x) => <use href={`#${u}f`} x={x}></use>)}
    </g>
  </g>
  <g class="st w n">{station.map((x) => <rect x={x - 1} y="164" width="2" height="40"></rect>)}</g>
  <rect class="m3" x="18" y="214" width="348" height="6"></rect>
  <path class="belt bt" d="M24 217H360"></path>
  <rect class="m" x="14" y="220" width="356" height="12" rx="6"></rect>
  <circle class="m3 d" cx="20" cy="226" r="3.5"></circle>
  <circle class="m3 d" cx="364" cy="226" r="3.5"></circle>
  <rect class="m3 d" x="22" y="188" width="346" height="3.5"></rect>
  <g class="d m3">
    <rect x="56" y="191" width="4" height="23"></rect>
    <rect x="306" y="191" width="4" height="23"></rect>
    <rect x="36" y="232" width="8" height="26"></rect>
    <rect x="190" y="232" width="8" height="26"></rect>
    <rect x="300" y="232" width="8" height="26"></rect>
  </g>
  <rect class="m d" x="334" y="232" width="14" height="16" rx="1.5"></rect>
  <rect class="b d" x="348" y="234" width="26" height="12" rx="3"></rect>
  <path class="h" d="M354 234V246M359 234V246M364 234V246" style="stroke:var(--i-kl)"></path>

  <!-- photo-eye on the guide rail, beam across the belt (45° = depth) -->
  <rect class="b2 d" x="111" y="173" width="5" height="6"></rect>
  <path class="e bm" d="M102 188 112 178" stroke-width="1.5"></path>
  <rect class="m d" x="92" y="183" width="10" height="10" rx="1.5"></rect>
  <circle class="y n bm" cx="97" cy="188" r="1.6"></circle>

  <!-- HMI box (stainless) on an arm -->
  <rect class="m3 d" x="268" y="116" width="12" height="5"></rect>
  <path class="t" d="M280 92 288 84H334L326 92Z"></path>
  <path class="s" d="M326 92 334 84V140L326 148Z"></path>
  <rect class="m" x="280" y="92" width="46" height="56" rx="1.5"></rect>
  <rect class="k d" x="285" y="98" width="36" height="25" rx="1"></rect>
  <rect class="n" x="285" y="98" width="36" height="5" style="fill:var(--i-kl);opacity:.16"></rect>
  <g class="w n">{[0, 1, 2, 3].map((i) => <rect class="hb" x={290 + i * 7.5} y="106" width="4" height="13"></rect>)}</g>
  <circle class="f d" cx="288" cy="136" r="3"></circle>
  <circle class="f d" cx="298" cy="136" r="3"></circle>
  <circle class="y d" cx="308" cy="136" r="3"></circle>
  <circle class="b d" cx="318" cy="136" r="3"></circle>

  <!-- brand traces: photo-eye → HMI (input), HMI → valve terminal (output) -->
  <path class="tr" d={`${tIn}${tOut}`}></path>
  <circle class="rn" cx="251" cy="106" r="4"></circle>
  <path class="p i1" pathLength="100" d={tIn}></path>
  <path class="p o1" pathLength="100" d={tOut}></path>
  <circle class="nd o1" cx="251" cy="106" r="2"></circle>
  <circle class="pg o1" cx="251" cy="106" r="4"></circle>
</Frame>
