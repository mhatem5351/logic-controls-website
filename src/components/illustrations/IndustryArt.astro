---
/**
 * Animated illustration for an industry.
 *   <IndustryArt slug="food-beverage" />                      decorative (aria-hidden), light palette
 *   <IndustryArt slug="pharmaceutical" variant="dark" />      on a navy band (or omit: auto inside .on-dark)
 *   <IndustryArt slug="commercial-laundry" label="…" size="20rem" />
 * 4:3, width 100% of its container unless `size` is set. See STYLE.md.
 */
import type { IndustrySlug } from "~/data/industries";
import type { ArtProps } from "./types";
import LazyArt from "./LazyArt.astro";
import FoodBeverage from "./industries/FoodBeverage.astro";
import Pharmaceutical from "./industries/Pharmaceutical.astro";
import CosmeticsPersonalCare from "./industries/CosmeticsPersonalCare.astro";
import PackagingLabeling from "./industries/PackagingLabeling.astro";
import BuildingMaterials from "./industries/BuildingMaterials.astro";
import CommercialLaundry from "./industries/CommercialLaundry.astro";
import TestEquipment from "./industries/TestEquipment.astro";

interface Props extends ArtProps {
  slug: IndustrySlug;
  /**
   * Render an empty, correctly sized slot that loads the art from the shared, cached fragment when it nears the
   * viewport (LazyArt.astro). Default: true for decorative art (no `label`) — card grids; false for labelled art.
   * Pass false where the art is part of the first screen (detail heroes, HeroArt).
   */
  lazy?: boolean;
}

const ART = {
  "food-beverage": FoodBeverage,
  pharmaceutical: Pharmaceutical,
  "cosmetics-personal-care": CosmeticsPersonalCare,
  "packaging-labeling": PackagingLabeling,
  "building-materials": BuildingMaterials,
  "commercial-laundry": CommercialLaundry,
  "test-equipment": TestEquipment,
} satisfies Record<IndustrySlug, unknown>;

const { slug, lazy = !Astro.props.label, ...rest } = Astro.props;
const Art = ART[slug];
---

{lazy ? <LazyArt src={`industries/${slug}`} {...rest} /> : Art && <Art {...rest} />}
