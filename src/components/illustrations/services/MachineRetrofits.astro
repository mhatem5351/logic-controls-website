---
/* machine-retrofits — one machine cabinet on a stand, next to the machine it controls (servo + belt +
   print drum). Loop 9.6 s: LEGACY interior (octal relays, cam timers, fuses, cam drum, tangled wiring,
   all grey, no life) → an amber scan bar sweeps left→right swapping it column by column for a MODERN
   layout (PLC, I/O, slim relays, servo drive, slotted ducts, live LEDs) → pulses run to the servo,
   encoder disc + drum turn → quick dissolve back to legacy. */
import Frame from "../ArtFrame.astro";
import { uid, type ArtProps } from "../types";
const p = Astro.props as ArtProps;
const u = uid("rf");
const cols = [[50, 94], [94, 139], [139, 183], [183, 228]];
const oct = [62, 86, 110, 134];
const tangle = [
  "M57 114c-6 14 18 8 10 24s-14 30 4 46M80 116c12 10-18 22-6 36s16 16 2 32M66 112c14 28-20 40-6 72",
  "M104 114c8 18-14 22-2 40s14 10 2 30M126 114c-14 14 12 26-2 44s-12 12 0 26M140 116c-22 20 6 46-26 68",
  "M150 116c18 4-6 24 12 30s-2 18 4 38M172 114c-10 22 14 18 2 36s10 14-4 34",
  "M196 116c14 14-12 22 4 34s16 20-4 34M216 114c-14 18 16 22 0 40s-6 18 6 30",
];
const io = [0, 1, 2, 3, 4, 5];
const wire = "M248 190H254L284 160H287.5";
---

<Frame {...p} uid={u} name="rf">
  <style is:inline>
    .lca-rf .lg{stroke:var(--i-tr)}
    .lca-rf .o,.lca-rf .i{animation:rfO 9.6s calc(var(--k) * .36s - 9.6s) linear infinite}
    .lca-rf .i{animation-name:rfI}
    .lca-rf .scan{animation:rfS 9.6s linear infinite}
    .lca-rf .lt{animation:rfL 2.4s calc(var(--s) - 2.4s) step-end infinite}
    .lca-rf .run{animation:rfB 1.2s step-end infinite}
    .lca-rf .vb{transform-box:fill-box;transform-origin:0 50%;animation:rfV 2.4s cubic-bezier(.65,0,.35,1) infinite}
    .lca-rf .enc{stroke:var(--i-b);stroke-width:3;stroke-dasharray:2.2 2.6;transform-box:fill-box;transform-origin:center;animation:rfE 9.6s cubic-bezier(.45,0,.55,1) infinite}
    .lca-rf .drum{transform-box:fill-box;transform-origin:center;animation:rfD 9.6s cubic-bezier(.45,0,.55,1) infinite}
    .lca-rf .belt{stroke-dasharray:2 2;animation:rfBt 9.6s cubic-bezier(.45,0,.55,1) infinite}
    .lca-rf .sl{stroke:var(--i-m);stroke-width:2;stroke-dasharray:1.2 3}
    .lca-rf .ot{stroke:var(--i-m2);stroke-width:16;stroke-dasharray:8 3}
    .lca-rf .tb{stroke:var(--i-m3);stroke-width:20;stroke-dasharray:4 1}
    .lca-rf .wr{stroke:var(--i-ln);stroke-width:4;stroke-dasharray:.9 4.1}
    .lca-rf .sc{stroke-dasharray:0 5;stroke-width:1.8}
    .lca-rf .sr{stroke:var(--i-b2);stroke-width:26;stroke-dasharray:5.5 1.2}
    .lca-rf .tk{stroke-dasharray:1 2.9}
    @keyframes rfO{0%,26%{opacity:1}27.5%,80%{opacity:0}86%,100%{opacity:1}}
    @keyframes rfI{0%,26%{opacity:0}27.5%,80%{opacity:1}86%,100%{opacity:0}}
    @keyframes rfS{0%,24.5%{transform:none;opacity:0}25%{transform:none;opacity:1}40%{transform:translateX(178px);opacity:1}41%,100%{transform:translateX(178px);opacity:0}}
    @keyframes rfL{0%,45%{opacity:1}46%,100%{opacity:0}}
    @keyframes rfB{0%,50%{opacity:1}51%,100%{opacity:.15}}
    @keyframes rfV{0%,100%{transform:scaleX(.3)}50%{transform:scaleX(1)}}
    @keyframes rfE{0%,40%{transform:none}85%,100%{transform:rotate(3turn)}}
    @keyframes rfD{0%,40%{transform:none}85%,100%{transform:rotate(1turn)}}
    @keyframes rfBt{0%,40%{stroke-dashoffset:0}85%,100%{stroke-dashoffset:-96}}
    @media (prefers-reduced-motion:reduce){.lca-rf .lt{opacity:1}}.lca-rf:is([data-play=rest],[data-motion=off] *) .lt{opacity:1}
  </style>

  <!-- shadows -->
  <path class="sh" d="M44 258H236L244 250H52ZM266 258H376L384 250H274Z"></path>

  <!-- cabinet on a stand -->
  <g class="d">
    <path class="s" d="M52 220 56 216V254L52 258ZM230 220 234 216V254L230 258Z"></path>
    <rect class="m3" x="52" y="238" width="170" height="5"></rect>
    <rect class="m" x="44" y="220" width="8" height="38"></rect>
    <rect class="m" x="222" y="220" width="8" height="38"></rect>
  </g>
  <path class="t" d="M34 72 48 58H252L238 72Z"></path>
  <path class="s" d="M238 72 252 58V206L238 220Z"></path>
  <rect class="f" x="34" y="72" width="204" height="148"></rect>
  <path class="s d" d="M40 78H46V208H232V214H40Z"></path>
  <rect class="m d" x="46" y="78" width="186" height="130"></rect>
  <path class="d" d="M40 214 46 208"></path>
  <circle class="m3 d" cx="245" cy="190" r="3"></circle>

  <!-- LEGACY interior, one group per scan column -->
  <g class="lg o rmh" style="--k:0">
    <g class="d">
      {oct.slice(0, 2).map((x) => <><rect class="m3" x={x - 11} y="91" width="22" height="22"></rect><circle class="m2" cx={x} cy="102" r="9"></circle></>)}
      <rect class="m2" x="52" y="128" width="40" height="38"></rect>
      <rect class="m3" x="62" y="140" width="20" height="14"></rect>
    </g>
    <path d="M57 133H89M57 161H89" style="stroke-dasharray:0 6.4"></path>
    <path class="ot bt" d="M52 192H94"></path>
    <path class="d" d={tangle[0]}></path>
  </g>
  <g class="lg o rmh" style="--k:1">
    <g class="d">
      {oct.slice(2).map((x) => <><rect class="m3" x={x - 11} y="91" width="22" height="22"></rect><circle class="m2" cx={x} cy="102" r="9"></circle></>)}
      {[101, 110, 119, 128].map((x) => <rect class="m2" x={x} y="131" width="7" height="30"></rect>)}
    </g>
    <path class="ot bt" d="M97 192H139"></path>
    <path class="d" d={tangle[1]}></path>
  </g>
  <g class="lg o rmh" style="--k:2">
    <g class="d">
      <rect class="m2" x="147" y="88" width="28" height="28"></rect>
      <circle class="f" cx="161" cy="102" r="10"></circle>
      <path d="M161 102l5-5"></path>
    </g>
    <circle class="h tk" cx="161" cy="102" r="7.5"></circle>
    <path class="ot bt" d="M142 192H183"></path>
    <path class="d" d={tangle[2]}></path>
  </g>
  <g class="lg o rmh" style="--k:3">
    <g class="d">
      <rect class="m2" x="192" y="88" width="28" height="28"></rect>
      <circle class="f" cx="206" cy="102" r="10"></circle>
      <path d="M206 102l-6-3"></path>
      <rect class="m2" x="148" y="128" width="76" height="38"></rect>
    </g>
    <circle class="h tk" cx="206" cy="102" r="7.5"></circle>
    <path d="M158 147H215" style="stroke:var(--i-m3);stroke-width:12;stroke-dasharray:0 11.4"></path>
    <path class="ot bt" d="M186 192H228"></path>
    <path class="d" d={tangle[3]}></path>
  </g>

  <!-- MODERN interior, same columns -->
  {cols.map(([a, b], i) => (
    <g class="i" style={`--k:${i}`}>
      <path class="m2 d" d={`${i < 3 ? `M${a} 124h${b - a}v8H${a}z` : ""}M${a} 168h${b - a}v8H${a}z`}></path>
      <path class="sl bt" d={`${i < 3 ? `M${a + 1} 125.5H${b - 1}M${a + 1} 130.5H${b - 1}` : ""}M${a + 1} 169.5H${b - 1}M${a + 1} 174.5H${b - 1}`}></path>
      <path class="wr bt" d={`M${a + 2} 180H${b - 2}`}></path>
      <path class="tb bt" d={`M${a + 2} 194H${b - 2}`}></path>
      <rect class="d" x={a + 2} y="184" width={b - a - 4} height="20"></rect>
      <path class="sc" d={`M${a + 4} 188H${b - 2}M${a + 4} 200H${b - 2}`}></path>
    </g>
  ))}
  <g class="i d" style="--k:0">
    {[52, 61, 70].map((x) => <><rect class="f" x={x} y="88" width="8" height="26"></rect><rect class="b n" x={x + 2} y="96" width="4" height="7"></rect></>)}
    <rect class="m" x="79" y="86" width="13" height="30"></rect>
    <path class="l" d="M82 92h7M82 96h7M82 100h7"></path>
    <path class="sr bt" d="M52 150H92"></path>
    <rect x="52" y="137" width="40" height="26"></rect>
    {[0, 2].map((i) => <circle class="y n lt" cx={55 + i * 13.4} cy="141" r="1.4" style={`--s:${0.9 + i * 0.5}s`}></circle>)}
  </g>
  <g class="i d" style="--k:1">
    <rect class="f" x="98" y="86" width="22" height="32"></rect>
    <rect class="b" x="98" y="86" width="22" height="6"></rect>
    <rect class="k" x="108" y="102" width="7" height="9"></rect>
    <rect class="f" x="120" y="86" width="18" height="32"></rect>
    <rect class="b" x="120" y="86" width="18" height="6"></rect>
    <path class="sr bt" d="M96 150H136"></path>
    <rect x="96" y="137" width="40" height="26"></rect>
    <circle class="y n run" cx="103" cy="97" r="1.5"></circle>
    {io.map((i) => <circle class="y n lt" cx={125 + (i % 2) * 8} cy={97 + (i >> 1) * 5} r="1.4" style={`--s:${((i * 0.37) % 2.4).toFixed(1)}s`}></circle>)}
    {[0, 2].map((i) => <circle class="y n lt" cx={100 + i * 13.4} cy="141" r="1.4" style={`--s:${0.3 + i * 0.6}s`}></circle>)}
  </g>
  <g class="i d" style="--k:2">
    <rect class="f" x="142" y="86" width="18" height="32"></rect>
    <rect class="b" x="142" y="86" width="18" height="6"></rect>
    <rect class="f" x="160" y="86" width="16" height="32"></rect>
    <rect class="b" x="160" y="86" width="16" height="6"></rect>
    <rect class="k" x="164" y="102" width="8" height="8"></rect>
    <rect class="f" x="144" y="138" width="16" height="26"></rect>
    <rect class="s" x="147" y="145" width="10" height="7"></rect>
    <rect class="f" x="163" y="138" width="16" height="26"></rect>
    <circle class="m" cx="171" cy="150" r="4"></circle>
    <path d="M171 150l2.4-2.4"></path>
    {io.map((i) => <circle class="y n lt" cx={147 + (i % 2) * 8} cy={97 + (i >> 1) * 5} r="1.4" style={`--s:${((1.1 + i * 0.53) % 2.4).toFixed(1)}s`}></circle>)}
  </g>
  <g class="i d" style="--k:3">
    <rect class="f" x="188" y="86" width="36" height="78"></rect>
    <rect class="b" x="188" y="86" width="36" height="7"></rect>
    <rect class="k n" x="194" y="98" width="18" height="10"></rect>
    <path class="l" d="M194 118h24M194 123h24M194 128h24M194 133h24"></path>
    <rect class="m3" x="192" y="146" width="10" height="12"></rect>
    <rect class="m3" x="206" y="146" width="14" height="12"></rect>
    <rect class="y n vb" x="196" y="102" width="14" height="2"></rect>
    <circle class="y n" cx="218" cy="103" r="1.6"></circle>
  </g>
  <rect x="40" y="78" width="192" height="136"></rect>

  <!-- scan bar -->
  <g class="scan rmh">
    <rect class="y n" x="46" y="80" width="8" height="126" opacity=".22"></rect>
    <path class="e" d="M50 80V206"></path>
  </g>

  <!-- the machine that was kept: bed, servo (axis into depth), belt, print drum -->
  <path class="t" d="M266 214 278 202H384L372 214Z"></path>
  <path class="s" d="M372 214 384 202V246L372 258Z"></path>
  <rect class="m" x="266" y="214" width="106" height="44"></rect>
  <rect class="d l" x="278" y="222" width="30" height="28"></rect>
  <rect class="m3 d" x="346" y="160" width="8" height="48"></rect>
  <circle class="f drum" cx="350" cy="160" r="22"></circle>
  <path class="d l drum" d="M350 138V182M328 160H372M334.4 144.4l31.2 31.2M334.4 175.6l31.2-31.2"></path>
  <circle class="m3 d" cx="350" cy="160" r="5"></circle>
  <rect class="m3 d" x="286" y="194" width="20" height="12"></rect>
  <circle class="b" cx="310" cy="168" r="14"></circle>
  <path class="b" d="M286.1 172.1 300.1 158.1 319.9 177.9 305.9 191.9Z"></path>
  <circle class="m" cx="296" cy="182" r="14"></circle>
  <circle class="enc" cx="296" cy="182" r="9"></circle>
  <path class="belt" d="M294.1 177.4 348.1 155.4A5 5 0 0 1 351.9 164.6L297.9 186.6A5 5 0 0 1 294.1 177.4Z" stroke-width="1.5"></path>
  <circle class="ink n" cx="296" cy="182" r="2.5"></circle>

  <!-- brand trace: cabinet → servo -->
  <path class="tr" d={wire}></path>
  <circle class="rn" cx="292" cy="160" r="4.5"></circle>
  <g class="i" style="--k:3;--t:1.2s">
    <path class="p" pathLength="100" d={wire}></path>
    <circle class="nd" cx="292" cy="160" r="2.2"></circle>
    <circle class="pg" cx="292" cy="160" r="4.5"></circle>
  </g>
</Frame>
