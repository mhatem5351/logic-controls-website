---
/**
 * Language switcher — native names (العربية / English / 中文 / Türkçe), keeps the current page (and, once the page
 * has loaded, its ?service= / ?industry= / ?location= / utm_* query and #hash), remembers the choice in the `lang`
 * cookie (read by the Worker on "/").
 *
 * variant: "inline" (row of links: utility bar, footer) · "menu" (globe button + popover list, < 1024px) ·
 *          "grid" (2×2, mobile drawer)
 *
 * Menu: the button shows the globe plus the language most visitors switch to from this page (ع on English pages,
 * EN elsewhere), so the one-tap quick switch it replaces stays discoverable. Native popover where supported
 * (Safari 17 / Firefox 125 / Chrome 114+); older engines get the same panel driven by a tiny script (the panel is
 * hidden by CSS until opened, never pinned over the page). The panel scrolls inside short viewports, and closes on
 * Escape, on an outside click and when keyboard focus leaves it.
 * Current language: aria-current plus a non-colour cue (check mark, bold / underline) that survives forced colours.
 */
import { getMessages, type Locale } from "~/i18n";
import Icon from "./Icon.astro";
import { languageLinks } from "./nav";
import { uid } from "./uid";
import { colon } from "./sections/main/rich";

interface Props {
  locale: Locale;
  /** Current path without the locale prefix. */
  path: string;
  variant?: "inline" | "menu" | "grid";
  /** Menu: the header is crowded (e.g. a long action next to it), so the globe goes icon-only below 384px. */
  tight?: boolean;
  class?: string;
}
const { locale, path, variant = "inline", tight = false, class: className } = Astro.props;
const t = getMessages(locale).ui;
const links = languageLinks(path);
const popId = uid("lang");
const SHORT: Record<Locale, string> = { en: "EN", ar: "ع", zh: "中", tr: "TR" };
const current = links.find((l) => l.locale === locale);
const target = links.find((l) => l.locale === (locale === "en" ? "ar" : "en"));
---

{
  variant === "inline" && (
    <ul role="list" aria-label={t.a11y.language} class:list={["flex items-center gap-1", className]}>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            hreflang={l.hreflang}
            lang={l.htmlLang}
            dir={l.dir}
            data-set-lang={l.locale}
            aria-current={l.locale === locale ? "true" : undefined}
            class:list={[
              "lc-lang-link inline-flex min-h-6 items-center px-2 py-0.5 transition-colors",
              l.locale === locale
                ? "font-bold text-white underline decoration-signal-400 decoration-2 underline-offset-[6px]"
                : "text-navy-200 hover:text-white",
              l.locale === "ar" && "text-[1.0625em]",
            ]}
          >
            {l.native}
          </a>
        </li>
      ))}
    </ul>
  )
}

{
  variant === "menu" && (
    <div class:list={["lc-lang-menu relative", className]}>
      <button
        type="button"
        popovertarget={popId}
        aria-controls={popId}
        aria-expanded="false"
        class="lc-lang-btn inline-flex h-10 min-w-10 items-center justify-center gap-1.5 border border-white/20 px-2.5 text-sm font-semibold text-white transition-colors hover:border-white/50 hover:bg-white/5"
        style={`anchor-name: --${popId}`}
      >
        <Icon name="globe" size={18} />
        <span class="sr-only">
          {t.a11y.language}
          {colon(locale)}
          {current?.native},
        </span>
        {target && (
          <span lang={target.htmlLang} dir={target.dir} class:list={[tight ? "max-[24rem]:sr-only" : "max-[22rem]:sr-only", target.locale === "ar" && "text-base leading-none"]}>
            {SHORT[target.locale]}
          </span>
        )}
      </button>
      <div
        id={popId}
        popover
        class="lc-lang-pop on-dark m-0 w-56 border border-white/12 bg-navy-900 p-1.5 text-navy-100 shadow-header"
        style={`position-anchor: --${popId}`}
      >
        <p class="px-3 pt-2 pb-1 type-label text-navy-300">{t.a11y.language}</p>
        <ul role="list">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                hreflang={l.hreflang}
                lang={l.htmlLang}
                data-set-lang={l.locale}
                aria-current={l.locale === locale ? "true" : undefined}
                class:list={[
                  "lc-lang-link flex min-h-11 items-center justify-between gap-3 px-3 text-start transition-colors hover:bg-white/8",
                  l.locale === locale ? "font-bold text-white" : "text-navy-100",
                ]}
              >
                <span dir={l.dir}>{l.native}</span>
                {l.locale === locale && <Icon name="check" size={16} class="text-signal-400" />}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}

{
  variant === "grid" && (
    <ul role="list" aria-label={t.a11y.language} class:list={["grid grid-cols-2 gap-2", className]}>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            hreflang={l.hreflang}
            lang={l.htmlLang}
            dir={l.dir}
            data-set-lang={l.locale}
            aria-current={l.locale === locale ? "true" : undefined}
            class:list={[
              "lc-lang-link flex min-h-12 items-center justify-center gap-2 border px-3 text-center font-semibold transition-colors",
              l.locale === locale
                ? "border-2 border-signal-400 bg-signal-400/10 font-bold text-white"
                : "border-white/15 text-navy-100 hover:border-white/40 hover:text-white",
            ]}
          >
            {l.locale === locale && <Icon name="check" size={16} class="shrink-0 text-signal-400" />}
            {l.native}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* Popover: anchored under the button where CSS anchor positioning exists, otherwise pinned under the header.
     Never taller than the space under the header (400% zoom, landscape phones): the list scrolls inside. */
  .lc-lang-pop {
    position: fixed;
    inset: auto;
    top: calc(var(--header-h) + 0.25rem);
    inset-inline-end: max(var(--spacing-gutter), calc((100vw - var(--container-site)) / 2));
    max-height: calc(100dvh - var(--header-h) - 1rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  @supports (position-anchor: --a) {
    .lc-lang-pop {
      top: anchor(bottom);
      inset-inline-end: anchor(end);
      margin-top: 0.5rem;
    }
  }
  /* No Popover API (Safari ≤ 16, Firefox ≤ 124, Chrome ≤ 113): the [popover] attribute means nothing there, so the
     panel would be displayed permanently. Keep it hidden until the fallback script opens it. */
  @supports not selector(:popover-open) {
    .lc-lang-pop:not(.is-open) {
      display: none;
    }
  }
  @media (pointer: coarse) {
    .lc-lang-btn {
      height: 2.75rem;
      min-width: 2.75rem;
    }
  }
</style>

<script>
  /* Remember the chosen language for the "/" redirect (Worker reads the `lang` cookie). `secure` on https only
     (the site is HTTPS-only with HSTS; plain-http local previews would otherwise drop the cookie). */
  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[data-set-lang]");
    if (link?.dataset.setLang) {
      const secure = location.protocol === "https:" ? "; secure" : "";
      document.cookie = `lang=${link.dataset.setLang}; path=/; max-age=31536000; samesite=lax${secure}`;
    }
  });

  /* Carry the page context across a language switch: preselection (?service=, ?industry=, ?location=, ?platform=),
     project filters and campaign tags, plus the #hash (#quote, #gallery…). Rewritten on the links themselves, so a
     long-press / middle-click / copied link gets it too. */
  const KEEP = /^(service|industry|location|platform|filter|utm_[a-z]+)$/;
  const syncLangLinks = () => {
    const params = new URLSearchParams();
    new URLSearchParams(location.search).forEach((v, k) => KEEP.test(k) && params.append(k, v));
    const qs = params.toString();
    const suffix = (qs ? `?${qs}` : "") + location.hash;
    document.querySelectorAll<HTMLAnchorElement>("a[data-set-lang]").forEach((a) => {
      const base = a.dataset.base ?? a.getAttribute("href") ?? "";
      a.dataset.base = base;
      a.setAttribute("href", base + suffix);
    });
  };
  syncLangLinks();
  addEventListener("hashchange", syncLangLinks);
  addEventListener("popstate", syncLangLinks);
  // Pages that change the query in place with replaceState (project filters): re-sync just before a link is used.
  const beforeUse = (e: Event) => (e.target as Element | null)?.closest?.("a[data-set-lang]") && syncLangLinks();
  document.addEventListener("pointerdown", beforeUse, true);
  document.addEventListener("focusin", beforeUse, true);

  /* Language menu: aria-expanded on the button, close when focus leaves, Popover-less fallback. */
  const supportsPopover = typeof HTMLElement !== "undefined" && "popover" in HTMLElement.prototype;
  document.querySelectorAll<HTMLElement>(".lc-lang-menu").forEach((menu) => {
    const btn = menu.querySelector<HTMLButtonElement>(".lc-lang-btn");
    const pop = menu.querySelector<HTMLElement>(".lc-lang-pop");
    if (!btn || !pop) return;
    const isOpen = () => (supportsPopover ? pop.matches(":popover-open") : pop.classList.contains("is-open"));
    const close = (focusButton = false) => {
      if (!isOpen()) return;
      if (supportsPopover) pop.hidePopover();
      else {
        pop.classList.remove("is-open");
        btn.setAttribute("aria-expanded", "false");
      }
      if (focusButton) btn.focus();
    };
    if (supportsPopover) {
      pop.addEventListener("toggle", (e) => btn.setAttribute("aria-expanded", String((e as ToggleEvent).newState === "open")));
    } else {
      btn.removeAttribute("popovertarget");
      btn.addEventListener("click", () => {
        const open = !pop.classList.contains("is-open");
        pop.classList.toggle("is-open", open);
        btn.setAttribute("aria-expanded", String(open));
      });
      pop.addEventListener("keydown", (e) => e.key === "Escape" && close(true));
      btn.addEventListener("keydown", (e) => e.key === "Escape" && close());
      document.addEventListener("click", (e) => !menu.contains(e.target as Node) && close());
    }
    // A disclosure that stays open after focus moves on covers the page: close it.
    pop.addEventListener("focusout", (e) => {
      const to = e.relatedTarget as Node | null;
      if (to && !pop.contains(to) && to !== btn) close();
    });
  });
</script>
