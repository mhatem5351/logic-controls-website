---
/**
 * Breadcrumb trail + JSON-LD BreadcrumbList. "Home" is prepended automatically.
 * items: [{ label, path? }] — path is locale-less ("services"); the last item is the current page.
 * Pass labels as plain text: the visible label goes through the text engine here (codes and names never split,
 * Chinese breaks between words, Arabic Latin runs isolated); the JSON-LD gets the same words without any display
 * controls (src/lib/jsonld.ts). Labels already run through plain()/keepCodes() are accepted too.
 */
import { getMessages, localePath, type Locale } from "~/i18n";
import { toHtml } from "~/lib/text";
import { breadcrumbList } from "~/lib/jsonld";
import Icon from "./Icon.astro";

interface Crumb {
  label: string;
  path?: string;
}
interface Props {
  locale?: Locale;
  items: Crumb[];
  /** Emit the BreadcrumbList JSON-LD (default true). */
  jsonLd?: boolean;
  /** Landmark label override (only needed if a page shows two trails). */
  label?: string;
  class?: string;
}
const locale = (Astro.props.locale ?? Astro.currentLocale ?? "en") as Locale;
const t = getMessages(locale).ui;
const { items, jsonLd = true, label, class: className } = Astro.props;
const trail: Crumb[] = [{ label: t.nav.home, path: "" }, ...items];
const ld = breadcrumbList(locale, trail);
---

<nav aria-label={label ?? t.a11y.breadcrumbs} class:list={["text-sm", className]}>
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-charcoal-600 on-dark:text-navy-300">
    {
      trail.map((c, i) => {
        const last = i === trail.length - 1;
        return (
          /* The chevron and its crumb never part (flex-nowrap). On phones the current crumb (the H1 right below repeats
             it) is clamped to one line instead of wrapping under a dangling chevron (VIS2-23); in RTL its Latin runs
             are never cut (style below). Touch: 44 px targets whose extra height is taken back by negative margins,
             so the row keeps its height (DEV2-07). */
          <li class:list={["flex min-w-0 flex-nowrap items-center gap-1.5", last && "max-sm:max-w-full"]}>
            {i > 0 && <Icon name="chevron-right" size={14} class="shrink-0 opacity-60" />}
            {last || c.path === undefined ? (
              <span
                aria-current={last ? "page" : undefined}
                class:list={[last && "lc-crumb-cur min-w-0 font-semibold text-navy-900 max-sm:truncate on-dark:text-white"]}
                set:html={toHtml(locale, c.label)}
              />
            ) : (
              <a
                href={localePath(locale, c.path)}
                class="inline-flex min-h-6 items-center whitespace-nowrap underline-offset-4 hover:text-royal-700 hover:underline pointer-coarse:-my-2.5 pointer-coarse:min-h-11 on-dark:hover:text-white"
                set:html={toHtml(locale, c.label)}
              />
            )}
          </li>
        );
      })
    }
  </ol>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, "\\u003c")} />}
</nav>

<style>
  /* RTL phones (VIS3-09, I18N3-04): the ellipsis takes the glyphs at the line's visual end, which inside an embedded
     Latin run is its START ("…iemens S7-1200", "…econ PLC"). Atomic there, a brand name or code is shown whole or not
     at all, so the crumb ends on a word boundary before it. */
  @media (max-width: 39.99rem) {
    :global([dir="rtl"]) .lc-crumb-cur :global(:is(bdi, [dir="ltr"], .lc-nw)) {
      display: inline-block;
    }
    /* The clamp clips at the padding box: room for descenders deeper than the line box, or WebKit cuts the tail and
       dots of a final Arabic ي ("في" drawn as "فى", VI4-05). The negative margin keeps the row's height. */
    .lc-crumb-cur {
      padding-block: 0.2em;
      margin-block: -0.2em;
    }
  }
</style>
