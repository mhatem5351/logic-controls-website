          </button>
          <button type="button" class="hs-btn hs-fault" data-c="fault" aria-pressed="false" aria-disabled="true" aria-describedby={`${u}-why-fault`}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 1.5L3.5 9h4l-1 5.5 6-7.5h-4z" /></svg>{t.controls.fault}
          </button>
          <button type="button" class="hs-btn hs-ack" data-c="ack" aria-disabled="true" aria-describedby={`${u}-why-ack`}>
