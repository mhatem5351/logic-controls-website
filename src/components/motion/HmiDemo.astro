        <!-- process / recipe / manual faceplate -->
        <div class="hs-side">
          <section class="hs-main" aria-label={t.kpi.title}>
            <div class="hs-k">
              <span class="hs-tag">TT-102</span> {t.kpi.tt102}
              {/* both words stacked in one cell, so the label keeps the width of the longer one (no re-wrap at a flip) */}
              <span class="hs-fdv"><span class="hs-tag">FDV</span> <b class="hs-stk"><span data-v="fdvTxt">{t.mimic.divert}</span><span class="hs-sz" aria-hidden="true">{t.mimic.forward}</span><span class="hs-sz" aria-hidden="true">{t.mimic.divert}</span></b></span>
            </div>
            <div class="hs-big" data-alm-ro="TT-102">
