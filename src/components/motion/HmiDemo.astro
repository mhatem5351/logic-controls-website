            </div>
            <div><dt>{t.kpi.hold}</dt><dd><span data-v="hold">{n1(0)}</span> s</dd></div>
            <div><dt><span class="hs-tag">FT-101</span> {t.kpi.flow}</dt><dd><span data-v="flow">0</span> L/h</dd></div>
            <div><dt><span class="hs-tag">TT-201</span> {t.kpi.hw}</dt><dd><span data-v="thw">{n1(70)}</span> °C</dd></div>
            <div><dt><span class="hs-tag">TCV-201</span> {t.kpi.valve}</dt><dd><span data-v="valve">0</span> %</dd></div>
            <div><dt>{t.kpi.batch} <span data-v="batch" class="hs-tag">B-1041</span></dt><dd><span data-v="litres">{n1(0)}</span> L</dd></div>
