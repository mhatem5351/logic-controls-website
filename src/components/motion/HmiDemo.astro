          </div>

          <div class="hs-box hs-perm" dir={dir}>
            <p class="hs-h">{t.perm.title} <span class="hs-permst hs-stk"><span data-v="permSt">{t.perm.blocked}</span><span class="hs-sz" aria-hidden="true">{t.perm.blocked}</span><span class="hs-sz" aria-hidden="true">{t.perm.ok}</span></span></p>
            <ul>
              <li data-perm="temp"><i aria-hidden="true"></i><span data-v="permTemp">{iso(fmt(t.perm.temp, { limit: n1(R.limit) }))}</span><span class="lc-hmi-sr" data-perm-st>{comma}{t.perm.notMet}</span></li>
              <li data-perm="check"><i aria-hidden="true"></i><span data-v="permCheck">{iso(fmt(t.perm.check, { s: CHECK_S }))}</span><span class="lc-hmi-sr" data-perm-st>{comma}{t.perm.notMet}</span></li>
              <li data-perm="dp"><i aria-hidden="true"></i><span>{t.perm.dp}</span><span class="lc-hmi-sr" data-perm-st>{comma}{t.perm.notMet}</span></li>
              <li data-perm="hold"><i aria-hidden="true"></i><span data-v="permHold">{iso(fmt(t.perm.hold, { hold: R.hold }))}</span><span class="lc-hmi-sr" data-perm-st>{comma}{t.perm.notMet}</span></li>
            </ul>
          </div>

          <div class="hs-box hs-manual" data-show="manual" dir={dir}>
            <p class="hs-h">{t.controls.manualTitle}</p>
            <div class="hs-row">
              <span class="hs-rl">{t.controls.sp}</span>
              <div class="hs-step">
                <button type="button" data-c="spDown" aria-label={t.controls.spDown}>−</button>
                <span class="hs-stepv" dir="ltr"><span data-v="sp">{n1(R.sp)}</span> °C</span>
                <button type="button" data-c="spUp" aria-label={t.controls.spUp}>+</button>
              </div>
            </div>
            <div class="hs-row">
              <span class="hs-rl" id={`${u}-fdv`}>{t.controls.fdv}</span>
              <div class="hs-seg" role="group" aria-labelledby={`${u}-fdv`}>
                <button type="button" data-c="fdvFwd" aria-pressed="false">{t.controls.fwd}</button>
                <button type="button" data-c="fdvDiv" aria-pressed="true">{t.controls.div}</button>
              </div>
            </div>
          </div>

          <div class="hs-box hs-cip" data-show="cip" dir={dir}>
            <p class="hs-h">{t.cip.title} <span class="hs-cipleft" data-v="cipLeft" dir="auto"></span></p>
            <ol>
              {(["pre", "caustic", "rinse", "acid", "final"] as const).map((k, i) => (
                <li data-ph={i}>
                  <span>{t.cip[k]}</span>
                  <i />
                  <span class="lc-hmi-sr" data-ph-st />
                </li>
              ))}
            </ol>
          </div>
        </div>

        <!-- trend + alarm summary -->
        <div class="hs-low">
          <div class="hs-trend" data-open="true">
            <div class="hs-th" dir={dir}>
              <button type="button" class="hs-tgl" aria-expanded="true" aria-controls={`${u}-trend`} data-c="trend">
                <span>{t.trend.title}</span> <small>{iso(t.trend.window)}</small>
              </button>
              <span class="hs-legend" aria-hidden="true">
                <i class="lg-pv"></i>TT-102 <i class="lg-th"></i>TT-101 <i class="lg-sp"></i>{t.trend.sp} <i class="lg-lim"></i>{t.trend.limit}
              </span>
            </div>
            <div class="hs-plot" id={`${u}-trend`}>
              <span class="hs-y" data-y="0"></span><span class="hs-y" data-y="1"></span><span class="hs-y" data-y="2"></span>
              <svg viewBox="0 0 600 100" preserveAspectRatio="none" role="img" aria-label={t.a11y.trend}>
                <path class="tr-grid" d="M0 0H600M0 50H600M0 100H600M150 0V100M300 0V100M450 0V100" />
                <path class="tr-lim" d="" />
                <path class="tr-sp" d="" />
                <path class="tr-th" d="" />
                <path class="tr-pv" d="" />
              </svg>
            </div>
          </div>
          <div class="hs-alarms" dir={dir}>
            <p class="hs-ah" id={`${u}-alm`}>{t.alarms.title}</p>
            <!-- alarm summary: a table (priority, time, tag, message, state), laid out as a compact list -->
            <div class="hs-alist" role="table" aria-labelledby={`${u}-alm`}>
              <div class="lc-hmi-sr" role="rowgroup">
                <div role="row">
                  <span role="columnheader">{t.alarms.prio}</span>
                  <span role="columnheader">{t.alarms.time}</span>
                  <span role="columnheader">{t.alarms.tag}</span>
                  <span role="columnheader">{t.alarms.message}</span>
                  <span role="columnheader">{t.alarms.state}</span>
                </div>
              </div>
              <div role="rowgroup" data-rows>
                <div role="row" class="hs-empty"><span role="cell" aria-colspan="5">{t.alarms.empty}</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="lc-hmi-glass" aria-hidden="true"></div>
      <div class="lc-hmi-chin" aria-hidden="true">
        <span class="lc-hmi-logo">Logic<b>Controls</b></span>
        <span class="lc-hmi-leds"><i data-led="pwr"></i>PWR<i data-led="com"></i>COM<i data-led="run"></i>RUN</span>
      </div>
    </div>
    <p class="lc-hmi-sr" aria-live="polite" data-live></p>
    {/* why Simulate fault / Acknowledge are dimmed (aria-describedby; hmi-demo.ts fills them while the key is aria-disabled) */}
    <span id={`${u}-why-fault`} data-why="fault" hidden>{t.msg.faultNeedsRun}</span>
    <span id={`${u}-why-ack`} data-why="ack" hidden>{t.msg.noAlarms}</span>
    <figcaption class="lc-hmi-foot">
      {/* through the text engine (I18N2-11): "ISA-101" never splits, zh breaks between words, Latin isolated in ar,
          and the screen size "10.1″" is one atom (an LTR isolate in Arabic, so the inch mark follows the number). */}
      <p class="lc-hmi-cap" id={`${u}-cap`}>
        <span class="lc-hmi-isa">ISA-101</span>
        <Fragment set:html={html(locale, t.caption)} />
      </p>
      <div class="lc-hmi-cta">
        <p>{t.intro.ctaQuestion}</p>
        <a href={quote} class="lc-hmi-btn">
          {t.intro.cta}
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="rtl:-scale-x-100"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
        <a href={project} class="lc-hmi-more">
          <span set:html={html(locale, t.intro.project)} />
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="rtl:-scale-x-100"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
      </div>
    </figcaption>
  </figure>
</div>

<style is:global>
  /* Until hmi-demo.css (requested by the bootstrap below) has loaded and the mimic is fitted to it, the demo keeps its
     place unseen: it is far below the first screen, and an unstyled or unfitted mimic would be worse than a blank.
     Only while the bootstrap can still show it (AUD4-03): if the site module never runs (a failed or stale chunk, a
     blocked script, an error before the bootstrap), nothing sets data-styled, and the section, heading and copy
     included, would stay a blank band of several screens. The bootstrap claims the section (data-styling) as soon as
     it runs; unclaimed after 4 s, it is shown as it is. A timer, not motion: !important keeps the motion-off
     catch-all (animation-delay: 0s) from showing it at once. */
  html.js .lc-hmi-wrap:not([data-styled]) {
    visibility: hidden;
    animation: lc-hmi-unclaimed 0s 4s forwards !important;
  }
  html.js .lc-hmi-wrap[data-styling]:not([data-styled]) {
    animation: none !important;
  }
  @keyframes lc-hmi-unclaimed {
    to {
      visibility: visible;
    }
  }
  /* Claimed and waiting for the sheet: the place it keeps is about the styled size, not the unstyled block's 4–5×
     (PSC4-03: a visitor already there saw a blank stretch of screens, then a jump). Styled heights measured on the
     built demo (both variants, 4 locales, Chromium and WebKit), per viewport range of the demo's own steps (its
     container breakpoints 560 / 860 / 1020 px and the mimic's full view from 600 px): within about 10%. Arabic text
     runs ~5% taller, Chinese ~6% shorter. */
  html.js .lc-hmi-wrap[data-styling]:not([data-styled]) {
    contain: size;
    overflow: clip;
    contain-intrinsic-block-size: calc(var(--lc-hmi-h) * var(--lc-hmi-k, 1));
  }
  html:lang(ar) .lc-hmi-wrap {
    --lc-hmi-k: 1.05;
  }
  html:lang(zh-Hans) .lc-hmi-wrap {
    --lc-hmi-k: 0.94;
  }
  .lc-hmi-wrap {
    --lc-hmi-h: 1880px;
  }
  .lc-hmi-wrap[data-variant="full"] {
    --lc-hmi-h: 2245px;
  }
  @media (min-width: 24.375rem) {
    .lc-hmi-wrap {
      --lc-hmi-h: 1750px;
    }
    .lc-hmi-wrap[data-variant="full"] {
      --lc-hmi-h: 2050px;
    }
  }
  @media (min-width: 37.625rem) {
    .lc-hmi-wrap {
      --lc-hmi-h: 1450px;
    }
    .lc-hmi-wrap[data-variant="full"] {
      --lc-hmi-h: 1710px;
    }
  }
  @media (min-width: 43.75rem) {
    .lc-hmi-wrap {
      --lc-hmi-h: 1280px;
    }
    .lc-hmi-wrap[data-variant="full"] {
      --lc-hmi-h: 1515px;
    }
  }
  @media (min-width: 57.1875rem) {
    .lc-hmi-wrap {
      --lc-hmi-h: 1100px;
    }
    .lc-hmi-wrap[data-variant="full"] {
      --lc-hmi-h: 1405px;
    }
  }
  @media (min-width: 67.5625rem) {
    .lc-hmi-wrap {
      --lc-hmi-h: 1015px;
    }
    .lc-hmi-wrap[data-variant="full"] {
      --lc-hmi-h: 1370px;
    }
  }
</style>

<script>
  /* Bootstrap (~1 KB): request the demo's stylesheet, fit the mimic once it applies, load the controller only when the
     panel is near the viewport or touched. */
  import { fitMimic } from "~/scripts/motion/hmi-fit";
  import { reloadOnce } from "~/scripts/site-load";

  type Mod = typeof import("~/scripts/motion/hmi-demo");
  const figs = [...document.querySelectorAll<HTMLElement>("[data-hmi]")];
  if (figs.length) {
    // low priority: decoration far below the fold, never in the way of the first screen's image and fonts
    const css = new Promise<boolean>((done) => {
      const link = Object.assign(document.createElement("link"), { rel: "stylesheet", href: figs[0]!.dataset.css ?? "", fetchPriority: "low" });
      link.addEventListener("load", () => done(true), { once: true });
      link.addEventListener("error", () => done(false), { once: true });
      document.head.append(link);
    });
    let mod: Promise<Mod> | undefined;
    // a failed import is not memoised: the next press asks again (CODE3-05)
    const load = () =>
      (mod ??= import("~/scripts/motion/hmi-demo").catch((e: unknown) => {
        mod = undefined;
        throw e;
      }));
    const boot = (fig: HTMLElement) => css.then(load).then((m) => m.initHmi(fig));

    for (const fig of figs) {
      // claimed: it stays unseen until the sheet below settles, never shown unstyled by the stylesheet's timer (AUD4-03)
      fig.closest(".lc-hmi-wrap")?.setAttribute("data-styling", "");
      /* fitted in the same task the sheet's load event runs in, then shown: no frame of an unfitted mimic. Shown also
         if the sheet failed (a tab left open across a deploy asks for a file that is gone): the copy and links stay
         readable rather than an invisible block. */
      void css.then(() => {
        fitMimic(fig);
        fig.closest(".lc-hmi-wrap")?.setAttribute("data-styled", "");
      });
      // a press that arrives before the controller: load it, then replay the press
      const early = (e: Event) => {
        if (fig.dataset.ready) return;
        const b = (e.target as Element).closest<HTMLButtonElement>("button[data-c]");
        if (e.type === "click" && b) {
          e.stopPropagation();
          /* the controller could not load (after a deploy, the previous build's chunk is gone): a press means the
             visitor wants the demo, so reload once to get the current build; else the static panel stays */
          boot(fig).then(
            () => b.click(),
            () => void reloadOnce(),
          );
        } else boot(fig).catch(() => {});
      };
      fig.addEventListener("click", early, true);
      fig.addEventListener("focusin", early);
      fig.addEventListener("pointerdown", early, { passive: true });
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (es) => {
            if (!es.some((e) => e.isIntersecting)) return;
            io.disconnect();
            boot(fig).catch(() => {});
          },
          { rootMargin: "800px 0px" },
        );
        io.observe(fig);
      } else boot(fig).catch(() => {});
    }
  }
</script>
