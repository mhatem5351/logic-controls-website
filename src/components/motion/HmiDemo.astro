---
/**
 * HmiDemo — a playable HTST pasteurizer HMI (process mimic + PLC logic simulated in the browser).
 *
 * - variant "full": intro block (title, lead, three "what you're seeing" points) + panel + caption/CTA.
 *   variant "compact": panel + caption/CTA only (for service pages that already have their own heading).
 * - tone: "light" (default, for white / light-grey bands) or "dark" (navy bands) — only affects the text
 *   around the panel; the panel itself is the same device in both.
 * - The panel is a static, fully-rendered SVG/HTML snapshot until the visitor presses a button
 *   (~6 KB gz script, no libraries). It pauses offscreen / in hidden tabs and respects reduced motion.
 * - The HMI screen is always LTR (process diagrams are), but every label is localised.
 */
import type enHmi from "~/i18n/messages/en/hmi.json";
import { getMessages, localePath, LOCALE_META, type Locale } from "~/i18n";
import BrandMark from "~/components/BrandMark.astro";
import { uid } from "~/components/uid";
import { RECIPES } from "~/scripts/motion/hmi-sim";
import { iso } from "~/scripts/motion/hmi-bidi";

interface Props {
  locale: Locale;
  variant?: "full" | "compact";
  tone?: "light" | "dark";
  /** Heading level of the intro title (full variant). */
  headingLevel?: 2 | 3;
  id?: string;
  class?: string;
}

const { locale, variant = "full", tone = "light", headingLevel = 2, id, class: className } = Astro.props;
const t = getMessages(locale).hmi as typeof enHmi;
const H = headingLevel === 3 ? "h3" : "h2";
const dir = LOCALE_META[locale].dir; // natural-language blocks inside the (always LTR) screen follow the page
const u = uid("hmi");
const quote = `${localePath(locale, "contact")}#quote`;
const R = RECIPES.milk;

// Strings the runtime needs (keeps the intro/loop copy out of the attribute).
const runtime = {
  status: t.status,
  mimic: { forward: t.mimic.forward, divert: t.mimic.divert, storage: t.mimic.storage, drain: t.mimic.drain },
  recipe: t.recipe,
  perm: t.perm,
  trend: { show: t.trend.show, hide: t.trend.hide },
  alarms: t.alarms,
  msg: t.msg,
  cip: t.cip,
};

// Holding tube, inlet → outlet, split into segments so the product temperature can travel along it.
const HOLD: [string, number][] = [
  ["M455 188V168H576", 141],
  ["M576 168H700", 124],
  ["M700 168A20 20 0 0 0 700 128", 62.8],
  ["M700 128H590", 110],
  ["M590 128H480", 110],
  ["M480 128A20 20 0 0 1 480 88", 62.8],
  ["M480 88H600", 120],
  ["M600 88H748", 148],
];
const HOLD_LEN = HOLD.reduce((s, [, l]) => s + l, 0);
let acc = 0;
const holdSegs = HOLD.map(([d, l]) => {
  const a = acc / HOLD_LEN;
  acc += l;
  return { d, a: a.toFixed(3), b: (acc / HOLD_LEN).toFixed(3) };
});

// Product / utility pipes (drawn in flow direction).
const PIPES: [string, string][] = [
  ["raw", "M92 246H128V190H162V214"],
  ["feed", "M178 292V340H219"],
  ["dis", "M232 327H318V310"],
  ["fwd", "M760 76V44H330V188"],
  ["div", "M772 88H792V22H194V214"],
  ["out", "M572 214H776V234"],
  ["hwr", "M420 310V392H442"],
  ["hwp", "M455 379H590"],
  ["hws", "M610 362V346H452V310"],
  ["ice", "M508 334V310M540 310V334"],
  ["steam", "M832 402H630"],
];
const tag = (x: number, y: number, a: string, n: string) => ({ x, y, a, n });
const TAGS = [
  tag(282, 300, "FT", "101"),
  tag(428, 160, "TT", "101"),
  tag(724, 64, "TT", "102"),
  tag(626, 236, "TT", "103"),
  tag(520, 368, "TT", "201"),
  tag(792, 378, "PT", "201"),
];
---

<div
  class:list={["lc-hmi-wrap", tone === "dark" && "on-dark", className]}
  data-variant={variant}
  data-tone={tone}
  id={id}
>
  {
    variant === "full" && (
      <header class="lc-hmi-intro">
        <div>
          <p class="lc-hmi-eyebrow type-label">
            <span class="slant-bar" aria-hidden="true" />
            {t.intro.eyebrow}
          </p>
          <H class="type-h2 lc-hmi-title">{t.intro.title}</H>
          <p class="type-lead lc-hmi-lead">{t.intro.lead}</p>
        </div>
        <div class="lc-hmi-seeing">
          <p class="type-label">{t.intro.seeing}</p>
          <ul>
            {t.intro.bullets.map((b, i) => (
              <li>
                <span class="lc-hmi-bico" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="20" height="20">
                    {i === 0 && <path d="M6 9V6.5a4 4 0 0 1 8 0V9M4.5 9h11v8h-11zM10 12v2" />}
                    {i === 1 && <path d="M10 3a5 5 0 0 0-5 5v3.5L3.5 14h13L15 11.5V8a5 5 0 0 0-5-5zM8 16.5a2 2 0 0 0 4 0" />}
                    {i === 2 && <path d="M3 3v14h14M6 13l3.5-4 3 2.5L17 6" />}
                  </svg>
                </span>
                <span>
                  <strong>{b.title}</strong> {b.text}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </header>
    )
  }

  <figure class="lc-hmi" data-hmi data-i18n={JSON.stringify(runtime)} aria-labelledby={`${u}-cap`}>
    <p class="lc-hmi-try"><span class="lc-led" aria-hidden="true"></span>{t.intro.try}</p>
    <div class="lc-hmi-dev">
      <div
        class="lc-hmi-screen"
        dir="ltr"
        role="group"
        aria-label={t.a11y.panel}
        data-run="0"
        data-fdv="div"
        data-mode="auto"
        data-cip="-1"
        data-fluid="milk"
        data-recipe="milk"
      >
        <!-- status bar -->
        <div class="hs-bar">
          <div class="hs-brand">
            <BrandMark tone="dark" class="hs-mark" />
            <span class="hs-name">Logic Controls</span>
          </div>
          <div class="hs-unit"><span dir="auto">{t.status.unit}</span><span class="hs-screen" dir="auto">{t.status.screen}</span></div>
          <div class="hs-right">
            <span class="hs-chip hs-mode" data-v="mode">AUTO</span>
            <span class="hs-chip hs-state" data-v="state">{t.status.ready}</span>
            <span class="hs-chip hs-alm" data-v="almCount" title={t.alarms.unacked}>0</span>
            <span class="hs-sim">{t.status.sim}</span>
            <time class="hs-clock" data-v="clock">--:--:--</time>
          </div>
        </div>

        <!-- process mimic -->
        <div class="hs-mimic">
          <svg viewBox="0 0 840 432" role="img" aria-label={t.a11y.mimic} focusable="false">
            <defs>
              <pattern id={`${u}-pl`} width="4.5" height="8" patternUnits="userSpaceOnUse">
                <rect width="2.2" height="8" class="m-plate" />
              </pattern>
              <linearGradient id={`${u}-tg`}>
                <stop offset="0" stop-color="rgb(95,136,184)" />
                <stop offset="0.38" stop-color="rgb(150,157,170)" />
                <stop offset="0.72" stop-color="rgb(196,152,104)" />
                <stop offset="1" stop-color="rgb(206,104,58)" />
              </linearGradient>
              <clipPath id={`${u}-raw`}><rect x="24" y="98" width="66" height="162" rx="9" /></clipPath>
              <clipPath id={`${u}-sto`}><rect x="746" y="236" width="60" height="94" rx="6" /></clipPath>
            </defs>

            <!-- equipment: tanks -->
            <g class="m-eq">
              <rect x="22" y="96" width="70" height="166" rx="11" />
              <path d="M30 262v16M84 262v16" class="m-leg" />
              <path d="M150 206h56v70l-20 16h-16l-20-16z" />
              <rect x="744" y="234" width="64" height="98" rx="8" />
              <path d="M752 332v12M800 332v12" class="m-leg" />
            </g>
            <rect class="m-lvl" data-lvl="raw" data-y0="98" data-h="162" x="24" y="131" width="66" height="129" clip-path={`url(#${u}-raw)`} />
            <rect class="m-lvl" data-lvl="bt" data-y0="208" data-h="66" x="152" y="241" width="52" height="33" />
            <rect class="m-lvl" data-lvl="sto" data-y0="236" data-h="94" x="746" y="313" width="60" height="17" clip-path={`url(#${u}-sto)`} />

            <!-- pipes: outer wall, then the product inside (coloured by temperature, dashes = flow) -->
            <g class="m-pipe">
              {PIPES.map(([, d]) => <path d={d} />)}
              {holdSegs.map((s) => <path d={s.d} />)}
            </g>
            <g class="m-flow">
              {PIPES.map(([k, d]) => <path d={d} data-p={k} />)}
              {holdSegs.map((s) => <path d={s.d} data-p="hold" data-a={s.a} data-b={s.b} />)}
            </g>

            <!-- plate heat exchanger -->
            <g class="m-phe">
              <path class="m-bar" d="M292 186h286M292 312h286" />
              <rect x="304" y="194" width="252" height="110" fill={`url(#${u}-pl)`} />
              <rect class="m-frame" x="296" y="190" width="8" height="118" rx="1.5" />
              <rect class="m-frame" x="556" y="190" width="10" height="118" rx="1.5" />
              <rect class="m-frame" x="398" y="192" width="5" height="114" />
              <rect class="m-frame" x="472" y="192" width="5" height="114" />
              <g class="m-sec">
                <rect x="320" y="240" width="64" height="18" rx="2" /><text x="352" y="253">{t.mimic.regen}</text>
                <rect x="406" y="240" width="64" height="18" rx="2" /><text x="438" y="253">{t.mimic.heating}</text>
                <rect x="482" y="240" width="64" height="18" rx="2" /><text x="514" y="253">{t.mimic.cooling}</text>
              </g>
            </g>

            <!-- pumps -->
            <g class="m-pump" data-pump="feed" transform="translate(232 340)">
              <circle r="13" />
              <g class="m-imp"><circle r="8" /><path d="M0 0V-8M0 0l7 4M0 0l-7 4" /></g>
            </g>
            <g class="m-pump" data-pump="hw" transform="translate(455 392)">
              <circle r="13" />
              <g class="m-imp"><circle r="8" /><path d="M0 0V-8M0 0l7 4M0 0l-7 4" /></g>
            </g>
            <!-- steam/hot-water heater -->
            <g class="m-eq">
              <rect x="590" y="362" width="40" height="50" rx="5" />
              <path class="m-coil" d="M598 372h24M598 380h24M598 388h24M598 396h24M598 404h24" />
            </g>

            <!-- valves -->
            <g class="m-valve" data-valve="lv" transform="translate(110 246)">
              <path d="M-9-6L0 0-9 6zM9-6L0 0 9 6z" />
            </g>
            <g class="m-valve m-tcv" data-valve="tcv" transform="translate(700 402)">
              <path d="M0 0v-12" class="m-stem" />
              <path d="M-8-12a8 8 0 0 1 16 0z" class="m-act" />
              <path d="M-9-6L0 0-9 6zM9-6L0 0 9 6z" />
            </g>
            <g class="m-fdv" transform="translate(760 88)">
              <path d="M0 0v14" class="m-stem" />
              <rect x="-9" y="14" width="18" height="9" rx="2" class="m-act" />
              <path class="m-fin" d="M-12-7L0 0-12 7z" />
              <path class="m-ffwd" d="M-7-12L0 0 7-12z" />
              <path class="m-fdiv" d="M12-7L0 0 12 7z" />
              <g class="m-lock" transform="translate(16 18)">
                <rect x="-6" y="-2" width="12" height="9" rx="1.5" />
                <path d="M-3.5-2v-2.5a3.5 3.5 0 0 1 7 0V-2" />
              </g>
            </g>

            <!-- instrument bubbles (ISA-5.1) -->
            <g class="m-tags">
              <path d="M282 311v16M439 160h16M724 75v13M626 225v-11M520 357v-11M792 389v13" class="m-lead" />
              {
                TAGS.map((g) => (
                  <g transform={`translate(${g.x} ${g.y})`}>
                    <circle r="11" />
                    <text y="-1.5">{g.a}</text>
                    <text y="7">{g.n}</text>
                  </g>
                ))
              }
            </g>

            <!-- readouts -->
            <g class="m-ro">
              <g transform="translate(36 166)"><rect width="42" height="17" rx="2" /><text x="38" y="12.5"><tspan data-v="rawLvl">82.0</tspan> %</text></g>
              <g transform="translate(157 222)"><rect width="42" height="17" rx="2" /><text x="38" y="12.5"><tspan data-v="btLvl">50.0</tspan> %</text></g>
              <g transform="translate(752 280)"><rect width="48" height="17" rx="2" /><text x="44" y="12.5"><tspan data-v="stoLvl">18.0</tspan> %</text></g>
              <g transform="translate(240 268)"><rect width="66" height="17" rx="2" /><text x="62" y="12.5"><tspan data-v="flow">0</tspan> L/h</text></g>
              <g transform="translate(352 152)" data-alm-ro="TT-101"><rect width="62" height="17" rx="2" /><text x="58" y="12.5"><tspan data-v="th">24.0</tspan> °C</text></g>
              <g transform="translate(640 55)" data-alm-ro="TT-102"><rect width="62" height="17" rx="2" /><text x="58" y="12.5"><tspan data-v="tt102">24.0</tspan> °C</text></g>
              <g transform="translate(642 228)"><rect width="56" height="17" rx="2" /><text x="52" y="12.5"><tspan data-v="tout">6.0</tspan> °C</text></g>
              <g transform="translate(534 360)"><rect width="56" height="17" rx="2" /><text x="52" y="12.5"><tspan data-v="thw">70.0</tspan> °C</text></g>
              <g transform="translate(718 370)" data-alm-ro="PT-201"><rect width="62" height="17" rx="2" /><text x="58" y="12.5"><tspan data-v="steam">3.0</tspan> bar</text></g>
              <g transform="translate(716 410)"><rect width="50" height="15" rx="2" /><text x="46" y="11.5"><tspan data-v="valve">0</tspan> %</text></g>
            </g>

            <!-- alarm indicators next to readouts (ISA-101: shape + colour + number) -->
            <g class="m-alm" data-p="3" data-alm-ind="TT-101" transform="translate(340 160)"><path d="M0-8L8 0 0 8-8 0z" /><text y="3.5">3</text></g>
            <g class="m-alm" data-p="1" data-alm-ind="TT-102" transform="translate(628 63)"><path d="M-7-7h14v14h-14z" /><text y="3.5">1</text></g>
            <g class="m-alm" data-p="2" data-alm-ind="PT-201" transform="translate(818 378)"><path d="M0-8l8 14h-16z" /><text y="4.5">2</text></g>

            <!-- product temperature colour key -->
            <g class="m-key" transform="translate(24 410)">
              <rect width="88" height="5" rx="2.5" fill={`url(#${u}-tg)`} />
              <text x="0" y="17">4 °C</text>
              <text x="88" y="17" class="m-e">85 °C</text>
            </g>

            <!-- labels -->
            <g class="m-lbl">
              <text x="57" y="86">{t.mimic.raw}</text>
              <text x="57" y="74" class="m-tagtx">T-101</text>
              <text x="110" y="268" class="m-tagtx">LV-101</text>
              <text x="212" y="290" class="m-tagtx m-s">B-101</text>
              <text x="146" y="314" class="m-e">{t.mimic.balance}</text>
              <text x="232" y="370">{t.mimic.feedPump}</text>
              <text x="232" y="381" class="m-tagtx">P-101</text>
              <text x="412" y="342" class="m-e">{t.mimic.phe}</text>
              <text x="590" y="105">{t.mimic.holding}</text>
              <text x="590" y="118" class="m-holdv"><tspan data-v="hold">0.0</tspan> s</text>
              <text x="760" y="134" class="m-tagtx">FDV-101</text>
              <text x="760" y="147" class="m-fdvst" data-v="fdvTxt">{t.mimic.divert}</text>
              <text x="520" y="33" class="m-dir">{t.mimic.forward} ←</text>
              <text x="480" y="16" class="m-dir">{t.mimic.divert} ←</text>
              <text x="776" y="350" data-v="outLbl">{t.mimic.storage}</text>
              <text x="776" y="360" class="m-tagtx">T-301</text>
              <text x="455" y="418">{t.mimic.hwPump}</text>
              <text x="638" y="356" class="m-s">{t.mimic.hotWater}</text>
              <text x="548" y="328" class="m-s">{t.mimic.iceWater}</text>
              <text x="834" y="424" class="m-e">{t.mimic.steam}</text>
              <text x="700" y="378" class="m-tagtx">TCV-201</text>
              <text x="178" y="203" class="m-cipl">{t.mimic.cipSupply}</text>
            </g>

          </svg>
        </div>

        <!-- process / recipe / manual faceplate -->
        <div class="hs-side">
          <section class="hs-main" aria-label={t.kpi.title}>
            <div class="hs-k">
              <span class="hs-tag">TT-102</span> {t.kpi.tt102}
              <span class="hs-fdv"><span class="hs-tag">FDV</span> <b data-v="fdvTxt">{t.mimic.divert}</b></span>
            </div>
            <div class="hs-big" data-alm-ro="TT-102">
              <span class="hs-bigv" data-v="tt102">24.0</span><span class="hs-u">°C</span>
              <span class="hs-almi" aria-hidden="true">1</span>
            </div>
            <div class="hs-ai" aria-hidden="true">
              <span class="hs-ai-band"></span>
              <span class="hs-ai-lim"></span>
              <span class="hs-ai-sp"></span>
              <span class="hs-ai-ptr"></span>
            </div>
            <div class="hs-sub" dir="auto">
              {t.kpi.limit} <b data-v="limit" dir="ltr">≥ {R.limit.toFixed(1)} °C</b> · {t.kpi.min} <b data-v="minHold" dir="ltr">{R.hold} s</b>
            </div>
          </section>
          <dl class="hs-grid">
            <div data-alm-ro="TT-101">
              <dt><span class="hs-tag">TT-101</span> {t.kpi.tt101}</dt>
              <dd><span data-v="th">24.0</span> °C <small>{t.kpi.sp} <span data-v="sp">{R.sp.toFixed(1)}</span></small></dd>
            </div>
            <div><dt>{t.kpi.hold}</dt><dd><span data-v="hold">0.0</span> s</dd></div>
            <div><dt><span class="hs-tag">FT-101</span> {t.kpi.flow}</dt><dd><span data-v="flow">0</span> L/h</dd></div>
            <div><dt><span class="hs-tag">TT-201</span> {t.kpi.hw}</dt><dd><span data-v="thw">70.0</span> °C</dd></div>
            <div><dt><span class="hs-tag">TCV-201</span> {t.kpi.valve}</dt><dd><span data-v="valve">0</span> %</dd></div>
            <div><dt>{t.kpi.batch} <span data-v="batch" class="hs-tag">B-1041</span></dt><dd><span data-v="litres">0.0</span> L</dd></div>
          </dl>

          <div class="hs-box hs-recipe" dir={dir}>
            <p class="hs-h" id={`${u}-rcp`}>{t.recipe.title}</p>
            <div class="hs-seg" role="group" aria-labelledby={`${u}-rcp`}>
              <button type="button" data-c="recipe" data-r="milk" aria-pressed="true">{t.recipe.milk}</button>
              <button type="button" data-c="recipe" data-r="cream" aria-pressed="false">{t.recipe.cream}</button>
              <button type="button" data-c="recipe" data-r="juice" aria-pressed="false">{t.recipe.juice}</button>
            </div>
          </div>

          <div class="hs-box hs-perm" dir={dir}>
            <p class="hs-h">{t.perm.title} <span class="hs-permst" data-v="permSt">{t.perm.blocked}</span></p>
            <ul>
              <li data-perm="temp"><i aria-hidden="true"></i><span data-v="permTemp">{iso(t.perm.temp.replace("{limit}", R.limit.toFixed(1)))}</span></li>
              <li data-perm="check"><i aria-hidden="true"></i><span data-v="permCheck">{iso(t.perm.check.replace("{s}", "2"))}</span></li>
              <li data-perm="dp"><i aria-hidden="true"></i><span>{t.perm.dp}</span></li>
              <li data-perm="hold"><i aria-hidden="true"></i><span data-v="permHold">{iso(t.perm.hold.replace("{hold}", String(R.hold)))}</span></li>
            </ul>
          </div>

          <div class="hs-box hs-manual" data-show="manual" dir={dir}>
            <p class="hs-h">{t.controls.manualTitle}</p>
            <div class="hs-row">
              <span class="hs-rl">{t.controls.sp}</span>
              <div class="hs-step">
                <button type="button" data-c="spDown" aria-label={t.controls.spDown}>−</button>
                <span class="hs-stepv" dir="ltr"><span data-v="sp">{R.sp.toFixed(1)}</span> °C</span>
                <button type="button" data-c="spUp" aria-label={t.controls.spUp}>+</button>
              </div>
            </div>
            <div class="hs-row">
              <span class="hs-rl" id={`${u}-fdv`}>{t.controls.fdv}</span>
              <div class="hs-seg" role="group" aria-labelledby={`${u}-fdv`}>
                <button type="button" data-c="fdvFwd" aria-pressed="false">{t.controls.fwd}</button>
                <button type="button" data-c="fdvDiv" aria-pressed="true">{t.controls.div}</button>
              </div>
            </div>
          </div>

          <div class="hs-box hs-cip" data-show="cip" dir={dir}>
            <p class="hs-h">{t.cip.title} <span class="hs-cipleft" data-v="cipLeft" dir="auto"></span></p>
            <ol>
              {(["pre", "caustic", "rinse", "acid", "final"] as const).map((k, i) => (
                <li data-ph={i}>
                  <span>{t.cip[k]}</span>
                  <i />
                </li>
              ))}
            </ol>
          </div>
        </div>

        <!-- operator message line -->
        <p class="hs-msg" data-v="msg" dir={dir}>{t.msg.idle}</p>

        <!-- trend + alarm list -->
        <div class="hs-low">
        <div class="hs-trend" data-open="true">
          <div class="hs-th" dir={dir}>
            <button type="button" class="hs-tgl" aria-expanded="true" aria-controls={`${u}-trend`} data-c="trend">
              <span>{t.trend.title}</span> <small>{iso(t.trend.window)}</small>
            </button>
            <span class="hs-legend" aria-hidden="true">
              <i class="lg-pv"></i>TT-102 <i class="lg-th"></i>TT-101 <i class="lg-sp"></i>{t.trend.sp} <i class="lg-lim"></i>{t.trend.limit}
            </span>
          </div>
          <div class="hs-plot" id={`${u}-trend`}>
