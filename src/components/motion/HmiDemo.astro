---
/**
 * HmiDemo — a playable HTST pasteurizer HMI (process mimic + PLC logic simulated in the browser).
 *
 * - variant "full": intro block (title, lead, three "what you're seeing" points) + panel + caption/CTA.
 *   variant "compact": panel + caption/CTA only (for service pages that already have their own heading).
 * - tone: "light" (default, for white / light-grey bands) or "dark" (navy bands) — only affects the text
 *   around the panel; the panel itself is the same device in both.
 * - The panel is a static, fully-rendered SVG/HTML snapshot until the visitor presses a button. A ~1 KB bootstrap
 *   (below) requests the demo's stylesheet, fits the mimic to its width and loads the controller (~8 KB gz) only when
 *   the panel comes within ~800px of the viewport, or on the first touch / focus inside it. It pauses offscreen / in hidden tabs, and with reduced
 *   motion or the site's pause switch (html[data-motion="off"]) the flowing / spinning / blinking turn into static
 *   indicators while the simulation itself still runs on request.
 * - A four-step "Try it" checklist above the screen (Start → Forward → Simulate fault → Acknowledge) ticks itself as
 *   the visitor plays; the next step's key carries an amber lamp.
 * - The HMI screen is always LTR (process diagrams are), but every label is localised. DOM order = focus order:
 *   status bar → mimic → message → command bar → faceplate → trend / alarms (the desktop grid only places them).
 */
import { getMessages, localePath, LOCALE_META, type Locale } from "~/i18n";
import { colon, heading, html, markup, punct } from "~/lib/text";
import BrandMark from "~/components/BrandMark.astro";
import { uid } from "~/components/uid";
import { CHECK_S, RECIPES } from "~/scripts/motion/hmi-sim";
import { fmt } from "~/lib/format";
import { iso } from "~/scripts/motion/hmi-bidi";
import { fmt1, keyStops, KEY_T0, KEY_T1 } from "~/scripts/motion/hmi-fmt";
import hmiCss from "./hmi-demo.css?url";

interface Props {
  locale: Locale;
  variant?: "full" | "compact";
  tone?: "light" | "dark";
  /** Heading level of the intro title (full variant). */
  headingLevel?: 2 | 3;
  id?: string;
  class?: string;
}

const { locale, variant = "full", tone = "light", headingLevel = 2, id, class: className } = Astro.props;
const t = getMessages(locale).hmi;
const H = headingLevel === 3 ? "h3" : "h2";
const dir = LOCALE_META[locale].dir; // natural-language blocks inside the (always LTR) screen follow the page
const u = uid("hmi");
/* UX2-16: the demo's next steps. The quote form opens with the matching need / industry preselected (rfq-form.ts reads
   ?service= / ?industry=); the case study is the real pasteurizer behind the demo (CIP, recipes, flow diversion). */
const quote = `${localePath(locale, "contact")}?service=plc-hmi-programming&industry=food-beverage#quote`;
const project = localePath(locale, "projects/pasteurizer-cip-recipes");
const R = RECIPES.milk;
const n1 = (v: number) => fmt1(v, locale);
/** Separator before a visually hidden state word ("TT-102 ≥ 72.0 °C, not met"). */
const comma = punct(locale).comma;

const mode = { auto: t.mode.auto, manual: t.mode.manual };

// Strings the runtime needs (keeps the intro/loop copy out of the attribute).
const runtime = {
  lang: locale,
  colon: colon(locale),
  comma,
  status: t.status,
  mode,
  mimic: { forward: t.mimic.forward, divert: t.mimic.divert, storage: t.mimic.storage, drain: t.mimic.drain },
  recipe: t.recipe,
  perm: t.perm,
  trend: { show: t.trend.show, hide: t.trend.hide },
  alarms: t.alarms,
  msg: t.msg,
  cip: t.cip,
  controls: { start: t.controls.start, ack: t.controls.ack },
  tour: { done: t.tour.done },
  quote,
};

// The idle message with the Start key drawn as a key cap ("Press [▶ Start] to run the pasteurizer."), assembled with
// markup`` (values escaped; same markup as the controller's PRESS in hmi-demo.ts).
const [pressA = "", pressB = ""] = iso(t.msg.press).split("{key}");
const pressHtml = markup`${pressA}<span class="hs-key"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3l8 5-8 5z"/></svg>${t.controls.start}</span>${pressB}`;

// Holding tube, inlet → outlet, split into segments so the product temperature can travel along it.
const HOLD: [string, number][] = [
  ["M455 188V168H576", 141],
  ["M576 168H700", 124],
  ["M700 168A20 20 0 0 0 700 128", 62.8],
  ["M700 128H590", 110],
  ["M590 128H480", 110],
  ["M480 128A20 20 0 0 1 480 88", 62.8],
  ["M480 88H600", 120],
  ["M600 88H748", 148],
];
const HOLD_LEN = HOLD.reduce((s, [, l]) => s + l, 0);
let acc = 0;
const holdSegs = HOLD.map(([d, l]) => {
  const a = acc / HOLD_LEN;
  acc += l;
  return { d, a: a.toFixed(3), b: (acc / HOLD_LEN).toFixed(3) };
});

// Product / utility pipes (drawn in flow direction).
const PIPES: [string, string][] = [
  ["raw", "M92 246H128V190H162V214"],
  ["feed", "M178 292V340H219"],
  ["dis", "M232 327H318V310"],
  ["fwd", "M760 76V44H330V188"],
  ["div", "M772 88H792V22H194V214"],
  ["out", "M572 214H776V234"],
  ["hwr", "M420 310V392H442"],
  ["hwp", "M455 379H590"],
  ["hws", "M610 362V346H452V310"],
  ["ice", "M508 334V310M540 310V334"],
  ["steam", "M832 402H630"],
];
const tag = (x: number, y: number, a: string, n: string) => ({ x, y, a, n });
const TAGS = [
  tag(282, 300, "FT", "101"),
  tag(428, 160, "TT", "101"),
  tag(724, 64, "TT", "102"),
  tag(626, 236, "TT", "103"),
  tag(520, 368, "TT", "201"),
  tag(792, 378, "PT", "201"),
];
// Product temperature key: cool (below the recipe's legal limit) | warm (at / above it), with a tick at the limit.
const KEY_W = 104;
const keyX = (v: number) => (((v - KEY_T0) / (KEY_T1 - KEY_T0)) * KEY_W).toFixed(1);
const stops = keyStops(R.limit);
const STEPS = ["start", "forward", "fault", "ack"] as const;
---

<div
  class:list={["lc-hmi-wrap", tone === "dark" && "on-dark", className]}
  data-variant={variant}
  data-tone={tone}
  id={id}
>
  {/* The demo's stylesheet is requested by the bootstrap below (PERF3-04): an in-body <link> + inline script held the
      parser, and with it DOMContentLoaded (the header / drawer code), ~0.6 s on slow phones. Without JS: this one. */}
  <noscript><link rel="stylesheet" href={hmiCss} /></noscript>
  {
    variant === "full" && (
      <header class="lc-hmi-intro">
        <div>
          <p class="lc-hmi-eyebrow type-label">
            <span class="slant-bar" aria-hidden="true" />
            {t.intro.eyebrow}
          </p>
          <H class="type-h2 lc-hmi-title" set:html={heading(locale, t.intro.title)} />
          <p class="type-lead lc-hmi-lead" set:html={html(locale, t.intro.lead)} />
        </div>
        <div class="lc-hmi-seeing">
          <p class="type-label">{t.intro.seeing}</p>
          <ul>
            {t.intro.bullets.map((b, i) => (
              <li>
                <span class="lc-hmi-bico" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="20" height="20">
                    {i === 0 && <path d="M6 9V6.5a4 4 0 0 1 8 0V9M4.5 9h11v8h-11zM10 12v2" />}
                    {i === 1 && <path d="M10 3a5 5 0 0 0-5 5v3.5L3.5 14h13L15 11.5V8a5 5 0 0 0-5-5zM8 16.5a2 2 0 0 0 4 0" />}
                    {i === 2 && <path d="M3 3v14h14M6 13l3.5-4 3 2.5L17 6" />}
                  </svg>
                </span>
                <span>
                  <strong set:html={html(locale, b.title)} /> <Fragment set:html={html(locale, b.text)} />
                </span>
              </li>
            ))}
          </ul>
        </div>
      </header>
    )
  }

  <figure class="lc-hmi" data-hmi data-fresh data-css={hmiCss} data-i18n={JSON.stringify(runtime)} aria-labelledby={`${u}-cap`}>
    <!-- "Try it": four steps that tick as the visitor plays (hmi-demo.ts) -->
    <div class="lc-hmi-tour" data-tour>
      <p class="lc-hmi-tour-h" id={`${u}-tour`}><span class="lc-led" aria-hidden="true"></span>{t.tour.label}</p>
      <ol aria-labelledby={`${u}-tour`}>
        {
          STEPS.map((k, i) => (
            <li data-step={k}>
              <span class="lc-hmi-stepn" aria-hidden="true">{i + 1}</span>
              {/* One cell, sized for its longest content (the label in bold, the current step's weight, and the hint):
                  a step turning current / done or the hint showing never re-wraps the list, so the keys below never
                  move under the finger (MOT3-05). */}
              <span class="lc-hmi-stepl">
                <span class="lc-hmi-stept" data-b={t.tour[k]}>
                  {t.tour[k]}
                </span>
                {/* while the fault develops: what to watch, drawn over the label (the step stays current until the plant
                    has diverted and recovered; screen readers still get the label, then the hint) */}
                {k === "fault" && (
                  <span class="lc-hmi-hint" data-step-hint>
                    {t.tour.watch}
                  </span>
                )}
              </span>
              <span class="lc-hmi-sr" data-step-st />
            </li>
          ))
        }
      </ol>
    </div>
    <div class="lc-hmi-dev" data-fab-avoid>
      <div
        class="lc-hmi-screen"
        dir="ltr"
        role="group"
        aria-label={t.a11y.panel}
        data-run="0"
        data-fdv="div"
        data-mode="auto"
        data-cip="-1"
        data-fluid="milk"
        data-recipe="milk"
      >
        <!-- status bar -->
        <div class="hs-bar">
          <div class="hs-brand">
            <BrandMark tone="dark" class="hs-mark" />
            <span class="hs-name">Logic Controls</span>
          </div>
          <div class="hs-unit"><span dir="auto">{t.status.unit}</span><span class="hs-screen" dir="auto">{t.status.screen}</span></div>
          <div class="hs-right">
            <span class="hs-chip hs-mode"><span class="lc-hmi-sr">{t.controls.mode}{colon(locale)}</span><span data-v="mode">{mode.auto}</span></span>
            <span class="hs-chip hs-state"><span class="lc-hmi-sr">{t.a11y.state}{colon(locale)}</span><span data-v="state">{t.status.ready}</span></span>
            <span class="hs-chip hs-alm"><span data-v="almCount">0</span><span class="lc-hmi-sr"> {t.alarms.unacked}</span></span>
            <span class="hs-sim"><span aria-hidden="true">{t.status.sim}</span><span class="lc-hmi-sr">{t.a11y.sim}</span></span>
            <time class="hs-clock" data-v="clock">--:--:--</time>
          </div>
        </div>

        <!-- process mimic (hmi-fit.ts crops the viewBox to the heating / holding / FDV core on narrow screens) -->
        <div class="hs-mimic">
          <svg viewBox="0 0 840 432" role="img" aria-label={t.a11y.mimic} focusable="false">
            <defs>
              <pattern id={`${u}-pl`} width="4.5" height="8" patternUnits="userSpaceOnUse">
                <rect width="2.2" height="8" class="m-plate" />
              </pattern>
              <linearGradient id={`${u}-tg`} data-key-grad>
                {stops.map(([o, c]) => <stop offset={o.toFixed(3)} stop-color={c} />)}
              </linearGradient>
              <!-- flow-direction chevron, drawn only when the marching dashes stop (reduced motion / pause switch) -->
              <marker id={`${u}-arr`} viewBox="0 0 10 10" refX="6" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto">
                <path class="m-arrp" d="M2.5 1.5L7 5l-4.5 3.5" />
              </marker>
              <clipPath id={`${u}-raw`}><rect x="24" y="98" width="66" height="162" rx="9" /></clipPath>
              <clipPath id={`${u}-sto`}><rect x="746" y="236" width="60" height="94" rx="6" /></clipPath>
            </defs>

            <!-- equipment: tanks -->
            <g class="m-eq">
              <rect x="22" y="96" width="70" height="166" rx="11" />
              <path d="M30 262v16M84 262v16" class="m-leg" />
              <path d="M150 206h56v70l-20 16h-16l-20-16z" />
              <rect x="744" y="234" width="64" height="98" rx="8" />
              <path d="M752 332v12M800 332v12" class="m-leg" />
            </g>
            <rect class="m-lvl" data-lvl="raw" data-y0="98" data-h="162" x="24" y="131" width="66" height="129" clip-path={`url(#${u}-raw)`} />
            <rect class="m-lvl" data-lvl="bt" data-y0="208" data-h="66" x="152" y="241" width="52" height="33" />
            <rect class="m-lvl" data-lvl="sto" data-y0="236" data-h="94" x="746" y="313" width="60" height="17" clip-path={`url(#${u}-sto)`} />

            <!-- pipes: outer wall, then the product inside (coloured by temperature, dashes = flow) -->
            <g class="m-pipe">
              {PIPES.map(([, d]) => <path d={d} />)}
              {holdSegs.map((s) => <path d={s.d} />)}
            </g>
            <g class="m-flow">
              {PIPES.map(([k, d]) => <path d={d} data-p={k} marker-end={`url(#${u}-arr)`} />)}
              {holdSegs.map((s) => <path d={s.d} data-p="hold" data-a={s.a} data-b={s.b} marker-end={`url(#${u}-arr)`} />)}
            </g>

            <!-- plate heat exchanger -->
            <g class="m-phe">
              <path class="m-bar" d="M292 186h286M292 312h286" />
              <rect x="304" y="194" width="252" height="110" fill={`url(#${u}-pl)`} />
              <rect class="m-frame" x="296" y="190" width="8" height="118" rx="1.5" />
              <rect class="m-frame" x="556" y="190" width="10" height="118" rx="1.5" />
              <rect class="m-frame" x="398" y="192" width="5" height="114" />
              <rect class="m-frame" x="472" y="192" width="5" height="114" />
              <g class="m-sec">
                <rect x="320" y="240" width="64" height="18" rx="2" /><text x="352" y="253">{t.mimic.regen}</text>
                <rect x="406" y="240" width="64" height="18" rx="2" /><text x="438" y="253">{t.mimic.heating}</text>
                <rect x="482" y="240" width="64" height="18" rx="2" /><text x="514" y="253">{t.mimic.cooling}</text>
              </g>
            </g>

            <!-- pumps -->
            <g class="m-pump" data-pump="feed" transform="translate(232 340)">
              <circle r="13" />
              <g class="m-imp"><circle r="8" /><path d="M0 0V-8M0 0l7 4M0 0l-7 4" /></g>
            </g>
            <g class="m-pump" data-pump="hw" transform="translate(455 392)">
              <circle r="13" />
              <g class="m-imp"><circle r="8" /><path d="M0 0V-8M0 0l7 4M0 0l-7 4" /></g>
            </g>
            <!-- steam/hot-water heater -->
            <g class="m-eq">
              <rect x="590" y="362" width="40" height="50" rx="5" />
              <path class="m-coil" d="M598 372h24M598 380h24M598 388h24M598 396h24M598 404h24" />
            </g>

            <!-- valves -->
            <g class="m-valve" data-valve="lv" transform="translate(110 246)">
              <path d="M-9-6L0 0-9 6zM9-6L0 0 9 6z" />
            </g>
            <g class="m-valve m-tcv" data-valve="tcv" transform="translate(700 402)">
              <path d="M0 0v-12" class="m-stem" />
              <path d="M-8-12a8 8 0 0 1 16 0z" class="m-act" />
              <path d="M-9-6L0 0-9 6zM9-6L0 0 9 6z" />
            </g>
            <g class="m-fdv" transform="translate(760 88)">
              <path d="M0 0v14" class="m-stem" />
              <rect x="-9" y="14" width="18" height="9" rx="2" class="m-act" />
              <path class="m-fin" d="M-12-7L0 0-12 7z" />
              <path class="m-ffwd" d="M-7-12L0 0 7-12z" />
              <path class="m-fdiv" d="M12-7L0 0 12 7z" />
              <g class="m-lock" transform="translate(16 18)">
                <rect x="-6" y="-2" width="12" height="9" rx="1.5" />
                <path d="M-3.5-2v-2.5a3.5 3.5 0 0 1 7 0V-2" />
              </g>
            </g>

            <!-- instrument bubbles (ISA-5.1) -->
            <g class="m-tags">
              <path d="M282 311v16M439 160h16M724 75v13M626 225v-11M520 357v-11M792 389v13" class="m-lead" />
              {
                TAGS.map((g) => (
                  <g transform={`translate(${g.x} ${g.y})`}>
                    <circle r="11" />
                    <text y="-1.5">{g.a}</text>
                    <text y="7.5">{g.n}</text>
                  </g>
                ))
              }
            </g>

            <!-- readouts -->
            <g class="m-ro">
              <g transform="translate(34 166)"><rect width="46" height="17" rx="2" /><text x="42" y="12.5"><tspan data-v="rawLvl">{n1(82)}</tspan> %</text></g>
              <g transform="translate(155 222)"><rect width="46" height="17" rx="2" /><text x="42" y="12.5"><tspan data-v="btLvl">{n1(50)}</tspan> %</text></g>
              <g transform="translate(750 280)"><rect width="52" height="17" rx="2" /><text x="48" y="12.5"><tspan data-v="stoLvl">{n1(18)}</tspan> %</text></g>
              <g transform="translate(238 268)"><rect width="70" height="17" rx="2" /><text x="66" y="12.5"><tspan data-v="flow">0</tspan> L/h</text></g>
              <g transform="translate(350 152)" data-alm-ro="TT-101"><rect width="64" height="17" rx="2" /><text x="60" y="12.5"><tspan data-v="th">{n1(24)}</tspan> °C</text></g>
              <g transform="translate(638 55)" data-alm-ro="TT-102"><rect width="64" height="17" rx="2" /><text x="60" y="12.5"><tspan data-v="tt102">{n1(24)}</tspan> °C</text></g>
              <g transform="translate(640 228)"><rect width="58" height="17" rx="2" /><text x="54" y="12.5"><tspan data-v="tout">{n1(6)}</tspan> °C</text></g>
              <g transform="translate(532 360)"><rect width="58" height="17" rx="2" /><text x="54" y="12.5"><tspan data-v="thw">{n1(70)}</tspan> °C</text></g>
              <g transform="translate(716 370)" data-alm-ro="PT-201"><rect width="64" height="17" rx="2" /><text x="60" y="12.5"><tspan data-v="steam">{n1(3)}</tspan> bar</text></g>
              <g transform="translate(714 410)"><rect width="52" height="16" rx="2" /><text x="48" y="12"><tspan data-v="valve">0</tspan> %</text></g>
            </g>

            <!-- alarm indicators next to readouts (ISA-101: shape + colour + number; filled = unacknowledged) -->
            <g class="m-alm" data-p="3" data-alm-ind="TT-101" transform="translate(338 160)"><g class="m-almi"><path d="M0-8L8 0 0 8-8 0z" /><text y="3.5">3</text></g></g>
            <g class="m-alm" data-p="1" data-alm-ind="TT-102" transform="translate(626 63)"><g class="m-almi"><path d="M-7-7h14v14h-14z" /><text y="3.5">1</text></g></g>
            <g class="m-alm" data-p="2" data-alm-ind="PT-201" transform="translate(818 378)"><g class="m-almi"><path d="M0-8l8 14h-16z" /><text y="4.5">2</text></g></g>

            <!-- product temperature colour key (cool below the legal limit, warm at / above it) -->
            <g class="m-key" transform="translate(296 408)">
              <rect width={KEY_W} height="5" rx="2.5" fill={`url(#${u}-tg)`} />
              <g class="m-key-lim" transform={`translate(${keyX(R.limit)} 0)`}>
                <path d="M0-3v11" />
                <text y="-5" data-v="keyLim">{R.limit}</text>
              </g>
              <text x="0" y="17">{KEY_T0} °C</text>
              <text x={KEY_W} y="17" class="m-e">{KEY_T1} °C</text>
            </g>

            <!-- labels -->
            <g class="m-lbl">
              <text x="57" y="86">{t.mimic.raw}</text>
              <text x="57" y="73" class="m-tagtx">T-101</text>
              <text x="110" y="268" class="m-tagtx">LV-101</text>
              <text x="212" y="290" class="m-tagtx m-s">B-101</text>
              <text x="146" y="314" class="m-e">{t.mimic.balance}</text>
              <text x="232" y="370">{t.mimic.feedPump}</text>
              <text x="232" y="382" class="m-tagtx">P-101</text>
              <text x="412" y="342" class="m-e">{t.mimic.phe}</text>
              <text x="590" y="105">{t.mimic.holding}</text>
              <text x="590" y="118" class="m-holdv"><tspan data-v="hold">{n1(0)}</tspan> s</text>
              <text x="760" y="134" class="m-tagtx">FDV-101</text>
              <text x="760" y="148" class="m-fdvst" data-v="fdvTxt">{t.mimic.divert}</text>
              <text x="520" y="33" class="m-dir">{t.mimic.forward} ←</text>
              <text x="480" y="16" class="m-dir">{t.mimic.divert} ←</text>
              <text x="776" y="350" data-v="outLbl">{t.mimic.storage}</text>
              <text x="776" y="361" class="m-tagtx">T-301</text>
              <text x="455" y="420">{t.mimic.hwPump}</text>
              <text x="638" y="356" class="m-s">{t.mimic.hotWater}</text>
              <text x="548" y="328" class="m-s">{t.mimic.iceWater}</text>
              <text x="834" y="424" class="m-e">{t.mimic.steam}</text>
              <text x="700" y="378" class="m-tagtx">TCV-201</text>
              <text x="178" y="203" class="m-cipl">{t.mimic.cipSupply}</text>
            </g>
          </svg>
        </div>

        <!-- operator message line -->
        <p class="hs-msg" dir={dir}>
          <span data-msg set:html={pressHtml} />
          {/* phones: the "Try it" list is off screen while playing; the current step mirrors it here (the list says it to AT) */}
          <span class="hs-tourn" aria-hidden="true" data-tour-n dir="ltr">1/4</span>
        </p>

        <!-- command bar (function keys) -->
        <div class="hs-cmd" data-teaser-anchor>
          <div class="hs-seg hs-run" role="group" aria-label={t.controls.run}>
            <button type="button" data-c="start" aria-pressed="false" data-next>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3l8 5-8 5z" /></svg>{t.controls.start}
            </button>
            <button type="button" data-c="stop" aria-pressed="true">
              <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="4" width="8" height="8" rx="1" /></svg>{t.controls.stop}
            </button>
          </div>
          <div class="hs-seg" role="group" aria-label={t.controls.mode}>
            <button type="button" data-c="auto" aria-pressed="true">{t.controls.auto}</button>
            <button type="button" data-c="manual" aria-pressed="false">{t.controls.manual}</button>
          </div>
