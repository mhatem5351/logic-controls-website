---
/**
 * ControlLoop — animated explainer of a closed loop: Sensor → PLC → Actuator → Process → back to the Sensor, with the
 * HMI / SCADA beside the PLC as a supervisory branch (dashed, two-way: status up, operator commands down). The list
 * keeps the five nodes in reading order; the drawing shows the PLC driving the actuator directly (an arc over the HMI
 * node), as in a real plant.
 * Pure CSS timeline (one 7.5 s cycle, played 3 times while the diagram is on screen, then it rests as the static
 * diagram). Everything that moves is composited: the amber signal dots ride full-length carriers moved with
 * `translate`, and each node's "strike" is a pre-rendered royal disc faded in with `opacity`. A tiny script flips
 * data-play when the diagram itself is on screen (the node row, not the intro: ≥ 50% of it on desktop; in the tall
 * vertical layout once the Sensor is 20% above the bottom edge), so cycle 1 starts where the eye is. Until the three
 * cycles have played, every new showing restarts from the Sensor; after the rest, hovering / tapping the diagram (or
 * focus inside it) replays one cycle. In the vertical layout the script also measures where the PLC → Actuator arc
 * starts and ends. Horizontal ≥ 64rem, vertical below. Static under reduced motion / html[data-motion="off"], with
 * every arrowhead drawn. Plain (un-nested) CSS, so browsers without CSS nesting (Firefox ESR 115) animate it too.
 */
import { getMessages, type Locale } from "~/i18n";
import Icon from "~/components/Icon.astro";
import { heading, html } from "~/lib/text";

interface Props {
  locale: Locale;
  /** Show eyebrow / title / lead above the diagram. */
  intro?: boolean;
  tone?: "light" | "dark";
  headingLevel?: 2 | 3;
  class?: string;
}

const { locale, intro = true, tone = "light", headingLevel = 2, class: className } = Astro.props;
const t = getMessages(locale).hmi.loop;
const H = headingLevel === 3 ? "h3" : "h2";
const N = headingLevel === 3 ? "h4" : "h3";
// ranges always with an en dash ("4–20 mA", "0–50 Hz"), whatever the copy uses
const range = (s: string) => s.replace(/(\d)\s?-\s?(\d)/g, "$1–$2");
/** When each node's strike peaks in the cycle (s): the signal arrives there (see the timeline in the styles). */
const GLOW = { sensor: 6.78, plc: 1.12, hmi: 2.02, actuator: 2.72, process: 3.92 } as const;
const nodes = (["sensor", "plc", "hmi", "actuator", "process"] as const).map((k) => ({ k, ...t.nodes[k], spec: range(t.nodes[k].spec) }));
const icon = { sensor: "thermometer", plc: "plc", hmi: "hmi", process: "factory" } as const;
/** Wire after each node: signal hop, supervisory link (PLC ⇄ HMI), none (HMI → Actuator is not a path), hop, last. */
const WIRE = ["hop", "sup", "skip", "hop", "last"] as const;
const ARABIC = /[\u0600-\u06FF]/;
---

<div class:list={["lc-loop", tone === "dark" && "on-dark", className]} data-loop data-play="0" data-tone={tone}>
  {
    intro && (
      <header class="lc-loop-head">
        <p class="type-label lc-loop-eyebrow">
          <span class="slant-bar" aria-hidden="true" />
          <span set:html={html(locale, t.eyebrow)} />
        </p>
        <H class="type-h2 lc-loop-title" set:html={heading(locale, t.title)} />
        <p class="type-lead lc-loop-lead" set:html={html(locale, t.lead)} />
      </header>
    )
  }
  <div class="lc-loop-body">
    <ol class="lc-loop-row">
      {
        nodes.map((n, i) => (
          <li class="lc-loop-node" data-k={n.k} style={`--gd:${GLOW[n.k]}s`}>
            <span class="lc-loop-ic" aria-hidden="true">
              {[0, 1].map((on) => (
                <span class={on ? "lc-loop-on" : "lc-loop-off"}>
                  {n.k === "actuator" ? (
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3.5 11.5l8.5 5 8.5-5v9l-8.5-5-8.5 5zM12 16.5V8M7.5 8a4.5 4.5 0 0 1 9 0z" />
                    </svg>
                  ) : (
                    <Icon name={icon[n.k]} size={26} />
                  )}
                </span>
              ))}
            </span>
            <div class="lc-loop-txt">
              <N class="lc-loop-l">
                {/* the index is decoration (the <ol> numbers the nodes for AT); its trailing space collapses at the end of
                    the flex item, so it only separates the words in extracted text ("01 Sensor", CS2-06) */}
                <span class="lc-loop-n" aria-hidden="true">{`${String(i + 1).padStart(2, "0")} `}</span>
                <span set:html={heading(locale, n.label)} />
              </N>
              <span class="lc-loop-t" set:html={html(locale, n.text)} />
              {/* codes and units read left to right; an Arabic spec ("PID · دورة المسح 10 ms") follows the page */}
              <span class="lc-loop-spec" dir={ARABIC.test(n.spec) ? "rtl" : "ltr"} set:html={html(locale, n.spec)} />
            </div>
            <span class="lc-loop-wire" data-w={WIRE[i]} aria-hidden="true">
              {(WIRE[i] === "hop" || WIRE[i] === "sup") && <i />}
            </span>
          </li>
        ))
      }
    </ol>
    {/* PLC → Actuator (over the HMI node) and Process → Sensor: three legs each, one dot per leg */}
    <span class="lc-loop-byp" aria-hidden="true"><i class="lg lg-a"></i><i class="lg lg-b"></i><i class="lg lg-c"></i></span>
    <span class="lc-loop-ret" aria-hidden="true"><i class="lg lg-a"></i><i class="lg lg-b"></i><i class="lg lg-c"></i></span>
  </div>
  <p class="lc-loop-cap" set:html={html(locale, t.caption)} />
</div>

<script>
  import { motionOff, onMotionChange } from "~/scripts/motion/motion-pref";

  const loops = [...document.querySelectorAll<HTMLElement>("[data-loop]")];
  const wide = matchMedia("(min-width: 64rem)");
  /* getAnimations() drops a CSS animation once it has finished (no fill), so the loop keeps its own set to seek them
     again; a cancelled one (motion switched off: the rule is gone) is idle and leaves the set. */
  const known = new WeakMap<HTMLElement, Set<Animation>>();
  const anims = (el: HTMLElement) => {
    let s = known.get(el);
    if (!s) known.set(el, (s = new Set()));
    for (const a of el.getAnimations({ subtree: true })) s.add(a);
    for (const a of s) if (a.playState === "idle") s.delete(a);
    return [...s];
  };
  const num = (el: HTMLElement, k: string, d: number) => parseFloat(getComputedStyle(el).getPropertyValue(k)) || d;
  /** One cycle (ms) and cycles per showing, from the CSS (--lp-cycle / --lp-n). */
  const cycle = (el: HTMLElement) => num(el, "--lp-cycle", 7.5) * 1000;
  const cycles = (el: HTMLElement) => num(el, "--lp-n", 3);
  /** All cycles played: past the last cycle's Sensor strike (+ its fade), nothing visible changes any more. */
  const rested = (el: HTMLElement) => {
    const a = anims(el);
    const end = cycles(el) * cycle(el) + 400;
    return a.length > 0 && a.every((x) => x.playState === "finished" || Number(x.currentTime) >= end);
  };
  const seek = (el: HTMLElement, t: number) => anims(el).forEach((a) => (a.currentTime = t));
  // plays only while on screen, in a visible tab, and when motion is allowed (else the CSS shows the static diagram)
  const play = (el: HTMLElement) => (el.dataset.play = el.dataset.vis === "1" && !document.hidden && !motionOff() ? "1" : "0");
  /** When the diagram left the screen (a real new showing restarts from the Sensor; a jitter at the edge resumes). */
  const away = new WeakMap<HTMLElement, number>();
  /* The node row (not the intro above it) decides: on desktop ≥ 50% of it inside the top 80% of the viewport; in the
     tall vertical layout as soon as its top (the Sensor) is 20% above the bottom edge. */
  const io = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-loop]")!;
        const vis = wide.matches ? e.intersectionRatio >= 0.5 : e.isIntersecting;
        const was = el.dataset.vis === "1";
        el.dataset.vis = vis ? "1" : "0";
        if (vis && !was) {
          if (performance.now() - (away.get(el) ?? -1e9) > 600 && !rested(el)) seek(el, 0);
        } else if (!vis && was) away.set(el, performance.now());
        play(el);
      }),
    { rootMargin: "0px 0px -20% 0px", threshold: [0, 0.5] },
  );
  /** After the rest: one more cycle, from the Sensor (the timeline's last cycle), on hover / tap / focus. */
  const replay = (el: HTMLElement) => {
    if (motionOff() || el.dataset.play !== "1" || !rested(el)) return;
    seek(el, (cycles(el) - 1) * cycle(el));
  };
  // vertical layout: the PLC → Actuator arc runs from the PLC icon's centre to the Actuator icon's centre
  const measure = (el: HTMLElement) => {
    const body = el.querySelector<HTMLElement>(".lc-loop-body")!;
    if (wide.matches) return body.removeAttribute("data-byp");
    const ic = (k: string) => el.querySelector<HTMLElement>(`[data-k="${k}"] .lc-loop-ic`)!;
    const b = body.getBoundingClientRect();
    const mid = (k: string) => {
      const r = ic(k).getBoundingClientRect();
      return r.top + r.height / 2 - b.top;
    };
    const top = mid("plc");
    body.style.setProperty("--byp-t", `${top.toFixed(1)}px`);
    body.style.setProperty("--byp-h", `${(mid("actuator") - top).toFixed(1)}px`);
    body.setAttribute("data-byp", "");
  };
  const ro = new ResizeObserver((es) => es.forEach((e) => measure((e.target as HTMLElement).closest<HTMLElement>("[data-loop]")!)));
  for (const el of loops) {
    const body = el.querySelector<HTMLElement>(".lc-loop-body")!;
    el.dataset.vis = "0";
    anims(el); // all still pending (paused at 0) here: remember them
    io.observe(body);
    ro.observe(body);
    // the body is a plain block (never a focus target itself); focusin only fires for content inside it
    body.addEventListener("pointerenter", (e) => e.pointerType !== "touch" && replay(el));
    body.addEventListener("click", () => replay(el));
    body.addEventListener("focusin", () => replay(el));
  }
  document.addEventListener("visibilitychange", () => loops.forEach(play));
  onMotionChange(() => loops.forEach((el) => (play(el), anims(el))));
</script>

<style is:global>
  .lc-loop {
    --lp-cycle: 7.5s;
    --lp-n: 3; /* cycles per showing */
    --lp-ic: 3.5rem;
    --lp-pad: 2.75rem; /* vertical layout: room for the two brackets on the inline-start side */
    --lp-line: var(--color-navy-200);
    --lp-pulse: var(--color-signal-400);
    --lp-ink: var(--color-navy-800);
    --lp-title: var(--color-navy-950); /* like every other light-band H2 */
    --lp-txt: var(--color-charcoal-600);
    --lp-ic-bg: #fff;
    --dir: 1;
  }
  [dir="rtl"] .lc-loop {
    --dir: -1;
  }
  .lc-loop[data-tone="dark"] {
    --lp-line: rgb(150 182 232 / 0.35);
    --lp-ink: #fff;
    --lp-title: #fff;
    --lp-txt: var(--color-navy-200);
    --lp-ic-bg: var(--color-navy-900);
  }
  .lc-loop-head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }
  .lc-loop-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-royal-600);
  }
  .lc-loop[data-tone="dark"] .lc-loop-eyebrow {
    color: var(--color-royal-300);
  }
  .lc-loop-title {
    margin-top: 0.85rem;
    color: var(--lp-title);
  }
  .lc-loop-lead {
    margin-top: 1rem;
    color: var(--lp-txt);
  }
  /* the dot carriers travel by their own length: clip, so they never add page overflow (RTL scrolls leftwards) */
  .lc-loop-body {
    position: relative;
    overflow: clip;
    overflow-clip-margin: 1rem;
  }
  .lc-loop-row {
    list-style: none;
    margin: 0;
    padding: 0 0 1.5rem;
    padding-inline-start: var(--lp-pad);
    display: grid;
    gap: 1.75rem;
  }
  .lc-loop-node {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .lc-loop-ic {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    width: var(--lp-ic);
    height: var(--lp-ic);
    border-radius: 50%;
    border: 1.5px solid var(--lp-line);
    background: var(--lp-ic-bg);
    color: var(--color-royal-600);
  }
  .lc-loop-ic > span {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  /* the strike: a royal disc with a white icon, faded in when the signal arrives (opacity only: composited) */
  .lc-loop-on {
    margin: -1.5px;
    background: var(--color-royal-600);
    color: #fff;
    box-shadow:
      0 0 0 6px rgb(37 122 224 / 0.18),
      0 10px 26px -8px rgb(5 86 173 / 0.7);
    opacity: 0;
  }
  .lc-loop[data-tone="dark"] .lc-loop-ic {
    color: var(--color-royal-300);
  }
  .lc-loop-txt {
    display: grid;
    gap: 0.3rem;
    padding-top: 0.2rem;
  }
  .lc-loop-l {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.3;
    color: var(--lp-ink);
  }
  .lc-loop-n {
    font: 600 0.75rem/1 var(--font-mono);
    color: var(--color-royal-600);
  }
  .lc-loop[data-tone="dark"] .lc-loop-n {
    color: var(--color-signal-300);
  }
  .lc-loop-t {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--lp-txt);
  }
  .lc-loop-spec {
    justify-self: start;
    margin-top: 0.2rem;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    background: var(--color-charcoal-100);
    color: var(--color-charcoal-700);
    font: 500 0.75rem/1.4 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  /* Chinese / Arabic words in the spec chip: the page's script face, not whatever the OS maps "monospace" to */
  .lc-loop-spec:lang(zh-Hans) {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  }
  .lc-loop-spec:lang(ar) {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, var(--font-arabic), sans-serif;
  }
  .lc-loop[data-tone="dark"] .lc-loop-spec {
    background: rgb(150 182 232 / 0.1);
    color: var(--color-navy-100);
  }

  /* ---------------------------------------------------------- wires (vertical on phones / tablets) */
  .lc-loop-wire {
    position: absolute;
    inset-inline-start: calc(var(--lp-ic) / 2 - 1px);
    top: calc(var(--lp-ic) + 4px);
    bottom: calc(-1.75rem + 4px);
    width: 2px;
    background: var(--lp-line);
  }
  /* arrowhead at the downstream end */
  .lc-loop-wire::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: -4px;
    border: 5px solid transparent;
    border-top: 6px solid var(--lp-line);
    border-bottom: 0;
  }
  /* last node: the line down to the return bracket, no arrowhead */
  .lc-loop-wire[data-w="last"] {
    bottom: -1.5rem;
  }
  .lc-loop-wire[data-w="last"]::after {
    display: none;
  }
  /* PLC ⇄ HMI: supervisory link, dashed, arrowheads both ways */
  .lc-loop-wire[data-w="sup"] {
    background: repeating-linear-gradient(var(--lp-line) 0 4px, transparent 4px 8px);
  }
  .lc-loop-wire[data-w="sup"]::before {
    content: "";
    position: absolute;
    top: -2px;
    left: -4px;
    border: 5px solid transparent;
    border-bottom: 6px solid var(--lp-line);
    border-top: 0;
  }
  /* HMI → Actuator is not a signal path: the PLC → Actuator arc replaces it (once measured, see the script) */
  .lc-loop-body[data-byp] .lc-loop-wire[data-w="skip"] {
    display: none;
  }

  /* dots: a carrier the size of its line, moved by translate (percent of the carrier = the line length) */
  .lc-loop-wire > i,
  .lc-loop .lg {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .lc-loop-wire > i {
    inset: 0;
    --to: 0 100%;
  }
  .lc-loop-wire > i::before,
  .lc-loop .lg::before {
    content: "";
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lp-pulse);
    box-shadow:
      0 0 0 3px rgb(255 176 43 / 0.25),
      0 0 12px 2px rgb(255 176 43 / 0.7);
  }
  .lc-loop-wire > i::before {
    top: -5px;
    left: -4px;
  }
  .lc-loop-wire[data-w="sup"] > i::before {
    scale: 0.7;
    opacity: 0.85;
  }

  /* brackets: PLC → Actuator (inner, measured) and Process → Sensor (outer) on the inline-start side */
  .lc-loop-ret,
  .lc-loop-byp {
    position: absolute;
    border: 2px solid var(--lp-line);
    border-inline-end: 0;
    border-start-start-radius: 12px;
    border-end-start-radius: 12px;
  }
  .lc-loop-ret {
    inset-inline-start: 0.5rem;
    top: calc(var(--lp-ic) / 2 - 1px);
    bottom: 0;
    width: calc(var(--lp-pad) - 0.5rem + var(--lp-ic) / 2);
    border-style: dashed;
    border-inline-end: 0;
  }
  .lc-loop-byp {
    display: none;
    inset-inline-start: 1.5rem;
    top: calc(var(--byp-t, 0px) - 1px);
    height: calc(var(--byp-h, 0px) + 2px);
    width: calc(var(--lp-pad) - 1.5rem + var(--lp-ic) / 2);
  }
  .lc-loop-body[data-byp] .lc-loop-byp {
    display: block;
  }
  /* static arrowheads into the Sensor (return) and into the Actuator (arc), visible in every motion mode */
  .lc-loop-ret::after,
  .lc-loop-byp::after {
    content: "";
    position: absolute;
    inset-inline-start: calc(var(--lp-pad) - 0.5rem - 9px);
    top: -4px;
    border: 5px solid transparent;
    border-inline-start: 7px solid var(--lp-line);
    border-inline-end: 0;
  }
  .lc-loop-byp::after {
    top: auto;
    bottom: -4px;
    inset-inline-start: calc(var(--lp-pad) - 1.5rem - 9px);
  }
  /* legs (vertical layout) — return: bottom → inline-start side → top; arc: top → inline-start side → bottom */
  .lc-loop .lg-a,
  .lc-loop .lg-c {
    inset-inline: 0;
    height: 2px;
  }
  .lc-loop .lg-b {
    inset-block: 0;
    inset-inline-start: -2px;
    width: 2px;
  }
  .lc-loop .lg::before {
    top: -4px;
  }
  .lc-loop .lg-b::before {
    left: -4px;
  }
  .lc-loop-ret .lg-a {
    bottom: -2px;
    --to: calc(var(--dir) * -100%) 0;
  }
  .lc-loop-ret .lg-a::before,
  .lc-loop-byp .lg-a::before {
    inset-inline-end: -5px;
  }
  .lc-loop-ret .lg-b {
    --to: 0 -100%;
  }
  .lc-loop-ret .lg-b::before {
    top: auto;
    bottom: -5px;
  }
  .lc-loop-ret .lg-c,
  .lc-loop-byp .lg-a {
    top: -2px;
  }
  .lc-loop-ret .lg-c,
  .lc-loop-byp .lg-c {
    --to: calc(var(--dir) * 100%) 0;
  }
  .lc-loop-ret .lg-c::before,
  .lc-loop-byp .lg-c::before {
    inset-inline-start: -5px;
  }
  .lc-loop-byp .lg-a {
    --to: calc(var(--dir) * -100%) 0;
  }
  .lc-loop-byp .lg-b {
    --to: 0 100%;
  }
  .lc-loop-byp .lg-b::before {
    top: -5px;
  }
  .lc-loop-byp .lg-c {
    bottom: -2px;
  }

  .lc-loop-cap {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--lp-txt);
  }

  /* ---------------------------------------------------------- timeline (one 7.5 s cycle, --lp-n times)
     0.20 s  Sensor → PLC hop (0.9 s)             1.12  PLC strikes
     1.50 s  PLC → HMI status blip (0.5 s)        2.02  HMI strikes (lighter)
     1.50 s  PLC → Actuator arc (0.12 + 0.95 + 0.12 s)   2.72  Actuator strikes
     3.00 s  Actuator → Process hop (0.9 s)       3.92  Process strikes
     4.20 s  Process → Sensor return (0.12 + 2.3 + 0.12 s: within 2× the forward speed)   6.78  Sensor strikes
     Hops ease in and out (a packet that accelerates and settles); bracket legs run at constant speed. */
  @media (prefers-reduced-motion: no-preference) {
    /* written out (no CSS nesting): Firefox < 117 drops nested rules, so ESR 115 would show a static diagram */
    :root:not([data-motion="off"]) .lc-loop .lc-loop-on {
      animation: lc-loop-glow var(--lp-cycle) linear var(--lp-n);
      animation-delay: calc(var(--gd) - 0.1s);
    }
    :root:not([data-motion="off"]) .lc-loop [data-k="hmi"] .lc-loop-on {
      --gmax: 0.6;
    }
    :root:not([data-motion="off"]) .lc-loop .lc-loop-wire[data-w="hop"] > i {
      animation: lc-loop-hop var(--lp-cycle) linear var(--lp-n);
    }
    :root:not([data-motion="off"]) .lc-loop [data-k="sensor"] .lc-loop-wire > i {
      animation-delay: 0.2s;
    }
    :root:not([data-motion="off"]) .lc-loop [data-k="actuator"] .lc-loop-wire > i {
      animation-delay: 3s;
    }
    :root:not([data-motion="off"]) .lc-loop .lc-loop-wire[data-w="sup"] > i {
      animation: lc-loop-blip var(--lp-cycle) linear var(--lp-n) 1.5s;
    }
    :root:not([data-motion="off"]) .lc-loop .lg-a,
    :root:not([data-motion="off"]) .lc-loop .lg-c {
      animation: lc-loop-leg-s var(--lp-cycle) linear var(--lp-n);
    }
    :root:not([data-motion="off"]) .lc-loop .lc-loop-byp .lg-a {
      animation-delay: 1.5s;
    }
    :root:not([data-motion="off"]) .lc-loop .lc-loop-byp .lg-b {
      animation: lc-loop-leg-b var(--lp-cycle) linear var(--lp-n) 1.62s;
    }
    :root:not([data-motion="off"]) .lc-loop .lc-loop-byp .lg-c {
      animation-delay: 2.57s;
    }
