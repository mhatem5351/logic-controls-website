---
/**
 * Site header.
 *  - Utility bar (≥1024px): "Setting up in Egypt?" link, phone, email, full language list. Scrolls away.
 *  - Main bar (sticky): logo, 5 nav items, quick Arabic/English switch, language menu (< 1024px only), "Request a quote",
 *    menu button.
 *  - Mobile drawer: native <dialog> (focus trap, Esc, inert page) opened by a tiny script.
 * `heroDark`: starts transparent over a dark hero, turns solid once the page scrolls.
 */
import { getMessages, type Locale } from "~/i18n";
import { SITE } from "~/data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { MAIN_NAV, FOREIGN_PATH, QUOTE_PATH, href, currentState, languageLinks, whatsappLink, mailtoLink, prefersEmail } from "./nav";

interface Props {
  locale: Locale;
  path: string;
  heroDark?: boolean;
}
const { locale, path, heroDark = false } = Astro.props;
const t = getMessages(locale).ui;
const email = prefersEmail(locale);
// Egyptian phones set to English land on /en/: keep a one-tap Arabic switch visible on English pages;
// Arabic, Chinese and Turkish pages get a one-tap English switch (what foreign visitors reach for). Desktop shows only this quick switch + the utility-bar list; the globe menu is mobile-only.
const quick = languageLinks(path).find((l) => l.locale === (locale === "en" ? "ar" : "en"));
const foreignState = currentState(FOREIGN_PATH, path);
---

<header
  class="lc-header on-dark sticky z-50 text-white"
  style="top: calc(-1 * var(--utility-h))"
  data-hero={heroDark ? "" : undefined}
>
  <div class="lc-header-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  {/* ---------- utility bar ---------- */}
  <div class="hidden h-(--utility-h) border-b border-white/8 text-[0.8125rem] lg:block">
    <div class="wrap flex h-full items-center justify-between gap-6">
      <a
        href={href(locale, FOREIGN_PATH)}
        aria-current={foreignState}
        class="group inline-flex min-h-6 items-center gap-2.5 font-semibold text-signal-300 transition-colors hover:text-white"
      >
        <span class="lc-led" aria-hidden="true"></span>
        <span>{t.nav.foreign}</span>
        <Icon name="arrow" size={14} class="transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" />
      </a>
      <div class="flex items-center gap-6 text-navy-200">
        <a href={`tel:${SITE.phone.tel}`} class="inline-flex min-h-6 items-center gap-2 transition-colors hover:text-white">
          <Icon name="phone" size={14} class="text-royal-300" />
          <span class="ltr" dir="ltr">{SITE.phone.display}</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="inline-flex min-h-6 items-center gap-2 transition-colors hover:text-white">
          <Icon name="mail" size={14} class="text-royal-300" />
          <span class="ltr" dir="ltr">{SITE.email}</span>
        </a>
        <span class="h-4 w-px bg-white/15" aria-hidden="true"></span>
        <LanguageSwitcher locale={locale} path={path} variant="inline" class="-me-2" />
      </div>
    </div>
  </div>

  {/* ---------- main bar ---------- */}
  <div class="h-(--header-h)">
    <div class="wrap flex h-full items-center gap-4 lg:gap-8">
      <a href={href(locale)} aria-label={t.a11y.homeLink} class="-my-1 shrink-0 py-1">
        <Logo variant="dark" width={124} loading="eager" class="h-auto w-[104px] lg:w-[124px]" alt="" />
      </a>

      <nav aria-label={t.a11y.mainNav} class="hidden lg:block">
        <ul role="list" class="flex items-center gap-0.5 xl:gap-2">
          {
            MAIN_NAV.map((item) => {
              const state = currentState(item.path, path);
              return (
                <li>
                  <a
                    href={href(locale, item.path)}
                    aria-current={state}
                    class:list={[
                      "lc-nav-link relative inline-flex h-10 items-center px-2.5 text-[0.9375rem] font-semibold whitespace-nowrap transition-colors xl:px-3",
                      state ? "text-white" : "text-navy-100 hover:text-white",
                    ]}
                  >
                    {t.nav[item.key]}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="ms-auto flex items-center gap-2 sm:gap-3">
        {
          quick && (
            <a
              href={quick.href}
              hreflang={quick.hreflang}
              lang={quick.htmlLang}
              dir={quick.dir}
              data-set-lang={quick.locale}
              class:list={[
                "inline-flex h-10 items-center border border-white/20 px-3 font-semibold whitespace-nowrap text-white transition-colors hover:border-signal-400 hover:text-signal-200 lg:max-xl:hidden",
                quick.locale === "ar" ? "text-[1.0625rem]" : "text-sm",
              ]}
            >
              {quick.native}
            </a>
          )
        }
        <LanguageSwitcher locale={locale} path={path} variant="menu" class:list={["lg:hidden", quick && "max-sm:hidden"]} />
        <Button href={href(locale, QUOTE_PATH)} size="sm" class="max-sm:hidden lg:min-h-10">
          {t.cta.quote}
        </Button>
        <button
          type="button"
          class="lc-menu-open inline-flex size-10 items-center justify-center border border-white/20 text-white transition-colors hover:border-white/50 lg:hidden"
          aria-haspopup="dialog"
          aria-controls="lc-drawer"
        >
          <Icon name="menu" size={22} />
          <span class="sr-only">{t.a11y.menu}</span>
        </button>
      </div>
    </div>
  </div>

  {/* ---------- mobile drawer ---------- */}
  <dialog id="lc-drawer" class="lc-drawer on-dark bg-navy-950 text-navy-100" aria-label={t.a11y.menu}>
    <div class="flex min-h-full flex-col">
      <div class="flex h-16 shrink-0 items-center justify-between border-b border-white/10 px-5">
        <Logo variant="dark" width={104} alt="Logic Controls" loading="lazy" />
        <button
          type="button"
          class="lc-menu-close inline-flex size-11 items-center justify-center border border-white/20 text-white hover:border-white/50"
          autofocus
        >
          <Icon name="close" size={22} />
          <span class="sr-only">{t.a11y.closeMenu}</span>
        </button>
      </div>
      <nav aria-label={t.a11y.mainNav} class="px-5 pt-4">
        <ul role="list" class="divide-y divide-white/8">
          {
            MAIN_NAV.map((item, i) => {
              const state = currentState(item.path, path);
              return (
                <li>
                  <a
                    href={href(locale, item.path)}
                    aria-current={state}
                    class:list={[
                      "flex min-h-14 items-center justify-between text-lg font-bold",
                      state ? "text-white" : "text-navy-100 hover:text-white",
                    ]}
                  >
                    <span class="flex items-center gap-4">
                      <span class="font-mono text-xs font-medium text-navy-400 ltr" dir="ltr" aria-hidden="true">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      {t.nav[item.key]}
                    </span>
                    <Icon name="chevron-right" size={20} class={state ? "text-signal-400" : "text-navy-400"} />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <div class="px-5 pt-5">
        <a
          href={href(locale, FOREIGN_PATH)}
          aria-current={foreignState}
          class="flex min-h-14 items-center gap-3 border border-signal-400/40 bg-signal-400/[0.07] px-4 font-semibold text-signal-200 hover:border-signal-400"
        >
          <span class="lc-led" aria-hidden="true"></span>
          <span class="flex-1">{t.nav.foreign}</span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="grid gap-3 px-5 pt-6">
        <Button href={href(locale, QUOTE_PATH)} size="lg" block iconEnd="arrow">
          {t.cta.quote}
        </Button>
        {
          email ? (
            <Button href={mailtoLink(t.email.subject)} size="lg" variant="on-dark" block icon="mail" iconClass="text-royal-300">
              {t.cta.emailEngineer}
            </Button>
          ) : (
            <Button href={whatsappLink(t.whatsapp.message)} size="lg" variant="on-dark" block icon="whatsapp" iconClass="text-[#25d366]" external>
              {t.cta.whatsapp}
            </Button>
          )
        }
      </div>
      <div class="px-5 pt-8">
        <p class="mb-3 type-label text-navy-300">{t.a11y.language}</p>
        <LanguageSwitcher locale={locale} path={path} variant="grid" />
      </div>
      <div class="mt-auto space-y-1 border-t border-white/10 px-5 pt-5 pb-8 text-sm text-navy-200">
        <a href={`tel:${SITE.phone.tel}`} class="flex min-h-11 items-center gap-3 hover:text-white">
          <Icon name="phone" size={18} class="text-royal-300" />
          <span class="ltr" dir="ltr">{SITE.phone.display}</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="flex min-h-11 items-center gap-3 hover:text-white">
          <Icon name="mail" size={18} class="text-royal-300" />
          <span class="ltr" dir="ltr">{SITE.email}</span>
        </a>
      </div>
    </div>
  </dialog>
</header>

<style>
  .lc-header-bg {
    background: rgb(4 14 39 / 0.94);
    box-shadow: var(--shadow-header);
    transition: background-color 0.35s ease, box-shadow 0.35s ease, backdrop-filter 0.35s ease;
  }
  @supports (backdrop-filter: blur(1px)) {
    .lc-header-bg {
      background: rgb(4 14 39 / 0.86);
      backdrop-filter: blur(14px) saturate(1.3);
    }
  }
  /* Over a dark hero and not yet scrolled: fully transparent. */
  .lc-header[data-hero]:not([data-scrolled]) .lc-header-bg {
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  /* Active / hover indicator: a slanted bar under the link (the logo's italic). */
  .lc-nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.125rem;
    height: 3px;
    background: var(--color-signal-400);
    transform: skewX(-10deg) scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.3s var(--ease-out-expo);
  }
  :global([dir="rtl"]) .lc-nav-link::after {
    transform: skewX(10deg) scaleX(0);
    transform-origin: 100% 50%;
  }
  .lc-nav-link:hover::after {
    transform: skewX(-10deg) scaleX(0.5);
  }
  .lc-nav-link[aria-current]::after {
    transform: skewX(-10deg) scaleX(1);
  }
  :global([dir="rtl"]) .lc-nav-link:hover::after {
    transform: skewX(10deg) scaleX(0.5);
  }
  :global([dir="rtl"]) .lc-nav-link[aria-current]::after {
    transform: skewX(10deg) scaleX(1);
  }

  /* Drawer: full-height sheet from the inline-end edge. */
  .lc-drawer {
    position: fixed;
    inset: 0;
    inset-inline-start: auto;
    width: min(26rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .lc-drawer::backdrop {
    background: rgb(4 14 39 / 0.6);
    backdrop-filter: blur(4px);
  }
  .lc-drawer[open] {
    animation: lc-drawer-in 0.35s var(--ease-out-expo);
  }
  @keyframes lc-drawer-in {
    from {
      transform: translateX(var(--drawer-from, 24px));
      opacity: 0;
    }
  }
  :global([dir="rtl"]) .lc-drawer {
    --drawer-from: -24px;
  }
  :global(html:has(.lc-drawer[open])) {
    overflow: hidden;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".lc-header");
  if (header) {
    // Transparent → solid once the page scrolls (only matters over a dark hero).
    if (header.hasAttribute("data-hero")) {
      let ticking = false;
      const update = () => {
        header.toggleAttribute("data-scrolled", window.scrollY > 24);
        ticking = false;
      };
      update();
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
    }
    // Mobile drawer.
    const drawer = header.querySelector<HTMLDialogElement>("#lc-drawer");
    const opener = header.querySelector<HTMLButtonElement>(".lc-menu-open");
    if (drawer && opener) {
      opener.addEventListener("click", () => {
        drawer.showModal();
        opener.setAttribute("aria-expanded", "true");
      });
      drawer.querySelector(".lc-menu-close")?.addEventListener("click", () => drawer.close());
      drawer.addEventListener("close", () => opener.setAttribute("aria-expanded", "false"));
      // Click on the backdrop closes the sheet.
      drawer.addEventListener("click", (e) => {
        if (e.target === drawer) drawer.close();
      });
      // Close if the viewport grows to desktop while open.
      matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && drawer.close());
    }
  }
</script>
