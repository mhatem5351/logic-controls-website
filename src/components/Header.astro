---
/**
 * Site header.
 *  - Utility bar (≥1024px): "Setting up in Egypt?" link (not on the zh / tr home page, whose hero leads with it), phone,
 *    email, full language list, pause animations. Scrolls away. One line always: a row wider than the bar (long labels
 *    with user text spacing) drops the switch's label, then the address text, as below 1280px.
 *  - Main bar (sticky; static on short landscape phones): logo, 5 nav items, language menu (< 1024px), the primary
 *    action, menu button.
 *  - Services and Industries are disclosure menus (APG "disclosure navigation menu" with top-level links): the label
 *    stays a link to the index page, the chevron button next to it shows / hides the full list (all 8 services /
 *    7 industries). Click, Enter, Space toggle; ArrowDown opens and moves into the list; Escape (from anywhere on the
 *    page) closes it and returns focus to the chevron if focus was inside; moving focus away or clicking outside closes
 *    it. Mouse only: resting on an item opens it after a short intent delay (also when another menu is already open —
 *    the panels then swap without stacking; never while the pointer is heading for the open panel, "menu aim"), and
 *    leaving closes it after a grace period. A click on a chevron whose
 *    menu hover opened (or was about to open) keeps it open and pins it, instead of toggling it shut. After Escape,
 *    hover does not re-open that menu until the pointer has left it (WCAG 1.4.13).
 *  - Primary action: "Request a quote" (en/tr/zh; "Quote" on phones) — WhatsApp on Arabic pages (WhatsApp-first), with
 *    a compact outline "Quote" next to it from 1024px. Both carry the page's context (pageContact: ?service= /
 *    ?industry= preselection, the page's WhatsApp message — "machine stopped" on maintenance and support).
 *  - Mobile drawer: <HeaderDrawer> (rendered here unless `drawer={false}`, when the layout renders it after the footer).
 * `heroDark`: starts transparent over a dark hero, turns solid once the page scrolls.
 */
import { getMessages, type Locale } from "~/i18n";
import { SITE, telLink } from "~/data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import ChromeIcon from "./ChromeIcon.astro";
import ChromeSprite from "./ChromeSprite.astro";
import HeaderDrawer from "./HeaderDrawer.astro";
import { pageContact } from "./contact-cta";
import Button from "./Button.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MotionToggle from "./MotionToggle.astro";
import { serviceIcon, industryIcon } from "./sections/catalog/catalog";
import { colon, ltr } from "~/lib/text";
import {
  MAIN_NAV,
  FOREIGN_PATH,
  OEM_PATH,
  href,
  currentState,
  whatsappLink,
  mailtoLink,
  prefersWhatsapp,
  investorFirst,
  serviceNav,
  industryNav,
  fmt,
} from "./nav";

interface Props {
  locale: Locale;
  path: string;
  heroDark?: boolean;
  /** Render the mobile drawer inside the header (default). false: the layout renders <HeaderDrawer> itself. */
  drawer?: boolean;
  /** The page's WhatsApp message (BaseLayout's whatsappMessage); default: derived from the path (pageContact). */
  whatsappMessage?: string;
}
const { locale, path, heroDark = false, drawer = true, whatsappMessage } = Astro.props;
const m = getMessages(locale);
const t = m.ui;
const waFirst = prefersWhatsapp(locale);
const foreignState = currentState(FOREIGN_PATH, path);
/* zh / tr home: the hero's secondary action is the foreign-manufacturers page, so the utility bar does not repeat it. */
const showForeign = !(path === "" && investorFirst(locale));
const ctx = pageContact(locale, path);
const mail = mailtoLink(undefined, { locale, path, topic: ctx.topic });
const wa = whatsappLink(whatsappMessage ?? ctx.whatsapp);

/* Submenus of the two catalogue sections (desktop dropdown + drawer accordion share the data). */
const menus = {
  services: {
    items: serviceNav(locale).map((l) => ({ ...l, icon: serviceIcon(l.slug) })),
    all: { label: m.common.labels.allServices as string, path: "services" },
  },
  industries: {
    items: industryNav(locale).map((l) => ({ ...l, icon: industryIcon(l.slug) })),
    all: { label: m.common.labels.allIndustries as string, path: "industries" },
  },
};
const ddId = (key: string) => `lc-dd-${key}`;
const oemLabel = m.foreign.oem?.eyebrow as string | undefined;
---

<header
  class="lc-header on-dark sticky z-50 text-white"
  style="top: calc(-1 * var(--utility-h))"
  data-hero={heroDark ? "" : undefined}
>
  <ChromeSprite />
  <div class="lc-header-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  {/* ---------- utility bar ---------- */}
  <div class="hidden h-(--utility-h) border-b border-white/8 text-[0.8125rem] lg:block">
    <div class="lc-util wrap flex h-full items-center justify-between gap-4 whitespace-nowrap xl:gap-6">
      {
        showForeign && (
          <a
            href={href(locale, FOREIGN_PATH)}
            aria-current={foreignState}
            class:list={[
              "group inline-flex min-h-6 items-center gap-2.5 font-semibold text-signal-300 transition-colors hover:text-white pointer-coarse:-my-1 pointer-coarse:min-h-11",
              foreignState && "underline decoration-2 underline-offset-[6px]",
            ]}
          >
            <span class="lc-led" aria-hidden="true" />
            <span>{t.nav.foreign}</span>
            <Icon name="arrow" size={14} class="transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" />
          </a>
        )
      }
      <div class="ms-auto flex shrink-0 items-center gap-4 text-navy-200 xl:gap-6">
        <a href={telLink()} class="inline-flex min-h-6 items-center gap-2 transition-colors hover:text-white pointer-coarse:-my-1 pointer-coarse:min-h-11">
          <ChromeIcon name="phone" size={14} class="text-royal-300" />
          <span class="sr-only">{t.contact.phone}{colon(locale)}</span>
          <span class="ltr" dir="ltr">{SITE.phone.display}</span>
        </a>
        {/* 1024–1279 (and a row too wide for its bar, data-tight="2"): the envelope alone (the address stays its
            accessible name), so the bar keeps one line. */}
        <a href={mail} class="inline-flex min-h-6 items-center gap-2 transition-colors hover:text-white pointer-coarse:-my-1 pointer-coarse:min-h-11">
          <ChromeIcon name="mail" size={14} class="text-royal-300" />
          <span class="sr-only">{t.contact.email}{colon(locale)}</span>
          <span class="lc-util-mail max-xl:sr-only" set:html={ltr(SITE.email)} />
        </a>
        <span class="h-4 w-px bg-white/15" aria-hidden="true"></span>
        <LanguageSwitcher locale={locale} path={path} variant="inline" class="-mx-2" />
        {/* "Pause animations" among the first tab stops (A11Y2-18); the label shows from 1280px (below, the pause
            glyph + switch, the label stays its accessible name). */}
        <span class="h-4 w-px bg-white/15" aria-hidden="true"></span>
        <MotionToggle variant="bar" locale={locale} class="lc-util-mt -me-1.5" />
      </div>
    </div>
  </div>

  {/* ---------- main bar ---------- */}
  <div class="h-(--header-h)">
    <div class="wrap flex h-full items-center gap-2 sm:gap-4 lg:gap-6 xl:gap-8">
      <a href={href(locale)} aria-label={t.a11y.homeLink} class="relative -my-1 shrink-0 py-1">
        <Logo variant="dark" width={124} loading="eager" class="h-auto w-[96px] min-[24rem]:w-[104px] lg:w-[124px]" alt="" />
        {/* Brand moment (first page of a session only, motion.css §3): an amber signal leaves the first ring node,
            branches up to the second and runs on to the third; each ring pings as it arrives. The overlay sits
            exactly over the raster mark (viewBox = logo-original.jpg pixels of the logo.png crop), never shifts layout. */}
        <svg class="lc-logo-intro" viewBox="326 320.25 794 335" fill="none" aria-hidden="true" focusable="false">
          <path class="t" pathLength="100" style="--d:.3s;--t:.9s" d="M347 471V547.3L420 602.1V464.5L459.5 425V360" />
          <path class="t" pathLength="100" style="--d:.525s;--t:.36s" d="M371.5 566V487.8L403.5 455.8V413" />
          <circle class="n" cx="347" cy="453" r="14.75" style="--d:.2s" />
          <circle class="n" cx="403.5" cy="395" r="14.75" style="--d:.885s" />
          <circle class="n" cx="459.5" cy="342" r="14.75" style="--d:1.2s" />
          <circle class="g" cx="347" cy="453" r="14.75" style="--d:.2s" />
          <circle class="g" cx="403.5" cy="395" r="14.75" style="--d:.885s" />
          <circle class="g" cx="459.5" cy="342" r="14.75" style="--d:1.2s" />
        </svg>
      </a>

      <nav aria-label={t.a11y.mainNav} class="hidden h-full lg:block">
        <ul role="list" class="flex h-full items-center gap-0.5 xl:gap-1.5">
          {
            MAIN_NAV.map((item) => {
              const state = currentState(item.path, path);
              const label = t.nav[item.key];
              const menu = "menu" in item ? menus[item.menu] : undefined;
              const linkCls = [
                "lc-nav-link relative inline-flex h-10 items-center text-[0.9375rem] font-semibold whitespace-nowrap transition-colors",
                menu ? "ps-2.5 pe-1 xl:ps-3" : "px-2.5 xl:px-3",
                state ? "text-white" : "text-navy-100 hover:text-white",
              ];
              if (!menu)
                return (
                  <li>
                    <a href={href(locale, item.path)} aria-current={state} class:list={linkCls}>
                      {label}
                      {state && <span class="lc-nav-ind" aria-hidden="true" />}
                    </a>
                  </li>
                );
              const id = ddId(item.key);
              return (
                <li class="lc-dd relative flex h-full items-center" data-dd>
                  <a href={href(locale, item.path)} aria-current={state} class:list={linkCls}>
                    {label}
                    {state && <span class="lc-nav-ind" aria-hidden="true" />}
                  </a>
                  <button
                    type="button"
                    class="lc-dd-btn inline-flex h-10 w-7 items-center justify-center text-navy-200 transition-colors hover:text-white"
                    aria-expanded="false"
                    aria-controls={id}
                  >
                    <Icon name="chevron-down" size={16} class="lc-dd-chev" />
                    <span class="sr-only">{fmt(t.a11y.submenu, { label })}</span>
                  </button>
                  <div id={id} class="lc-dd-panel on-dark border border-white/12 bg-navy-900 p-2 text-navy-100 shadow-header" hidden>
                    <ul role="list" class:list={["grid gap-x-1 gap-y-0.5", menu.items.length > 4 && "grid-cols-2"]}>
                      {menu.items.map((l) => {
                        const cur = currentState(l.path, path) === "page";
                        return (
                          <li>
                            <a
                              href={href(locale, l.path)}
                              aria-current={cur ? "page" : undefined}
                              class:list={[
                                "lc-dd-link group/dd flex min-h-11 items-center gap-3 px-2.5 py-1.5 transition-colors hover:bg-white/8",
                                cur ? "font-bold text-white" : "font-medium text-navy-100 hover:text-white",
                              ]}
                            >
                              <span
                                class="chamfer inline-grid size-8 shrink-0 place-items-center bg-white/[0.06] text-royal-300 transition-colors [--chamfer:6px] group-hover/dd:bg-royal-600 group-hover/dd:text-white"
                                aria-hidden="true"
                              >
                                <ChromeIcon name={l.icon} size={16} />
                              </span>
                              <span class:list={["leading-snug", cur && "underline decoration-signal-400 decoration-2 underline-offset-4"]}>{l.label}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                    <div class="mt-2 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t border-white/10 px-2.5 pt-2">
                      <a
                        href={href(locale, menu.all.path)}
                        aria-current={path === menu.all.path ? "page" : undefined}
                        class="group/all inline-flex min-h-10 items-center gap-1.5 text-sm font-bold text-royal-300 transition-colors hover:text-white"
                      >
                        {menu.all.label}
                        <Icon name="arrow" size={14} class="transition-transform group-hover/all:translate-x-0.5 rtl:group-hover/all:-translate-x-0.5" />
                      </a>
                      {menu === menus.services && (
                        <span class="flex flex-wrap items-center gap-x-5 gap-y-1">
                          <a
                            href={href(locale, FOREIGN_PATH)}
                            class="inline-flex min-h-10 items-center gap-2.5 text-sm font-semibold text-signal-300 transition-colors hover:text-white"
                          >
                            <span class="lc-led" aria-hidden="true" />
                            {t.nav.foreign}
                          </a>
                          {oemLabel && (
                            <a href={href(locale, OEM_PATH)} class="inline-flex min-h-10 items-center text-sm font-semibold text-navy-100 transition-colors hover:text-white">
                              {oemLabel}
                            </a>
                          )}
                        </span>
                      )}
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="ms-auto flex items-center gap-2 sm:gap-3">
        <LanguageSwitcher locale={locale} path={path} variant="menu" tight={waFirst} class="lg:hidden" />
        {
          waFirst ? (
            <>
              <Button href={wa} size="sm" icon="whatsapp" external class="lc-head-cta lg:min-h-10" aria-label={`${t.cta.whatsapp} (${t.a11y.newTab})`}>
                <span class="max-[22.5rem]:sr-only sm:hidden lg:inline xl:hidden" aria-hidden="true">{t.cta.whatsappShort}</span>
                <span class="max-sm:hidden lg:max-xl:hidden" aria-hidden="true">{t.cta.whatsapp}</span>
              </Button>
              {/* Desktop: WhatsApp stays first and filled; the quote form one click away (UX2-25). */}
              <Button href={ctx.quote} size="sm" variant="on-dark" class="lc-head-cta max-lg:hidden lg:min-h-10">
                {t.cta.quoteShort}
              </Button>
            </>
          ) : (
            <Button href={ctx.quote} size="sm" class="lc-head-cta lg:min-h-10">
              <span class="sm:hidden">{t.cta.quoteShort}</span>
              <span class="max-sm:hidden">{t.cta.quote}</span>
            </Button>
          )
        }
        <button
          type="button"
          class="lc-menu-open inline-flex size-10 items-center justify-center border border-white/20 text-white transition-colors hover:border-white/50 lg:hidden"
          aria-haspopup="dialog"
          aria-controls="lc-drawer"
          aria-expanded="false"
        >
          <Icon name="menu" size={22} />
          <span class="sr-only">{t.a11y.menu}</span>
        </button>
      </div>
    </div>
  </div>

  {drawer && <HeaderDrawer locale={locale} path={path} whatsappMessage={whatsappMessage} />}
</header>

<style>
  .lc-header-bg {
    background: rgb(4 14 39 / 0.94);
    box-shadow: var(--shadow-header);
    transition:
      background-color var(--dur-ui) var(--ease-mech),
      box-shadow var(--dur-ui) var(--ease-mech),
      backdrop-filter var(--dur-ui) var(--ease-mech);
  }
  @supports (backdrop-filter: blur(1px)) {
    .lc-header-bg {
      background: rgb(4 14 39 / 0.86);
      backdrop-filter: blur(14px) saturate(1.3);
    }
  }
  /* Over a dark hero and not yet scrolled: fully transparent (a dropdown being open also counts as "scrolled"). */
  .lc-header[data-hero]:not([data-scrolled]):not(:has(.lc-dd-panel:not([hidden]))) .lc-header-bg {
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }
  /* Landscape phones (≈340px of usable height): a pinned 64px bar would take a fifth of the screen, so it scrolls
     away — and anchor jumps then need no room for it (DEV2-13). */
  @media (max-height: 30rem) and (max-width: 63.99rem) {
    .lc-header {
      position: relative;
      top: 0 !important;
    }
    :global(html) {
      scroll-padding-top: 1rem;
    }
  }

  @media (max-width: 79.99rem) {
    .lc-header :global(.lc-util-mt .lc-mt-label) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  /* A row wider than its bar from 1280px (long labels with WCAG text spacing, A11Y3-05; set by the script below): the
     same compact forms as below 1280px, the pause switch's label first, then the address. Both stay accessible names. */
  .lc-util[data-tight] :global(.lc-util-mt .lc-mt-label),
  .lc-util[data-tight="2"] .lc-util-mail {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Hover: a slanted bar slides in from the inline start and leaves towards the inline end (origin flips).
     Current section: a separate amber bar (.lc-nav-ind) that view-transitions along the nav between pages. */
  .lc-nav-link::after,
  .lc-nav-ind {
    content: "";
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.125rem;
    height: 3px;
    transform: skewX(calc(-1 * var(--slant)));
  }
  .lc-dd .lc-nav-link::after,
  .lc-dd .lc-nav-ind {
    inset-inline-end: 0.25rem;
  }
  .lc-nav-link::after {
    background: rgb(255 255 255 / 0.4);
    scale: 0 1;
    transform-origin: 100% 50%;
    transition: scale var(--dur-ui) var(--ease-mech);
  }
  .lc-nav-link:is(:hover, :focus-visible):not([aria-current])::after {
    scale: 1 1;
    transform-origin: 0 50%;
  }
  :global([dir="rtl"]) .lc-nav-link::after {
    transform-origin: 0 50%;
  }
  :global([dir="rtl"]) .lc-nav-link:is(:hover, :focus-visible):not([aria-current])::after {
    transform-origin: 100% 50%;
  }
  .lc-nav-ind {
    background: var(--color-signal-400);
  }
  :global([dir="rtl"]) .lc-nav-link::after,
  :global([dir="rtl"]) .lc-nav-ind {
    transform: skewX(var(--slant));
  }
  /* Forced colours drop background colours: keep the "you are here" bar as a system colour. */
  @media (forced-colors: active) {
    .lc-nav-ind {
      forced-color-adjust: none;
      background: Highlight;
    }
  }

  /* Desktop dropdown panel: under its item, aligned to the item's inline start; drops a few px into place. */
  .lc-dd-panel {
    position: absolute;
    top: calc(100% - 0.375rem);
    inset-inline-start: -0.5rem;
    z-index: 10;
    width: max-content;
    min-width: 17rem;
    max-width: min(40rem, calc(100vw - 2 * var(--spacing-gutter)));
    max-height: calc(100dvh - var(--header-h) - 1rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--dur-micro) var(--ease-exit),
      translate var(--dur-micro) var(--ease-exit),
      display var(--dur-micro) allow-discrete;
  }
  .lc-dd-panel[hidden] {
    display: none;
    opacity: 0;
    translate: 0 calc(-1 * var(--move-ui));
  }
  .lc-dd-panel:not([hidden]) {
    transition-duration: var(--dur-ui);
    transition-timing-function: var(--ease-mech);
  }
  @starting-style {
    .lc-dd-panel:not([hidden]) {
      opacity: 0;
      translate: 0 calc(-1 * var(--move-ui));
    }
  }
  /* Moving from one open menu to the next: the old panel goes at once (two panels never stack), the new one only
     fades in quickly — the header is already solid, nothing needs to drop into place. */
  .lc-dd-panel[data-instant] {
    transition: none;
  }
  .lc-dd-panel[data-switch]:not([hidden]) {
    transition-duration: var(--dur-micro);
  }
  @starting-style {
    .lc-dd-panel[data-switch]:not([hidden]) {
      translate: 0 0;
    }
  }
  .lc-dd-panel .lc-dd-link {
    min-width: 13rem;
  }
  /* The chevron svg comes from <Icon>: scoped selectors must reach it through :global (MOT2-13). */
  .lc-dd-btn :global(.lc-dd-chev) {
    transition: rotate var(--dur-ui) var(--ease-mech);
  }
  .lc-dd-btn[aria-expanded="true"] :global(.lc-dd-chev) {
    rotate: 180deg;
  }
  .lc-dd-btn[aria-expanded="true"] {
    color: var(--color-white);
  }
  /* Touch screens: 44px targets for the bar's controls (desktop density unchanged). */
  @media (pointer: coarse) {
    .lc-dd-btn {
      width: 2.5rem;
    }
    .lc-menu-open {
      width: 2.75rem;
      height: 2.75rem;
    }
    .lc-header :global(.lc-head-cta) {
      min-height: 2.75rem;
    }
  }
</style>

<script>
  /* Site chrome controller (header menus + a few page-wide behaviours). Idempotent: binds once per page even if the
     module is bundled or imported more than once; it does not depend on any other script having run. */
  const header = document.querySelector<HTMLElement>(".lc-header");
  if (header && !header.hasAttribute("data-ready")) {
    header.setAttribute("data-ready", "");

    /* Utility bar (A11Y3-05): one nowrap row, sized for the default text. When its content is wider than the bar
       (Turkish labels with WCAG text spacing), it steps down to the compact forms (data-tight, CSS above). Its groups
       are observed too: their width follows the text (spacing, a late font). The fit runs in the next frame, never
       inside the observer callback, so its own size change is reported normally rather than as a resize loop. */
    const util = header.querySelector<HTMLElement>(".lc-util");
    if (util && "ResizeObserver" in window) {
      const over = () => util.scrollWidth > util.clientWidth + 1;
      const fit = () => {
        util.removeAttribute("data-tight");
        if (!over()) return;
        util.dataset.tight = "1";
        if (over()) util.dataset.tight = "2";
      };
      let queued = 0;
      let shown = false;
      const ro = new ResizeObserver((entries) => {
        // below 1024px the bar is not rendered (width 0): nothing to fit, and no layout read on phones
        for (const e of entries) if (e.target === util) shown = e.contentRect.width > 0;
        if (shown) queued ||= requestAnimationFrame(() => ((queued = 0), fit()));
      });
      for (const el of [util, ...util.children]) ro.observe(el);
    }

    // Transparent → solid once the page scrolls (only matters over a dark hero).
    if (header.hasAttribute("data-hero")) {
      let ticking = false;
      const update = () => {
        header.toggleAttribute("data-scrolled", window.scrollY > 24);
        ticking = false;
      };
      // First read in the first frame: during the site script's evaluation it would force the page's first style and
      // layout inside that task (PERF3-05). The frame is painted with the right state either way.
      requestAnimationFrame(update);
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
    }

    /* ---- Desktop disclosure menus (Services, Industries) ---- */
    type Opener = "" | "hover" | "click";
    interface Item {
      li: HTMLElement;
      btn: HTMLButtonElement;
      panel: HTMLElement;
      /** How the open panel was opened: by hover intent, or by a click / key (pinned). */
      by: Opener;
      openTimer: number;
      closeTimer: number;
      /** Escape closed it while the pointer rested on it: hover must not re-open it until the pointer leaves. */
      noHover: boolean;
      /** pointerType of the press that led to the current click ("" for keyboard). */
      press: string;
    }
    const items: Item[] = [...header.querySelectorAll<HTMLElement>("[data-dd]")].flatMap((li) => {
      const btn = li.querySelector<HTMLButtonElement>(".lc-dd-btn");
      const panel = li.querySelector<HTMLElement>(".lc-dd-panel");
      return btn && panel ? [{ li, btn, panel, by: "" as Opener, openTimer: 0, closeTimer: 0, noHover: false, press: "" }] : [];
    });
    const isOpen = (it: Item) => it.btn.getAttribute("aria-expanded") === "true";
    const clearTimers = (it: Item) => {
      clearTimeout(it.openTimer);
      clearTimeout(it.closeTimer);
      it.openTimer = it.closeTimer = 0;
    };
    /** Skip the panel's transition for this one change (switching menus, back/forward cache). */
    const instant = (panel: HTMLElement) => {
      panel.setAttribute("data-instant", "");
      requestAnimationFrame(() => requestAnimationFrame(() => panel.removeAttribute("data-instant")));
    };
    const setOpen = (it: Item, open: boolean, by: Opener = "click") => {
      clearTimers(it);
      if (open) {
        let switching = false;
        for (const other of items) {
          if (other === it || !isOpen(other)) continue;
          switching = true;
          instant(other.panel);
          setOpen(other, false);
        }
        if (!isOpen(it)) it.panel.toggleAttribute("data-switch", switching);
        it.by = by;
      } else {
        it.by = "";
        it.panel.removeAttribute("data-switch");
      }
      it.btn.setAttribute("aria-expanded", String(open));
      it.panel.hidden = !open;
    };
    const links = (it: Item) => [...it.panel.querySelectorAll<HTMLAnchorElement>("a")];
    const hoverable = matchMedia("(hover: hover) and (pointer: fine)");
    const OPEN_MS = 140;
    const CLOSE_MS = 260;
    /** Keyboard focus is inside another item's open panel: a resting pointer must not swap that menu away (its panel
     *  would hide with the focus in it, and focus would drop to <body>). */
    const focusElsewhere = (it: Item) => items.some((o) => o !== it && isOpen(o) && o.panel.contains(document.activeElement));
    const armOpen = (it: Item) => {
      clearTimeout(it.openTimer);
      it.openTimer = window.setTimeout(() => {
        if (focusElsewhere(it)) return void (it.openTimer = 0);
        setOpen(it, true, "hover");
      }, OPEN_MS);
    };
    const armClose = (it: Item) => {
      clearTimeout(it.closeTimer);
      it.closeTimer = window.setTimeout(() => {
        if (!it.li.contains(document.activeElement)) setOpen(it, false);
      }, CLOSE_MS);
    };
    /* Menu aim (UX3-01): the way from "Services" to the top of its right-hand column crosses "Industries". While the
       pointer is heading for the open panel (its path, extended, meets the panel's top edge), the item it passes over
       neither opens nor lets the open one close: their timers restart on every move (≥ 4 px, so a resting hand's
       jitter does not count). The swap happens once the pointer rests on the other item, or turns away. */
    let last: { x: number; y: number } | null = null;
    header.addEventListener("pointermove", (e) => {
      const open = items.find(isOpen);
      if (e.pointerType !== "mouse" || !open) return void (last = null);
      const p = { x: e.clientX, y: e.clientY };
      const from = last;
      if (from && (p.x - from.x) ** 2 + (p.y - from.y) ** 2 < 16) return;
      last = p;
      if (!from || p.y <= from.y || (!items.some((it) => it.openTimer) && !open.closeTimer)) return;
      const r = open.panel.getBoundingClientRect();
      if (p.y >= r.top) return;
      const x = p.x + ((p.x - from.x) * (r.top - p.y)) / (p.y - from.y);
      if (x < r.left || x > r.right) return;
      for (const it of items) if (it.openTimer) armOpen(it);
      if (open.closeTimer) armClose(open);
    });
    header.addEventListener("pointerleave", () => (last = null));

    for (const it of items) {
      const { li, btn, panel } = it;
      btn.addEventListener("pointerdown", (e) => (it.press = e.pointerType));
      btn.addEventListener("click", (e) => {
        const mouse = e.detail > 0 && it.press === "mouse";
        it.press = "";
        // Hover intent opened it (or was about to): the click the visitor aimed at the chevron keeps it open — pinned.
        if (mouse && (it.openTimer || (isOpen(it) && it.by === "hover"))) return setOpen(it, true, "click");
        setOpen(it, !isOpen(it), "click");
      });
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          setOpen(it, true, "click");
          links(it)[0]?.focus();
        }
      });
      // Arrow keys move between the panel's links (Home / End jump to the ends; ArrowUp from the first → the chevron).
      panel.addEventListener("keydown", (e) => {
        const list = links(it);
        const i = list.indexOf(document.activeElement as HTMLAnchorElement);
        if (i < 0) return;
        const next = { ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: list.length - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        if (next < 0) btn.focus();
        else list[Math.min(next, list.length - 1)]?.focus();
      });
      // Focus moved on to something outside the item: close. (A click on nothing focusable gives no relatedTarget; the
      // document click handler below decides that case.)
      li.addEventListener("focusout", (e) => {
        const to = e.relatedTarget as Node | null;
        if (to && !li.contains(to)) setOpen(it, false);
      });
      // Hover intent (mouse only).
      li.addEventListener("pointerenter", (e) => {
        if (e.pointerType !== "mouse" || !hoverable.matches) return;
        clearTimeout(it.closeTimer);
        it.closeTimer = 0;
        if (it.noHover || isOpen(it)) return;
        // Wait for the pointer to rest, also when another menu is open (a pointer on its way to that menu's panel
        // only passes over this item; see menu aim above). Reaching the open panel leaves this item: the timer stops.
        armOpen(it);
      });
      li.addEventListener("pointerleave", (e) => {
        if (e.pointerType !== "mouse") return;
        clearTimeout(it.openTimer);
        it.openTimer = 0;
        it.noHover = false;
        // Only a menu that hover opened closes on leave; a pinned one waits for Escape, an outside click or focus-out.
        if (isOpen(it) && it.by === "hover") armClose(it);
      });
    }
    document.addEventListener("click", (e) => {
      for (const it of items) if (isOpen(it) && !it.li.contains(e.target as Node)) setOpen(it, false);
    });
    // Escape from anywhere closes an open menu (WCAG 1.4.13: dismissible without moving pointer or focus). Focus returns
    // to the chevron only if it was inside the menu.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      for (const it of items) {
        const pointerOn = it.li.matches(":hover");
        if (it.openTimer || isOpen(it)) it.noHover = pointerOn;
        if (!isOpen(it)) {
          clearTimers(it);
          continue;
        }
        const inside = it.li.contains(document.activeElement);
        setOpen(it, false);
        if (inside) it.btn.focus();
      }
    });
    // Back / forward cache: the page comes back as it was left — close what was open, without replaying the exit.
    addEventListener("pageshow", (e) => {
      if (!e.persisted) return;
      for (const it of items) {
        if (!isOpen(it)) continue;
        instant(it.panel);
        setOpen(it, false);
      }
      document.querySelectorAll<HTMLElement>(".lc-lang-pop").forEach((p) => {
        try {
          if (p.matches(":popover-open")) p.hidePopover();
        } catch {}
      });
    });

    /* ---- Keyboard focus on a card with a stretched link (A11Y2-24): the browser scrolls only the link into view,
       so half of the card's focus ring can stay under the sticky header. Bring the whole card in. ---- */
    document.addEventListener("focusin", (e) => {
      const el = e.target as Element | null;
      if (!el?.matches?.(".lc-stretch, a[class*='after:inset-0']") || !el.matches(":focus-visible")) return;
      const card = el.closest<HTMLElement>("li, article");
      if (!card || card.closest("[data-snap], .lc-toc-row")) return;
      const r = card.getBoundingClientRect();
      const top = (parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0) + 8;
      if (r.height + top > innerHeight) return;
      if (r.top < top) scrollBy({ top: r.top - top, behavior: "instant" });
      else if (r.bottom > innerHeight - 8) scrollBy({ top: r.bottom - innerHeight + 8, behavior: "instant" });
    });

    /* ---- Print (DEV2-16): Firefox (≤ 142) and Safari (< 18.4) do not print the content of closed <details>. Open
       them for printing and restore afterwards; exclusive groups (name="…") are lifted for the print only. ---- */
    let printed: { el: HTMLDetailsElement; name: string | null }[] = [];
    addEventListener("beforeprint", () => {
      printed = [...document.querySelectorAll<HTMLDetailsElement>("details:not([open])")].map((el) => ({ el, name: el.getAttribute("name") }));
      for (const { el } of printed) el.removeAttribute("name");
      for (const { el } of printed) el.open = true;
    });
    addEventListener("afterprint", () => {
      for (const { el } of printed) el.open = false;
      for (const { el, name } of printed) if (name !== null) el.setAttribute("name", name);
      printed = [];
    });
  }
</script>
