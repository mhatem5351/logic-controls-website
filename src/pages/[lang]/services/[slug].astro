---
/**
 * Service detail page (one per locale × service).
 * Hero (+ animated ServiceArt) → capabilities → [live HMI demo] → when to call us + deliverables → related projects
 * → related industries + platforms → FAQ → one closing band: the service's pitch + quote / WhatsApp buttons beside the
 * "what we need to quote" checklist (<QuoteCta>). Section headings carry a title only (no orphan "01 —" index).
 * Control panels also shows "Panels we have built" (real panel photos from the case studies) after "What we do"; those
 * projects are then left out of the "Related projects" cards (no project or photo shown twice on the page).
 * Maintenance / troubleshooting leads with "Call an engineer" + a "machine stopped" WhatsApp message (a stopped
 * line needs a call, not a form); the quote form stays as a text link.
 */
import { Picture } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Icon from "~/components/Icon.astro";
import FAQ from "~/components/FAQ.astro";
import LogoWall from "~/components/LogoWall.astro";
import HmiDemo from "~/components/motion/HmiDemo.astro";
import HeroArt from "~/components/sections/catalog/HeroArt.astro";
import FeatureGrid from "~/components/sections/catalog/FeatureGrid.astro";
import SpecList from "~/components/sections/catalog/SpecList.astro";
import RelatedProjects from "~/components/sections/catalog/RelatedProjects.astro";
import LinkTiles from "~/components/sections/catalog/LinkTiles.astro";
import QuoteCta from "~/components/sections/main/QuoteCta.astro";
import {
  brandsIn,
  countLabel,
  imageAlt,
  industryCopy,
  industryIcon,
  projectCopy,
  projectsFor,
  projectsForService,
  quoteHref,
  secondaryCta,
  serviceCopy,
} from "~/components/sections/catalog/catalog";
import { absUrl, caseStudyId, graph, service, webPage } from "~/lib/jsonld";
import { pageContact } from "~/components/contact-cta";
import { techLabel, html, heading } from "~/lib/text";
import { LOCALES, getMessages, localePath, type Locale } from "~/i18n";
import { SERVICES, SERVICE_SLUGS, type ServiceSlug } from "~/data/services";
import { SITE, telLink } from "~/data/site";

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => SERVICE_SLUGS.map((slug) => ({ params: { lang, slug } })));
}

const locale = Astro.params.lang as Locale;
const slug = Astro.params.slug as ServiceSlug;
const m = getMessages(locale);
const L = m.common.labels;
const item = serviceCopy(locale, slug)!;
const data = SERVICES.find((s) => s.slug === slug)!;
const path = `services/${slug}`;
const url = absUrl(localePath(locale, path));

/* Services that show the playable HMI (the demo is a pasteurizer: PLC logic, process loop, alarms/trends). SCADA gets
   a one-line link to the demo on /technologies/ instead of a fifth copy of it (CS2-12); the HMI-programming and
   process-control pages keep the live demo, it is their most direct proof. */
const HMI_DEMO: readonly string[] = ["plc-hmi-programming", "process-control"];
const HMI_TEASER: readonly string[] = ["scada-data-logging"];
const showHmi = HMI_DEMO.includes(slug);
const hmiTeaser = HMI_TEASER.includes(slug);

const related = projectsFor(locale, projectsForService(slug));
const RELATED_LIMIT = 3;
/* "All related projects (n)" only when the filtered list has more than the cards shown; otherwise the full portfolio. */
const allLink =
  related.length > RELATED_LIMIT
    ? { href: `${localePath(locale, "projects")}?service=${slug}`, label: L.allRelatedProjects, count: related.length }
    : { href: localePath(locale, "projects"), label: L.allProjects, count: projectsFor(locale).length };
const industries = data.industries.filter((i) => industryCopy(locale, i));
/* Industry tiles count the projects of this service in that industry (not the industry's total). */
const inIndustry = (i: string) => related.filter((p) => (p.industries as readonly string[]).includes(i)).length;
const relatedBrands = brandsIn(related);
const brands = relatedBrands.length >= 2 ? relatedBrands : [...SITE.brands];
const quote = quoteHref(locale, { service: slug });
/* A stopped machine needs a call now: phone first, WhatsApp with a "machine stopped" message, form as a text link. */
const urgent = slug === "maintenance-support";
/* The same message the header, drawer and floating button carry (contact-cta.ts pageContact: tr / zh add an English
   line naming the service in English, UX2-24). */
const wa = pageContact(locale, `services/${slug}`).whatsapp;
const primary = urgent ? { label: L.callEngineer, href: telLink() } : { label: m.ui.cta.quote, href: quote };

/* Control panels: photos of panels WE built — only case studies whose recorded scope includes control-panel
   building (services include "control-panels"). Programming-only or commissioning-only jobs must never appear here. */
const panels =
  slug === "control-panels"
    ? projectsForService(slug)
        .filter((pr) => pr.services.includes("control-panels") && projectCopy(locale, pr.slug))
        .map((pr) => ({ pr, img: [pr.cover, ...pr.gallery].find((im) => im.key === "panel") }))
        .filter((x): x is { pr: (typeof x)["pr"]; img: NonNullable<(typeof x)["img"]> } => !!x.img)
        .slice(0, 6)
    : [];

/* Related projects shown as cards: not the ones already in the panels strip just above (same projects, same photo). */
const inStrip = new Set(panels.map((x) => x.pr.slug));
const relatedCards = related.filter((pr) => !inStrip.has(pr.slug));

/* Alternate light / muted backgrounds over the sections that actually render. */
const order = ["capabilities", panels.length > 0 && "panels", showHmi && "hmi", "fit", relatedCards.length > 0 && "projects", "industries", "faq"].filter(Boolean) as string[];
const bg = (key: string) => (order.indexOf(key) % 2 === 0 ? "light" : "muted") as "light" | "muted";

/* Structured data (src/lib/jsonld.ts): the page + the Service, linked to the case studies that prove it. */
const jsonLd = graph(
  webPage(locale, { path, name: item.seoTitle, description: item.seoDescription, mainEntity: { "@id": `${url}#service` } }),
  service(locale, { path, name: item.title, description: item.seoDescription, subjectOf: related.map((pr) => caseStudyId(locale, pr.slug)) }),
);
---

<BaseLayout locale={locale} title={item.seoTitle} description={item.seoDescription} path={path} heroDark jsonLd={jsonLd} whatsappMessage={wa}>
  <Hero
    locale={locale}
    size="page"
    title={html(locale, item.h1)}
    lead={html(locale, item.intro[0] ?? item.summary)}
    chips={brands}
    primary={primary}
    secondary={secondaryCta(locale, wa)}
  >
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: m.common.breadcrumbs.services, path: "services" }, { label: item.navTitle }]} />
    {
      urgent && (
        <p class="mt-5 text-sm">
          <a href={quote} class="group inline-flex min-h-6 items-center gap-2 font-semibold text-royal-300 underline-offset-4 hover:text-white hover:underline">
            {m.ui.cta.quote}
            <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
          </a>
        </p>
      )
    }
    <HeroArt slot="media" kind="service" slug={slug} />
    <HeroArt inline kind="service" slug={slug} />
  </Hero>

  {/* What we do */}
  <Section variant={bg("capabilities")} id="capabilities" aria-labelledby="capabilities-title">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] lg:gap-20">
      <SectionHeading
        id="capabilities-title"
        title={html(locale, item.capabilitiesTitle ?? L.capabilities)}
        lead={item.intro.length > 1 ? html(locale, item.intro.slice(1).join(" ")) : undefined}
        class="self-start lg:sticky lg:top-[calc(var(--header-h)+2rem)]"
      />
      <FeatureGrid items={item.capabilities} locale={locale} columns={2} />
    </div>
  </Section>

  {/* Panels we have built (control panels): photos of real panels, each linked to its case study */}
  {
    panels.length > 0 && (
      <Section variant={bg("panels")} id="panels" aria-labelledby="panels-title">
        <SectionHeading id="panels-title" eyebrow={m.common.breadcrumbs.projects} title={html(locale, L.panelsBuilt)} />
        {/* One per row below 416px (the labels wrap between words, never into the next column); 3 up only for 3+. */}
        <ul role="list" class:list={["mt-10 grid grid-cols-1 gap-x-4 gap-y-8 min-[26rem]:grid-cols-2 sm:gap-x-6", panels.length >= 3 ? "lg:grid-cols-3" : "lg:max-w-4xl"]}>
          {panels.map(({ pr, img }) => (
            <li class="lc-reveal group relative min-w-0 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-(--focus)">
              <div class="lc-card-photo chamfer relative aspect-[4/3] overflow-hidden bg-navy-950">
                <Picture
                  src={img.image}
                  alt={imageAlt(locale, pr.slug, img.key)}
                  formats={["avif", "webp"]}
                  widths={[320, 480, 640, 800]}
                  sizes={
                    panels.length >= 3
                      ? "(min-width: 1280px) 400px, (min-width: 1024px) calc((100vw - 7rem) / 3), (min-width: 416px) calc((100vw - 3rem) / 2), calc(100vw - 2rem)"
                      : "(min-width: 1024px) 440px, (min-width: 416px) calc((100vw - 3rem) / 2), calc(100vw - 2rem)"
                  }
                  loading="lazy"
                  layout="full-width"
                  class="size-full object-cover transition-[scale] duration-(--dur-section) ease-emph group-hover:scale-[1.04]"
                />
              </div>
              {pr.technologies[0] && <p class="mt-3 text-sm font-semibold text-royal-700 [&_.lc-nw]:whitespace-normal [&_bdi]:whitespace-normal" set:html={html(locale, techLabel(locale, pr.technologies[0]))} />}
              <h3 class="mt-1 text-[0.9375rem] leading-snug font-bold text-navy-950 group-hover:text-royal-700 sm:text-base [&_.lc-nw]:whitespace-normal [&_bdi]:whitespace-normal">
                <a href={localePath(locale, `projects/${pr.slug}`)} class="lc-stretch after:absolute after:inset-0 after:content-['']" set:html={html(locale, projectCopy(locale, pr.slug)!.cardTitle)} />
              </h3>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {/* Live HMI (programming / process / SCADA pages) */}
  {
    showHmi && (
      <Section variant={bg("hmi")} id="hmi-demo" aria-labelledby="hmi-demo-title">
        <SectionHeading
          id="hmi-demo-title"
          eyebrow={m.hmi.intro.eyebrow}
          title={html(locale, m.hmi.intro.title)}
          lead={html(locale, m.hmi.intro.lead)}
        />
        <HmiDemo locale={locale} variant="compact" class="mt-10" />
      </Section>
    )
  }

  {/* SCADA: the live HMI demo is one click away on the technologies page */}
  {
    hmiTeaser && (
      <Section compact variant={bg("fit") === "light" ? "muted" : "light"} id="hmi-demo" aria-label={m.hmi.intro.eyebrow}>
        <a
          href={`${localePath(locale, "technologies")}#hmi-demo`}
          class="group on-dark relative isolate flex items-center gap-5 overflow-hidden bg-navy-950 px-6 py-5 text-white sm:px-8"
        >
          <span aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint opacity-70" />
          <span class="chamfer inline-grid size-12 shrink-0 place-items-center bg-royal-600 text-white [--chamfer:10px]">
            <Icon name="hmi" size={24} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block type-label text-signal-300">{m.hmi.intro.eyebrow}</span>
            <span class="mt-1 block type-h4 text-white group-hover:text-royal-200" set:html={heading(locale, m.hmi.intro.title)} />
          </span>
          <Icon name="arrow" size={20} class="shrink-0 text-royal-300 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
        </a>
      </Section>
    )
  }

  {/* When to call us + what you receive */}
  <Section variant={bg("fit")} id="fit" aria-labelledby="situations-title">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading id="situations-title" title={html(locale, item.situationsTitle ?? L.situations)} />
        <SpecList items={item.situations} locale={locale} marker="bar" ruled class="mt-8 border-t border-charcoal-200" />
      </div>
      <div class="on-dark relative isolate self-start overflow-hidden bg-navy-950 p-7 text-navy-100 sm:p-10">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint mask-fade-edges"></div>
        <h2 id="deliverables-title" class="type-h3 text-white">{L.deliverables}</h2>
        <SpecList items={item.deliverables} locale={locale} marker="check" ruled class="mt-6 border-t border-white/10" />
      </div>
    </div>
  </Section>

  {/* Related projects (hidden when the service has none yet) */}
  <RelatedProjects
    locale={locale}
    projects={relatedCards}
    title={L.relatedProjects}
    variant={relatedCards.length ? bg("projects") : "light"}
    limit={RELATED_LIMIT}
    all={allLink}
  />

  {/* Related industries + platforms */}
  <Section variant={bg("industries")} id="industries" aria-labelledby="industries-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading id="industries-title" title={html(locale, L.relatedIndustries)} />
    </div>
    <LinkTiles
      class="mt-10"
      items={industries.map((i) => ({
        href: localePath(locale, `industries/${i}`),
        title: industryCopy(locale, i)!.navTitle,
        icon: industryIcon(i),
        meta: inIndustry(i) ? countLabel(locale, inIndustry(i)) : undefined,
      }))}
    />
    <div class="lc-logos mt-16 lg:max-w-[calc(var(--n)*20%)]" style={`--n:${brands.length}`}>
      {/* Fewer than 5 brands: as many columns as logos from 640px (no lone logo on tablets, no empty 5th cell under the
          top rule on desktop). */}
      <LogoWall locale={locale} brands={brands} class={({ 2: "sm:[&_ul]:grid-cols-2", 3: "sm:[&_ul]:grid-cols-3", 4: "sm:[&_ul]:grid-cols-4" } as Record<number, string>)[brands.length]} />
    </div>
  </Section>

  {/* FAQ */}
  <Section variant={bg("faq")} id="faq" aria-labelledby="faq-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] lg:gap-20">
      <SectionHeading id="faq-title" title={html(locale, L.faq)} class="self-start" />
      <FAQ items={item.faq.map((f) => ({ q: f.q, a: html(locale, f.a) }))} openFirst />
    </div>
  </Section>

  <QuoteCta
    locale={locale}
    id="quote-checklist"
    eyebrow={item.navTitle}
    title={item.cta.title}
    text={item.cta.text}
    primary={{ label: m.ui.cta.quote, href: quote }}
    secondary={secondaryCta(locale, wa)}
  />
</BaseLayout>

<style>
  /* The text wordmark (Wecon) renders below 18.66px bold on phones: use the 5.3:1 grey so it passes WCAG AA. */
  .lc-logos :global(li) {
    color: var(--color-charcoal-600);
  }
</style>
