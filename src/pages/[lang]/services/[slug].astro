---
/**
 * Service detail page (one per locale × service).
 * Hero (+ animated ServiceArt) → capabilities → [live HMI demo] → when to call us + deliverables → related projects
 * → related industries + platforms → FAQ → one closing band: the service's pitch + quote / WhatsApp buttons beside the
 * "what we need to quote" checklist (<QuoteCta>). Section headings carry a title only (no orphan "01 —" index).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import FAQ from "~/components/FAQ.astro";
import LogoWall from "~/components/LogoWall.astro";
import HmiDemo from "~/components/motion/HmiDemo.astro";
import HeroArt from "~/components/sections/catalog/HeroArt.astro";
import FeatureGrid from "~/components/sections/catalog/FeatureGrid.astro";
import SpecList from "~/components/sections/catalog/SpecList.astro";
import RelatedProjects from "~/components/sections/catalog/RelatedProjects.astro";
import LinkTiles from "~/components/sections/catalog/LinkTiles.astro";
import QuoteCta from "~/components/sections/main/QuoteCta.astro";
import {
  absUrl,
  brandsIn,
  countLabel,
  html,
  industryCopy,
  industryIcon,
  orgRef,
  projectsFor,
  projectsForIndustry,
  projectsForService,
  quoteHref,
  secondaryCta,
  serviceCopy,
} from "~/components/sections/catalog/catalog";
import { fmt } from "~/components/nav";
import { LOCALES, getMessages, localePath, type Locale } from "~/i18n";
import { SERVICES, SERVICE_SLUGS, type ServiceSlug } from "~/data/services";
import { SITE } from "~/data/site";

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => SERVICE_SLUGS.map((slug) => ({ params: { lang, slug } })));
}

const locale = Astro.params.lang as Locale;
const slug = Astro.params.slug as ServiceSlug;
const m = getMessages(locale);
const L = m.common.labels;
const item = serviceCopy(locale, slug)!;
const data = SERVICES.find((s) => s.slug === slug)!;
const path = `services/${slug}`;
const url = absUrl(localePath(locale, path));

/* Services that show the playable HMI (the demo is a pasteurizer: PLC logic, process loop, alarms/trends). */
const HMI_DEMO: readonly string[] = ["plc-hmi-programming", "process-control", "scada-data-logging"];
const showHmi = HMI_DEMO.includes(slug);

const related = projectsFor(locale, projectsForService(slug));
const industries = data.industries.filter((i) => industryCopy(locale, i));
const relatedBrands = brandsIn(related);
const brands = relatedBrands.length >= 2 ? relatedBrands : [...SITE.brands];
const wa = fmt(m.common.whatsapp.service, { service: item.title });
const quote = quoteHref(locale, { service: slug });

/* Alternate light / muted backgrounds over the sections that actually render. */
const order = ["capabilities", showHmi && "hmi", "fit", related.length > 0 && "projects", "industries", "faq"].filter(Boolean) as string[];
const bg = (key: string) => (order.indexOf(key) % 2 === 0 ? "light" : "muted") as "light" | "muted";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${url}#service`,
  name: item.title,
  serviceType: item.title,
  description: item.seoDescription,
  url,
  provider: orgRef(),
  areaServed: { "@type": "Country", name: "Egypt" },
  availableChannel: { "@type": "ServiceChannel", serviceUrl: absUrl(localePath(locale, "contact")), servicePhone: SITE.phone.tel },
};
---

<BaseLayout locale={locale} title={item.seoTitle} description={item.seoDescription} path={path} heroDark jsonLd={jsonLd} whatsappMessage={wa}>
  <Hero
    locale={locale}
    size="page"
    title={html(item.h1, locale)}
    lead={html(item.intro[0] ?? item.summary, locale)}
    chips={brands}
    primary={{ label: m.ui.cta.quote, href: quote }}
    secondary={secondaryCta(locale, wa)}
  >
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: m.common.breadcrumbs.services, path: "services" }, { label: item.navTitle }]} />
    <HeroArt slot="media" kind="service" slug={slug} />
    <HeroArt inline kind="service" slug={slug} />
  </Hero>

  {/* What we do */}
  <Section variant={bg("capabilities")} id="capabilities" aria-labelledby="capabilities-title">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] lg:gap-20">
      <SectionHeading
        id="capabilities-title"
        title={html(L.capabilities, locale)}
        lead={item.intro.length > 1 ? html(item.intro.slice(1).join(" "), locale) : undefined}
        class="self-start lg:sticky lg:top-[calc(var(--header-h)+2rem)]"
      />
      <FeatureGrid items={item.capabilities} locale={locale} columns={2} />
    </div>
  </Section>

  {/* Live HMI (programming / process / SCADA pages) */}
  {
    showHmi && (
      <Section variant={bg("hmi")} id="hmi-demo" aria-labelledby="hmi-demo-title">
        <SectionHeading
          id="hmi-demo-title"
          eyebrow={m.hmi.intro.eyebrow}
          title={html(m.hmi.intro.title, locale)}
          lead={html(m.hmi.intro.lead, locale)}
        />
        <HmiDemo locale={locale} variant="compact" class="mt-10" />
      </Section>
    )
  }

  {/* When to call us + what you receive */}
  <Section variant={bg("fit")} id="fit" aria-labelledby="situations-title">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading id="situations-title" title={html(L.situations, locale)} />
        <SpecList items={item.situations} locale={locale} marker="bar" ruled class="mt-8 border-t border-charcoal-200" />
      </div>
      <div class="on-dark relative isolate self-start overflow-hidden bg-navy-950 p-7 text-navy-100 sm:p-10">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint mask-fade-edges"></div>
        <h2 id="deliverables-title" class="type-h3 text-white">{L.deliverables}</h2>
        <SpecList items={item.deliverables} locale={locale} marker="check" ruled class="mt-6 border-t border-white/10" />
      </div>
    </div>
  </Section>

  {/* Related projects (hidden when the service has none yet) */}
  <RelatedProjects
    locale={locale}
    projects={related}
    title={L.relatedProjects}
    variant={related.length ? bg("projects") : "light"}
    all={{ href: `${localePath(locale, "projects")}?service=${slug}`, label: L.allProjects, count: related.length }}
  />

  {/* Related industries + platforms */}
  <Section variant={bg("industries")} id="industries" aria-labelledby="industries-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading id="industries-title" title={html(L.relatedIndustries, locale)} />
    </div>
    <LinkTiles
      class="mt-10"
      items={industries.map((i) => ({
        href: localePath(locale, `industries/${i}`),
        title: industryCopy(locale, i)!.navTitle,
        icon: industryIcon(i),
        meta: projectsForIndustry(i).length ? countLabel(locale, projectsForIndustry(i).length) : undefined,
      }))}
    />
    <div class="lc-logos mt-16 lg:max-w-[calc(var(--n)*20%)]" style={`--n:${brands.length}`}>
      <LogoWall locale={locale} brands={brands} />
    </div>
  </Section>

  {/* FAQ */}
  <Section variant={bg("faq")} id="faq" aria-labelledby="faq-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] lg:gap-20">
      <SectionHeading id="faq-title" title={html(L.faq, locale)} class="self-start" />
      <FAQ items={item.faq.map((f) => ({ q: f.q, a: html(f.a, locale) }))} openFirst />
    </div>
  </Section>

  <QuoteCta
    locale={locale}
    id="quote-checklist"
    eyebrow={item.navTitle}
    title={item.cta.title}
    text={item.cta.text}
    primary={{ label: m.ui.cta.quote, href: quote }}
    secondary={secondaryCta(locale, wa)}
  />
</BaseLayout>

<style>
  /* The text wordmark (Wecon) renders below 18.66px bold on phones: use the 5.3:1 grey so it passes WCAG AA. */
  .lc-logos :global(li) {
    color: var(--color-charcoal-600);
  }
</style>
