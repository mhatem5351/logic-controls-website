---
/**
 * Services overview: hero → service cards (animated art) → recent case studies (proof right after the offer) →
 * how the pieces fit (control loop) → ways to work with us → how we work → FAQ → CTA band.
 * Listing page: the hero stays short (one-line lead, no stat strip — the figures live on home / about) so the first
 * row of cards shows early; "take the full scope or a part" is covered by "Ways to work with us".
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Card from "~/components/Card.astro";
import CtaBand from "~/components/CtaBand.astro";
import FAQ from "~/components/FAQ.astro";
import ProcessSteps from "~/components/ProcessSteps.astro";
import ServiceArt from "~/components/illustrations/ServiceArt.astro";
import ControlLoop from "~/components/motion/ControlLoop.astro";
import FeatureGrid from "~/components/sections/catalog/FeatureGrid.astro";
import RelatedProjects from "~/components/sections/catalog/RelatedProjects.astro";
import { projectsFor, quoteHref, secondaryCta, serviceCopy, serviceSlugs } from "~/components/sections/catalog/catalog";
import { html } from "~/lib/text";
import { absUrl, graph, itemList, webPage } from "~/lib/jsonld";
import { getMessages, localePath, localeStaticPaths, type Locale } from "~/i18n";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const m = getMessages(locale);
const idx = m.services.index;
const L = m.common.labels;
const slugs = serviceSlugs(locale);
const recent = projectsFor(locale); /* newest first */
const wa = m.common.whatsapp.quote;

/* Structured data (src/lib/jsonld.ts): CollectionPage with the services as an ItemList. */
const jsonLd = graph(
  webPage(locale, {
    type: "CollectionPage",
    path: "services",
    name: idx.seo.title,
    description: idx.seo.description,
    mainEntity: itemList(idx.h1, slugs.map((s) => ({ name: serviceCopy(locale, s)!.title, url: absUrl(localePath(locale, `services/${s}`)) }))),
  }),
);
---

<BaseLayout locale={locale} title={idx.seo.title} description={idx.seo.description} path="services" heroDark jsonLd={jsonLd} whatsappMessage={wa}>
  <Hero
    locale={locale}
    size="compact"
    title={html(locale, idx.h1)}
    lead={html(locale, idx.intro[0] ?? "")}
    chips={["PLC", "HMI", "SCADA", "VFD"]}
    primary={{ label: m.ui.cta.quote, href: quoteHref(locale) }}
    secondary={secondaryCta(locale, wa)}
  >
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: m.common.breadcrumbs.services }]} />
  </Hero>

  {/* The eight services */}
  <Section id="services" class="pt-10! lg:pt-14!" aria-label={m.ui.nav.services}>
    <ul role="list" class="lc-grid-services">
      {
        slugs.map((s) => {
          const it = serviceCopy(locale, s)!;
          return (
            <li>
              <Card variant="service" title={it.title} href={localePath(locale, `services/${s}`)} text={it.summary} cta={L.viewService} headingLevel="h2">
                <Fragment slot="media">
                  <ServiceArt slug={s} />
                </Fragment>
              </Card>
            </li>
          );
        })
      }
    </ul>
  </Section>

  {/* Recent case studies */}
  <RelatedProjects
    locale={locale}
    projects={recent}
    id="recent-projects"
    variant="muted"
    eyebrow={m.common.breadcrumbs.projects}
    title={m.home.projects.title}
    lead={m.home.projects.intro}
    all={{ href: localePath(locale, "projects"), label: L.allProjects, count: recent.length }}
  />

  {/* How the pieces fit */}
  <Section id="control-loop">
    <ControlLoop locale={locale} />
  </Section>

  {/* Ways to work with us */}
  <Section variant="dark" id="engagement" aria-labelledby="engagement-title">
    <SectionHeading id="engagement-title" eyebrow={idx.engagement.eyebrow} title={html(locale, idx.engagement.title)} />
    <FeatureGrid items={idx.engagement.items} locale={locale} columns={4} class="mt-12" />
  </Section>

  {/* How we work */}
  <Section id="process" aria-labelledby="process-title">
    <SectionHeading id="process-title" eyebrow={idx.processEyebrow} title={html(locale, m.common.process.title)} lead={html(locale, m.common.process.intro)} />
    <ProcessSteps locale={locale} steps={m.common.process.steps} class="mt-14" />
  </Section>

  {/* FAQ */}
  <Section variant="muted" id="faq" aria-labelledby="faq-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] lg:gap-20">
      <SectionHeading id="faq-title" eyebrow={L.faq} title={html(locale, idx.faq.title)} class="self-start" />
      <FAQ items={idx.faq.items.map((f) => ({ q: f.q, a: html(locale, f.a) }))} openFirst />
    </div>
  </Section>

  <CtaBand locale={locale} title={html(locale, m.common.ctaBand.default.title)} text={m.common.ctaBand.default.text} secondary={secondaryCta(locale, wa)} />
</BaseLayout>
