const d = DEMO[locale];

const SCALES = {
  royal: ["#f0f8ff", "#deefff", "#c1e0ff", "#95c6ff", "#5fa4fa", "#257ae0", "#0556ad", "#034393", "#023378", "#04255b", "#03163d"],
  navy: ["#f0f6fd", "#deebfd", "#c1d6f6", "#96b6e8", "#628ed3", "#3267b8", "#1951a5", "#034091", "#012c75", "#061b45", "#040e27"],
  charcoal: ["#fafafb", "#f3f3f6", "#e5e6eb", "#d1d2d8", "#a7a7ab", "#7e8087", "#6a6b72", "#4e4f58", "#363740", "#25262e", "#16161e"],
  signal: ["#fff9e4", "#ffefbc", "#ffdd84", "#ffc64b", "#ffb02b", "#f79719", "#d6760c", "#af5b0b", "#8a4613", "#6d3714", "#492107"],
} as const;
const STEPS = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const SAMPLED: Record<string, string> = {
  "royal-600": "logo · gear top",
  "navy-700": "logo · brand blue (mean)",
  "navy-800": "logo · gear bottom",
  "charcoal-800": "logo · “Logic”",
  "charcoal-600": "logo · traces",
  "charcoal-400": "logo · swoosh",
};
const ICONS: IconName[] = ["panel", "plc", "hmi", "gear", "bolt", "flask", "bottle", "droplet", "box", "wrench", "shield", "globe", "phone", "mail", "whatsapp", "facebook", "arrow", "check", "map-pin", "clock", "factory", "traces", "gauge", "file", "users", "calendar", "send", "download", "thermometer", "layers", "play", "plus", "external", "chevron-right", "menu", "close"];
const serviceIcons: IconName[] = ["panel", "plc", "gear"];
const galleryImages: { src: ImageMetadata; alt: string }[] = [];
[P.panelVfd, P.filler, P.hmiLabel, P.panelPlc, P.hmiMachine, P.hmiLamps].forEach((src, i) => {
  if (src) galleryImages.push({ src, alt: d.gallery[i] ?? "" });
});
const cap = "mb-3 font-mono text-xs tracking-wider text-charcoal-600 uppercase on-dark:text-navy-300";
---

<BaseLayout locale={locale} title="Styleguide" path="styleguide" noindex heroDark>
  <Hero locale={locale} size="page" title={d.heroTitle} lead={d.heroLead} chips={["TOKENS", "MOTIFS", "COMPONENTS"]} primary={false} secondary={false}>
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: "Styleguide" }]} jsonLd={false} />
  </Hero>

  {/* ------------------------------------------------ brand */}
  <Section>
    <SectionHeading index="01" eyebrow="Brand" title="Logo, mark & swoosh" />
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      <div class="grid min-h-48 place-items-center border border-charcoal-200 bg-white p-8">
        <Logo width={220} />
      </div>
      <div class="grid min-h-48 place-items-center bg-navy-950 p-8">
        <Logo variant="dark" width={220} />
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div class="grid place-items-center border border-charcoal-200 p-4"><BrandMark class="h-20 w-auto" title="Logic Controls" /></div>
        <div class="grid place-items-center bg-navy-950 p-4"><BrandMark tone="dark" class="h-20 w-auto" /></div>
        <div class="grid place-items-center bg-navy-50 p-4 text-royal-600"><BrandMark tone="mono" class="h-20 w-auto" /></div>
        <div class="col-span-3 grid place-items-center border border-charcoal-200 p-6"><Swoosh class="w-full max-w-72" /></div>
      </div>
    </div>
  </Section>

  {/* ------------------------------------------------ colour */}
  <Section variant="muted">
    <SectionHeading index="02" eyebrow="Colour" title="Palette sampled from the logo" lead="Royal · navy · charcoal come from the logo pixels; signal amber is the single accent (control-panel pilot lamp)." />
    <div class="mt-10 space-y-6" lang="en">
      {
        Object.entries(SCALES).map(([name, hexes]) => (
          <div>
            <p class="mb-2 font-mono text-sm font-semibold text-navy-900">{name}</p>
            <ul role="list" class="grid grid-cols-6 gap-1.5 sm:grid-cols-11">
              {hexes.map((hex, i) => {
                const key = `${name}-${STEPS[i]}`;
                return (
                  <li class="overflow-hidden border border-black/5 bg-white">
                    <div class="flex h-16 items-end p-1.5" style={`background:${hex}`}>
                      {SAMPLED[key] && <span class="lc-led !size-2" style="--led:var(--color-signal-400)" title={SAMPLED[key]} />}
                    </div>
                    <div class="px-1.5 py-1 font-mono text-[0.625rem] leading-tight text-charcoal-700">
                      <span class="block font-semibold">{STEPS[i]}</span>
                      <span class="block uppercase">{hex.slice(1)}</span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
      <p class="font-mono text-xs text-charcoal-600"><span class="lc-led !size-2 me-2 align-middle" style="--led:var(--color-signal-400)"></span>= sampled from logo-original.jpg</p>
    </div>
  </Section>

  {/* ------------------------------------------------ type */}
  <Section>
    <SectionHeading index="03" eyebrow="Typography" title="Type scale" />
    <div class="mt-10 divide-y divide-charcoal-200 border-y border-charcoal-200">
      {
        [
          ["display", "type-display"],
          ["h1", "type-h1"],
          ["h2", "type-h2"],
          ["h3", "type-h3"],
          ["h4", "type-h4"],
          ["lead", "type-lead"],
          ["body", "text-base"],
          ["small", "text-sm"],
        ].map(([label, cls]) => (
          <div class="grid gap-2 py-6 md:grid-cols-[8rem_1fr] md:items-baseline">
            <p class="font-mono text-xs text-charcoal-600 uppercase" lang="en">{label}</p>
            <p class:list={[cls, "text-navy-950"]}>{label === "body" || label === "small" || label === "lead" ? d.lorem : d.services[1]![0]}</p>
          </div>
        ))
      }
      <div class="grid gap-2 py-6 md:grid-cols-[8rem_1fr] md:items-baseline">
        <p class="font-mono text-xs text-charcoal-600 uppercase" lang="en">label</p>
        <p class="type-label text-royal-700">{t.nav.servicesList.plcHmi}</p>
      </div>
      <div class="grid gap-2 py-6 md:grid-cols-[8rem_1fr] md:items-baseline">
        <p class="font-mono text-xs text-charcoal-600 uppercase" lang="en">code</p>
        <p class="text-charcoal-700"><span class="type-code ltr" dir="ltr">LS XGB-DR16C · Wecon PI3070ig · 24 VDC · IP65</span></p>
      </div>
    </div>
  </Section>

  {/* ------------------------------------------------ motifs */}
  <Section variant="muted">
    <SectionHeading index="04" eyebrow="Motifs" title="Signature visual language" lead="10° italic slant · 45° chamfer · swoosh · circuit traces with ring nodes · blueprint grid · HMI spec chips with status LEDs." />
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <div class="flex min-h-40 flex-col justify-between border border-charcoal-200 bg-white p-6">
        <p class={cap}>slant-bar</p>
        <div class="flex items-center gap-3 text-royal-600"><span class="slant-bar" /><span class="slant-bar w-10" /><span class="slant-bar w-16 text-signal-500" /></div>
      </div>
      <div class="flex min-h-40 flex-col justify-between border border-charcoal-200 bg-white p-6">
        <p class={cap}>chamfer / chamfer-lg</p>
        <div class="flex gap-4"><div class="chamfer h-16 w-24 bg-navy-900" /><div class="chamfer-lg h-16 w-32 bg-royal-600" /></div>
      </div>
      <div class="flex min-h-40 flex-col justify-between border border-charcoal-200 bg-white p-6">
        <p class={cap}>chips + led</p>
        <div class="space-y-3">
          <Chips items={["PLC", "HMI", "VFD", "SCADA"]} joined led />
          <Chips items={["LS XGB", "Wecon PI", "Delta VFD"]} led="green" size="sm" />
        </div>
      </div>
      <div class="on-dark relative min-h-56 overflow-hidden bg-navy-950 p-6 md:col-span-2">
        <div class="absolute inset-0 bg-blueprint" />
        <CircuitTraces corner="bottom-start" class="origin-bottom-left scale-75 rtl:origin-bottom-right" />
        <p class={cap + " relative"}>blueprint + circuit traces (CSS pulses, reduced-motion safe)</p>
      </div>
      <div class="flex min-h-40 flex-col justify-between bg-navy-950 p-6">
        <p class={cap + " text-navy-300"}>swoosh on dark</p>
        <Swoosh tone="light" class="w-full" />
      </div>
    </div>
  </Section>

  <Section variant="dark" angle="both">
    <SectionHeading index="05" eyebrow="Angled section" title={d.ctaTitle} lead={d.lorem} />
  </Section>

  {/* ------------------------------------------------ buttons */}
  <Section>
    <SectionHeading index="06" eyebrow="Buttons" title="Button" />
    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      <div class="space-y-5 border border-charcoal-200 p-6">
        <p class={cap}>light surface</p>
        <div class="flex flex-wrap items-center gap-3">
          <Button href="#">{t.cta.quote}</Button>
          <Button href="#" variant="secondary" icon="phone">{t.cta.call}</Button>
          <Button href="#" variant="ghost">{t.cta.learnMore}</Button>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <Button size="sm">{t.cta.quote}</Button>
          <Button size="md" variant="secondary">{t.cta.viewAll}</Button>
          <Button size="lg" iconEnd="arrow">{t.cta.quote}</Button>
        </div>
      </div>
      <div class="on-dark space-y-5 bg-navy-950 p-6">
        <p class={cap}>dark surface</p>
        <div class="flex flex-wrap items-center gap-3">
          <Button href="#">{t.cta.quote}</Button>
          <Button href="#" variant="on-dark" icon="whatsapp" iconClass="text-whatsapp-500">{t.cta.whatsapp}</Button>
          <Button href="#" variant="ghost">{t.cta.learnMore}</Button>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <Button size="sm" variant="on-dark" icon="mail">{t.cta.email}</Button>
          <Button size="lg" iconEnd="arrow">{t.cta.quote}</Button>
        </div>
      </div>
    </div>
  </Section>

  {/* ------------------------------------------------ icons */}
  <Section variant="muted" compact>
    <SectionHeading index="07" eyebrow="Icons" title="Icon set" as="h2" size="h3" />
    <ul role="list" class="mt-8 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-12" lang="en">
      {
        ICONS.map((name) => (
          <li class="flex flex-col items-center gap-2 border border-charcoal-200 bg-white px-1 py-4 text-navy-900">
            <Icon name={name} />
            <span class="font-mono text-[0.625rem] text-charcoal-600">{name}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ------------------------------------------------ cards */}
  <Section>
    <SectionHeading index="08" eyebrow={t.nav.services} title="Card · service" lead={d.lorem} />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        d.services.map(([title, text], i) => (
          <Card
            variant="service"
            title={title}
            text={text}
            icon={serviceIcons[i]}
            href={href(locale, SERVICE_LINKS[i]!.path)}
            tags={[["24 VDC", "DIN rail", "IP54"], ["LS", "Siemens", "Wecon"], ["VFD", "Servo", "Safety"]][i]}
            cta={t.cta.learnMore}
          />
        ))
      }
    </div>
  </Section>

  <Section variant="muted">
    <SectionHeading index="09" eyebrow={t.nav.industries} title="Card · industry" />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        INDUSTRY_LINKS.map((ind, i) => (
          <Card
            variant="industry"
            title={t.nav.industriesList[ind.key]}
            text={d.industries[i]}
            icon={ind.icon}
            href={href(locale, ind.path)}
            image={[P.filler, P.pharma, P.hmiLabel, P.autoclave][i]}
            cta={t.cta.learnMore}
          />
        ))
      }
    </div>
  </Section>

  <Section>
    <SectionHeading index="10" eyebrow={t.nav.projects} title="Card · project" />
    <div class="mt-10 grid gap-x-6 gap-y-12 md:grid-cols-3">
      {
        d.projects.map(([title, meta], i) => (
          <Card
            variant="project"
            title={title}
            meta={[...meta]}
            href={href(locale, "projects")}
            image={[P.panelVfd, P.hmiMachine, P.panelLamps][i] ?? ["/media/shampoo-filling-line-poster-v3.webp", "/media/bottle-printing-retrofit-poster-v3.webp", "/media/hotel-laundry-hmi-poster-v3.webp"][i]}
            tags={[["LS XGB", "Wecon PI", "VFD"], ["Delta PLC", "Servo"], ["Wecon HMI", "Inverter"]][i]}
            cta={t.cta.viewProject}
          />
        ))
      }
      <Card variant="service" title="media slot" text="A page can drop an illustration component in place of the icon/photo.">
        <div slot="media" class="chamfer grid h-24 place-items-center bg-navy-950 text-royal-300"><Icon name="traces" size={40} /></div>
      </Card>
    </div>
  </Section>

  {/* ------------------------------------------------ stats + process */}
  <Section variant="dark" compact>
    <StatStrip items={d.stats.map(([value, label]) => ({ value, label }))} />
  </Section>
  <Section>
    <SectionHeading index="11" eyebrow="StatStrip · light" title={d.ctaTitle} as="h2" size="h3" />
    <StatStrip class="mt-10" items={d.stats.map(([value, label]) => ({ value, label }))} />
  </Section>

  <Section variant="muted">
    <SectionHeading index="12" eyebrow="ProcessSteps" title={d.steps[0]![0] + " · " + d.steps[3]![0]} />
    <ProcessSteps class="mt-12" steps={d.steps.map(([title, text], i) => ({ title, text, icon: (["map-pin", "file", "panel", "check"] as IconName[])[i] }))} />
  </Section>
  <Section variant="dark">
    <ProcessSteps steps={d.steps.map(([title, text]) => ({ title, text }))} />
  </Section>

  {/* ------------------------------------------------ logo wall, faq, breadcrumbs */}
  <Section compact>
    <LogoWall locale={locale} />
  </Section>
  <Section variant="dark" compact>
    <LogoWall locale={locale} note={false} />
  </Section>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <SectionHeading index="13" eyebrow="FAQ" title={t.faq.title} lead={d.lorem} />
      <FAQ items={d.faq.map(([q, a]) => ({ q, a }))} exclusive openFirst />
    </div>
    <div class="mt-16 space-y-4">
      <p class={cap}>breadcrumbs</p>
      <Breadcrumbs locale={locale} label={`${t.a11y.breadcrumbs} (demo)`} items={[{ label: t.nav.services, path: "services" }, { label: t.nav.servicesList.controlPanels }]} jsonLd={false} />
    </div>
  </Section>

  {/* ------------------------------------------------ media */}
  <Section variant="muted">
    <SectionHeading index="14" eyebrow="VideoPlayer · Gallery" title={d.video[0]!} />
    <div class="mt-10 grid items-start gap-8 lg:grid-cols-[1.6fr_1fr]">
      <VideoPlayer src="/media/shampoo-filling-line-v3.mp4" poster="/media/shampoo-filling-line-poster-v3.webp" title={d.video[0]!} caption={d.video[0]} duration="0:58" />
      <VideoPlayer src="/media/hotel-laundry-hmi-v3.mp4" poster="/media/hotel-laundry-hmi-poster-v3.webp" title={d.video[1]!} caption={d.video[1]} aspect="9/16" />
    </div>
    {galleryImages.length > 0 && <Gallery class="mt-12" images={galleryImages} columns={3} />}
  </Section>

  <CtaBand locale={locale} eyebrow={t.cta.quote} title={d.ctaTitle} text={d.ctaText} />
</BaseLayout>
