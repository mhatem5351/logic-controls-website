    lorem: "تصمم Logic Controls وتصنّع وتشغّل لوحات تحكم PLC وأنظمة أتمتة الماكينات للمصانع في المناطق الصناعية بمصر.",
  },
  zh: {
    heroTitle: "设计系统与<em>组件</em>",
