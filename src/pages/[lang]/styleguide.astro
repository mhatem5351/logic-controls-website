---
/**
 * Internal styleguide (noindex, excluded from the sitemap). Shows every token and component in the page's locale.
 * Section captions are English on purpose (internal tool); demo content is localised so RTL/CJK rendering can be checked.
 */
import type { ImageMetadata } from "astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import Button from "~/components/Button.astro";
import Card from "~/components/Card.astro";
import Chips from "~/components/Chips.astro";
import StatStrip from "~/components/StatStrip.astro";
import LogoWall from "~/components/LogoWall.astro";
import CtaBand from "~/components/CtaBand.astro";
import FAQ from "~/components/FAQ.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import ProcessSteps from "~/components/ProcessSteps.astro";
import VideoPlayer from "~/components/VideoPlayer.astro";
import Gallery from "~/components/Gallery.astro";
import Icon, { type IconName } from "~/components/Icon.astro";
import Logo from "~/components/Logo.astro";
import BrandMark from "~/components/BrandMark.astro";
import Swoosh from "~/components/Swoosh.astro";
import CircuitTraces from "~/components/CircuitTraces.astro";
import { INDUSTRY_LINKS, SERVICE_LINKS, href } from "~/components/nav";
import { getMessages, localeStaticPaths, type Locale } from "~/i18n";

// Internal page: generated in dev only, never shipped to production.
export const getStaticPaths = () => (import.meta.env.DEV ? localeStaticPaths() : []);
const locale = Astro.params.lang as Locale;
const t = getMessages(locale).ui;

/* Project photos: the cleaned, published copies in src/assets/projects (never the raw client-data originals). */
const photoFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*/*.jpg", { eager: true });
const photo = (path: string) => photoFiles[`/src/assets/projects/${path}.jpg`]?.default;
const P = {
  panelVfd: photo("shampoo-filling-delta-wecon/panel"),
  filler: photo("shampoo-filling-delta-wecon/machine"),
  hmiLabel: photo("labeling-machine-delta-wecon/recipes"),
  panelPlc: photo("milk-pasteurizer/panel"),
  hmiMachine: photo("pasteurizer-cip-recipes/settings-timers"),
  hmiLamps: photo("pasteurizer-cip-recipes/hmi"),
  pharma: photo("tablet-coating-scada/machine"),
  autoclave: photo("olive-autoclave-sterilization/machine"),
  panelLamps: photo("labeling-machine-delta-wecon/panel"),
  panelWide: photo("anaerobic-waste-treatment-commissioning/panel"),
};

