---
/**
 * Case study (one per locale × project).
 * Hero (cover; a screen capture or a photo too small for the desktop panel is shown framed at ≤ 1× its size, never
 * stretched: catalog/media.ts + FramedHero) → project facts: ONE data sheet (header band: client · industry · services ·
 * location · year; then the copy's `facts`, a value naming a platform brand linking to /technologies/#brand, plus any
 * technology group the facts do not state; the last cell spans its row, no filler cells) → "At a glance" (first in the
 * story's DOM, shown as the sidebar from 1024px) → Challenge → Solution → Scope → [Technologies used: only without
 * facts] → Result → video (16:9, centred) → gallery (without the hero's cover photo) → previous / next → related
 * projects → CTA band. All case-study H2s share one size; the story column has one measure (44rem).
 * Below 1024px the media block (film + photos) comes right after the facts — on a phone the hero photo sits
 * behind the title, so the machine is shown before the story. It is also first in the DOM (reading / tab order
 * match the phone layout); from 1024px `lg:order-last` puts it back after the story. Story headings carry a title
 * only (no orphan "01 —" index).
 */
import { getImage } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import CtaBand from "~/components/CtaBand.astro";
import Gallery from "~/components/Gallery.astro";
import VideoPlayer from "~/components/VideoPlayer.astro";
import Icon from "~/components/Icon.astro";
import SpecList from "~/components/sections/catalog/SpecList.astro";
import TechStack from "~/components/sections/catalog/TechStack.astro";
import ProjectNav from "~/components/sections/catalog/ProjectNav.astro";
import RelatedProjects from "~/components/sections/catalog/RelatedProjects.astro";
import FramedHero from "~/components/sections/catalog/FramedHero.astro";
import { heroTreatment } from "~/components/sections/catalog/media";
import { factPlatformHref, techGroupLabel, techRows } from "~/components/sections/catalog/facts";
import { techLabel } from "~/lib/text";
import {
  imageAlt,
  industryCopy,
  isPreFounding,
  orderedServices,
  projectCopy,
  projectImages,
  projectsFor,
  quoteHref,
  caseStudyQuoteHref,
  secondaryCta,
  serviceCopy,
} from "~/components/sections/catalog/catalog";
import { heading, html, plain } from "~/lib/text";
import { absUrl, article, graph, webPage } from "~/lib/jsonld";
import { pageContact } from "~/components/contact-cta";
import { LOCALES, getMessages, localePath, type Locale } from "~/i18n";
import { PROJECT_SLUGS, getProject, relatedProjects, type ProjectSlug } from "~/data/projects";

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => PROJECT_SLUGS.map((slug) => ({ params: { lang, slug } })));
}

const locale = Astro.params.lang as Locale;
const slug = Astro.params.slug as ProjectSlug;
const m = getMessages(locale);
const L = m.common.labels;
const p = getProject(slug)!;
const c = projectCopy(locale, slug)!;
/* `solution` is a list of paragraphs (a single string is still accepted). */
const solution: string[] = ([] as string[]).concat(c.solution as string | string[]);
const path = `projects/${slug}`;
const url = absUrl(localePath(locale, path));

const industries = p.industries.filter((i) => industryCopy(locale, i));
const services = orderedServices(p.services).filter((s) => serviceCopy(locale, s));
const location = (m.common.locations as Record<string, string>)[p.location] ?? p.location;
const preFounding = isPreFounding(p);

const video = p.video;
const vertical = !!video && video.height > video.width;
/* Optional short visible captions per photo (projects.json → items[slug].imageCaptions[key]). */
const captions = (c as { imageCaptions?: Record<string, string> }).imageCaptions ?? {};
const allImages = projectImages(p).map((img) => ({ key: img.key, src: img.image, alt: imageAlt(locale, slug, img.key), caption: captions[img.key] }));
/* The cover is already the hero photo, so the gallery shows the other photos. It stays only when it is the case
   study's one photo and there is no film, so every page keeps at least one photo that opens full size. */
const otherImages = allImages.filter((img) => img.key !== p.cover.key);
const images = otherImages.length || video ? otherImages : allImages;
const landscapeVideo = !!video && !vertical;
const showMedia = landscapeVideo || images.length > 0;
/* A landscape film with one or two photos: film and photos side by side. Otherwise film, then the photos:
   1 → one centred photo · 2 → two up · 3 → a lead photo + two · 4 → 2 × 2 (big enough to read HMI screens) · 5+ → 3 up. */
const sideBySide = landscapeVideo && images.length > 0 && images.length <= 2;
const galleryLead = !sideBySide && images.length === 3;
const galleryCols = (sideBySide ? 1 : images.length === 4 ? 2 : Math.min(images.length, 3)) as 1 | 2 | 3;
/* Project facts table (projects.json → items[slug].facts: [{ label, value }]); rendered only when present. */
const rawFacts = (c as { facts?: { label: string; value: string }[] }).facts ?? [];
/* One facts table: the copy's facts (a value naming a platform brand links to its section on /technologies/), then any
   technology group the facts do not state (facts.ts). The separate "Technologies used" block only remains for a case
   study without facts. */
const facts: { label: string; value: string; href?: string }[] = [
  ...rawFacts.map((f, i) => ({ ...f, href: factPlatformHref(locale, slug, i) })).filter((f) => f.label && f.value),
  ...(rawFacts.length ? techRows(slug, p.technologies) : []).map((g) => ({
    label: techGroupLabel(locale, g.group),
    value: g.items.map((s) => techLabel(locale, s)).join(" · "),
  })),
];
/* The last cell spans the rest of its row (2 columns on tablets, 3 on desktop): no blank filler cells. */
const lastSpan = [
  facts.length % 2 === 1 ? "sm:col-span-2" : "",
  ({ 1: "lg:col-span-3", 2: "lg:col-span-2", 0: "lg:col-span-1" } as Record<number, string>)[facts.length % 3] ?? "",
].join(" ");
/* Case studies that also prove the foreign-manufacturers offer (commissioning lines supplied by others). */
const FOREIGN_PROOF: readonly string[] = ["anaerobic-waste-treatment-commissioning"];
/* Hero media: covers that are screen captures or too small for the panel are framed, never stretched (media.ts). */
const treatment = heroTreatment(p);
const videoTitle = c.videoTitle ?? c.cardTitle;

/* Portfolio order (newest first) for previous / next, wrapping around. */
const list = projectsFor(locale);
const at = list.findIndex((x) => x.slug === slug);
const prev = list[(at - 1 + list.length) % list.length]!;
const next = list[(at + 1) % list.length]!;
const related = projectsFor(locale, relatedProjects(slug, 3));

/* Same message as the chrome's WhatsApp actions (contact-cta.ts pageContact; tr / zh name the case study in English too). */
const wa = pageContact(locale, `projects/${slug}`).whatsapp;
/* Social card: 1.91:1, 1200×630 when the photo allows. Images are never enlarged, so for smaller covers crop the
   largest 1.91:1 box that fits (and report its real size in og:image:width/height). */
const ogW = Math.min(1200, p.cover.image.width, Math.floor((p.cover.image.height * 1200) / 630));
const ogH = Math.round((ogW * 630) / 1200);
const og = await getImage({ src: p.cover.image, width: ogW, height: ogH, fit: "cover", format: "jpg", quality: 80 });
const industryName = industryCopy(locale, p.industries[0] ?? "")?.navTitle;
/* Hero props shared by the two Hero variants below (full-bleed cover / framed media). */
const heroProps = {
  locale,
  size: "page" as const,
  title: html(locale, c.title),
  lead: html(locale, c.summary),
  chips: [industryName, location, String(p.year)].filter((x): x is string => !!x),
  image: p.cover.image,
  imageAlt: imageAlt(locale, slug, p.cover.key),
  primary: { label: m.ui.cta.quote, href: caseStudyQuoteHref(locale, p) },
  secondary: secondaryCta(locale, wa),
};
const crumbs = [{ label: m.common.breadcrumbs.projects, path: "projects" }, { label: plain(locale, c.cardTitle) }];


/* Structured data (src/lib/jsonld.ts): the page + the case study as Article (publication dates from git, the project
   year as temporalCoverage, localized industries / technologies, the generated card + the cover, the film). */
const jsonLd = graph(
  webPage(locale, { path, name: c.seoTitle, description: c.seoDescription, mainEntity: { "@id": `${url}#case-study` } }),
  article(locale, {
    path,
    project: p,
    copy: c,
    coverUrl: absUrl(og.src),
    industries: industries.map((i) => ({ name: industryCopy(locale, i)!.title, path: `industries/${i}` })),
    location,
    section: m.common.breadcrumbs.projects,
    videoTitle,
  }),
);
---

<BaseLayout locale={locale} title={c.seoTitle} description={c.seoDescription} path={path} heroDark jsonLd={jsonLd} ogImage={og.src} ogImageSize={{ width: ogW, height: ogH }} whatsappMessage={wa}>
  {/* Two variants on purpose: a `media` slot inside a false condition still counts as a filled slot for the Hero
      (Astro.slots.has), which would drop the full-bleed photo of the "cover" case studies. */}
  {
    treatment === "cover" ? (
      <Hero {...heroProps}>
        <Breadcrumbs slot="breadcrumbs" locale={locale} items={crumbs} />
      </Hero>
    ) : (
      <Hero {...heroProps} bandWithMedia>
        <Breadcrumbs slot="breadcrumbs" locale={locale} items={crumbs} />
        <FramedHero slot="media" image={p.cover.image} alt={imageAlt(locale, slug, p.cover.key)} kind={treatment} />
      </Hero>
    )
  }

  {/* Project facts: one data sheet. Header band = client · industry · services · location · year; below it the facts
      table (equipment, scope, PLC, HMI…), hairline cells, the last one spanning the rest of its row. */}
  <Section compact class="border-b border-charcoal-200" aria-labelledby="facts-title">
    <h2 id="facts-title" class="flex items-center gap-3 type-h4 text-navy-950">
      <span class="slant-bar text-royal-600" aria-hidden="true" />
      {L.projectFacts}
    </h2>
    <div class="mt-5 border border-charcoal-200 bg-white">
      <dl class="grid grid-cols-2 gap-x-6 gap-y-5 bg-navy-50/70 px-4 py-4 sm:px-5 sm:py-5 lg:grid-cols-[1.2fr_1.2fr_2fr_0.8fr_0.6fr]">
        <div class="col-span-2 lg:col-span-1">
          <dt class="type-label text-charcoal-600">{L.client}</dt>
          <dd class="mt-1.5 font-semibold text-navy-950" set:html={html(locale, c.client)} />
        </div>
        <div class="col-span-2 lg:col-span-1">
          <dt class="type-label text-charcoal-600">{industries.length > 1 ? L.industries : L.industry}</dt>
          <dd class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1">
            {
              industries.map((i) => (
                <a href={localePath(locale, `industries/${i}`)} class="font-semibold text-royal-700 underline decoration-royal-200 underline-offset-4 hover:decoration-royal-600">
                  {industryCopy(locale, i)!.navTitle}
                </a>
              ))
            }
          </dd>
        </div>
        <div class="col-span-2 lg:col-span-1">
          <dt class="type-label text-charcoal-600">{services.length > 1 ? L.services : L.service}</dt>
          <dd class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1">
            {
              services.map((s) => (
                <a href={localePath(locale, `services/${s}`)} class="font-semibold text-royal-700 underline decoration-royal-200 underline-offset-4 hover:decoration-royal-600">
                  {serviceCopy(locale, s)!.navTitle}
                </a>
              ))
            }
          </dd>
        </div>
        <div>
          <dt class="type-label text-charcoal-600">{L.location}</dt>
          <dd class="mt-1.5 font-semibold text-navy-950">{location}</dd>
        </div>
        <div>
          <dt class="type-label text-charcoal-600">{L.year}</dt>
          <dd class="mt-1.5 font-semibold text-navy-950"><span class="ltr" dir="ltr">{p.year}</span></dd>
        </div>
      </dl>
      {
        facts.length > 0 && (
          <dl class="grid gap-px border-t border-charcoal-200 bg-charcoal-200 sm:grid-cols-2 lg:grid-cols-3">
            {facts.map((f, i) => (
              <div class:list={["flex flex-col gap-1.5 bg-white px-4 py-3.5 sm:px-5", i === facts.length - 1 && lastSpan]}>
                <dt class="type-label text-charcoal-600" set:html={html(locale, f.label)} />
                <dd class="font-semibold text-navy-950">
                  {f.href ? (
                    <a href={f.href} class="text-royal-700 underline decoration-royal-200 underline-offset-4 hover:decoration-royal-600" set:html={html(locale, f.value)} />
                  ) : (
                    <Fragment set:html={html(locale, f.value)} />
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    {
      preFounding && (
        <p class="mt-5 flex flex-wrap items-start gap-x-4 gap-y-1 text-sm text-charcoal-600">
          <span class="flex items-start gap-2">
            <Icon name="clock" size={16} class="mt-0.5 shrink-0 text-royal-600" />
            <span set:html={html(locale, m.common.notes.preFounding)} />
          </span>
          {/* who those engineers are (CS2-11) */}
          <a href={`${localePath(locale, "about")}#founder`} class="group inline-flex items-center gap-1.5 font-semibold text-royal-700 underline decoration-royal-200 underline-offset-4 hover:decoration-royal-600">
            {m.common.founderStrip.cta}
            <Icon name="arrow" size={14} class="transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" />
          </a>
        </p>
      )
    }
  </Section>

  <div class="flex flex-col">
    {/* Media: film (16:9) + photos. Headings use the story's H2 size (h3 scale): the media supports the story. */}
    {
      showMedia && (
        <Section variant="muted" id="media" class="lg:order-last" aria-labelledby={landscapeVideo ? "video-title" : "gallery-title"}>
          {sideBySide && video ? (
            <>
              <SectionHeading id="video-title" eyebrow={L.video} title={html(locale, L.watchVideo)} size="h3" />
              <div class="mt-8 grid items-start gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
                <VideoPlayer locale={locale} src={video.src} poster={video.poster} title={videoTitle} description={c.videoDescription} aspect="16/9" caption={videoTitle} />
                <div>
                  <h3 id="gallery-title" class="mb-3 type-label text-charcoal-600">{L.gallery}</h3>
                  <Gallery
                    locale={locale}
                    images={images}
                    columns={images.length === 2 ? 2 : 1}
                    sizes={images.length === 2 ? "(min-width: 1024px) 400px, calc((100vw - 3rem) / 2)" : "(min-width: 1024px) 400px, calc(100vw - 2rem)"}
                    class="lg:[&_ul]:grid-cols-1"
                  />
                </div>
              </div>
            </>
          ) : (
            <>
              {landscapeVideo && video && (
                <div class:list={["mx-auto max-w-5xl", images.length > 0 && "mb-16 sm:mb-20"]}>
                  <SectionHeading id="video-title" eyebrow={L.video} title={html(locale, L.watchVideo)} size="h3" />
                  <VideoPlayer locale={locale} src={video.src} poster={video.poster} title={videoTitle} description={c.videoDescription} aspect="16/9" caption={videoTitle} class="mt-8" />
                </div>
              )}
              {images.length > 0 && (
                <div class:list={[galleryCols === 1 && "mx-auto max-w-3xl"]}>
                  <SectionHeading id="gallery-title" eyebrow={L.fromSite} title={html(locale, L.gallery)} size="h3" />
                  <Gallery locale={locale} images={images} columns={galleryCols} lead={galleryLead} class="mt-8" />
                </div>
              )}
            </>
          )}
          <div class:list={["mt-10 grid gap-3 text-sm text-charcoal-600 sm:grid-cols-2 sm:gap-8", !landscapeVideo && galleryCols === 1 ? "mx-auto max-w-3xl" : landscapeVideo && !sideBySide && images.length === 0 && "mx-auto max-w-5xl"]}>
            <p class="flex gap-2.5"><Icon name="shield" size={18} class="mt-0.5 shrink-0 text-royal-600" /><span set:html={html(locale, m.common.notes.anonymised)} /></p>
            <p class="flex gap-2.5"><Icon name="file" size={18} class="mt-0.5 shrink-0 text-royal-600" /><span set:html={html(locale, m.common.notes.photos)} /></p>
          </div>
        </Section>
      )
    }

    {/* Story */}
    <Section id="story" class="lg:pt-20!">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] lg:gap-16">
        {/* First in the DOM (the summary is read before the story), the sidebar from 1024px. Below 1024px the aside
            dissolves into the grid: the reel and "At a glance" move above the story, the reference offer after it. */}
        <aside class:list={["max-lg:contents lg:col-start-2 lg:row-start-1 lg:flex lg:min-w-0 lg:flex-col lg:gap-8", !vertical && "lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start"]} aria-labelledby="highlights-title">
          <div class="on-dark relative isolate overflow-hidden bg-navy-950 text-navy-100 max-lg:-order-1">
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint mask-fade-edges"></div>
            <div class="flex items-center gap-3 border-b border-white/10 px-6 py-3.5">
              <span class="lc-led" style="--led:#2bd47d" aria-hidden="true"></span>
              <h2 id="highlights-title" class="type-h4 text-white">{L.highlights}</h2>
            </div>
            <ul role="list" class="divide-y divide-white/10 px-6">
              {
                c.highlights.map((h) => (
                  <li class="flex items-start gap-3 py-4">
                    <Icon name="check" size={18} class="mt-0.5 text-signal-400" strokeWidth={2.25} />
                    <span class="font-semibold text-white" set:html={html(locale, h)} />
                  </li>
                ))
              }
            </ul>
            <div class="border-t border-white/10 px-6 py-5">
              <a href={caseStudyQuoteHref(locale, p)} class="group inline-flex min-h-6 items-center gap-2 text-sm font-bold text-royal-300 hover:text-white">
                {m.common.ctaBand.project.title}
                <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
              </a>
            </div>
          </div>

          {
            video && vertical && (
              <div class="max-lg:order-first">
                <p class="mb-3 flex items-center gap-2 type-label text-charcoal-600">
                  <Icon name="play" size={12} class="text-royal-600" />
                  {L.watchVideo}
                </p>
                <VideoPlayer locale={locale} src={video.src} poster={video.poster} title={videoTitle} description={c.videoDescription} aspect="9/16" caption={videoTitle} class="max-w-[22rem]" />
              </div>
            )
          }

          {/* The one third-party proof an anonymised portfolio can offer: a reference call (with the client's permission). */}
          <div class="relative border border-charcoal-200 bg-white p-6 max-lg:order-last">
            <span aria-hidden="true" class="absolute -top-px start-6 h-1 w-14 skew-x-[-10deg] bg-royal-600 rtl:skew-x-[10deg]" />
            <p class="flex items-center gap-2.5 type-h4 text-navy-950">
              <Icon name="users" size={20} class="shrink-0 text-royal-600" />
              <span set:html={heading(locale, L.referenceTitle)} />
            </p>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-charcoal-700" set:html={html(locale, L.referenceText)} />
            <a href={quoteHref(locale, { service: "other", intent: "reference" })} class="group mt-4 inline-flex min-h-6 items-center gap-2 text-sm font-bold text-royal-600 hover:text-royal-800">
              {L.referenceCta}
              <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
            </a>
          </div>
        </aside>

        <article class="min-w-0 lg:col-start-1 lg:row-start-1">
          <section aria-labelledby="challenge-title">
            <SectionHeading id="challenge-title" title={html(locale, L.challenge)} size="h3" />
            <p class="mt-5 max-w-[44rem] text-lg/relaxed text-charcoal-700" set:html={html(locale, c.challenge)} />
          </section>

          <section aria-labelledby="solution-title" class="mt-14">
            <SectionHeading id="solution-title" title={html(locale, L.solution)} size="h3" />
            {
              solution.map((para, i) => (
                <p class:list={["max-w-[44rem] text-lg/relaxed text-charcoal-700", i === 0 ? "mt-5" : "mt-4"]} set:html={html(locale, para)} />
              ))
            }
          </section>

          <section aria-labelledby="scope-title" class="mt-14">
            <SectionHeading id="scope-title" title={html(locale, L.scope)} size="h3" />
            <SpecList items={c.scope} locale={locale} marker="check" columns={2} ruled class="mt-6 max-w-[44rem] border-t border-charcoal-200" />
          </section>

          {
            rawFacts.length === 0 && techRows("", p.technologies).length > 0 && (
              <section aria-labelledby="technologies-title" class="mt-14">
                <SectionHeading id="technologies-title" title={html(locale, L.technologiesUsed)} size="h3" />
                <TechStack technologies={p.technologies} locale={locale} class="mt-6 max-w-[44rem]" />
              </section>
            )
          }

          <section aria-labelledby="result-title" class="mt-14">
            <SectionHeading id="result-title" title={html(locale, L.result)} size="h3" />
            <div class="relative mt-6 max-w-[44rem] border-s-4 border-royal-600 bg-navy-50 px-6 py-6 sm:px-8">
              <p class="type-lead text-navy-950" set:html={html(locale, c.result)} />
            </div>
            {
              /* A commissioning-only job on equipment supplied by others: the same service foreign manufacturers need
                 when they start a line in Egypt (CS2-11). */
              FOREIGN_PROOF.includes(slug) && (
                <a
                  href={localePath(locale, "foreign-manufacturers")}
                  class="group mt-5 inline-flex items-center gap-2 font-bold text-royal-700 underline decoration-royal-200 underline-offset-4 hover:decoration-royal-600"
                >
                  <Icon name="globe" size={18} class="shrink-0 text-royal-600" />
                  {m.home.audiences.foreign.title}
                  <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
                </a>
              )
            }
          </section>
        </article>
      </div>
    </Section>
  </div>

  {/* Previous / next */}
  <Section compact id="more">
    <ProjectNav locale={locale} prev={prev} next={next} />
  </Section>

  <RelatedProjects locale={locale} projects={related} title={L.relatedProjects} eyebrow={m.common.breadcrumbs.projects} variant="muted" all={{ href: localePath(locale, "projects"), label: L.allProjects }} />

  <CtaBand
    locale={locale}
    title={html(locale, m.common.ctaBand.project.title)}
    text={m.common.ctaBand.project.text}
    primary={{ label: m.ui.cta.quote, href: caseStudyQuoteHref(locale, p) }}
    secondary={secondaryCta(locale, wa)}
  />
</BaseLayout>
