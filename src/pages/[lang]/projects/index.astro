---
/**
 * Portfolio: hero → filters (industry × service) + project cards → notes → CTA band.
 * Listing page: short hero (one-line lead, no stat strip) so the filters and the first cards show early.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import CtaBand from "~/components/CtaBand.astro";
import Icon from "~/components/Icon.astro";
import ProjectBrowser from "~/components/sections/catalog/ProjectBrowser.astro";
import { imageAlt, projectCopy, projectsFor, quoteHref, secondaryCta } from "~/components/sections/catalog/catalog";
import { html } from "~/lib/text";
import { absUrl, graph, itemList, webPage } from "~/lib/jsonld";
import { getMessages, localePath, localeStaticPaths, type Locale } from "~/i18n";
import { featuredProjects } from "~/data/projects";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const m = getMessages(locale);
const idx = m.projects.index;
const notes = m.common.notes;
const L = m.common.labels;
const projects = projectsFor(locale);
const wa = m.common.whatsapp.default;
/* Hero photo: the first featured case study's cover (data-driven). */
const heroProject = featuredProjects().find((p) => projectCopy(locale, p.slug)) ?? projects[0];

/* Structured data (src/lib/jsonld.ts): CollectionPage with the case studies as an ItemList. */
const jsonLd = graph(
  webPage(locale, {
    type: "CollectionPage",
    path: "projects",
    name: idx.seo.title,
    description: idx.seo.description,
    mainEntity: itemList(idx.h1, projects.map((p) => ({ name: projectCopy(locale, p.slug)!.cardTitle, url: absUrl(localePath(locale, `projects/${p.slug}`)) }))),
  }),
);
---

<BaseLayout locale={locale} title={idx.seo.title} description={idx.seo.description} path="projects" heroDark jsonLd={jsonLd} whatsappMessage={wa}>
  <Hero
    locale={locale}
    size="compact"
    title={html(locale, idx.h1)}
    lead={html(locale, idx.intro[0] ?? "")}
    primary={{ label: m.ui.cta.quote, href: quoteHref(locale) }}
    secondary={secondaryCta(locale, wa)}
    image={heroProject?.cover.image}
    imageAlt={heroProject ? imageAlt(locale, heroProject.slug, heroProject.cover.key) : ""}
  >
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: m.common.breadcrumbs.projects }]} />
  </Hero>

  <Section id="portfolio" class="pt-8! lg:pt-12!">
    <ProjectBrowser locale={locale} projects={projects} />

    {/* Clients are anonymised, so the one third-party proof on offer is a reference call: shown as a block, not a footnote. */}
    <div class="mt-16 grid gap-6 border-t border-charcoal-200 pt-8 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-start md:gap-10">
      <div class="relative border border-charcoal-200 bg-white p-6 sm:p-7">
        <span aria-hidden="true" class="absolute -top-px start-6 h-1 w-14 skew-x-[-10deg] bg-royal-600 rtl:skew-x-[10deg] sm:start-7" />
        <h2 class="flex items-center gap-2.5 type-h4 text-navy-950">
          <Icon name="users" size={20} class="shrink-0 text-royal-600" />
          {L.referenceTitle}
        </h2>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-charcoal-700">{L.referenceText}</p>
        <a href={quoteHref(locale, { service: "other" })} class="group mt-4 inline-flex min-h-6 items-center gap-2 text-sm font-bold text-royal-600 hover:text-royal-800">
          {L.referenceCta}
          <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
        </a>
      </div>
      <p class="flex gap-2.5 text-sm text-charcoal-600 md:pt-2"><Icon name="shield" size={18} class="mt-0.5 shrink-0 text-royal-600" />{notes.anonymised}</p>
    </div>
  </Section>

  <CtaBand locale={locale} title={html(locale, m.common.ctaBand.default.title)} text={m.common.ctaBand.default.text} secondary={secondaryCta(locale, wa)} />
</BaseLayout>
