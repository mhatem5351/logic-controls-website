---
/**
 * Home — dual-path entry (factories in Egypt / setting up in Egypt). Section order: src/i18n/CONTENT.md §4.
 * Hero → platforms → two doors → recent work → services → industries → live HMI demo → why us (+ founder strip) →
 * how we work → commissioning case for foreign manufacturers → zones → FAQ → closing CTA with the quote checklist.
 * Services and industries sit next to each other (a buyer scanning the offer is not interrupted by the demo); light
 * and tinted bands alternate. Phones and tablets (< 1024px) get compact service rows, industry tiles, a one-screen
 * teaser of the HMI demo (expands in place), the first three process steps and the first four FAQs (the rest one tap
 * away), and a swipeable row of case studies with a position cue instead of the full grid; the full card grids start
 * at 1024px (VIS2-07: the 768px tablet was the longest layout).
 * zh / tr (investorFirst): the hero's second action is the foreign-manufacturers page, with one quiet line for machine
 * builders under it (no extra banner: at most three actions above the fold).
 */
import { Picture } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import LogoWall from "~/components/LogoWall.astro";
import Card from "~/components/Card.astro";
import Button from "~/components/Button.astro";
import ViewAll from "~/components/ViewAll.astro";
import Icon, { type IconName } from "~/components/Icon.astro";
import ProcessSteps from "~/components/ProcessSteps.astro";
import FAQ from "~/components/FAQ.astro";
import HmiDemo from "~/components/motion/HmiDemo.astro";
import ServiceArt from "~/components/illustrations/ServiceArt.astro";
import IndustryArt from "~/components/illustrations/IndustryArt.astro";
import AudienceDoors from "~/components/sections/main/AudienceDoors.astro";
import DemoTeaser from "~/components/sections/main/DemoTeaser.astro";
import ProjectCard from "~/components/sections/catalog/ProjectCard.astro";
import CopyEmail from "~/components/CopyEmail.astro";
import ZonesBlock from "~/components/sections/main/ZonesBlock.astro";
import QuoteCta from "~/components/sections/main/QuoteCta.astro";
import FounderStrip from "~/components/sections/main/FounderStrip.astro";
import Chips from "~/components/Chips.astro";
import { serviceIcon, industryIcon } from "~/components/sections/catalog/catalog";
import { html, heading, emphasize } from "~/lib/text";
import { getMessages, localeStaticPaths, type Locale } from "~/i18n";
import { ORG_ID, graph, organization, webPage, website } from "~/lib/jsonld";
import { STATS } from "~/data/stats";
import { SERVICE_SLUGS } from "~/data/services";
import { INDUSTRY_SLUGS } from "~/data/industries";
import { PROJECTS, featuredProjects, getProject } from "~/data/projects";
import { href, FOREIGN_PATH, OEM_PATH, whatsappLink, mailtoLink, prefersEmail, investorFirst as investorFirstFor, fmt } from "~/components/nav";
import { HOME_HERO_PRELOAD, HOME_HERO_VIDEO } from "~/components/hero-media";
import whyMachine from "~/assets/projects/shampoo-filling-delta-wecon/machine.jpg";
import caseHmi from "~/assets/projects/anaerobic-waste-treatment-commissioning/hmi.jpg";
import casePanel from "~/assets/projects/anaerobic-waste-treatment-commissioning/panel.jpg";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const t = getMessages(locale);
const h = t.home;
const c = t.common;
const email = prefersEmail(locale);
/** zh/tr visitors are mostly investors: lead with the "setting up in Egypt" door. */
const investorFirst = investorFirstFor(locale);
/* Hero second action: the foreign-manufacturers page on zh/tr, WhatsApp elsewhere (zh without it: email, Hero default). */
const heroSecondary = investorFirst
  ? { label: h.audiences.foreign.cta, href: href(locale, FOREIGN_PATH), kind: "link" as const }
  : email
    ? undefined
    : { label: h.hero.ctaSecondary, href: whatsappLink(c.whatsapp.default) };

const EMPHASIS: Record<Locale, string> = {
  en: "machine automation",
  ar: "أتمتة ماكينات",
  zh: "设备自动化",
  tr: "makine otomasyonu",
};
const heroTitle = emphasize(html(locale, h.hero.title), EMPHASIS[locale]);
const projects = featuredProjects();
const projectCount = PROJECTS.length;

/* Hero proof: lead with delivered projects and the published case studies (count from the data), then years and
   industries. */
const stat = (key: (typeof STATS)[number]["key"]) => ({ value: STATS.find((s) => s.key === key)?.value ?? "", label: c.stats[key].label });
const heroProof = [stat("projects"), { value: String(projectCount), label: c.stats.caseStudies.label }, stat("experience"), stat("industries")];

/* Commissioning case framed for foreign manufacturers (imported line, Siemens S7-200 SMART + MCGS HMI). */
const caseSlug = "anaerobic-waste-treatment-commissioning";
const caseData = getProject(caseSlug);
const caseItem = t.projects.items[caseSlug as keyof typeof t.projects.items] as
  | { cardTitle: string; client: string; highlights: string[]; imageAlts: Record<string, string> }
  | undefined;
const caseService = t.services.items["testing-commissioning"]?.navTitle;

const whyIcons: IconName[] = ["users", "layers", "hmi", "shield"];
const oemTitle = t.foreign.oem.title;
/* FAQ on phones and tablets: the first four, the rest one tap away (UX: the page was ~19 screens tall). */
const FAQ_MOBILE = 4;
/* How we work on phones and tablets: the first three steps, the rest one tap away. */
const STEPS_MOBILE = 3;
const processIcons: IconName[] = ["map-pin", "file", "panel", "check", "gauge", "users"];

/* Desktop only: there the poster is the visible media panel (LCP). Below 1024px it is a band after the CTAs in its
   small variants (Hero.astro / hero-media.ts), and a preload would only compete with the CSS and fonts the H1 needs. */
const poster = HOME_HERO_PRELOAD;

/* ---------- structured data (src/lib/jsonld.ts): the one company node (ProfessionalService) + WebSite + this page ---------- */
const jsonLd = graph(
  organization(locale),
  website(),
  webPage(locale, { path: "", name: h.seo.title, description: h.seo.description, about: { "@id": ORG_ID } }),
);
---

<BaseLayout
  locale={locale}
  title={h.seo.title}
  description={h.seo.description}
  path=""
  heroDark
  preloadImage={poster}
  jsonLd={jsonLd}
  whatsappMessage={c.whatsapp.default}
>
  <Hero
    locale={locale}
    title={heroTitle}
    lead={html(locale, h.hero.lead)}
    chips={[h.hero.eyebrow]}
    chipsShort={[h.hero.eyebrowShort]}
    titleSize="fit"
    priority
    video={HOME_HERO_VIDEO}
    primary={{ label: h.hero.ctaPrimary, href: href(locale, "contact/#quote") }}
    secondary={heroSecondary}
    proof={heroProof}
  >
    {
      /* Machine builders exporting to Egypt don't see themselves as "setting up a factory": one quiet line to their block. */
      investorFirst && oemTitle && (
        <a
          href={href(locale, OEM_PATH)}
          class="lc-rise group mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-signal-300 underline-offset-4 transition-colors hover:text-white hover:underline"
          style="--i:2"
          data-fab-avoid
        >
          <span set:html={html(locale, oemTitle)} />
          <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" />
        </a>
      )
    }
  </Hero>

  {/* ---------- platforms + two doors ---------- */}
  <Section compact class="pt-12 sm:pt-14">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <p class="flex items-center gap-3 type-label text-royal-700">
          <span class="slant-bar text-royal-600" aria-hidden="true"></span>
          {c.platforms.title}
        </p>
        <p class="mt-3 text-charcoal-600">{c.platforms.intro}</p>
        <Button href={href(locale, "technologies")} variant="ghost" class="mt-2 -ms-1">{c.platforms.cta}</Button>
      </div>
      {/* In the 8/12 column the cells are narrower than the marks' fixed height allows between 1024 and 1279px: scale them
          down there so no logo runs into the dividers (VIS2-09; the per-cell cap itself belongs in LogoWall). */}
      <LogoWall locale={locale} title="" class="lg:col-span-8 lg:[--logo-scale:0.66] min-[72rem]:[--logo-scale:0.8] xl:[--logo-scale:0.94] min-[90rem]:[--logo-scale:1] [&_li]:text-charcoal-600" />
    </div>
  </Section>

  <Section class="pt-6 sm:pt-8">
    <h2 id="who-title" class="mb-6 flex items-center gap-3 type-label text-charcoal-600">
      <span class="slant-bar text-royal-600" aria-hidden="true"></span>
      {h.audiences.title}
    </h2>
    <AudienceDoors locale={locale} foreignFirst={investorFirst} />
  </Section>

  {/* ---------- recent work (featured case studies; a swipeable row with a position cue below 1024px) ---------- */}
  <Section variant="muted" id="projects" aria-labelledby="projects-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading id="projects-title" index="01" eyebrow={c.labels.featuredProjects} title={html(locale, h.projects.title)} lead={html(locale, h.projects.intro)} />
      <ViewAll href={href(locale, "projects")} label={h.projects.cta} count={projectCount} />
    </div>
    <ul
      role="list"
      class="lc-snap -mx-(--spacing-gutter) mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-(--spacing-gutter) pt-2 pb-4 scroll-px-(--spacing-gutter) md:mt-10 md:gap-6 lg:mx-0 lg:mt-12 lg:grid lg:grid-cols-3 lg:gap-x-6 lg:gap-y-12 lg:overflow-visible lg:p-0"
      data-snap
    >
      {
        projects.map((p) => (
          <li class="flex w-[84%] max-w-sm shrink-0 snap-start md:w-[46%] md:max-w-none lg:w-auto [&>*]:w-full">
            <ProjectCard
              project={p}
              locale={locale}
              maxTags={2}
              sizes="(min-width: 2560px) 475px, (min-width: 1920px) 450px, (min-width: 1280px) 400px, (min-width: 1024px) calc((100vw - 7rem) / 3), (min-width: 768px) 46vw, (min-resolution: 2.5dppx) min(50.4vw, 14.4rem), min(84vw, 24rem)"
            />
          </li>
        ))
      }
    </ul>
    <div class="lc-snap-dots mt-1 flex items-center justify-center gap-2 lg:hidden" aria-hidden="true" data-snap-dots>
      {projects.map((_, i) => <span class:list={["h-1.5 w-6 bg-charcoal-300 transition-colors", i === 0 && "bg-royal-600"]} />)}
      <span class="ms-2 font-mono text-xs text-charcoal-600 ltr" dir="ltr" data-snap-count>1 / {projects.length}</span>
    </div>
    <p class="mt-6 flex items-start gap-2.5 text-sm text-charcoal-600 md:mt-10">
      <Icon name="shield" size={18} class="mt-0.5 shrink-0 text-royal-600" />
      {c.notes.anonymised}
    </p>
  </Section>

  {/* ---------- services (compact rows on phones and tablets, illustrated cards from 1024px) ---------- */}
  <Section id="services" aria-labelledby="services-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading id="services-title" index="02" eyebrow={c.labels.services} title={html(locale, h.services.title)} lead={html(locale, h.services.intro)} />
      <ViewAll href={href(locale, "services")} label={h.services.cta} count={SERVICE_SLUGS.length} class="max-lg:hidden" />
    </div>
    <ul role="list" class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:hidden">
      {
        SERVICE_SLUGS.map((slug) => {
          const s = t.services.items[slug];
          return (
            <li class="lc-reveal group relative flex items-center gap-4 border border-charcoal-200 bg-white p-4 transition-[border-color,box-shadow] duration-(--dur-ui) ease-mech hover:border-royal-300 hover:shadow-lift has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-(--focus)">
              <span class="chamfer inline-grid size-11 shrink-0 place-items-center bg-navy-950 text-royal-300 [--chamfer:9px]" aria-hidden="true">
                <Icon name={serviceIcon(slug)} size={22} />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="type-h4 text-navy-950">
                  <a href={href(locale, `services/${slug}`)} class="lc-stretch after:absolute after:inset-0 after:content-['']" set:html={heading(locale, s.navTitle)} />
                </h3>
                <p class="mt-0.5 line-clamp-2 text-sm text-charcoal-600" set:html={html(locale, s.summary)} />
              </div>
              <Icon name="chevron-right" size={18} class="shrink-0 text-royal-600" />
            </li>
          );
        })
      }
    </ul>
    <ul role="list" class="lc-grid-services mt-12 hidden lg:grid">
      {
        SERVICE_SLUGS.map((slug) => {
          const s = t.services.items[slug];
          return (
            <li>
              <Card variant="service" title={s.title} text={s.summary} href={href(locale, `services/${slug}`)} cta={c.labels.learnMore}>
                <Fragment slot="media">
                  <ServiceArt slug={slug} />
                </Fragment>
              </Card>
            </li>
          );
        })
      }
    </ul>
    <ViewAll href={href(locale, "services")} label={h.services.cta} count={SERVICE_SLUGS.length} class="mt-6 lg:hidden" />
  </Section>

  {/* ---------- industries (compact tiles on phones and tablets, illustrated cards from 1024px) ---------- */}
  <Section variant="muted" id="industries" aria-labelledby="industries-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading id="industries-title" index="03" eyebrow={c.labels.industries} title={html(locale, h.industries.title)} lead={html(locale, h.industries.intro)} />
      <ViewAll href={href(locale, "industries")} label={h.industries.cta} count={INDUSTRY_SLUGS.length} class="max-lg:hidden" />
    </div>
    {/* 4 per row only from 720px: at 640–719 "Pharmaceutical" was wider than a quarter tile (VIS3-03) */}
    <ul role="list" class="mt-8 grid grid-cols-2 gap-3 min-[45rem]:grid-cols-4 lg:hidden">
      {
        INDUSTRY_SLUGS.map((slug) => (
          <li class="lc-reveal on-dark group relative flex flex-col justify-between gap-4 bg-navy-950 p-4 text-white has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-(--focus)">
            <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-signal-400 transition-[scale] duration-(--dur-ui) ease-mech group-hover:scale-x-100 rtl:origin-right" />
            <span class="chamfer inline-grid size-10 place-items-center bg-royal-600/25 text-signal-300 [--chamfer:8px]" aria-hidden="true">
              <Icon name={industryIcon(slug)} size={20} />
            </span>
            <h3 class="lc-tile-title text-[0.9375rem] leading-snug font-bold text-white">
              <a href={href(locale, `industries/${slug}`)} class="lc-stretch after:absolute after:inset-0 after:content-['']">
                {t.industries.items[slug].navTitle}
              </a>
            </h3>
          </li>
        ))
      }
      <li class="group relative flex flex-col justify-between gap-4 border border-dashed border-royal-600/40 bg-royal-50/50 p-4 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-(--focus)">
        <span class="chamfer inline-grid size-10 place-items-center bg-royal-600 text-white [--chamfer:8px]" aria-hidden="true">
          <Icon name="plus" size={20} />
        </span>
        <h3 class="lc-tile-title text-[0.9375rem] leading-snug font-bold text-navy-950">
          <a href={`${href(locale, "contact")}?industry=other#quote`} class="lc-stretch after:absolute after:inset-0 after:content-['']">
            {t.contact.form.fields.industry.options.other}
          </a>
        </h3>
      </li>
    </ul>
    <ul role="list" class="lc-grid-industries mt-12 hidden lg:grid">
      {
        INDUSTRY_SLUGS.map((slug) => {
          const ind = t.industries.items[slug];
          return (
            <li>
              <Card variant="industry" title={ind.title} text={ind.summary} href={href(locale, `industries/${slug}`)} cta={c.labels.viewIndustry}>
                <Fragment slot="media">
                  <div class="relative flex justify-center pt-5">
                    <IndustryArt slug={slug} variant="dark" size="86%" />
                  </div>
                </Fragment>
              </Card>
            </li>
          );
        })
      }
      <li>
        <article class="group relative flex h-full flex-col justify-between border border-dashed border-royal-600/40 bg-royal-50/50 p-6 transition-colors hover:border-royal-600 sm:p-7 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-(--focus)">
          <span class="chamfer inline-grid size-12 place-items-center bg-royal-600 text-white [--chamfer:10px]">
            <Icon name="plus" size={24} />
          </span>
          <div class="mt-10">
            <h3 class="type-h3 text-navy-950">
              <a href={`${href(locale, "contact")}?industry=other#quote`} class="lc-stretch after:absolute after:inset-0 after:content-['']">
                {t.contact.form.fields.industry.options.other}
              </a>
            </h3>
            <p class="mt-2 text-sm text-charcoal-600">{c.ctaBand.industry.text}</p>
            <span aria-hidden="true" class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-royal-600">
              {t.ui.cta.quote}
              <Icon name="arrow" size={16} class="transition-transform duration-(--dur-ui) ease-mech group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
            </span>
          </div>
        </article>
      </li>
    </ul>
    <ViewAll href={href(locale, "industries")} label={h.industries.cta} count={INDUSTRY_SLUGS.length} class="mt-6 lg:hidden" />
  </Section>

  {/* ---------- live HMI demo (one-screen teaser on phones and tablets, expands in place; the heading and lead stay
       readable by assistive technology, only the demo panel is inert while collapsed) ---------- */}
  <Section variant="dark" angle="both" id="hmi-demo">
    <DemoTeaser locale={locale} interactive=".lc-hmi" class="[--teaser-h:42rem] md:[--teaser-h:38rem]">
      <HmiDemo locale={locale} tone="dark" />
    </DemoTeaser>
  </Section>

  {/* ---------- why us + founder ---------- */}
  <Section id="why">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHeading id="why-title" index="04" eyebrow={t.about.why.title} title={html(locale, h.why.title)} />
        {/* The machine we automated, not its legacy screen: a busy, saturated HMI capture shown as proof contradicted the
            ISA-101 screens the site sells (VIS2-06). The capture stays in that case study's gallery. */}
        <figure class="mt-10 max-lg:hidden">
          <div class="chamfer-lg relative aspect-[16/9] overflow-hidden bg-navy-950 shadow-lift">
            <Picture
              src={whyMachine}
              alt={(t.projects.items["shampoo-filling-delta-wecon"]?.imageAlts as Record<string, string> | undefined)?.machine ?? ""}
              formats={["avif", "webp"]}
              widths={[480, 720, 960]}
              width={960}
              height={540}
              fit="cover"
              sizes="(min-width: 1024px) 40vw, 100vw"
              layout="full-width"
              class="size-full object-cover"
            />
          </div>
          <figcaption class="mt-3 flex items-center gap-2 text-sm text-charcoal-600">
            <Icon name="hmi" size={18} class="text-royal-600" />
            <span set:html={html(locale, t.projects.items["shampoo-filling-delta-wecon"].cardTitle)} />
          </figcaption>
        </figure>
      </div>
      <ol role="list" class="grid grid-cols-1 content-start gap-px self-center overflow-hidden border border-charcoal-200 bg-charcoal-200 sm:grid-cols-2 lg:col-span-7">
        {
          h.why.items.map((item, i) => (
            <li class="relative grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 bg-white p-5 sm:block sm:p-8">
              <div class="flex items-center justify-between">
                <span class="chamfer inline-grid size-10 place-items-center bg-navy-950 text-royal-300 [--chamfer:9px] sm:size-11">
                  <Icon name={whyIcons[i] ?? "check"} size={22} />
                </span>
                <span aria-hidden="true" class="font-mono text-xs text-charcoal-600 ltr max-sm:hidden" dir="ltr">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="type-h4 text-navy-950 sm:mt-5" set:html={heading(locale, item.title)} />
              <p class="col-span-2 mt-2 text-[0.9375rem] text-charcoal-600" set:html={html(locale, item.text)} />
            </li>
          ))
        }
      </ol>
    </div>
    <FounderStrip locale={locale} class="mt-10 lg:mt-14" />
  </Section>

  {/* ---------- how we work ---------- */}
  <Section variant="muted" id="process">
    <SectionHeading id="process-title" index="05" eyebrow={t.services.index.processEyebrow} title={html(locale, c.process.title)} lead={html(locale, c.process.intro)} />
    <div data-cap data-capped class="lc-cap-steps">
      <ProcessSteps class="mt-10 max-lg:gap-7 md:mt-14" locale={locale} steps={c.process.steps.map((s, i) => ({ ...s, icon: processIcons[i] }))} />
      {
        c.process.steps.length > STEPS_MOBILE && (
          <button type="button" class="lc-cap-more lc-btn mt-8 lg:hidden" data-variant="secondary" aria-expanded="false">
            <span class="lc-btn-label">{fmt(t.ui.process.more, { count: c.process.steps.length })}</span>
            <Icon name="chevron-down" size={18} />
          </button>
        )
      }
    </div>
  </Section>

  {/* ---------- for foreign manufacturers: a commissioning case (the top-bar link and the second door carry the
       general pitch; this band shows the work) ---------- */}
  <Section variant="dark" angle="both" aria-labelledby="foreign-title">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-6">
        <p class="mb-4 flex items-center gap-3 type-label text-signal-300">
          <span class="lc-led" aria-hidden="true"></span>
          {caseService ?? t.ui.nav.foreign}
        </p>
        <h2 id="foreign-title" class="type-h2 text-white" set:html={heading(locale, h.foreignBand.title)} />
        <p class="mt-5 max-w-2xl type-lead text-navy-200" set:html={html(locale, h.foreignBand.text)} />
        {
          caseItem && caseData && (
            <article class="lc-reveal group relative mt-8 border border-white/10 bg-white/[0.04] has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-(--focus)">
              <div class="flex items-center gap-3 border-b border-white/10 px-5 py-3">
                <span class="lc-led" style="--led:#2bd47d" aria-hidden="true"></span>
                <p class="type-label text-navy-200">
                  {caseItem.client}{"\u00a0· "}<span class="ltr" dir="ltr">{caseData.year}</span>
                </p>
              </div>
              <div class="px-5 pt-4 pb-5">
                <h3 class="type-h4 text-white">
                  <a
                    href={href(locale, `projects/${caseSlug}`)}
                    class="lc-stretch after:absolute after:inset-0 after:z-10 after:content-['']"
                    set:html={heading(locale, caseItem.cardTitle)}
                  />
                </h3>
                <ul role="list" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3 sm:gap-4">
                  {caseItem.highlights.map((hl) => (
                    <li class="flex items-start gap-2 text-sm text-navy-100">
                      <Icon name="check" size={16} class="mt-0.5 shrink-0 text-signal-400" strokeWidth={2.25} />
                      <span set:html={html(locale, hl)} />
                    </li>
                  ))}
                </ul>
                <span aria-hidden="true" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-royal-300 transition-colors group-hover:text-white">
                  {c.labels.readCaseStudy}
                  <Icon name="arrow" size={16} class="transition-[translate] duration-(--dur-ui) ease-mech group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
                </span>
              </div>
            </article>
          )
        }
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href={href(locale, FOREIGN_PATH)} size="lg" iconEnd="arrow" class="max-sm:w-full">{h.foreignBand.cta}</Button>
          {
            /* zh / tr: machine builders exporting to Egypt are a core audience — straight to their block. */
            investorFirst && oemTitle && (
              <a href={href(locale, OEM_PATH)} class="group inline-flex min-h-11 items-center gap-2 font-semibold text-signal-300 transition-colors hover:text-white">
                {oemTitle}
                <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" />
              </a>
            )
          }
        </div>
      </div>
      {
        caseItem && (
          <div class="relative max-lg:order-first lg:col-span-6" aria-hidden="true">
            <div class="chamfer-lg relative aspect-[16/9] overflow-hidden bg-navy-900 ring-1 ring-white/10 lg:aspect-[4/3]">
              <Picture src={caseHmi} alt="" formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 1024px) 45vw, 100vw" layout="full-width" class="size-full object-cover" />
              <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(4_14_39/0.55),transparent_45%)]" />
            </div>
            <div class="absolute -bottom-6 end-4 w-[34%] border-4 border-navy-950 bg-navy-950 shadow-lift sm:end-6 lg:-bottom-10 lg:w-[40%]">
              <Picture src={casePanel} alt="" formats={["avif", "webp"]} widths={[240, 360, 480]} width={480} height={480} fit="cover" sizes="(min-width: 1024px) 18vw, 34vw" layout="full-width" class="aspect-square size-full object-cover" />
            </div>
            {caseData && <Chips items={[caseData.technologies[0], caseData.technologies[2]].filter((x): x is string => !!x)} size="sm" class="absolute start-4 bottom-4 max-w-[58%] sm:start-6 sm:bottom-6 [&_li]:bg-navy-950/85 [&_li]:backdrop-blur-sm" />}
          </div>
        )
      }
    </div>
  </Section>

  {/* ---------- zones ---------- */}
  <Section id="zones" aria-labelledby="zones-title">
    <SectionHeading id="zones-title" index="06" eyebrow={c.labels.location} title={html(locale, c.zones.title)} lead={html(locale, c.zones.intro)} />
    <ZonesBlock locale={locale} compact class="mt-8 md:mt-12" />
  </Section>

  {/* ---------- FAQ ---------- */}
  <Section variant="muted" id="faq" aria-labelledby="faq-title">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <SectionHeading id="faq-title" index="07" eyebrow={c.labels.faq} title={html(locale, h.faq.title)} />
          <div class="mt-6 flex flex-col items-start gap-3 lg:mt-8">
            {
              email ? (
                <div class="flex flex-wrap items-center gap-3">
                  <Button href={mailtoLink(undefined, { locale, path: "" })} variant="secondary" icon="mail" iconClass="text-royal-600">{t.ui.cta.emailEngineer}</Button>
                  <CopyEmail locale={locale} tone="light" />
                </div>
              ) : (
                <Button href={whatsappLink(c.whatsapp.default)} variant="secondary" icon="whatsapp" iconClass="text-whatsapp-700" external>{t.ui.cta.whatsapp}</Button>
              )
            }
          </div>
        </div>
      </div>
      <div class="lc-cap-faq lg:col-span-8" data-cap data-capped>
        <FAQ items={h.faq.items.map((f) => ({ q: f.q, a: html(locale, f.a) }))} openFirst />
        {
          h.faq.items.length > FAQ_MOBILE && (
            <button type="button" class="lc-cap-more lc-btn mt-6 lg:hidden" data-variant="secondary" aria-expanded="false">
              <span class="lc-btn-label">{fmt(t.ui.faq.more, { count: h.faq.items.length })}</span>
              <Icon name="chevron-down" size={18} />
            </button>
          )
        }
      </div>
    </div>
  </Section>

  <QuoteCta locale={locale} title={c.ctaBand.default.title} text={c.ctaBand.default.text} />
</BaseLayout>

<style>
  /* Phones and tablets: the case studies are a swipeable row. Its own scroll box would freeze the scroll-driven card
     reveal (motion.css §4), so cards in the row simply sit in place. */
  @media (max-width: 63.99rem) {
    .lc-snap :global(.lc-reveal) {
      animation: none;
    }
    .lc-snap {
      scrollbar-width: thin;
      scrollbar-color: var(--color-charcoal-300) transparent;
    }
  }
  /* The playable panel shows interlocks, alarms and trends by itself; on phones and tablets (where it starts as a
     one-screen teaser) the three explanatory points above it are left out (they stay on desktops). */
  @media (max-width: 63.99rem) {
    #hmi-demo :global(.lc-hmi-seeing) {
      display: none;
    }
    /* Phones and tablets — FAQ: first four questions; How we work: first three steps — the rest behind "Show all…"
       (with JS; all of them without). */
    :global(html.js) .lc-cap-faq[data-capped] :global(details:nth-of-type(n + 5)),
    :global(html.js) .lc-cap-steps[data-capped] :global(.lc-steps > li:nth-child(n + 4)) {
      display: none;
    }
    /* the last visible step's rail would point at nothing */
    :global(html.js) .lc-cap-steps[data-capped] :global(.lc-steps > li:nth-child(3) .lc-step-rail) {
      display: none;
    }
  }
  :global(html:not(.js)) .lc-cap-more,
  [data-cap]:not([data-capped]) .lc-cap-more {
    display: none;
  }
</style>

<script>
  import { scrollBehavior } from "~/scripts/motion/motion-pref";

  /* Swipeable case-study row: keep the focused card fully in view (Chromium does not scroll a partly visible
     element inside a scroller), and show which card is in view (dots + "2 / 3", decorative). Instant while motion is
     paused or reduced (scrollBehavior). */
  document.querySelectorAll<HTMLElement>("[data-snap]").forEach((row) => {
    const items = [...row.children] as HTMLElement[];
    row.addEventListener("focusin", (e) => {
      const li = (e.target as HTMLElement).closest("li");
      if (li && row.scrollWidth > row.clientWidth) li.scrollIntoView({ block: "nearest", inline: "start", behavior: scrollBehavior() });
    });
    const dots = row.parentElement?.querySelector<HTMLElement>("[data-snap-dots]");
    const marks = dots ? ([...dots.children].filter((el) => !el.hasAttribute("data-snap-count")) as HTMLElement[]) : [];
    const count = dots?.querySelector<HTMLElement>("[data-snap-count]");
    if (!dots || !("IntersectionObserver" in window)) return;
    const seen = new Map<Element, number>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => seen.set(en.target, en.intersectionRatio));
        let best = 0;
        items.forEach((el, i) => {
          if ((seen.get(el) ?? 0) > (seen.get(items[best]!) ?? 0)) best = i;
        });
        marks.forEach((m, i) => {
          m.classList.toggle("bg-royal-600", i === best);
          m.classList.toggle("bg-charcoal-300", i !== best);
        });
        if (count) count.textContent = `${best + 1} / ${items.length}`;
      },
      { root: row, threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    items.forEach((el) => io.observe(el));
  });

  /* Phones: "Show all questions / steps" reveals the rest in place and moves focus to the first item revealed. */
  document.querySelectorAll<HTMLElement>("[data-cap]").forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>(".lc-cap-more");
    btn?.addEventListener("click", () => {
      const hidden = [...box.querySelectorAll<HTMLElement>("details, .lc-steps > li")].filter((el) => el.offsetParent === null);
      box.removeAttribute("data-capped");
      btn.setAttribute("aria-expanded", "true");
      const first = hidden[0];
      const summary = first?.querySelector<HTMLElement>(":scope > summary");
      if (summary) summary.focus();
      else if (first) {
        first.tabIndex = -1;
        first.focus();
      }
    });
  });
</script>
