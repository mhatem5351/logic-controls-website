---
/**
 * Request sent (noindex, excluded from the sitemap). Confirmation, what happens next, urgent help and
 * "send drawings" (WhatsApp; email first on zh), links back. No third-party conversion pixels.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Section from "~/components/Section.astro";
import Button from "~/components/Button.astro";
import Icon from "~/components/Icon.astro";
import NextSteps from "~/components/sections/main/NextSteps.astro";
import { html } from "~/components/sections/main/rich";
import { getMessages, localeStaticPaths, type Locale } from "~/i18n";
import { SITE } from "~/data/site";
import { href, whatsappLink, mailtoLink, prefersEmail } from "~/components/nav";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const t = getMessages(locale);
const th = t.contact.thanks;
const email = prefersEmail(locale);
---

<BaseLayout locale={locale} title={th.seo.title} description={th.seo.description} path="contact/thanks" noindex heroDark>
  <Hero locale={locale} size="page" title={html(locale, th.h1)} lead={html(locale, th.text)} primary={false} secondary={false}>
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: t.common.breadcrumbs.contact, path: "contact" }, { label: t.common.breadcrumbs.thanks }]} />
    <div class="lc-rise mt-8 flex flex-wrap gap-3" style="--i:2">
      <Button href={href(locale)} variant="on-dark" icon="arrow" iconClass="-scale-x-100 rtl:scale-x-100">{th.backHome}</Button>
      <Button href={href(locale, "projects")} variant="ghost">{th.seeProjects}</Button>
    </div>
  </Hero>

  <Section class="lc-thanks">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-full bg-success-700 text-white"><Icon name="check" size={22} /></span>
          <span class="type-label text-success-700">{t.common.breadcrumbs.thanks}</span>
        </div>
        <NextSteps locale={locale} headingLevel="h2" class="mt-8 [&>h2]:type-h3" />
      </div>

      <div class="grid content-start gap-5 sm:grid-cols-2 lg:col-span-7">
        {/* urgent: a machine is stopped */}
        <div class="on-dark chamfer-lg relative isolate flex flex-col overflow-hidden bg-navy-950 p-6 text-navy-100 sm:p-7">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint mask-fade-edges" />
          <p class="flex items-center gap-2.5 type-label text-signal-300"><span class="lc-led" data-blink aria-hidden="true" />{th.urgent.title}</p>
          <p class="mt-3 text-navy-100">{th.urgent.text}</p>
          <div class="mt-auto grid gap-2.5 pt-6">
            {
              email ? (
                <Button href={mailtoLink(t.ui.email.subject)} variant="on-dark" icon="mail" iconClass="text-royal-300" block>{t.ui.cta.emailEngineer}</Button>
              ) : (
                <Button href={whatsappLink(t.common.whatsapp.default)} variant="on-dark" icon="whatsapp" iconClass="text-[#25d366]" external block>{th.urgent.cta}</Button>
              )
            }
            <a href={`tel:${SITE.phone.tel}`} class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-navy-100 hover:text-white">
              <Icon name="phone" size={16} class="text-royal-300" />
              <span class="sr-only">{t.common.labels.phone}: </span><span class="ltr" dir="ltr">{SITE.phone.display}</span>
            </a>
          </div>
        </div>

        {/* send photos / drawings */}
        <div class="flex flex-col border border-charcoal-200 bg-white p-6 sm:p-7">
          <p class="flex items-center gap-2.5 type-label text-royal-700"><Icon name="file" size={16} />{th.more.title}</p>
          <p class="mt-3 text-charcoal-700">{th.more.text}</p>
          <div class="mt-auto grid gap-2.5 pt-6">
            {
              email ? (
                <>
                  <Button href={mailtoLink(t.ui.email.subject)} icon="mail" block>
                    <span class="ltr" dir="ltr">{SITE.email}</span>
                  </Button>
                  <a href={whatsappLink(t.common.whatsapp.drawings)} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-royal-600 hover:text-royal-800 hover:underline">
                    <Icon name="whatsapp" size={16} class="text-[#128c4a]" />{t.ui.cta.inEgyptWhatsapp}<span class="sr-only"> ({t.ui.a11y.newTab})</span>
                  </a>
                </>
              ) : (
                <>
                  <Button href={whatsappLink(t.common.whatsapp.drawings)} icon="whatsapp" external block>{th.more.cta}</Button>
                  <a href={mailtoLink(t.ui.email.subject)} class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-royal-600 hover:text-royal-800 hover:underline">
                    <Icon name="mail" size={16} /><span class="ltr" dir="ltr">{SITE.email}</span>
                  </a>
                </>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
