---
/**
 * Request sent (noindex, excluded from the sitemap). Confirmation, the request number (?ref= from the Worker) with a
 * copy button, what was received (file names; files the Worker could not attach), what happens next, urgent help and
 * "send drawings" (WhatsApp; email first on zh), links back. With a request number the WhatsApp/email links carry it,
 * so files sent later land with the request. No third-party conversion pixels.
 * Those links are templates built here with the site's link builders (whatsappLink / mailtoLink): data-ref-href (slot
 * {ref}) and, on the "send drawings" links, data-handoff-href (slot {handoff}: who sent which request); the script
 * only fills the slots (fillHref, src/lib/rfq-rules.ts). Their plain href works without it.
 *
 * Urgent requests (a machine is stopped, or troubleshooting sent without a timeline): "call an engineer now" replaces
 * the hero's "back home / projects" buttons, so the next useful action is on the first screen (UX2-06). Its WhatsApp
 * message (email on zh: subject "Urgent…") starts with the request number and ends with the "Machine and brand:"
 * prompt the visitor completes (I18N3-07).
 * File names in the "received / not attached / not sent" lines are each isolated (FSI…PDI): in Arabic text a list of
 * Arabic and Latin names would otherwise tear extensions from their names (I18N3-02).
 * The two cards' WhatsApp buttons switch to a short label when their card is narrow (VIS3-06, container query).
 * The success check badge sits above the H1: the form's success badge morphs into it (MOT2-16, a short flight).
 * The form hands over a short summary in sessionStorage (RFQ_SESSION.sent, src/scripts/rfq-form.ts); this page reads it
 * once and deletes it (CODE2-11). Without it (no JS, reload) the page still works from ?ref= (and ?skipped=n). Without
 * ?ref= it falls back to the last request number this tab sent (RFQ_SESSION.last: number and urgency only), so the
 * number does not vanish (CODE2-21; the language switcher keeps ?ref= too).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Section from "~/components/Section.astro";
import Button from "~/components/Button.astro";
import Icon from "~/components/Icon.astro";
import NextSteps from "~/components/sections/main/NextSteps.astro";
import { punct, html, colon, ltr } from "~/lib/text";
import { getMessages, localeStaticPaths, type Locale } from "~/i18n";
import { SITE, telLink } from "~/data/site";
import { href, whatsappLink, mailtoLink, prefersEmail } from "~/components/nav";
import { hrefSlot } from "~/lib/rfq-rules";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const t = getMessages(locale);
const th = t.contact.thanks;
const email = prefersEmail(locale);
const P = punct(locale);
/** Link templates (slots {ref} / {handoff}, filled by the script below). */
const tpl = {
  /** "About request {ref}: my machine is stopped…  Machine and brand:" (WhatsApp; email on zh). */
  stopped: whatsappLink(th.urgentNow.whatsapp),
  stoppedMail: `${mailtoLink(th.urgentNow.emailSubject)}&body=${encodeURIComponent(th.urgentNow.whatsapp.replace(/\r?\n/g, "\r\n"))}`,
  /** More files for request {ref}. */
  moreWa: whatsappLink(th.ref.whatsapp),
  moreMail: mailtoLink(th.ref.emailSubject),
  /** The full hand-off ("I am {name} from {company}, I just sent request {ref} ({need})…"). */
  handoffWa: whatsappLink("{handoff}"),
  handoffMail: `${mailtoLink(th.ref.emailSubject)}&body=${hrefSlot("handoff")}`,
};
/** Short WhatsApp labels for narrow cards (VIS3-06): the round-2 narrow CTA label and "Send on WhatsApp". Rendered
 *  with the long label; a container query shows one, so the accessible name is always the visible text. */
const narrow = {
  urgent: t.ui.cta.whatsappNarrow !== th.urgent.cta ? t.ui.cta.whatsappNarrow : undefined,
  more: th.more.ctaShort !== th.more.cta ? th.more.ctaShort : undefined,
};
---

<BaseLayout locale={locale} title={th.seo.title} description={th.seo.description} path="contact/thanks" noindex heroDark>
  <Hero locale={locale} size="page" title={html(locale, th.h1)} lead={html(locale, th.text)} primary={false} secondary={false}>
    <Fragment slot="breadcrumbs">
      <Breadcrumbs locale={locale} items={[{ label: t.common.breadcrumbs.contact, path: "contact" }, { label: t.common.breadcrumbs.thanks }]} />
      {/* the form's success badge lands here (view transition "lc-success"), right above the headline */}
      <p class="mt-6 flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-full bg-success-700 text-white" data-vt-success><Icon name="check" size={22} /></span>
        <span class="type-label text-success-500">{t.common.breadcrumbs.thanks}</span>
      </p>
    </Fragment>
    {/* urgent requests: call now, first on the first screen (before the request number) */}
    <div class="lc-rise mt-6 max-w-xl border-s-4 border-signal-400 bg-white/[0.06] p-4 sm:p-5" style="--i:2" data-urgent-now hidden>
      <p class="flex items-center gap-2.5 font-bold text-white">
        <span class="lc-led" data-blink aria-hidden="true"></span>
        {th.urgentNow.title}
      </p>
      <p class="mt-1 text-sm text-navy-200" data-urgent-text data-tpl={th.urgentNow.text}></p>
      <div class="mt-3 flex flex-wrap gap-3">
        {/* a real space between the label and the number (its accessible name, and the gap: a margin on the LTR
            number would land on its far side in Arabic) */}
        <Button href={telLink()} icon="phone">
          {t.common.labels.callEngineer}{" "}<span class="ltr font-normal whitespace-nowrap" dir="ltr">{SITE.phone.display}</span>
        </Button>
        {
          email ? (
            <Button href={mailtoLink(t.ui.email.subject)} variant="on-dark" icon="mail" iconClass="text-royal-300" data-ref-href={tpl.stoppedMail}>
              {t.ui.cta.emailEngineer}
            </Button>
          ) : (
            <Button href={whatsappLink(t.common.whatsapp.stopped)} variant="on-dark" icon="whatsapp" iconClass="text-whatsapp-500" external data-ref-href={tpl.stopped}>
              {th.urgent.cta}
            </Button>
          )
        }
      </div>
    </div>
    <div class="lc-rise mt-7 w-fit max-w-full border border-white/15 bg-white/[0.04] px-4 py-3 text-sm" style="--i:2" data-ref-box data-handoff={th.handoff} data-sep={P.listSep} hidden>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="text-navy-200">{th.ref.label}{colon(locale)}</span>
        <strong class="ltr font-mono text-lg tracking-wide text-white" dir="ltr" data-ref></strong>
        {/* A11Y3-04: a fixed name; "Number copied" is shown, and said once by [data-ref-live] (not by a renamed button) */}
        <button
          type="button"
          class="lc-ref-copy inline-flex min-h-8 items-center gap-1.5 border border-white/20 px-2 text-xs font-semibold text-navy-100 hover:border-white/50 hover:text-white"
          aria-label={th.ref.copy}
          data-ref-copy
          data-copied={th.ref.copied}
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"></path>
          </svg>
          <span data-ref-copy-label aria-hidden="true">{th.ref.copy}</span>
        </button>
      </p>
      <p class="mt-1 text-navy-300">{th.ref.hint}</p>
      <p class="mt-2 text-navy-100" data-received data-tpl={th.received} hidden></p>
      <p class="mt-2 text-navy-100" data-reply-by data-tpl={th.replyBy} hidden></p>
      <p class="mt-2 border-s-2 border-signal-400 ps-3 text-signal-100" data-skipped data-tpl={th.skipped} data-some={th.skippedSome} hidden></p>
      <p class="mt-2 border-s-2 border-signal-400 ps-3 text-signal-100" data-dropped data-tpl={th.dropped} hidden></p>
      <p class="sr-only" aria-live="polite" data-ref-live></p>
    </div>
    <div class="lc-rise mt-8 flex flex-wrap gap-3" style="--i:2" data-default-actions>
      <Button href={href(locale)} variant="on-dark" icon="arrow" iconClass="-scale-x-100 rtl:scale-x-100">{th.backHome}</Button>
      <Button href={href(locale, "projects")} variant="ghost">{th.seeProjects}</Button>
    </div>
  </Hero>

  <Section class="lc-thanks">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <NextSteps locale={locale} headingLevel="h2" class="[&>h2]:type-h3" />
      </div>

      {/* side by side only where each card is wide enough for its buttons: stacked below 768 px and between 1024 and
          1280 px (VIS3-06) */}
      <div class="grid content-start gap-5 md:grid-cols-2 lg:col-span-7 lg:grid-cols-1 xl:grid-cols-2">
        {/* urgent: a machine is stopped */}
        <div class="on-dark chamfer-lg relative isolate flex flex-col overflow-hidden bg-navy-950 p-6 text-navy-100 sm:p-7">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint mask-fade-edges" />
          <p class="flex items-center gap-2.5 type-label text-signal-300"><span class="lc-led" data-blink aria-hidden="true" />{th.urgent.title}</p>
          <p class="mt-3 text-navy-100" set:html={html(locale, th.urgent.text)} />
          <div class="@container mt-auto grid gap-2.5 pt-6">
            {
              email ? (
                <Button href={mailtoLink(t.ui.email.subject)} variant="on-dark" icon="mail" iconClass="text-royal-300" block data-ref-href={tpl.stoppedMail}>{t.ui.cta.emailEngineer}</Button>
              ) : (
                <Button href={whatsappLink(t.common.whatsapp.stopped)} variant="on-dark" icon="whatsapp" iconClass="text-whatsapp-500" external block data-ref-href={tpl.stopped}>
                  {narrow.urgent ? (
                    <>
                      <span class="@max-[22rem]:hidden">{th.urgent.cta}</span>
                      <span class="@min-[22rem]:hidden">{narrow.urgent}</span>
                    </>
                  ) : (
                    th.urgent.cta
                  )}
                </Button>
              )
            }
            <a href={telLink()} class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-navy-100 hover:text-white">
              <Icon name="phone" size={16} class="text-royal-300" />
              <span class="sr-only">{t.common.labels.phone}{colon(locale)}</span><span class="ltr" dir="ltr">{SITE.phone.display}</span>
            </a>
          </div>
        </div>

        {/* send photos / drawings */}
        <div class="flex flex-col border border-charcoal-200 bg-white p-6 sm:p-7">
          <p class="flex items-center gap-2.5 type-label text-royal-700"><Icon name="file" size={16} /><span data-more-title data-title-more={th.more.titleMore}>{th.more.title}</span></p>
          <p class="mt-3 text-charcoal-700" set:html={html(locale, th.more.text)} />
          <div class="@container mt-auto grid gap-2.5 pt-6">
            {
              email ? (
                <>
                  <Button href={mailtoLink(t.ui.email.subject)} icon="mail" block data-ref-href={tpl.moreMail} data-handoff-href={tpl.handoffMail}>
                    <Fragment set:html={ltr(SITE.email)} />
                  </Button>
                  <a href={whatsappLink(t.common.whatsapp.drawings)} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-royal-600 hover:text-royal-800 hover:underline" data-ref-href={tpl.moreWa} data-handoff-href={tpl.handoffWa}>
                    <Icon name="whatsapp" size={16} class="text-whatsapp-700" />
                    <span set:html={html(locale, t.ui.cta.inEgyptWhatsapp)} />
                    <span class="sr-only"> ({t.ui.a11y.newTab})</span>
                  </a>
                </>
              ) : (
                <>
                  <Button href={whatsappLink(t.common.whatsapp.drawings)} icon="whatsapp" external block data-ref-href={tpl.moreWa} data-handoff-href={tpl.handoffWa}>
                    {narrow.more ? (
                      <>
                        <span class="@max-[22rem]:hidden">{th.more.cta}</span>
                        <span class="@min-[22rem]:hidden">{narrow.more}</span>
                      </>
                    ) : (
                      th.more.cta
                    )}
                  </Button>
                  <a href={mailtoLink(t.ui.email.subject)} data-ref-href={tpl.moreMail} data-handoff-href={tpl.handoffMail} class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-royal-600 hover:text-royal-800 hover:underline">
                    <Icon name="mail" size={16} /><Fragment set:html={ltr(SITE.email)} />
                  </a>
                </>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  // The Worker redirects (no-JS) or the form navigates (JS) here with ?ref=LC-XXXXX: show it and put it in the links.
  import { REF_RE, RFQ_SESSION, fillHref } from "~/lib/rfq-rules";
  import { fmt } from "~/lib/format";
  import type { RfqLast, RfqSent } from "~/scripts/rfq-form";

  const session = {
    read<T>(key: string): Partial<T> {
      try {
        const v: unknown = JSON.parse(sessionStorage.getItem(key) ?? "{}");
        return v && typeof v === "object" ? (v as Partial<T>) : {};
      } catch {
        return {};
      }
    },
    write(key: string, value: string | null) {
      try {
        if (value === null) sessionStorage.removeItem(key);
        else sessionStorage.setItem(key, value);
      } catch {}
    },
  };
  const params = new URLSearchParams(location.search);
  // ?ref= first; without it (or with a broken one) the last request this tab sent (CODE2-21)
  const last = session.read<RfqLast>(RFQ_SESSION.last);
  const query = params.get("ref") ?? "";
  const ref = REF_RE.test(query) ? query : typeof last.ref === "string" && REF_RE.test(last.ref) ? last.ref : "";
  const box = document.querySelector<HTMLElement>("[data-ref-box]");
  if (box && ref) {
    box.querySelector("[data-ref]")!.textContent = ref;
    box.hidden = false;
    // The form's summary of what was sent: read once, then deleted (it holds the visitor's name and company).
    let sent = session.read<RfqSent>(RFQ_SESSION.sent);
    session.write(RFQ_SESSION.sent, null);
    if (sent.ref !== ref) sent = {};
    const urgent = sent.urgent ?? (last.ref === ref ? last.urgent : "") ?? "";
    session.write(RFQ_SESSION.last, JSON.stringify({ ref, urgent } satisfies RfqLast));
    const sep = box.dataset.sep ?? ", ";
    /** File names, each isolated with its own direction (I18N3-02). */
    const names = (list: readonly string[]) => list.map((n) => String.fromCharCode(0x2068) + n + String.fromCharCode(0x2069)).join(sep);
    const vars: Record<string, string> = { ref, name: sent.name ?? "", company: sent.company ?? "", need: sent.need ?? "" };
    const fill = (s: string, more: Record<string, string> = {}) => fmt(s, { ...vars, ...more }, { missing: "empty" });
    const line = (sel: string, text: string) => {
      const el = box.querySelector<HTMLElement>(sel);
      if (!el || !text) return;
      el.textContent = text;
      el.hidden = false;
    };
    // UX2-20: what arrived, what did not (and the channel the visitor asked for)
    if (sent.files?.length) {
      line("[data-received]", fill(box.querySelector<HTMLElement>("[data-received]")!.dataset.tpl!, { files: names(sent.files) }));
      const title = document.querySelector<HTMLElement>("[data-more-title]");
      if (title?.dataset.titleMore) title.textContent = title.dataset.titleMore;
    }
    const skippedEl = box.querySelector<HTMLElement>("[data-skipped]")!;
    if (sent.skipped?.length) line("[data-skipped]", fill(skippedEl.dataset.tpl!, { files: names(sent.skipped) }));
    else if (Number(params.get("skipped")) > 0) line("[data-skipped]", skippedEl.dataset.some!);
    // DEV3-01: files the visitor left out after a timed-out upload ("Send without the files")
    if (sent.dropped?.length) line("[data-dropped]", fill(box.querySelector<HTMLElement>("[data-dropped]")!.dataset.tpl!, { files: names(sent.dropped) }));
    if (sent.reply) line("[data-reply-by]", fill(box.querySelector<HTMLElement>("[data-reply-by]")!.dataset.tpl!, { channel: sent.reply }));
    // UX2-06: urgent → "call an engineer now" on the first screen instead of "back home / projects"
    if (urgent) {
      const text = document.querySelector<HTMLElement>("[data-urgent-text]");
      if (text) text.textContent = fill(text.dataset.tpl!, { ref: String.fromCharCode(0x2066) + ref + String.fromCharCode(0x2069) });
      document.querySelector<HTMLElement>("[data-urgent-now]")!.hidden = false;
      document.querySelector<HTMLElement>("[data-default-actions]")!.hidden = true;
    }

    // The links' templates (data-ref-href, data-handoff-href) come from the server: only the slots are filled here.
    // The "send drawings" links carry the full hand-off when the form said who sent what; the others their own
    // message (or subject) with the number.
    const handoff = sent.name && sent.company && sent.need ? fill(box.dataset.handoff!) : "";
    document.querySelectorAll<HTMLAnchorElement>("a[data-ref-href]").forEach((a) => {
      a.href = fillHref((handoff && a.dataset.handoffHref) || a.dataset.refHref!, { ref, handoff });
    });

    // "Copy number"
    const copy = box.querySelector<HTMLButtonElement>("[data-ref-copy]");
    const live = box.querySelector<HTMLElement>("[data-ref-live]");
    const copyLabel = copy?.querySelector<HTMLElement>("[data-ref-copy-label]");
    const copyText = copyLabel?.textContent ?? ""; // read once: a second click must not take "Copied" for the label
    let copyTimer = 0;
    copy?.addEventListener("click", async () => {
      let ok = false;
      try {
        await navigator.clipboard.writeText(ref);
        ok = true;
      } catch {
        const ta = Object.assign(document.createElement("textarea"), { value: ref, readOnly: true });
        ta.style.cssText = "position:fixed;inset-inline-start:-9999px;top:0;opacity:0";
        document.body.append(ta);
        ta.select();
        try {
          ok = document.execCommand("copy");
        } catch {}
        ta.remove();
      }
      if (!ok) return;
      if (copyLabel) copyLabel.textContent = copy.dataset.copied ?? copyText;
      if (live) {
        live.textContent = "";
        requestAnimationFrame(() => (live.textContent = copy.dataset.copied ?? ""));
      }
      clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => copyLabel && (copyLabel.textContent = copyText), 2400);
    });
  }
</script>
