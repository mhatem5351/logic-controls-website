---
/**
 * Industries overview: hero → one card per industry (animated art) + "not listed?" tile → CTA band.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Card from "~/components/Card.astro";
import Button from "~/components/Button.astro";
import Icon from "~/components/Icon.astro";
import CtaBand from "~/components/CtaBand.astro";
import IndustryArt from "~/components/illustrations/IndustryArt.astro";
import { absUrl, countLabel, html, industryCopy, industrySlugs, projectsForIndustry, quoteHref, secondaryCta } from "~/components/sections/catalog/catalog";
import { getMessages, localePath, localeStaticPaths, type Locale } from "~/i18n";
import { STATS } from "~/data/stats";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const m = getMessages(locale);
const idx = m.industries.index;
const L = m.common.labels;
const slugs = industrySlugs(locale);
const wa = m.common.whatsapp.default;
const [lead, ...rest] = idx.intro;
const proof = STATS.filter((st) => st.key === "projects" || st.key === "industries" || st.key === "experience").map((st) => ({
  value: st.value,
  label: m.common.stats[st.key].label,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: idx.h1,
  itemListElement: slugs.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: industryCopy(locale, s)!.title,
    url: absUrl(localePath(locale, `industries/${s}`)),
  })),
};
---

<BaseLayout locale={locale} title={idx.seo.title} description={idx.seo.description} path="industries" heroDark jsonLd={jsonLd} whatsappMessage={wa}>
  <Hero
    locale={locale}
    size="page"
    title={html(idx.h1, locale)}
    lead={lead ? html(lead, locale) : undefined}
    primary={{ label: m.ui.cta.quote, href: quoteHref(locale) }}
    secondary={secondaryCta(locale, wa)}
    proof={proof}
  >
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: m.common.breadcrumbs.industries }]} />
  </Hero>

  <Section variant="muted" id="industries" aria-label={m.ui.nav.industries}>
    <ul role="list" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        slugs.map((s) => {
          const it = industryCopy(locale, s)!;
          const n = projectsForIndustry(s).length;
          return (
            <li>
              <Card variant="industry" title={it.title} href={localePath(locale, `industries/${s}`)} text={it.summary} cta={L.viewIndustry} headingLevel="h2" class="h-full">
                <Fragment slot="media">
                  <div class="relative flex justify-center pt-6">
                    <IndustryArt slug={s} variant="dark" size="80%" />
                    {n > 0 && (
                      <span class="absolute end-4 top-4 border border-white/15 bg-navy-950/70 px-2 py-1 type-label text-navy-100 backdrop-blur-sm">
                        {countLabel(locale, n)}
                      </span>
                    )}
                  </div>
                </Fragment>
              </Card>
            </li>
          );
        })
      }
      {
        rest.length > 0 && (
          <li>
            <div class="chamfer-lg relative isolate flex h-full min-h-72 flex-col justify-between gap-8 overflow-hidden bg-royal-600 p-6 text-white sm:p-7 on-dark">
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-blueprint opacity-70" />
              <span class="inline-grid size-10 place-items-center border border-white/30 text-signal-300">
                <Icon name="plus" size={22} />
              </span>
              <div>
                <p class="type-h4 text-white" set:html={html(rest.join(" "), locale)} />
                <Button href={quoteHref(locale)} variant="on-dark" iconEnd="arrow" class="mt-6">
                  {L.contactUs}
                </Button>
              </div>
            </div>
          </li>
        )
      }
    </ul>
  </Section>

  <CtaBand locale={locale} title={html(m.common.ctaBand.industry.title, locale)} text={m.common.ctaBand.industry.text} secondary={secondaryCta(locale, wa)} />
</BaseLayout>
