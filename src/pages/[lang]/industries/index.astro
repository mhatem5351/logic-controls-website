---
/**
 * Industries overview: hero → one card per industry (animated art) + "not listed?" tile → CTA band.
 * Listing page: short hero (no stat strip — the project count per industry is on each card) so the cards show early.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Section from "~/components/Section.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Card from "~/components/Card.astro";
import Icon from "~/components/Icon.astro";
import CtaBand from "~/components/CtaBand.astro";
import IndustryArt from "~/components/illustrations/IndustryArt.astro";
import { countLabel, industryCopy, industryProof, industrySlugs, projectCopy, projectsForIndustry, quoteHref, secondaryCta } from "~/components/sections/catalog/catalog";
import { heading, html } from "~/lib/text";
import { absUrl, graph, itemList, webPage } from "~/lib/jsonld";
import { getMessages, localePath, localeStaticPaths, type Locale } from "~/i18n";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const m = getMessages(locale);
const idx = m.industries.index;
const L = m.common.labels;
const slugs = industrySlugs(locale);
const proof = industryProof(locale, slugs, 2);
const wa = m.common.whatsapp.default;
const [lead, ...rest] = idx.intro;

/* Structured data (src/lib/jsonld.ts): CollectionPage with the industries as an ItemList. */
const jsonLd = graph(
  webPage(locale, {
    type: "CollectionPage",
    path: "industries",
    name: idx.seo.title,
    description: idx.seo.description,
    mainEntity: itemList(idx.h1, slugs.map((s) => ({ name: industryCopy(locale, s)!.title, url: absUrl(localePath(locale, `industries/${s}`)) }))),
  }),
);
---

<BaseLayout locale={locale} title={idx.seo.title} description={idx.seo.description} path="industries" heroDark jsonLd={jsonLd} whatsappMessage={wa}>
  <Hero
    locale={locale}
    size="compact"
    title={html(locale, idx.h1)}
    lead={lead ? html(locale, lead) : undefined}
    primary={{ label: m.ui.cta.quote, href: quoteHref(locale) }}
    secondary={secondaryCta(locale, wa)}
  >
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: m.common.breadcrumbs.industries }]} />
  </Hero>

  <Section variant="muted" id="industries" class="pt-10! lg:pt-14!" aria-label={m.ui.nav.industries}>
    <ul role="list" class="lc-grid-industries">
      {
        slugs.map((s) => {
          const it = industryCopy(locale, s)!;
          const n = projectsForIndustry(s).length;
          return (
            <li>
              <Card
                variant="industry"
                title={it.title}
                href={localePath(locale, `industries/${s}`)}
                text={it.summary}
                cta={L.viewIndustry}
                headingLevel="h2"
                links={{
                  label: `${it.navTitle}: ${L.relatedProjects}`,
                  /* Up to 2 of the industry's case studies (relevance first: primary industry, our own control system, no
                     repeats; catalog.ts industryProof): proof one click from the hub (CS2-08). */
                  items: proof[s].map((p) => ({ href: localePath(locale, `projects/${p.slug}`), html: heading(locale, projectCopy(locale, p.slug)!.cardTitle) })),
                }}
              >
                <Fragment slot="media">
                  <div class="relative flex justify-center pt-5">
                    <IndustryArt slug={s} variant="dark" size="86%" />
                    {n > 0 && (
                      <span class="absolute end-4 top-4 border border-white/15 bg-navy-950/70 px-2 py-1 type-label text-navy-100 backdrop-blur-sm">
                        {countLabel(locale, n)}
                      </span>
                    )}
                  </div>
                </Fragment>
              </Card>
            </li>
          );
        })
      }
      {
        rest.length > 0 && (
          <li>
            {/* the same "other industry" tile as the home page (VIS2-17: one treatment, the dashed light tile) */}
            <article class="group relative flex h-full min-h-72 flex-col justify-between border border-dashed border-royal-600/40 bg-royal-50/50 p-6 transition-colors hover:border-royal-600 sm:p-7 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-(--focus)">
              <span class="chamfer inline-grid size-12 place-items-center bg-royal-600 text-white [--chamfer:10px]" aria-hidden="true">
                <Icon name="plus" size={24} />
              </span>
              <div class="mt-10">
                <p class="type-h4 text-navy-950" set:html={heading(locale, rest.join(" "))} />
                <a
                  href={quoteHref(locale, { industry: "other" })}
                  class="lc-stretch mt-5 inline-flex items-center gap-2 text-sm font-bold text-royal-600 after:absolute after:inset-0 after:content-[''] hover:text-royal-800"
                >
                  {L.contactUs}
                  <Icon name="arrow" size={16} class="transition-transform duration-(--dur-ui) ease-mech group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
                </a>
              </div>
            </article>
          </li>
        )
      }
    </ul>
  </Section>

  <CtaBand locale={locale} title={html(locale, m.common.ctaBand.industry.title)} text={m.common.ctaBand.industry.text} secondary={secondaryCta(locale, wa)} />
</BaseLayout>
