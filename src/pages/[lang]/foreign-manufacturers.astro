---
/**
 * Foreign manufacturers (investor landing page; the key page for /zh/ and /tr/ visitors).
 * Hero → "On this page" bar → what a new plant needs (need → how we close the gap) → services → for machine builders
 * (OEMs who need a local commissioning / service team) → when to involve us → standards & documentation → experience
 * with imported lines (+ founder strip) → languages → zones → FAQ → CTA. Section indices follow what is rendered.
 * Hero CTAs: quote + "Email an engineer" (documents and formal requests travel by email for foreign teams);
 * WhatsApp stays in the closing band.
 */
import { Picture } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Section from "~/components/Section.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import Button from "~/components/Button.astro";
import Icon, { type IconName } from "~/components/Icon.astro";
import ProcessSteps from "~/components/ProcessSteps.astro";
import LogoWall from "~/components/LogoWall.astro";
import FAQ from "~/components/FAQ.astro";
import CtaBand from "~/components/CtaBand.astro";
import ZonesBlock from "~/components/sections/main/ZonesBlock.astro";
import FounderStrip from "~/components/sections/main/FounderStrip.astro";
import PageToc from "~/components/sections/main/PageToc.astro";
import { html, emphasize } from "~/components/sections/main/rich";
import { getMessages, localeStaticPaths, localePath, LOCALE_META, type Locale } from "~/i18n";
import { absUrl, graph, service, webPage } from "~/lib/jsonld";
import { STATS } from "~/data/stats";
import { href, whatsappLink, mailtoLink, prefersEmail } from "~/components/nav";
import heroImage from "~/assets/projects/tablet-coating-scada/machine.jpg";
import proofHmi from "~/assets/projects/anaerobic-waste-treatment-commissioning/hmi.jpg";
import proofPanel from "~/assets/projects/anaerobic-waste-treatment-commissioning/panel.jpg";

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const t = getMessages(locale);
const f = t.foreign;
const c = t.common;
const email = prefersEmail(locale);
const quoteHref = `${href(locale, "contact")}?service=new-factory#quote`;
const PATH = "foreign-manufacturers";
/* Machine builders (OEMs) exporting to Egypt: a local commissioning / service team on their behalf (foreign.oem). */
const oem = f.oem;
const oemQuote = `${href(locale, "contact")}?service=oem-partner#quote`;
const oemMessage = c.whatsapp.oem;
const oemIcons: IconName[] = ["check", "users", "hmi", "wrench"];

/* Section numbers follow what is rendered. */
let n = 0;
const idx = () => String(++n).padStart(2, "0");
const I = {
  needs: idx(),
  services: idx(),
  oem: oem ? idx() : "",
  timeline: idx(),
  standards: idx(),
  proof: idx(),
  languages: idx(),
  zones: idx(),
  faq: idx(),
};
const toc = [
  { id: "needs", label: f.eyebrows.needs },
  { id: "services", label: c.labels.services },
  ...(oem ? [{ id: "oem", label: oem.eyebrow }] : []),
  { id: "timeline", label: f.eyebrows.timeline },
  { id: "standards", label: f.eyebrows.standards },
  { id: "proof", label: f.eyebrows.proof },
  { id: "languages", label: f.eyebrows.languages },
  { id: "zones", label: c.labels.location },
  { id: "faq", label: c.labels.faq },
];
const caseSlug = "anaerobic-waste-treatment-commissioning";
const caseItem = t.projects.items[caseSlug];
const caseAlts = (caseItem?.imageAlts ?? {}) as Record<string, string>;
const heroAlt = ((t.projects.items["tablet-coating-scada"]?.imageAlts ?? {}) as Record<string, string>).machine ?? "";

const EMPHASIS: Record<Locale, string> = {
  en: "automation and controls team",
  ar: "للأتمتة وأنظمة التحكم",
  zh: "本地自动化与控制团队",
  tr: "otomasyon ve kontrol ekibiniz",
};
const needIcons: IconName[] = ["users", "gear", "hmi", "box", "file", "wrench"];
const serviceIcons: IconName[] = ["gear", "traces", "check", "hmi", "bolt", "box", "users", "shield"];
/* Each "what we do for new factories" item links to the service page that covers it (foreign.services.items order). */
const serviceLinks = [
  "services/testing-commissioning",
  "services/testing-commissioning",
  "services/testing-commissioning",
  "services/plc-hmi-programming",
  "services/control-panels",
  "services/maintenance-support",
  "services/maintenance-support",
  "services/maintenance-support",
];
const stepIcons: IconName[] = ["file", "check", "panel", "gauge", "wrench"];
const proof = STATS.map((s) => ({ value: s.value, label: c.stats[s.key].label }));

/* Structured data (src/lib/jsonld.ts): the page + the service for manufacturers setting up in Egypt (localized). */
const jsonLd = graph(
  webPage(locale, { path: "foreign-manufacturers", name: f.seo.title, description: f.seo.description, mainEntity: { "@id": `${absUrl(localePath(locale, "foreign-manufacturers"))}#service` } }),
  service(locale, { path: "foreign-manufacturers", name: f.hero.title, serviceType: f.seo.title, description: f.seo.description, audience: f.hero.eyebrow }),
);
---

<BaseLayout locale={locale} title={f.seo.title} description={f.seo.description} path="foreign-manufacturers" heroDark jsonLd={jsonLd} whatsappMessage={c.whatsapp.foreign}>
  <Hero
    locale={locale}
    size="home"
    titleSize="fit"
    title={emphasize(html(locale, f.hero.title), EMPHASIS[locale])}
    lead={html(locale, f.hero.lead)}
    chips={[f.hero.eyebrow]}
    image={heroImage}
    imageAlt={heroAlt}
    priority
    primary={{ label: f.hero.ctaPrimary, href: quoteHref }}
    secondary={{ label: t.ui.cta.emailEngineer, href: mailtoLink(undefined, { locale, topic: t.ui.nav.foreign, path: PATH }) }}
  >
    <Breadcrumbs slot="breadcrumbs" locale={locale} items={[{ label: c.breadcrumbs.foreign }]} />
    <ul role="list" class="lc-rise mt-9 grid max-w-xl gap-2.5 border-t border-white/10 pt-6" style="--i:3" data-fab-avoid>
      {
        f.hero.chips.map((chip) => (
          <li class="flex items-start gap-3 text-[0.9375rem] text-navy-100">
            <span class="mt-0.5 grid size-5 shrink-0 place-items-center bg-signal-400 text-navy-950" aria-hidden="true">
              <Icon name="check" size={14} strokeWidth={2.5} />
            </span>
            <span set:html={html(locale, chip)} />
          </li>
        ))
      }
    </ul>
  </Hero>

  {/* ---------- proof figures ---------- */}
  <Section compact class="border-b border-charcoal-200" aria-label={c.stats.title}>
    <dl class="grid grid-cols-2 gap-y-8 lg:grid-cols-4">
      {
        proof.map((p, i) => (
          <div
            class:list={[
              "relative flex flex-col gap-1.5 px-4 sm:px-6",
              i > 0 && "before:absolute before:inset-y-1 before:start-0 before:w-px before:-skew-x-[10deg] before:bg-charcoal-200 rtl:before:skew-x-[10deg]",
              i === 2 && "max-lg:before:hidden",
            ]}
          >
            <dt class="text-sm font-medium text-charcoal-600">{p.label}</dt>
            <dd class="order-first type-stat text-navy-950" style="font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem)">
              <span class="ltr" dir="ltr">{p.value.replace(/\+$/, "")}{p.value.endsWith("+") && <span class="text-royal-600">+</span>}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <PageToc locale={locale} items={toc} />

  {/* ---------- 01 what a new plant needs: need → how we close the gap ---------- */}
  <Section id="needs" aria-labelledby="needs-title">
    <SectionHeading id="needs-title" index={I.needs} eyebrow={f.eyebrows.needs} title={html(locale, f.needs.title)} lead={html(locale, f.needs.intro)} />
    <div class="mt-12 hidden grid-cols-[minmax(0,5fr)_4rem_minmax(0,7fr)] gap-6 border-b-2 border-navy-950 pb-3 lg:grid" aria-hidden="true">
      <p class="type-label text-charcoal-600">{f.needs.columns.need}</p>
      <span></span>
      <p class="type-label text-charcoal-600">{f.needs.columns.answer}</p>
    </div>
    <ol role="list" class="mt-10 lg:mt-0">
      {
        f.needs.items.map((item, i) => (
          <li class="group grid gap-3 border-b border-charcoal-200 py-6 lg:grid-cols-[minmax(0,5fr)_4rem_minmax(0,7fr)] lg:items-center lg:gap-6 lg:py-7">
            <div class="flex items-center gap-4">
              <span class="chamfer grid size-12 shrink-0 place-items-center bg-navy-950 text-royal-300 transition-colors [--chamfer:10px] group-hover:bg-royal-700 group-hover:text-white">
                <Icon name={needIcons[i] ?? "check"} size={22} />
              </span>
              <h3 class="flex items-baseline gap-2 type-h4 text-navy-950">
                <span class="font-mono text-xs text-royal-700 ltr" dir="ltr">{String(i + 1).padStart(2, "0")}</span>
                <span>{item.title}</span>
              </h3>
            </div>
            <span aria-hidden="true" class="relative hidden h-px bg-royal-600/40 lg:block">
              <span class="absolute -top-[3px] start-0 size-[7px] rounded-full border border-royal-600 bg-white" />
              <Icon name="chevron-right" size={16} class="absolute -end-1.5 -top-2 text-royal-600" />
            </span>
            <p class="text-charcoal-700 max-lg:ps-16" set:html={html(locale, item.text)} />
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ---------- 02 services for new factories ---------- */}
  <Section variant="muted" id="services" aria-labelledby="services-title">
    <SectionHeading id="services-title" index={I.services} eyebrow={c.labels.services} title={html(locale, f.services.title)} />
    <ul role="list" class="mt-12 grid gap-px overflow-hidden border border-charcoal-200 bg-charcoal-200 sm:grid-cols-2 lg:grid-cols-4">
      {
        f.services.items.map((s, i) => (
          <li class="group relative bg-white p-6 transition-colors hover:bg-royal-50/40 has-[a:focus-visible]:z-10 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:-outline-offset-2 has-[a:focus-visible]:outline-(--focus) sm:p-7">
            <span aria-hidden="true" class="absolute -top-px start-6 h-1 w-8 skew-x-[-10deg] bg-royal-600 transition-[width] duration-300 group-hover:w-14 rtl:skew-x-[10deg] sm:start-7" />
            <div class="flex items-center justify-between">
              <Icon name={serviceIcons[i] ?? "check"} size={26} class="text-royal-600" />
              <span aria-hidden="true" class="font-mono text-xs text-charcoal-600 ltr" dir="ltr">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="mt-5 type-h4 text-navy-950">
              {serviceLinks[i] ? (
                <a href={href(locale, serviceLinks[i])} class="lc-stretch after:absolute after:inset-0 after:content-[''] group-hover:text-royal-700" set:html={html(locale, s.title)} />
              ) : (
                <span set:html={html(locale, s.title)} />
              )}
            </h3>
            <p class="mt-2 text-[0.9375rem] text-charcoal-600" set:html={html(locale, s.text)} />
            {serviceLinks[i] && (
              <Icon name="arrow" size={16} class="mt-4 text-royal-600 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ---------- for machine builders (OEMs): commissioning and support on their behalf ---------- */}
  {
    oem && (
      <Section id="oem" aria-labelledby="oem-title">
        <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-5">
            <SectionHeading id="oem-title" index={I.oem} eyebrow={oem.eyebrow} title={html(locale, oem.title)} lead={html(locale, oem.intro)} />
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href={oemQuote} iconEnd="arrow" class="max-sm:w-full">{oem.cta}</Button>
              {
                email ? (
                  <Button href={mailtoLink(undefined, { locale, topic: oem.eyebrow, path: PATH })} variant="secondary" icon="mail" iconClass="text-royal-600" class="max-sm:w-full">
                    {t.ui.cta.emailEngineer}
                  </Button>
                ) : (
                  <Button href={whatsappLink(oemMessage)} variant="secondary" icon="whatsapp" iconClass="text-whatsapp-700" external class="max-sm:w-full">
                    {t.ui.cta.whatsapp}
                  </Button>
                )
              }
            </div>
          </div>
          <ol role="list" class="relative grid gap-px overflow-hidden border border-charcoal-200 bg-charcoal-200 sm:grid-cols-2 lg:col-span-7">
            {oem.items.map((item, i) => (
              <li class="relative bg-white p-6 sm:p-7">
                <div class="flex items-center justify-between">
                  <span class="chamfer inline-grid size-11 place-items-center bg-navy-950 text-royal-300 [--chamfer:9px]" aria-hidden="true">
                    <Icon name={oemIcons[i] ?? "check"} size={22} />
                  </span>
                  <span aria-hidden="true" class="font-mono text-xs text-charcoal-600 ltr" dir="ltr">{String(i + 1).padStart(2, "0")}</span>
                </div>
                <h3 class="mt-5 type-h4 text-navy-950" set:html={html(locale, item.title)} />
                <p class="mt-2 text-[0.9375rem] text-charcoal-600" set:html={html(locale, item.text)} />
              </li>
            ))}
          </ol>
        </div>
      </Section>
    )
  }

  {/* ---------- 03 when to involve us ---------- */}
  <Section id="timeline" aria-labelledby="timeline-title">
    <SectionHeading id="timeline-title" index={I.timeline} eyebrow={f.eyebrows.timeline} title={html(locale, f.timeline.title)} lead={html(locale, f.timeline.intro)} />
    <ProcessSteps class="mt-14" locale={locale} steps={f.timeline.steps.map((s, i) => ({ title: s.title, text: s.text, icon: stepIcons[i] }))} />
  </Section>

  {/* ---------- 04 standards & documentation ---------- */}
  <Section variant="dark" angle="both" id="standards" aria-labelledby="standards-title">
    <div class="grid items-start gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <SectionHeading id="standards-title" index={I.standards} eyebrow={f.eyebrows.standards} title={html(locale, f.standards.title)} />
        <div class="mt-6 space-y-4 text-navy-200">
          {f.standards.paragraphs.map((p) => <p set:html={html(locale, p)} />)}
        </div>
      </div>
      <div class="lg:col-span-6">
        <div class="chamfer-lg relative border border-white/10 bg-white/[0.04] p-6 sm:p-8">
          <span aria-hidden="true" class="absolute -top-px start-8 h-1 w-14 skew-x-[-10deg] bg-signal-400 rtl:skew-x-[10deg]"></span>
          <ul role="list" class="divide-y divide-white/10">
            {
              f.standards.items.map((item, i) => (
                <li class="flex items-center gap-4 py-4 first:pt-0 last:pb-0">
                  <span class="grid size-11 shrink-0 place-items-center border border-royal-400/40 bg-navy-900 text-signal-300">
                    <Icon name={i === 0 ? "shield" : "file"} size={20} />
                  </span>
                  <span class="flex-1 font-semibold text-white" set:html={html(locale, item)} />
                  <Icon name="check" size={18} class="shrink-0 text-[#2bd47d]" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>

  {/* ---------- 05 experience with imported lines ---------- */}
  <Section id="proof" aria-labelledby="proof-title">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="relative lg:col-span-6">
        <div class="chamfer-lg relative aspect-[4/3] overflow-hidden bg-navy-950">
          <Picture src={proofHmi} alt={caseAlts.hmi ?? ""} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 1024px) 45vw, 100vw" layout="full-width" class="size-full object-cover" />
        </div>
        <div class="absolute -bottom-8 end-4 w-[42%] border-4 border-white bg-white shadow-lift sm:end-6">
          <Picture src={proofPanel} alt={caseAlts.panel ?? ""} formats={["avif", "webp"]} widths={[240, 360, 480]} sizes="(min-width: 1024px) 20vw, 40vw" layout="full-width" class="aspect-square size-full object-cover" />
        </div>
      </div>
      <div class="lg:col-span-6 max-lg:pt-6">
        <SectionHeading id="proof-title" index={I.proof} eyebrow={f.eyebrows.proof} title={html(locale, f.proof.title)} />
        <div class="mt-6 space-y-4 text-charcoal-700">
          {f.proof.paragraphs.map((p) => <p set:html={html(locale, p)} />)}
        </div>
        {
          caseItem && (
            <a href={href(locale, `projects/${caseSlug}`)} class="group mt-8 flex items-center gap-4 border border-charcoal-200 p-4 transition-colors hover:border-royal-600">
              <span class="chamfer grid size-11 shrink-0 place-items-center bg-navy-950 text-signal-300 [--chamfer:9px]"><Icon name="check" size={20} /></span>
              <span class="min-w-0 flex-1">
                <span class="block type-label text-charcoal-600">{f.proof.cta}</span>
                <span class="mt-0.5 block font-bold text-navy-950 group-hover:text-royal-700">{caseItem.cardTitle}</span>
              </span>
              <Icon name="arrow" size={20} class="shrink-0 text-royal-600 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
            </a>
          )
        }
        {/* The one third-party proof an anonymised portfolio can offer: a reference call (with the client's permission). */}
        <div class="relative mt-6 border border-charcoal-200 bg-white p-6">
          <span aria-hidden="true" class="absolute -top-px start-6 h-1 w-14 skew-x-[-10deg] bg-royal-600 rtl:skew-x-[10deg]" />
          <p class="flex items-center gap-2.5 type-h4 text-navy-950">
            <Icon name="users" size={20} class="shrink-0 text-royal-600" />
            {c.labels.referenceTitle}
          </p>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-charcoal-700">{c.labels.referenceText}</p>
          <a href={`${href(locale, "contact")}?service=other#quote`} class="group mt-4 inline-flex min-h-6 items-center gap-2 text-sm font-bold text-royal-600 hover:text-royal-800">
            {c.labels.referenceCta}
            <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
          </a>
        </div>
      </div>
    </div>
    <LogoWall locale={locale} class="mt-20 [&_li]:text-charcoal-600" />
    <FounderStrip locale={locale} class="mt-14 lg:mt-16" />
  </Section>

  {/* ---------- 06 languages ---------- */}
  <Section variant="muted" id="languages" aria-labelledby="languages-title">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <SectionHeading id="languages-title" index={I.languages} eyebrow={f.eyebrows.languages} title={html(locale, f.languages.title)} />
        <p class="mt-6 text-charcoal-700" set:html={html(locale, f.languages.text)} />
      </div>
      <ul role="list" class="grid content-start gap-4 sm:grid-cols-2 lg:col-span-7">
        {
          (["ar", "en", "zh", "tr"] as const).map((l) => (
            <li class:list={["relative border bg-white p-5 sm:p-6", l === locale ? "border-royal-600 shadow-card" : "border-charcoal-200"]}>
              <p lang={LOCALE_META[l].htmlLang} class="type-h3 text-navy-950">
                {LOCALE_META[l].native}
              </p>
              <p class="mt-2 text-sm text-charcoal-600" set:html={html(locale, f.languages.roles[l])} />
              {l === locale && <span class="lc-led absolute end-5 top-6" aria-hidden="true" />}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  {/* ---------- 07 zones ---------- */}
  <Section id="zones" aria-labelledby="zones-title">
    <SectionHeading id="zones-title" index={I.zones} eyebrow={c.labels.location} title={html(locale, c.zones.title)} lead={html(locale, c.zones.intro)} />
    <ZonesBlock locale={locale} class="mt-12" />
  </Section>

  {/* ---------- 08 FAQ ---------- */}
  <Section variant="muted" id="faq" aria-labelledby="faq-title">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <SectionHeading id="faq-title" index={I.faq} eyebrow={c.labels.faq} title={html(locale, f.faq.title)} />
          <Button href={quoteHref} variant="secondary" iconEnd="arrow" class="mt-8">{f.hero.ctaPrimary}</Button>
        </div>
      </div>
      <FAQ class="lg:col-span-8" items={f.faq.items.map((x) => ({ q: x.q, a: html(locale, x.a) }))} openFirst />
    </div>
  </Section>

  <CtaBand
    locale={locale}
    title={html(locale, c.ctaBand.foreign.title)}
    text={c.ctaBand.foreign.text}
    eyebrow={t.ui.nav.foreign}
    primary={{ label: f.hero.ctaPrimary, href: quoteHref }}
    secondary={email ? undefined : { label: f.hero.ctaSecondary, href: whatsappLink(c.whatsapp.foreign) }}
  />
</BaseLayout>
