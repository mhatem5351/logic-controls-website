{
  // Type-checks the Worker against the Workers runtime types (the site's tsconfig excludes worker/):
  //   npx tsc -p worker
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/lib/rfq-rules.ts", "../src/i18n/config.ts"]
}
