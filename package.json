{
  "name": "logic-controls-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-i18n.mjs && astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check && node scripts/check-i18n.mjs",
    "deploy": "npm run build && wrangler deploy",
    "qa:html": "html-validate \"dist/**/*.html\"",
    "indexnow": "node --env-file=.env scripts/indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "html-validate": "^11.16.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
}
