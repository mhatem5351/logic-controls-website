# Cloudflare Workers static assets: response headers (https://developers.cloudflare.com/workers/static-assets/headers/)
# Third-party origins allowed by the CSP — and nothing else:
#   challenges.cloudflare.com      Turnstile widget (script + iframe + siteverify from the browser)
#   static.cloudflareinsights.com  Web Analytics beacon script
#   cloudflareinsights.com         Web Analytics beacon reports (/cdn-cgi/rum)
# script-src keeps 'unsafe-inline' here only because a header cannot list per-page hashes. Every page also carries a
#   <meta http-equiv="content-security-policy"> (astro.config.mjs security.csp + integrations/csp-inline-hashes.mjs)
#   whose script-src lists the SHA-256 of each inline script on that page and no 'unsafe-inline'. Browsers enforce
#   both policies, so only the build's own inline scripts run (an injected <script> or onerror= handler is refused).
#   If a Cloudflare feature that injects inline scripts into HTML is ever switched on (Rocket Loader, Bot Fight Mode's
#   JavaScript detections, Zaraz), its snippet is refused by that <meta> policy: test the live site's console first.
# No upgrade-insecure-requests: every URL in the site is already https or same-origin, Cloudflare redirects http to
# https (Always Use HTTPS) and HSTS below keeps browsers on https; the directive only broke local http previews in
# WebKit (it upgrades http://127.0.0.1 subresources, which then fail).
# HSTS without `preload` for now: add it (and submit to hstspreload.org) once every subdomain is known to be https-only.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; child-src https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Illustration fragments for lazy art slots: always requested as /en/art/<kind>/?v=<content hash>
# (src/pages/[lang]/art/[kind].astro, shared by every locale)
/en/art/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

/media/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*
  Cache-Control: public, max-age=604800
